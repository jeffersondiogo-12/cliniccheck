    function printDoc() {
      const openPreview = document.querySelector('.print-preview.open');
      if (!openPreview) { alert('Visualize a receita ou o atestado antes de imprimir.'); return; }
      const pane = openPreview.closest('.content > *');
      if (pane) pane.classList.add('pane-print-active');
      window.print();
      if (pane) pane.classList.remove('pane-print-active');
