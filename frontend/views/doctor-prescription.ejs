    // ── HISTÓRICO RECEITAS ──
    async function loadHistR() {
      const res = await fetch('/api/prescriptions/prescriptions', { headers: h });
      allPrescriptions = res.ok ? await res.json() : [];
      renderHistR();
    }

    function renderHistR() {
      const q = (document.getElementById('histRSearch').value || '').toLowerCase();
      const list = !q ? allPrescriptions : allPrescriptions.filter(r =>
        (r.patient_name || '').toLowerCase().includes(q) ||
        (r.patient_email || '').toLowerCase().includes(q)
      );
      const tbody = document.getElementById('histRBody');
      if (!list.length) { tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:24px;color:var(--text-muted)">Nenhuma receita encontrada</td></tr>'; return; }
      tbody.innerHTML = list.map(r => {
        const meds = (Array.isArray(r.medications) ? r.medications : []).map(m => m.name || '').filter(Boolean).join(', ') || '—';
        return `<tr>
          <td><strong>${escH(r.patient_name || '—')}</strong><br><small style="color:var(--text-muted)">${escH(r.patient_email || '')}</small></td>
          <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escH(meds)}">${escH(meds)}</td>
          <td>${escH(r.surgery_title || '—')}</td>
          <td>${r.issued_at ? new Date(r.issued_at).toLocaleDateString('pt-BR') : '—'}</td>
          <td><button class="btn btn-red btn-sm" onclick="deleteRec('${r.id}')">Excluir</button></td>
        </tr>`;
      }).join('');
    }

    async function deleteRec(id) {
      if (!confirm('Excluir esta receita?')) return;
      await fetch(`/api/prescriptions/prescriptions/${id}`, { method: 'DELETE', headers: h });
      allPrescriptions = allPrescriptions.filter(r => r.id !== id);
      renderHistR();
    }

    // ── HISTÓRICO ATESTADOS ──
    async function loadHistA() {
      const res = await fetch('/api/prescriptions/certificates', { headers: h });
      allAtestados = res.ok ? await res.json() : [];
      renderHistA();
    }

    function normalizeCidArray(a) {
      if (Array.isArray(a.cids) && a.cids.length) return a.cids;
      if (a.cid10_code) return [{ code: a.cid10_code, description: a.cid10_desc || '', version: a.cid_version || '10' }];
      return [];
    }

    function renderHistA() {
      const q = (document.getElementById('histASearch').value || '').toLowerCase();
      const list = !q ? allAtestados : allAtestados.filter(a =>
        (a.patient_name || '').toLowerCase().includes(q) ||
        (a.patient_email || '').toLowerCase().includes(q) ||
        (a.cid10_code || '').toLowerCase().includes(q) ||
        normalizeCidArray(a).some(c => (c.code || '').toLowerCase().includes(q) || (c.description || '').toLowerCase().includes(q))
      );
      const tbody = document.getElementById('histABody');
      if (!list.length) { tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--text-muted)">Nenhum atestado encontrado</td></tr>'; return; }
      tbody.innerHTML = list.map(a => {
        const cids = normalizeCidArray(a);
        const cidCell = cids.length ?
          cids.map(c => `<span class="badge badge-blue">${escH(c.code)}</span><small style="display:block;color:var(--text-muted)">${escH(c.description || '')}</small>`).join('') :
          '—';
        return `<tr>
          <td><strong>${escH(a.patient_name || '—')}</strong><br><small style="color:var(--text-muted)">${escH(a.patient_email || '')}</small></td>
          <td>${cidCell}</td>
          <td>${a.rest_days} dia(s)</td>
          <td>${escH(a.surgery_title || '—')}</td>
          <td>${a.issued_at ? new Date(a.issued_at).toLocaleDateString('pt-BR') : '—'}</td>
          <td><button class="btn btn-red btn-sm" onclick="deleteAte('${a.id}')">Excluir</button></td>
        </tr>`;
      }).join('');
    }

    async function deleteAte(id) {
      if (!confirm('Excluir este atestado?')) return;
      await fetch(`/api/prescriptions/certificates/${id}`, { method: 'DELETE', headers: h });
      allAtestados = allAtestados.filter(a => a.id !== id);
      renderHistA();
    }

    // ── CID-10 TABELA ──
    let allCids = [];

    async function loadCidTable() {
      try {
        const res = await fetch('/api/prescriptions/cid10', { headers: h });
        if (!res.ok) throw new Error('Falha ao carregar CID-10');
        allCids = await res.json();
        renderCidTable();
      } catch (err) {
        console.error('Erro ao carregar CID-10:', err);
        const tbody = document.getElementById('cidBody');
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:24px;color:var(--red);">Erro ao carregar dados. Tente recarregar a página.</td></tr>';
      }
    }

    function renderCidTable() {
      const tbody = document.getElementById('cidBody');
      if (!allCids.length) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:24px;color:var(--text-muted)">Nenhum CID-10 cadastrado. Clique em "+ Novo CID-10".</td></tr>';
        return;
      }
      tbody.innerHTML = allCids.map(c => `<tr>
        <td><strong>${escH(c.code)}</strong></td>
        <td>${escH(c.description)}</td>
        <td>${escH(c.category || '—')}</td>
        <td><span class="badge ${c.active ? 'badge-green' : 'badge-gray'}">${c.active ? 'Ativo' : 'Inativo'}</span></td>
        <td style="display:flex;gap:6px;flex-wrap:wrap;">
          <button class="btn btn-outline btn-sm" onclick="toggleCid('${c.id}',${!c.active})">${c.active ? 'Desativar' : 'Ativar'}</button>
          <button class="btn btn-red btn-sm" onclick="deleteCid('${c.id}')">Excluir</button>
        </td>
      </tr>`).join('');
    }

    async function toggleCid(id, active) {
      try {
        const res = await fetch(`/api/prescriptions/cid10/${id}`, {
          method: 'PUT',
          headers: h,
          body: JSON.stringify({ active })
        });
        if (!res.ok) throw new Error('Falha ao atualizar');
        await loadCidTable();
      } catch (err) {
        alert('Erro ao atualizar: ' + err.message);
      }
    }

    async function deleteCid(id) {
      if (!confirm('Excluir este CID-10?')) return;
      try {
        const res = await fetch(`/api/prescriptions/cid10/${id}`, { method: 'DELETE', headers: h });
        if (!res.ok) throw new Error('Falha ao excluir');
        allCids = allCids.filter(c => c.id !== id);
        renderCidTable();
      } catch (err) {
        alert('Erro ao excluir: ' + err.message);
      }
    }

    // ── MODAL CID ──
    function openAddCidModal() {
      document.getElementById('cidCode').value = '';
      document.getElementById('cidDesc').value = '';
      document.getElementById('cidCat').value = '';
      document.getElementById('cidOk').style.display = 'none';
      document.getElementById('cidErr').style.display = 'none';
      document.getElementById('cidModal').classList.add('open');
      setTimeout(() => document.getElementById('cidCode').focus(), 100);
    }

    function closeCidModal() {
      document.getElementById('cidModal').classList.remove('open');
    }

    async function saveCid() {
      const ok = document.getElementById('cidOk');
      const err = document.getElementById('cidErr');
      ok.style.display = 'none';
      err.style.display = 'none';

      const code = document.getElementById('cidCode').value.trim().toUpperCase();
      const desc = document.getElementById('cidDesc').value.trim();
      const category = document.getElementById('cidCat').value.trim() || null;

      if (!code) { err.textContent = 'Informe o código CID-10.'; err.style.display = 'block'; return; }
      if (!desc) { err.textContent = 'Informe a descrição.'; err.style.display = 'block'; return; }
      if (!/^[A-Z]\d{1,2}(\.\d{1,2})?$/.test(code)) {
        err.textContent = 'Formato inválido. Use ex: J45, K21.0, Z87.1';
        err.style.display = 'block';
        return;
      }

      const btn = document.getElementById('cidSaveBtn');
      btn.disabled = true;
      btn.textContent = 'Salvando...';
      try {
        const res = await fetch('/api/prescriptions/cid10', {
          method: 'POST',
          headers: h,
          body: JSON.stringify({ code, description: desc, category })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Erro ao salvar');
        ok.textContent = 'CID-10 cadastrado com sucesso!';
        ok.style.display = 'block';
        allCids.unshift(data);
        renderCidTable();
        setTimeout(() => {
          closeCidModal();
          document.getElementById('cidCode').value = '';
          document.getElementById('cidDesc').value = '';
          document.getElementById('cidCat').value = '';
        }, 1000);
      } catch (error) {
        err.textContent = error.message || 'Erro de conexão.';
        err.style.display = 'block';
      }
      btn.disabled = false;
      btn.textContent = 'Salvar';
    }

    document.getElementById('cidModal').addEventListener('click', e => {
      if (e.target === e.currentTarget) closeCidModal();
    });

    // ── INIT ──
    loadBase();
    addMed('rMedList');
  </script>

  <!-- socket.io - atualizações em tempo real -->
  <script src="/socket.io/socket.io.js"></script>
  <script>
    (function() {
      const _tok = localStorage.getItem('doctorToken');
      const _doc = JSON.parse(localStorage.getItem('doctorData') || '{}');
      if (!_tok || !_doc.id) return;
      const _sock = io({ transports: ['websocket', 'polling'] });
      _sock.on('connect', () => _sock.emit('join_doctor', _doc.id));
      _sock.on('prescription_saved', () => { if (typeof loadHistR === 'function') loadHistR(); });
      _sock.on('certificate_saved', () => { if (typeof loadHistA === 'function') loadHistA(); });
      _sock.on('patient_created', () => { if (typeof loadBase === 'function') loadBase(); });
      _sock.on('patient_updated', () => { if (typeof loadBase === 'function') loadBase(); });
