                    </select>
                  </div>
                </div>
                <div class="cid-search-wrap">
                  <input type="text" id="aCidSearch" placeholder="Digite código (ex: J45, 6A80) ou termo (CID-11)..." autocomplete="off" oninput="onCidInput(this.value)" onkeydown="onCidKeyDown(event)" onfocus="onCidFocus()" onblur="onCidBlur()" />
                  <div class="cid-dropdown" id="aCidDropdown" style="display:none"></div>
                </div>
                <div class="cid-selected" id="aCidSelected">
                  <div><strong>CIDs selecionados para este atestado</strong></div>
                  <div class="cid-list" id="aCidList"></div>
