                <p id="pvDoctorInfo">Dr(a). —</p>
                <p class="clinic-address" id="pvClinicAddress"></p>
              </div>
            </div>
            <div class="doc-type">RECEITA MÉDICA</div>
          </div>
          <div class="print-section">
            <h4>Paciente</h4>
            <p><strong id="pvRName">—</strong></p>
            <p id="pvRInfo" style="font-size:11px;color:var(--text-muted);margin-top:3px;"></p>
          </div>
          <div class="print-section">
            <h4>Medicamentos Prescritos</h4>
            <table class="print-meds"><thead><tr><th>Medicamento</th><th>Dosagem</th><th>Posologia</th></tr></thead>
            <tbody id="pvMedRows"></tbody></table>
          </div>
