<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Clinic Chek · Receita / Atestado</title>
  <link rel="icon" type="image/svg+xml" href="/public/brand/clinic-check-favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

  <style>
    /* ============================================================
       SISTEMA DE TEMAS — CLARO EQUILIBRADO / ESCURO
       ============================================================ */
    :root {
      --bg-base: #edf2f7;
      --bg-surface: #f7fafc;
      --bg-card: #ffffff;
      --bg-card-hover: #f0f5ff;
      --bg-elevated: #eef2f7;
      --bg-input: #ffffff;
      --border-subtle: #e2e8f0;
      --border-card: #e2e8f0;
      --text-primary: #2d3748;
      --text-secondary: #4a5568;
      --text-muted: #718096;
      --accent-1: #4a90d9;
      --accent-1-dim: #e8f0fe;
      --accent-2: #6bc5b8;
      --accent-2-dim: #e6f7f2;
      --accent-3: #b794f4;
      --accent-3-dim: #f0e8ff;
      --accent-4: #f6ad55;
      --accent-4-dim: #fef5e7;
      --accent-5: #6fcf97;
      --accent-5-dim: #eafaf1;
      --red: #e53e3e;
      --red-bg: #fff5f5;
      --shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
      --shadow-hover: 0 8px 30px rgba(0, 0, 0, 0.10);
      --radius: 12px;
      --font: 'Inter', system-ui, -apple-system, sans-serif;
      --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    [data-theme="dark"] {
      --bg-base: #0b1120;
      --bg-surface: #111c2e;
      --bg-card: #162033;
      --bg-card-hover: #1c2a42;
      --bg-elevated: #1e2d45;
      --bg-input: #111c2e;
      --border-subtle: rgba(255, 255, 255, 0.06);
      --border-card: rgba(255, 255, 255, 0.07);
      --text-primary: #f0f4ff;
      --text-secondary: #b0c4e8;
      --text-muted: #7a8aa8;
      --accent-1: #3b82f6;
      --accent-1-dim: rgba(59, 130, 246, 0.15);
      --accent-2: #06b6d4;
      --accent-2-dim: rgba(6, 182, 212, 0.12);
      --accent-3: #8b5cf6;
      --accent-3-dim: rgba(139, 92, 246, 0.12);
      --accent-4: #f59e0b;
      --accent-4-dim: rgba(245, 158, 11, 0.12);
      --accent-5: #10b981;
      --accent-5-dim: rgba(16, 185, 129, 0.12);
      --red: #f87171;
      --red-bg: rgba(239, 68, 68, 0.08);
      --shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
      --shadow-hover: 0 12px 40px rgba(0, 0, 0, 0.45);
    }

    /* ============================================================
       RESET E BASE
       ============================================================ */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: var(--font);
      background: var(--bg-base);
      color: var(--text-primary);
      display: flex;
      min-height: 100vh;
      transition: background var(--transition), color var(--transition);
    }

    /* ============================================================
       SIDEBAR — ESTRUTURA COMPLETA
       ============================================================ */
    /* ----- TEMA CLARO (PADRÃO) E ESCURO PARA SIDEBAR ----- */
    :root {
      --sb-bg: #f8fafc;
      --sb-surface: #ffffff;
      --sb-elevated: #f1f5f9;
      --sb-border: #e2e8f0;
      --sb-text: #1e293b;
      --sb-text-secondary: #334155;
      --sb-text-muted: #64748b;
      --sb-accent: #2563eb;
      --sb-accent-dim: #eff6ff;
      --sb-accent-hover: #dbeafe;
      --sb-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
      --sb-radius: 12px;
      --sb-font: 'Inter', system-ui, -apple-system, sans-serif;
      --sb-sidebar-width: 280px;
      --sb-sidebar-collapsed: 72px;
      --sb-transition: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    [data-theme="dark"] {
      --sb-bg: #0b1120;
      --sb-surface: #111c2e;
      --sb-elevated: #1e2d45;
      --sb-border: rgba(255, 255, 255, 0.06);
      --sb-text: #f0f4ff;
      --sb-text-secondary: #b0c4e8;
      --sb-text-muted: #7a8aa8;
      --sb-accent: #3b82f6;
      --sb-accent-dim: rgba(59, 130, 246, 0.15);
      --sb-accent-hover: rgba(59, 130, 246, 0.25);
      --sb-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
    }

    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--sb-sidebar-width);
      background: var(--sb-surface);
      border-right: 1px solid var(--sb-border);
      color: var(--sb-text);
      font-family: var(--sb-font);
      z-index: 1000;
      display: flex;
      flex-direction: column;
      transition: width var(--sb-transition), transform var(--sb-transition), background var(--sb-transition);
      box-shadow: var(--sb-shadow);
      overflow: hidden;
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
    }

    .sidebar.collapsed {
      width: var(--sb-sidebar-collapsed);
    }
    .sidebar.collapsed .sb-brand-title,
    .sidebar.collapsed .sidebar-user,
    .sidebar.collapsed .sb-group-btn span:not(.caret),
    .sidebar.collapsed .nav-item span,
    .sidebar.collapsed .sidebar-footer .btn-logout span,
    .sidebar.collapsed .sb-toggle-label {
      opacity: 0;
      pointer-events: none;
      width: 0;
      overflow: hidden;
      transition: opacity 0.2s;
    }
    .sidebar.collapsed .sb-brand-icon {
      margin-right: 0;
    }
    .sidebar.collapsed .nav-item {
      justify-content: center;
      padding: 10px !important;
    }
    .sidebar.collapsed .nav-item i {
      margin-right: 0;
      font-size: 18px;
    }
    .sidebar.collapsed .sb-group-btn {
      justify-content: center;
      padding: 6px 0;
    }
    .sidebar.collapsed .sb-group-btn .caret {
      display: none;
    }
    .sidebar.collapsed .sidebar-footer .btn-logout {
      justify-content: center;
      padding: 10px !important;
    }
    .sidebar.collapsed .sidebar-footer .btn-logout i {
      margin-right: 0;
    }

    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 999;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .sidebar-overlay.active {
      opacity: 1;
    }

    .sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 20px 14px;
      border-bottom: 1px solid var(--sb-border);
      flex-shrink: 0;
    }
    .sb-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      overflow: hidden;
    }
    .sb-brand-icon {
      width: 38px;
      height: 38px;
      background: linear-gradient(135deg, var(--sb-accent), #06b6d4);
      border-radius: var(--sb-radius);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 18px;
      flex-shrink: 0;
      transition: transform 0.3s ease;
    }
    .sb-brand-icon:hover {
      transform: rotate(-8deg) scale(1.05);
    }
    .sb-brand-title {
      display: flex;
      flex-direction: column;
      white-space: nowrap;
      overflow: hidden;
      transition: opacity 0.2s;
    }
    .sb-brand-title h2 {
      font-size: 17px;
      font-weight: 700;
      color: var(--sb-text);
      letter-spacing: -0.3px;
      background: linear-gradient(135deg, var(--sb-text) 60%, var(--sb-accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .sb-brand-title small {
      font-size: 10px;
      color: var(--sb-text-muted);
      font-weight: 400;
      -webkit-text-fill-color: var(--sb-text-muted);
    }

    .sb-toggle-btn {
      background: none;
      border: none;
      color: var(--sb-text-muted);
      font-size: 18px;
      cursor: pointer;
      padding: 6px 8px;
      border-radius: 8px;
      transition: background 0.2s, transform 0.3s;
      flex-shrink: 0;
    }
    .sb-toggle-btn:hover {
      background: var(--sb-elevated);
      color: var(--sb-text);
    }
    .sb-toggle-btn:active {
      transform: scale(0.9);
    }

    .sidebar-user {
      margin: 12px 16px 8px;
      padding: 14px 16px;
      background: var(--sb-elevated);
      border-radius: var(--sb-radius);
      border: 1px solid var(--sb-border);
      transition: background 0.3s, opacity 0.2s;
      flex-shrink: 0;
    }
    .sidebar-user .name {
      font-size: 14px;
      font-weight: 600;
      color: var(--sb-text);
    }
    .sidebar-user .role {
      font-size: 11px;
      color: var(--sb-text-muted);
      margin-top: 2px;
    }
    .sidebar-user .clinic {
      font-size: 11px;
      color: var(--sb-accent);
      margin-top: 4px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .sidebar-user .clinic i {
      font-size: 10px;
    }

    .sidebar-nav {
      flex: 1;
      padding: 8px 12px 8px;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--sb-border) transparent;
    }
    .sidebar-nav::-webkit-scrollbar {
      width: 4px;
    }
    .sidebar-nav::-webkit-scrollbar-thumb {
      background: var(--sb-border);
      border-radius: 10px;
    }

    .sb-group {
      margin-top: 4px;
    }
    .sb-group + .sb-group {
      margin-top: 6px;
      padding-top: 8px;
      border-top: 1px solid var(--sb-border);
    }

    .sb-group-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: transparent;
      border: 0;
      color: var(--sb-text-muted);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      padding: 6px 10px;
      cursor: pointer;
      font-family: var(--sb-font);
      border-radius: 6px;
      transition: color 0.25s, background 0.25s;
    }
    .sb-group-btn:hover {
      color: var(--sb-accent);
      background: var(--sb-accent-dim);
    }
    .sb-group-btn .caret {
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      font-size: 9px;
    }
    .sb-group.open .sb-group-btn .caret {
      transform: rotate(90deg);
      color: var(--sb-accent);
    }

    .sb-group-list {
      display: flex;
      flex-direction: column;
      gap: 2px;
      overflow: hidden;
      max-height: 0;
      opacity: 0;
      transform: translateY(-6px);
      transition: max-height 0.4s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.3s ease,
        transform 0.3s ease;
      pointer-events: none;
    }
    .sb-group.open .sb-group-list {
      max-height: 600px;
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 9px 12px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 500;
      color: var(--sb-text-secondary);
      text-decoration: none;
      transition: background 0.2s, color 0.2s, transform 0.15s, padding 0.2s;
      position: relative;
      background: transparent;
      border: none;
      cursor: pointer;
      width: 100%;
      text-align: left;
      font-family: var(--sb-font);
      overflow: hidden;
    }
    .nav-item i {
      width: 20px;
      font-size: 15px;
      color: var(--sb-text-muted);
      flex-shrink: 0;
      transition: color 0.2s, transform 0.3s;
    }
    .nav-item span {
      white-space: nowrap;
      overflow: hidden;
      transition: opacity 0.2s;
    }

    .nav-item::before {
      content: '';
      position: absolute;
      left: 0;
      top: 6px;
      bottom: 6px;
      width: 3px;
      border-radius: 0 4px 4px 0;
      background: var(--sb-accent);
      transform: scaleY(0);
      transform-origin: center;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .nav-item:hover {
      background: var(--sb-accent-dim);
      color: var(--sb-text);
      transform: translateX(3px);
    }
    .nav-item:hover i {
      color: var(--sb-accent);
      transform: scale(1.1) rotate(-4deg);
    }
    .nav-item:hover::before {
      transform: scaleY(0.5);
    }

    .nav-item.active {
      background: var(--sb-accent-dim);
      color: var(--sb-text);
      font-weight: 600;
      box-shadow: inset 3px 0 0 var(--sb-accent);
    }
    .nav-item.active::before {
      transform: scaleY(1);
    }
    .nav-item.active i {
      color: var(--sb-accent);
    }
    .nav-item:active {
      transform: scale(0.97);
    }
    .nav-item[hidden] {
      display: none !important;
    }

    .sidebar-footer {
      padding: 12px 16px 16px;
      border-top: 1px solid var(--sb-border);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .theme-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 6px 10px;
      border-radius: 8px;
      background: var(--sb-elevated);
      border: 1px solid var(--sb-border);
      transition: background 0.3s;
    }
    .theme-toggle .sb-toggle-label {
      font-size: 12px;
      font-weight: 500;
      color: var(--sb-text-muted);
      transition: opacity 0.2s;
    }
    .theme-toggle .toggle-switch {
      position: relative;
      width: 40px;
      height: 22px;
      background: var(--sb-border);
      border-radius: 12px;
      cursor: pointer;
      transition: background 0.3s;
      flex-shrink: 0;
    }
    .theme-toggle .toggle-switch .slider {
      position: absolute;
      top: 2px;
      left: 2px;
      width: 18px;
      height: 18px;
      background: #fff;
      border-radius: 50%;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }
    [data-theme="dark"] .theme-toggle .toggle-switch {
      background: var(--sb-accent);
    }
    [data-theme="dark"] .theme-toggle .toggle-switch .slider {
      transform: translateX(18px);
      background: #fff;
    }

    .btn-logout {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      width: 100%;
      border: none;
      border-radius: 8px;
      background: rgba(239, 68, 68, 0.08);
      color: #ef4444;
      font-size: 13px;
      font-weight: 500;
      font-family: var(--sb-font);
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
    }
    .btn-logout i {
      font-size: 15px;
    }
    .btn-logout span {
      transition: opacity 0.2s;
    }
    .btn-logout:hover {
      background: rgba(239, 68, 68, 0.16);
    }
    .btn-logout:active {
      transform: scale(0.97);
    }

    @media (max-width: 992px) {
      .sidebar {
        transform: translateX(-100%);
        width: var(--sb-sidebar-width);
        border-right: none;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.2);
      }
      .sidebar.open {
        transform: translateX(0);
      }
      .sidebar-overlay {
        display: block;
      }
      .sidebar-overlay.active {
        display: block;
      }
      .sidebar.collapsed {
        width: var(--sb-sidebar-width);
      }
      .sidebar.collapsed .sb-brand-title,
      .sidebar.collapsed .sidebar-user,
      .sidebar.collapsed .sb-group-btn span:not(.caret),
      .sidebar.collapsed .nav-item span,
      .sidebar.collapsed .sidebar-footer .btn-logout span,
      .sidebar.collapsed .sb-toggle-label {
        opacity: 1;
        pointer-events: auto;
        width: auto;
        overflow: visible;
      }
      .sidebar.collapsed .nav-item {
        justify-content: flex-start;
        padding: 9px 12px !important;
      }
      .sidebar.collapsed .nav-item i {
        font-size: 15px;
        margin-right: 0;
      }
      .sidebar.collapsed .sb-group-btn {
        justify-content: space-between;
        padding: 6px 10px;
      }
      .sidebar.collapsed .sb-group-btn .caret {
        display: inline;
      }
      .sidebar.collapsed .sidebar-footer .btn-logout {
        justify-content: flex-start;
        padding: 10px 14px !important;
      }
      .sidebar.collapsed .sidebar-footer .btn-logout i {
        margin-right: 0;
      }
    }

    @media (max-width: 480px) {
      .sidebar {
        width: 100%;
        max-width: 320px;
      }
      .sb-brand-title h2 {
        font-size: 15px;
      }
    }

    /* ============================================================
       MAIN (ajustado para a nova sidebar)
       ============================================================ */
    .main {
      margin-left: var(--sb-sidebar-width);
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      background: var(--bg-base);
      transition: background var(--transition), margin-left var(--transition);
    }
    @media (max-width: 992px) {
      .main {
        margin-left: 0;
      }
    }

    .topbar {
      padding: 16px 32px;
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 40;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition: background var(--transition), border-color var(--transition);
    }
    .topbar h1 {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.3px;
      color: var(--text-primary);
    }
    .topbar .meta {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
    }
    .topbar-actions {
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .topbar-actions .badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--text-secondary);
      background: var(--bg-elevated);
      padding: 4px 14px 4px 10px;
      border-radius: 20px;
      border: 1px solid var(--border-subtle);
    }
    .topbar-actions .badge i {
      color: var(--accent-5);
      font-size: 10px;
    }

    .content {
      padding: 24px 32px 40px;
      flex: 1;
    }

    /* ============================================================
       CARDS E GRIDS (copiados da página original)
       ============================================================ */
    .card {
      background: var(--bg-card);
      border-radius: var(--radius);
      border: 1px solid var(--border-card);
      overflow: hidden;
      margin-bottom: 20px;
      box-shadow: var(--shadow);
      transition: background var(--transition), border-color var(--transition), box-shadow var(--transition), transform 0.25s ease;
    }
    .card:hover {
      box-shadow: var(--shadow-hover);
      transform: translateY(-4px) scale(1.002);
      border-color: var(--accent-1);
    }
    .card-header {
      padding: 16px 22px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: rgba(255, 255, 255, 0.02);
      transition: border-color var(--transition), background var(--transition);
    }
    .card-header h3 {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .card-header h3 i {
      color: var(--accent-1);
      font-size: 16px;
    }
    .card-body {
      padding: 20px 22px;
    }

    .card-overflow-visible {
      overflow: visible;
    }

    /* ============================================================
       FORMULÁRIOS
       ============================================================ */
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .form-grid.cols1 {
      grid-template-columns: 1fr;
    }
    .form-grid.cols3 {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .form-group.span2 {
      grid-column: span 2;
    }
    .form-group.span3 {
      grid-column: span 3;
    }
    .form-group label {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.3px;
      transition: color var(--transition);
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 9px 14px;
      border: 1px solid var(--border-card);
      border-radius: var(--radius);
      font-size: 13px;
      font-family: var(--font);
      color: var(--text-primary);
      background: var(--bg-input);
      outline: none;
      transition: background var(--transition), border-color var(--transition), color var(--transition), box-shadow var(--transition), transform 0.15s ease;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--accent-1);
      box-shadow: 0 0 0 3px var(--accent-1-dim);
      transform: scale(1.01);
    }
    .form-group input::placeholder,
    .form-group textarea::placeholder {
      color: var(--text-muted);
      font-weight: 300;
    }
    .form-group textarea {
      resize: vertical;
      min-height: 80px;
    }
    .form-group select option {
      background: var(--bg-input);
      color: var(--text-primary);
    }

    /* ============================================================
       BOTÕES
       ============================================================ */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      border: none;
      border-radius: var(--radius);
      font-size: 12px;
      font-weight: 600;
      font-family: var(--font);
      cursor: pointer;
      transition: background var(--transition), color var(--transition), border-color var(--transition), box-shadow var(--transition), transform 0.2s ease;
      text-decoration: none;
      letter-spacing: 0.2px;
      position: relative;
      overflow: hidden;
    }
    .btn::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255, 255, 255, 0.15), transparent 60%);
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
    }
    .btn:hover::after {
      opacity: 1;
    }
    .btn i {
      font-size: 14px;
    }
    .btn-solid {
      background: var(--accent-1);
      color: #fff;
      box-shadow: 0 4px 16px rgba(74, 144, 217, 0.3);
    }
    .btn-solid:hover {
      background: #3b7ec8;
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 6px 24px rgba(74, 144, 217, 0.4);
    }
    .btn-solid:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }
    .btn-outline {
      background: transparent;
      color: var(--text-secondary);
      border: 1px solid var(--border-card);
    }
    .btn-outline:hover {
      border-color: var(--accent-1);
      background: var(--accent-1-dim);
      color: var(--text-primary);
      transform: translateY(-2px) scale(1.02);
    }
    .btn-teal {
      background: var(--accent-2);
      color: #fff;
      box-shadow: 0 4px 16px rgba(107, 197, 184, 0.3);
    }
    .btn-teal:hover {
      background: #5ab8a9;
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 6px 24px rgba(107, 197, 184, 0.4);
    }
    .btn-sm {
      padding: 5px 14px;
      font-size: 11px;
    }
    .btn-red {
      background: var(--red-bg);
      color: var(--red);
      border: 1px solid rgba(229, 62, 62, 0.15);
    }
    .btn-red:hover {
      background: rgba(229, 62, 62, 0.12);
      transform: translateY(-2px) scale(1.02);
    }
    .btn-icon {
      padding: 6px;
      border-radius: 6px;
    }

    /* ============================================================
       ALERTAS
       ============================================================ */
    .alert-msg {
      padding: 12px 16px;
      border-radius: var(--radius);
      font-size: 13px;
      margin-top: 12px;
      display: none;
      font-weight: 500;
      transition: background var(--transition), color var(--transition), border-color var(--transition), transform 0.2s ease;
    }
    .alert-msg.show {
      display: block;
      animation: fadeUp 0.3s ease;
    }
    .alert-ok {
      background: var(--accent-5-dim);
      color: var(--accent-5);
      border-left: 3px solid var(--accent-5);
    }
    .alert-err {
      background: var(--red-bg);
      color: var(--red);
      border-left: 3px solid var(--red);
    }

    .spin {
      display: inline-block;
      width: 14px;
      height: 14px;
      border: 2px solid rgba(255, 255, 255, 0.2);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      vertical-align: middle;
      margin-right: 6px;
    }
    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* ============================================================
       TABS
       ============================================================ */
    .tabs-row {
      display: flex;
      gap: 4px;
      margin-bottom: 22px;
      flex-wrap: wrap;
    }
    .tab-btn {
      padding: 9px 18px;
      border: 1.5px solid var(--border-card);
      border-radius: 8px;
      background: var(--bg-card);
      font-size: 12px;
      font-weight: 500;
      font-family: var(--font);
      cursor: pointer;
      color: var(--text-secondary);
      transition: all 0.2s;
    }
    .tab-btn.active {
      background: var(--accent-1);
      color: #fff;
      border-color: var(--accent-1);
    }
    .tab-btn:hover:not(.active) {
      border-color: var(--accent-1);
      background: var(--accent-1-dim);
    }

    /* ============================================================
       TABELAS
       ============================================================ */
    .table-wrap {
      overflow-x: auto;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    thead th {
      padding: 10px 14px;
      text-align: left;
      font-size: 10px;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid var(--border-subtle);
      background: rgba(255, 255, 255, 0.02);
    }
    tbody tr {
      border-bottom: 1px solid var(--border-subtle);
      transition: background 0.2s ease, border-color var(--transition), transform 0.15s ease;
    }
    tbody tr:last-child {
      border-bottom: none;
    }
    tbody tr:hover {
      background: var(--bg-card-hover);
      transform: scale(1.002);
    }
    tbody td {
      padding: 11px 14px;
      color: var(--text-secondary);
      vertical-align: middle;
    }
    tbody td strong {
      color: var(--text-primary);
      font-weight: 500;
    }

    /* ============================================================
       BADGES
       ============================================================ */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 12px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: 600;
      gap: 4px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      transition: background var(--transition), color var(--transition), transform 0.2s ease;
    }
    .badge:hover {
      transform: scale(1.06);
    }
    .badge-blue {
      background: var(--accent-1-dim);
      color: var(--accent-1);
    }
    .badge-green {
      background: var(--accent-5-dim);
      color: var(--accent-5);
    }
    .badge-yellow {
      background: var(--accent-4-dim);
      color: var(--accent-4);
    }
    .badge-red {
      background: var(--red-bg);
      color: var(--red);
    }
    .badge-gray {
      background: var(--bg-elevated);
      color: var(--text-muted);
    }
    .badge-teal {
      background: var(--accent-2-dim);
      color: var(--accent-2);
    }

    /* ============================================================
       COMPONENTES ESPECÍFICOS DA PÁGINA DE RECEITA/ATESTADO
       ============================================================ */
    .patient-box {
      background: var(--accent-1-dim);
      border: 1px solid #c3dafe;
      border-radius: 10px;
      padding: 14px 18px;
      margin-bottom: 16px;
      display: none;
    }
    .patient-box .pb-name {
      font-size: 14px;
      font-weight: 700;
      color: var(--accent-1);
    }
    .patient-box .pb-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 8px;
      margin-top: 10px;
    }
    .patient-box .pb-item {
      font-size: 11px;
      color: var(--text-secondary);
    }
    .patient-box .pb-item strong {
      display: block;
      font-size: 9px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      color: var(--text-muted);
      margin-bottom: 2px;
    }
    .consent-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: 600;
      margin-top: 8px;
    }
    .consent-signed {
      background: var(--accent-5-dim);
      color: var(--accent-5);
    }
    .consent-pending {
      background: var(--accent-4-dim);
      color: var(--accent-4);
    }
    .consent-none {
      background: var(--bg-elevated);
      color: var(--text-muted);
    }

    .patient-search-wrap {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .patient-api-status {
      font-size: 10px;
      color: var(--text-muted);
      min-height: 14px;
    }
    .patient-api-status.ok {
      color: var(--accent-5);
    }
    .patient-api-status.warn {
      color: var(--accent-4);
    }
    .patient-api-status.err {
      color: var(--red);
    }

    .patient-dropdown {
      background: var(--bg-card);
      border: 1.5px solid var(--accent-1);
      border-radius: 8px;
      max-height: 220px;
      overflow-y: auto;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }
    .patient-option {
      padding: 10px 12px;
      cursor: pointer;
      font-size: 12px;
      transition: background 0.12s;
      border-bottom: 1px solid var(--border-subtle);
    }
    .patient-option:last-child {
      border-bottom: none;
    }
    .patient-option:hover {
      background: var(--accent-1-dim);
    }
    .patient-option .name {
      font-weight: 600;
      color: var(--accent-1);
      font-size: 11px;
    }
    .patient-option .meta {
      color: var(--text-secondary);
      font-size: 10px;
      margin-top: 2px;
    }
    .patient-option.empty {
      cursor: default;
      color: var(--text-muted);
    }

    .med-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 12px;
    }
    .med-item {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr auto;
      gap: 8px;
      align-items: end;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      padding: 10px 12px;
    }
    .med-item input {
      padding: 7px 10px;
      border: 1.5px solid var(--border-card);
      border-radius: 7px;
      font-size: 11px;
      font-family: var(--font);
      background: var(--bg-input);
      outline: none;
      color: var(--text-primary);
      transition: border-color 0.2s;
    }
    .med-item input:focus {
      border-color: var(--accent-1);
    }
    .med-item label {
      font-size: 9px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.4px;
      display: block;
      margin-bottom: 3px;
    }
    .med-item .med-col {
      display: flex;
      flex-direction: column;
    }
    .med-remove {
      background: none;
      border: none;
      cursor: pointer;
      color: var(--red);
      padding: 6px;
      border-radius: 6px;
      transition: background 0.15s;
    }
    .med-remove:hover {
      background: var(--red-bg);
    }
    .med-remove svg {
      width: 14px;
      height: 14px;
      fill: currentColor;
    }

    .cid-search-wrap {
      position: relative;
    }
    .cid-dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg-card);
      border: 1.5px solid var(--accent-1);
      border-radius: 8px;
      z-index: 100;
      max-height: 220px;
      overflow-y: auto;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }
    .cid-option {
      padding: 10px 14px;
      cursor: pointer;
      font-size: 12px;
      transition: background 0.12s;
      border-bottom: 1px solid var(--border-subtle);
    }
    .cid-option:last-child {
      border-bottom: none;
    }
    .cid-option:hover {
      background: var(--accent-1-dim);
    }
    .cid-option.active {
      background: var(--accent-1-dim);
    }
    .cid-option .cid-code {
      font-weight: 700;
      color: var(--accent-1);
      font-size: 11px;
    }
    .cid-option .cid-desc {
      color: var(--text-secondary);
      font-size: 11px;
      margin-top: 1px;
    }
    .cid-selected {
      background: var(--accent-1-dim);
      border: 1px solid #c3dafe;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 12px;
      display: none;
      margin-top: 6px;
    }
    .cid-selected .cid-code {
      font-weight: 700;
      color: var(--accent-1);
    }
    .cid-toolbar {
      display: flex;
      align-items: flex-end;
      gap: 8px;
      flex-wrap: wrap;
    }
    .cid-toolbar .cid-filter {
      min-width: 180px;
      max-width: 220px;
    }
    .cid-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 8px;
    }
    .cid-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--accent-1-dim);
      border: 1px solid #c3dafe;
      color: var(--accent-1);
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
    }
    .cid-pill small {
      font-size: 9px;
      color: var(--text-muted);
      font-weight: 600;
      text-transform: uppercase;
    }
    .cid-pill button {
      border: none;
      background: transparent;
      color: var(--red);
      font-size: 14px;
      line-height: 1;
      cursor: pointer;
      padding: 0 0 0 2px;
    }
    .cid-empty {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 8px;
    }

    /* ============================================================
       PREVIEW / PRINT
       ============================================================ */
    .print-preview {
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 10px;
      padding: 32px;
      font-size: 13px;
      line-height: 1.7;
      display: none;
      font-family: var(--font);
    }
    .print-preview.open {
      display: block;
    }

    .print-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 3px solid var(--accent-1);
      padding-bottom: 14px;
      margin-bottom: 20px;
    }
    .print-head .clinic-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .print-head .clinic-logo {
      width: 64px;
      height: 64px;
      object-fit: contain;
      border-radius: 6px;
    }
    .print-head .clinic-info h2 {
      font-size: 15px;
      font-weight: 700;
      color: var(--accent-1);
      margin: 0 0 2px;
    }
    .print-head .clinic-info p {
      font-size: 11px;
      color: var(--text-secondary);
      margin: 1px 0;
    }
    .print-head .clinic-info .clinic-address {
      font-size: 10px;
      color: var(--text-muted);
      margin-top: 2px;
    }
    .print-head .doc-type {
      font-size: 18px;
      font-weight: 700;
      color: var(--accent-1);
      text-align: right;
      letter-spacing: 0.5px;
    }

    .print-section {
      margin-bottom: 14px;
      padding: 12px 14px;
      border: 1px solid var(--border-subtle);
      border-radius: 6px;
      background: var(--bg-surface);
    }
    .print-section h4 {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 5px;
      margin: 0 0 8px;
    }
    .print-section p,
    .print-section strong {
      font-size: 13px;
      color: var(--text-primary);
      margin: 2px 0;
    }

    .print-meds {
      width: 100%;
      border-collapse: collapse;
      margin-top: 4px;
    }
    .print-meds thead {
      background: var(--accent-1-dim);
    }
    .print-meds th {
      text-align: left;
      padding: 7px 10px;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
    }
    .print-meds td {
      padding: 7px 10px;
      font-size: 12px;
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
    }
    .print-meds tbody tr:nth-child(even) {
      background: var(--bg-surface);
    }

    .print-footer {
      margin-top: 36px;
      padding-top: 14px;
      border-top: 1.5px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }
    .print-footer>div:first-child {
      font-size: 11px;
      color: var(--text-secondary);
    }
    .print-sig {
      text-align: center;
      min-width: 220px;
    }
    .print-sig .sig-line {
      border-bottom: 1.5px solid var(--text-primary);
      width: 220px;
      margin: 0 auto 5px;
    }
    .print-sig p {
      font-size: 11px;
      color: var(--text-secondary);
      margin: 1px 0;
    }

    @media print {
      .sidebar,
      .topbar,
      .no-print,
      .tabs-row,
      .card {
        display: none !important;
      }
      .content>.pane-print-active {
        display: block !important;
        padding: 0 !important;
        background: transparent !important;
      }
      .content>.pane-print-active>.print-preview.open {
        display: block !important;
      }
      .print-preview.open {
        border: none !important;
        padding: 16px 20px !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
      }
      .main {
        margin-left: 0 !important;
        padding: 0 !important;
      }
      body,
      html {
        background: white !important;
        margin: 0;
        padding: 0;
      }
      .print-head {
        border-bottom-width: 2px !important;
      }
      .print-section h4 {
        color: #555 !important;
      }
      .print-footer {
        margin-top: 60px;
      }
      .print-sig .sig-line {
        border-color: #000 !important;
      }
    }

    /* ============================================================
       MODAL CID
       ============================================================ */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 300;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .modal-overlay.open {
      display: flex;
    }
    .modal {
      background: var(--bg-card);
      border-radius: var(--radius);
      width: 100%;
      max-width: 480px;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.25);
      border: 1px solid var(--border-card);
      transition: transform 0.25s ease;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
    }
    .modal:hover {
      transform: scale(1.005);
    }
    .modal-head {
      padding: 18px 22px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }
    .modal-head h3 {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
    }
    .modal-close {
      background: none;
      border: none;
      cursor: pointer;
      color: var(--text-muted);
      font-size: 24px;
      line-height: 1;
      transition: color 0.15s, transform 0.2s ease;
    }
    .modal-close:hover {
      color: var(--text-primary);
      transform: rotate(90deg);
    }
    .modal-body {
      padding: 22px;
      overflow-y: auto;
      flex: 1;
    }
    .modal-foot {
      padding: 14px 22px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      gap: 8px;
      justify-content: flex-end;
      flex-shrink: 0;
      background: var(--bg-surface);
      border-radius: 0 0 var(--radius) var(--radius);
    }
    .modal-foot .btn {
      min-width: 80px;
      justify-content: center;
    }

    /* ============================================================
       RESPONSIVO GERAL
       ============================================================ */
    @media (max-width: 900px) {
      .content {
        padding: 16px;
      }
      .form-grid {
        grid-template-columns: 1fr;
      }
      .form-grid.cols3 {
        grid-template-columns: 1fr;
      }
      .form-group.span2,
      .form-group.span3 {
        grid-column: span 1;
      }
      .med-item {
        grid-template-columns: 1fr 1fr;
      }
      .med-item .med-col:nth-child(3) {
        grid-column: span 2;
      }
      .topbar {
        padding: 12px 18px;
        flex-wrap: wrap;
        gap: 8px;
      }
      .topbar h1 {
        font-size: 18px;
      }
      .modal {
        max-width: 100%;
        margin: 8px;
      }
    }
    @media (max-width: 640px) {
      .stat-card .value {
        font-size: 22px;
      }
      .card-body {
        padding: 14px;
      }
    }

    /* ============================================================
       ANIMAÇÕES
       ============================================================ */
    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>
<body>

  <!-- ============================================================
  SIDEBAR — NOVA ESTRUTURA
  ============================================================ -->
  <aside class="sidebar" id="appSidebar">
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="sidebar-header">
      <div class="sb-brand">
        <div class="sb-brand-icon"><i class="fas fa-heartbeat"></i></div>
        <div class="sb-brand-title">
          <h2>Clinic Chek</h2>
          <small>Gestão inteligente</small>
        </div>
      </div>
      <button class="sb-toggle-btn" id="sidebarToggleBtn" aria-label="Toggle sidebar">
        <i class="fas fa-bars"></i>
      </button>
    </div>

