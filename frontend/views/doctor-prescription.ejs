                  <div class="patient-dropdown" id="rPatientDropdown" style="display:none"></div>
                </div>
                <select id="rPatientSelect" style="margin-top:6px;"><option value="">Selecione o paciente</option></select>
              </div>
              <div class="form-group span2">
                <label>Procedimento (assinado e disponível)</label>
                <select id="rSurgerySelect"><option value="">Selecione um procedimento elegível</option></select>
              </div>
            </div>
            <div class="patient-box" id="rPatientBox">
              <div class="pb-name" id="rPatientName">—</div>
              <div class="pb-grid">
                <div class="pb-item"><strong>E-mail</strong><span id="rPatientEmail">—</span></div>
                <div class="pb-item"><strong>CPF / RG</strong><span id="rPatientCpf">—</span></div>
                <div class="pb-item"><strong>Nascimento</strong><span id="rPatientBirth">—</span></div>
                <div class="pb-item"><strong>Endereço</strong><span id="rPatientAddr">—</span></div>
              </div>
              <div id="rConsentBadge"></div>
            </div>
          </div>
        </div>

        <!-- Medicamentos -->
        <div class="card">
          <div class="card-header">
            <h3><i class="fas fa-pills"></i> Medicamentos</h3>
            <button class="btn btn-outline btn-sm" onclick="addMed('rMedList')">+ Adicionar Medicamento</button>
          </div>
          <div class="card-body">
            <div class="med-list" id="rMedList"></div>
            <div class="form-grid">
              <div class="form-group">
                <label>Validade da Receita (dias)</label>
                <input type="number" id="rValidDays" value="30" min="1" max="365" />
              </div>
              <div class="form-group">
                <label>Data de Emissão</label>
                <input type="date" id="rIssuedAt" />
              </div>
              <div class="form-group span2">
                <label>Orientações / Posologia adicional</label>
                <textarea id="rNotes" placeholder="Instruções gerais, cuidados, retorno..."></textarea>
              </div>
            </div>
            <div style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;" class="no-print">
              <button class="btn btn-teal" id="rSaveBtn" onclick="saveReceita()">
                <i class="fas fa-save"></i> Salvar Receita
              </button>
              <button class="btn btn-outline" onclick="previewReceita()">
                <i class="fas fa-eye"></i> Visualizar
              </button>
              <button class="btn btn-outline" onclick="printDoc()"><i class="fas fa-print"></i> Imprimir</button>
            </div>
            <div class="alert-msg alert-ok"  id="rOk"></div>
            <div class="alert-msg alert-err" id="rErr"></div>
          </div>
        </div>

        <!-- Preview Receita -->
