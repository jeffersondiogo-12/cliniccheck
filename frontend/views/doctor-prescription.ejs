    <div class="modal">
      <div class="modal-head">
        <h3><i class="fas fa-plus-circle" style="color:var(--accent-1);margin-right:8px;"></i>Cadastrar CID-10 Personalizado</h3>
        <button class="modal-close" onclick="closeCidModal()">&times;</button>
      </div>
      <div class="modal-body">
        <div class="form-grid cols1">
          <div class="form-group">
            <label>Código CID-10 *</label>
            <input type="text" id="cidCode" placeholder="Ex: J45, K21.0, Z87.1..." maxlength="8" />
            <small style="font-size:10px;color:var(--text-muted);">Formato: letra + número (ex: J45) ou alfanumérico com ponto (ex: K21.0)</small>
          </div>
          <div class="form-group">
            <label>Descrição *</label>
            <input type="text" id="cidDesc" placeholder="Nome da doença / condição" />
          </div>
          <div class="form-group">
            <label>Categoria (opcional)</label>
            <input type="text" id="cidCat" placeholder="Ex: Respiratório, Digestivo..." />
          </div>
        </div>
        <div class="alert-msg alert-ok"  id="cidOk"></div>
        <div class="alert-msg alert-err" id="cidErr"></div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-outline" onclick="closeCidModal()">Cancelar</button>
        <button class="btn btn-teal" id="cidSaveBtn" onclick="saveCid()">Salvar</button>
      </div>
    </div>
  </div>

  <!-- ============================================================
  SCRIPTS — SIDEBAR + FUNCIONALIDADES ORIGINAIS (sem alterações)
  ============================================================ -->
  <script>
    // ============================================================
    // SIDEBAR (mesmo código da tela de procedimentos)
    // ============================================================
    (function initSidebar() {
      const sidebar = document.querySelector('.sidebar');
      const toggleBtn = document.getElementById('sidebarToggleBtn');
      const overlay = document.getElementById('sidebarOverlay');
      let isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
      if (isCollapsed) sidebar.classList.add('collapsed');

      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (window.innerWidth <= 992) {
          sidebar.classList.toggle('open');
          overlay.classList.toggle('active');
          document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
        } else {
          isCollapsed = !isCollapsed;
          sidebar.classList.toggle('collapsed', isCollapsed);
          localStorage.setItem('sidebarCollapsed', String(isCollapsed));
        }
      });

      overlay.addEventListener('click', function() {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      });

      window.addEventListener('resize', function() {
        if (window.innerWidth > 992) {
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        }
      });

      // Tema
      const themeToggle = document.getElementById('themeToggle');
      const currentTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', currentTheme);
      themeToggle.addEventListener('click', function() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const newTheme = isDark ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      });

      // Grupos colapsáveis
      document.querySelectorAll('.sb-group-btn').forEach((btn) => {
        btn.addEventListener('click', function() {
          const group = this.closest('.sb-group');
          if (group) group.classList.toggle('open');
        });
      });

      // Dados do usuário
      const doctorToken = localStorage.getItem('doctorToken');
      const receptionToken = localStorage.getItem('receptionToken');
      const token = doctorToken || receptionToken;
      const isReceptionSession = !doctorToken && !!receptionToken;
      const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');
      const nameEl = document.getElementById('sidebarName');
      const roleEl = document.getElementById('sidebarRole');
      const clinicEl = document.getElementById('sidebarClinic');
      if (nameEl) nameEl.textContent = doctorData.name || 'Profissional';
      if (roleEl) roleEl.textContent = isReceptionSession ? 'Recepcionista' : (doctorData.isClinicOwner ? 'Owner da Clinica' : 'Profissional');
      if (clinicEl) clinicEl.textContent = 'Clinica: ' + (doctorData.clinicName || '--');

      // Logout
      document.getElementById('logoutBtn').addEventListener('click', function() {
        localStorage.removeItem('doctorToken'); localStorage.removeItem('doctorData');
        localStorage.removeItem('receptionToken'); localStorage.removeItem('receptionData');
        window.location.href = isReceptionSession ? '/recepcao/login' : '/medico/login';
      });

      // Permissões (opcional)
      if (token) {
        fetch(isReceptionSession ? '/api/auth/permissions-receptionist' : '/api/auth/permissions', { headers: { Authorization: 'Bearer ' + token } })
          .then((r) => r.ok ? r.json() : null)
          .then((data) => {
            if (!data || !Array.isArray(data.pages)) return;
            const allowed = new Set((data.pages || []).filter((p) => p.can_view).map((p) => p.code));
            document.querySelectorAll('#sidebarNav .nav-item[data-page]').forEach((item) => {
              const rawCodes = item.getAttribute('data-page-codes') || item.getAttribute('data-page') || '';
              const pageCodes = rawCodes.split(',').map((code) => code.trim()).filter(Boolean);
              const canSee = pageCodes.some((code) => allowed.has(code));
              item.hidden = !canSee;
            });
            document.querySelectorAll('.sb-group').forEach((g) => {
              const hasVisible = Array.from(g.querySelectorAll('.nav-item')).some((i) => !i.hidden);
              g.style.display = hasVisible ? '' : 'none';
            });
          })
          .catch(() => {});
      }
    })();
  </script>

  <!-- ============================================================
  SCRIPTS — LÓGICA DA PÁGINA DE RECEITA/ATESTADO (ORIGINAL)
  ============================================================ -->
  <script>
    // ============================================================
    // CONFIGURAÇÃO INICIAL
    // ============================================================
    const doctorToken = localStorage.getItem('doctorToken');
    const receptionToken = localStorage.getItem('receptionToken');
    const token = doctorToken || receptionToken;
    const isReceptionSession = !doctorToken && !!receptionToken;
    const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');
    if (!token) window.location.href = '/medico/login';
    if (doctorData.name) document.getElementById('sidebarName').textContent = doctorData.name;

    const h = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };

    // Datas padrão
    const today = new Date().toISOString().slice(0, 10);
    document.getElementById('rIssuedAt').value = today;
    document.getElementById('aIssuedAt').value = today;

    // ── TABS ──
    const PANES = { receita: 'paneReceita', atestado: 'paneAtestado', 'hist-r': 'paneHistR', 'hist-a': 'paneHistA', cid: 'paneCid' };
    const TABS = { receita: 'tabRec', atestado: 'tabAte', 'hist-r': 'tabHistR', 'hist-a': 'tabHistA', cid: 'tabCid' };

    function switchTab(t) {
      Object.values(PANES).forEach(p => document.getElementById(p).style.display = 'none');
      Object.values(TABS).forEach(b => document.getElementById(b).classList.remove('active'));
      document.getElementById(PANES[t]).style.display = '';
      document.getElementById(TABS[t]).classList.add('active');
      if (t === 'hist-r') loadHistR();
      if (t === 'hist-a') loadHistA();
      if (t === 'cid') loadCidTable();
      document.getElementById('previewReceita').classList.remove('open');
      document.getElementById('previewAtestado').classList.remove('open');
    }

    // ── DADOS BASE ──
    let allPatients = [];
    let allSurgeries = [];
    let allPrescriptions = [];
    let allAtestados = [];
    let clinicData = {};

    function asId(value) {
      if (value === null || value === undefined) return '';
      return String(value);
    }

    function normalizeText(value) {
      return String(value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
    }

    function normalizeDoc(value) {
      return String(value || '').replace(/[^0-9a-z]/gi, '').toLowerCase();
    }

    function getPatientDisplayName(patient) {
      return patient?.name || patient?.full_name || patient?.patient_name || patient?.fullName || patient?.patientName || 'Paciente sem nome';
    }

    function getPatientEmail(patient) {
      return patient?.email || patient?.patient_email || patient?.emailAddress || '';
    }

    function getPatientDocument(patient) {
      return patient?.document_id || patient?.document || patient?.cpf || patient?.documentId || patient?.cpfCnpj || '';
    }

    function getFilteredPatients(qRaw) {
      const q = normalizeText(qRaw);
      const qDoc = normalizeDoc(qRaw);
      if (!q) return allPatients;
      return allPatients.filter(p => {
        const name = normalizeText(getPatientDisplayName(p));
        const email = normalizeText(getPatientEmail(p));
        const doc = normalizeDoc(getPatientDocument(p));
        const idText = normalizeText(p.id);
        return name.includes(q) || email.includes(q) || idText.includes(q) || (qDoc && doc.includes(qDoc));
      });
    }

    function setPatientApiStatus(prefix, message, level = 'ok') {
      const el = document.getElementById(`${prefix}PatientApiStatus`);
      if (!el) return;
      el.classList.remove('ok', 'warn', 'err');
      if (level) el.classList.add(level);
      el.textContent = message;
    }

    function normalizePatientsPayload(payload) {
      if (Array.isArray(payload)) return payload;
      if (Array.isArray(payload?.patients)) return payload.patients;
      return [];
    }

    async function fetchPatientsWithFallback() {
      const candidates = [
        { url: '/api/patients', source: 'patients-api' },
        { url: '/api/prescriptions/patients', source: 'prescriptions-fallback' },
      ];
      let lastError = null;
      for (const candidate of candidates) {
        try {
          const res = await fetch(candidate.url, { headers: h });
          if (!res.ok) {
            lastError = `Falha em ${candidate.url} (${res.status})`;
            continue;
          }
          const data = await res.json();
          const patients = normalizePatientsPayload(data);
          if (patients.length) {
            return { patients, source: candidate.source };
          }
          lastError = `API ${candidate.url} retornou vazio`;
        } catch (err) {
          lastError = err?.message || `Erro ao acessar ${candidate.url}`;
        }
      }
      throw new Error(lastError || 'Não foi possível carregar pacientes');
    }

    async function loadBase() {
      try {
        const [patientsData, sRes, cRes] = await Promise.all([
          fetchPatientsWithFallback(),
          fetch('/api/surgeries', { headers: h }),
          fetch('/api/clinics', { headers: h }),
        ]);

        allPatients = patientsData.patients;
        allSurgeries = sRes.ok ? await sRes.json() : [];
        const clinics = cRes.ok ? await cRes.json() : [];
        clinicData = clinics[0] || {};
        const sourceLabel = patientsData.source === 'patients-api' ? '/api/patients' : '/api/prescriptions/patients';
        setPatientApiStatus('r', `${allPatients.length} paciente(s) carregado(s) via ${sourceLabel}.`, 'ok');
        setPatientApiStatus('a', `${allPatients.length} paciente(s) carregado(s) via ${sourceLabel}.`, 'ok');
        console.info('[RX/ATE] Pacientes carregados:', { count: allPatients.length, source: sourceLabel });
        populatePatientSelects();
      } catch (err) {
        allPatients = [];
        setPatientApiStatus('r', `Erro ao carregar pacientes: ${err.message}`, 'err');
        setPatientApiStatus('a', `Erro ao carregar pacientes: ${err.message}`, 'err');
        console.error('[RX/ATE] Erro ao carregar pacientes', err);
        populatePatientSelects();
      }
    }

    function renderPatientDropdown(prefix, filtered, qRaw) {
      const dd = document.getElementById(`${prefix}PatientDropdown`);
      if (!dd) return;
      const hasQuery = Boolean((qRaw || '').trim());
      if (!hasQuery) {
        dd.style.display = 'none';
        dd.innerHTML = '';
        return;
      }
      if (!filtered.length) {
        dd.innerHTML = '<div class="patient-option empty">Nenhum paciente encontrado para este filtro.</div>';
        dd.style.display = 'block';
        return;
      }
      dd.innerHTML = filtered.slice(0, 20).map(p => {
        const id = asId(p.id);
        const name = escH(getPatientDisplayName(p));
        const email = escH(getPatientEmail(p) || 'sem e-mail');
        const doc = escH(getPatientDocument(p) || 'sem documento');
        return `<div class="patient-option" data-prefix="${prefix}" data-patient-id="${id}" onclick="selectPatientFromDropdown(this)">
          <div class="name">${name}</div>
          <div class="meta">${email} · ${doc}</div>
        </div>`;
      }).join('');
      dd.style.display = 'block';
    }

    function selectPatientFromDropdown(el) {
      const prefix = el.dataset.prefix;
      const patientId = el.dataset.patientId;
      const pat = allPatients.find(p => asId(p.id) === asId(patientId));
      if (!prefix || !pat) return;
      document.getElementById(`${prefix}PatientSearch`).value = getPatientDisplayName(pat);
      const select = document.getElementById(`${prefix}PatientSelect`);
      select.value = asId(pat.id);
      onPatientChange(prefix);
      const dd = document.getElementById(`${prefix}PatientDropdown`);
      dd.style.display = 'none';
    }

    function populatePatientSelects() {
      ['rPatientSelect', 'aPatientSelect'].forEach(id => {
        const sel = document.getElementById(id);
        const prefix = id.startsWith('r') ? 'r' : 'a';
        const currentValue = asId(sel.value);
        const qRaw = document.getElementById(id.replace('Select', 'Search')).value;
        const filtered = getFilteredPatients(qRaw);
        sel.innerHTML = '<option value="">Selecione o paciente</option>';
        filtered.forEach(p => {
          const o = document.createElement('option');
          o.value = asId(p.id);
          const displayName = getPatientDisplayName(p);
          const displayDoc = getPatientDocument(p);
          const displayEmail = getPatientEmail(p);
          o.textContent = `${displayName}${displayEmail ? ' — ' + displayEmail : ''}${displayDoc ? ' (' + displayDoc + ')' : ''}`;
          sel.appendChild(o);
        });
        const selectedStillVisible = filtered.some(p => asId(p.id) === currentValue);
        if (selectedStillVisible) {
          sel.value = currentValue;
        } else if (currentValue) {
          const selectedPatient = allPatients.find(p => asId(p.id) === currentValue);
          if (selectedPatient) {
            const fallbackOption = document.createElement('option');
            const displayName = getPatientDisplayName(selectedPatient);
            const displayDoc = getPatientDocument(selectedPatient);
            const displayEmail = getPatientEmail(selectedPatient);
            fallbackOption.value = currentValue;
            fallbackOption.textContent = `${displayName}${displayEmail ? ' — ' + displayEmail : ''}${displayDoc ? ' (' + displayDoc + ')' : ''}`;
            sel.appendChild(fallbackOption);
            sel.value = currentValue;
          }
        } else if ((qRaw || '').trim() && filtered.length === 1) {
          sel.value = asId(filtered[0].id);
          onPatientChange(prefix);
        }
        renderPatientDropdown(prefix, filtered, qRaw);
        const typed = normalizeText(qRaw);
        if (!allPatients.length) {
          setPatientApiStatus(prefix, 'Nenhum paciente carregado pela API.', 'warn');
        } else if (typed) {
          setPatientApiStatus(prefix, `${filtered.length} resultado(s) para "${qRaw}".`, filtered.length ? 'ok' : 'warn');
        }
      });
    }

    document.getElementById('rPatientSearch').addEventListener('input', () => populatePatientSelects());
    document.getElementById('aPatientSearch').addEventListener('input', () => populatePatientSelects());
    document.addEventListener('click', e => {
      if (!e.target.closest('.patient-search-wrap')) {
        const rDd = document.getElementById('rPatientDropdown');
        const aDd = document.getElementById('aPatientDropdown');
        if (rDd) rDd.style.display = 'none';
        if (aDd) aDd.style.display = 'none';
      }
    });

    function onPatientChange(prefix) {
      const patId = asId(document.getElementById(`${prefix}PatientSelect`).value);
      const pat = allPatients.find(p => asId(p.id) === patId);
      const box = document.getElementById(`${prefix}PatientBox`);
      if (!pat) {
        box.style.display = 'none';
        const surgSel = document.getElementById(`${prefix}SurgerySelect`);
        if (surgSel) surgSel.innerHTML = '<option value="">Selecione um procedimento elegível</option>';
        return;
      }
      box.style.display = 'block';
      document.getElementById(`${prefix}PatientName`).textContent = getPatientDisplayName(pat);
      document.getElementById(`${prefix}PatientEmail`).textContent = getPatientEmail(pat) || '—';
      document.getElementById(`${prefix}PatientCpf`).textContent = getPatientDocument(pat) || '—';
      document.getElementById(`${prefix}PatientBirth`).textContent = pat.birth_date ? new Date(pat.birth_date).toLocaleDateString('pt-BR') : '—';
      document.getElementById(`${prefix}PatientAddr`).textContent = pat.address || '—';

      const surgSel = document.getElementById(`${prefix}SurgerySelect`);
      const patSurg = allSurgeries.filter((s) => {
        if (asId(s.patient_id) !== patId) return false;
        const status = String(s.status || '').toUpperCase();
        return status === 'SIGNED';
      });
      surgSel.innerHTML = '<option value="">Selecione um procedimento elegível</option>';
      patSurg.forEach(s => {
        const o = document.createElement('option');
        o.value = asId(s.id);
        o.textContent = `${s.title || 'Procedimento'} — ${s.status} — ${s.procedure_type || ''}`;
        o.dataset.consent = s.document_status || '';
        surgSel.appendChild(o);
      });
      renderConsentBadge(prefix, '');
    }

    function onSurgeryChange(prefix) {
      const sel = document.getElementById(`${prefix}SurgerySelect`);
      const opt = sel.options[sel.selectedIndex];
      renderConsentBadge(prefix, opt ? opt.dataset.consent : '');
    }

    function renderConsentBadge(prefix, consentStatus) {
      const el = document.getElementById(`${prefix}ConsentBadge`);
      if (!consentStatus) { el.innerHTML = '<span class="consent-badge consent-none">Sem documento de consentimento</span>'; return; }
      if (consentStatus === 'SIGNED') el.innerHTML = '<span class="consent-badge consent-signed">✓ Consentimento Assinado</span>';
      else el.innerHTML = '<span class="consent-badge consent-pending">⏳ Consentimento Pendente de Assinatura</span>';
    }

    document.getElementById('rPatientSelect').addEventListener('change', () => onPatientChange('r'));
    document.getElementById('aPatientSelect').addEventListener('change', () => onPatientChange('a'));
    document.getElementById('rSurgerySelect').addEventListener('change', () => onSurgeryChange('r'));
    document.getElementById('aSurgerySelect').addEventListener('change', () => onSurgeryChange('a'));

    // ── MEDICAMENTOS ──
    function addMed(listId) {
      const list = document.getElementById(listId);
      const div = document.createElement('div');
      div.className = 'med-item';
      div.innerHTML = `
        <div class="med-col"><label>Medicamento / Princípio Ativo</label><input type="text" placeholder="Ex: Amoxicilina 500mg" class="med-name" /></div>
        <div class="med-col"><label>Dosagem</label><input type="text" placeholder="Ex: 500mg" class="med-dose" /></div>
        <div class="med-col"><label>Posologia</label><input type="text" placeholder="Ex: 1 comp. 8/8h por 7 dias" class="med-pos" /></div>
        <button class="med-remove" onclick="this.closest('.med-item').remove()" title="Remover"><svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg></button>`;
      list.appendChild(div);
      div.querySelector('.med-name').focus();
    }

    function getMeds(listId) {
      return [...document.getElementById(listId).querySelectorAll('.med-item')].map(el => ({
        name: el.querySelector('.med-name').value.trim(),
        dose: el.querySelector('.med-dose').value.trim(),
        posology: el.querySelector('.med-pos').value.trim(),
      })).filter(m => m.name);
    }

    // ── SALVAR RECEITA ──
    async function saveReceita() {
      const ok = document.getElementById('rOk');
      const err = document.getElementById('rErr');
      ok.style.display = 'none';
      err.style.display = 'none';
      const patientId = document.getElementById('rPatientSelect').value;
      const surgeryId = document.getElementById('rSurgerySelect').value || null;
      if (!patientId) { err.textContent = 'Selecione o paciente.'; err.style.display = 'block'; return; }
      if (!surgeryId) {
        err.textContent = 'Vincule a receita a um procedimento assinado disponível.';
        err.style.display = 'block';
        return;
      }
      const meds = getMeds('rMedList');
      if (!meds.length) { err.textContent = 'Adicione pelo menos um medicamento.'; err.style.display = 'block'; return; }
      const btn = document.getElementById('rSaveBtn');
      btn.disabled = true;
      btn.innerHTML = '<span class="spin"></span>Salvando...';
      try {
        const res = await fetch('/api/prescriptions/prescriptions', {
          method: 'POST',
          headers: h,
          body: JSON.stringify({
            patientId,
            surgeryId,
            medications: meds,
            notes: document.getElementById('rNotes').value.trim() || null,
            validDays: Number(document.getElementById('rValidDays').value) || 30,
            issuedAt: document.getElementById('rIssuedAt').value || today,
          })
        });
        const data = await res.json();
        if (res.ok) {
          ok.textContent = 'Receita salva com sucesso!';
          ok.style.display = 'block';
          allPrescriptions.unshift(data);
        } else {
          err.textContent = data.error || 'Erro ao salvar.';
          err.style.display = 'block';
        }
      } catch {
        err.textContent = 'Erro de conexão.';
        err.style.display = 'block';
      }
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-save"></i> Salvar Receita';
    }

    // ── SALVAR ATESTADO ──
    async function saveAtestado() {
      const ok = document.getElementById('aOk');
      const err = document.getElementById('aErr');
      ok.style.display = 'none';
      err.style.display = 'none';
      const patientId = document.getElementById('aPatientSelect').value;
      const surgeryId = document.getElementById('aSurgerySelect').value || null;
      if (!patientId) { err.textContent = 'Selecione o paciente.'; err.style.display = 'block'; return; }
      if (!surgeryId) {
        err.textContent = 'Vincule o atestado a um procedimento assinado disponível.';
        err.style.display = 'block';
        return;
      }
      const restDays = Number(document.getElementById('aRestDays').value);
      if (!restDays || restDays < 1) { err.textContent = 'Informe os dias de repouso.'; err.style.display = 'block'; return; }
      const btn = document.getElementById('aSaveBtn');
      btn.disabled = true;
      btn.innerHTML = '<span class="spin"></span>Salvando...';
      try {
        const res = await fetch('/api/prescriptions/certificates', {
          method: 'POST',
          headers: h,
          body: JSON.stringify({
            patientId,
            surgeryId,
            cids: selectedCids.map(c => ({ code: c.code, description: c.description, version: c.version, uri: c.uri, source: c.source })),
            cid10Code: selectedCids[0]?.code || null,
            cid10Desc: selectedCids[0]?.description || null,
            cidVersion: selectedCids[0]?.version || null,
            cidUri: selectedCids[0]?.uri || null,
            restDays,
            justification: document.getElementById('aJustification').value.trim() || null,
            issuedAt: document.getElementById('aIssuedAt').value || today,
          })
        });
        const data = await res.json();
        if (res.ok) {
          ok.textContent = 'Atestado salvo com sucesso!';
          ok.style.display = 'block';
          allAtestados.unshift(data);
          clearCid();
        } else {
          err.textContent = data.error || 'Erro ao salvar.';
          err.style.display = 'block';
        }
      } catch {
        err.textContent = 'Erro de conexão.';
        err.style.display = 'block';
      }
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-save"></i> Salvar Atestado';
    }

    // ── CID ──
    let selectedCids = [];
    let cidTimer = null;
    let cidResults = [];
    let cidActiveIndex = -1;
    let cidAbortController = null;

    function hideCidDropdown() {
      const dd = document.getElementById('aCidDropdown');
      dd.style.display = 'none';
      dd.innerHTML = '';
      cidResults = [];
      cidActiveIndex = -1;
    }

    function renderCidDropdown(items) {
      const dd = document.getElementById('aCidDropdown');
      cidResults = Array.isArray(items) ? items : [];
      if (!cidResults.length) {
        hideCidDropdown();
        return;
      }
      if (cidActiveIndex >= cidResults.length) cidActiveIndex = 0;
      dd.innerHTML = cidResults.map((c, idx) =>
        `<div class="cid-option ${idx === cidActiveIndex ? 'active' : ''}" data-idx="${idx}">
          <div class="cid-code">${escH(cleanCidText(c.code))}</div>
          <div class="cid-desc">${escH(cleanCidText(c.description))} <small style="color:var(--text-muted)">(${escH(c.system || 'CID-10')})</small></div>
        </div>`
      ).join('');
      dd.style.display = 'block';
    }

    function selectCidResultByIndex(index) {
      const c = cidResults[index];
      if (!c) return;
      selectCid(cleanCidText(c.code), cleanCidText(c.description), c.version || '10', c.uri || '', c.system || 'CID-10', c.source || 'search');
    }

    function onCidInput(q) { searchCid(q); }

    function onCidFocus() {
      const q = document.getElementById('aCidSearch').value || '';
      if (q.trim().length >= 2) searchCid(q);
    }

    function onCidBlur() {
      setTimeout(() => {
        const val = document.getElementById('aCidSearch').value;
        confirmCidManual(val, true);
        hideCidDropdown();
      }, 180);
    }

    function onCidKeyDown(event) {
      const dd = document.getElementById('aCidDropdown');
      const isOpen = dd.style.display === 'block' && cidResults.length > 0;
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (!isOpen) return;
        cidActiveIndex = (cidActiveIndex + 1 + cidResults.length) % cidResults.length;
        renderCidDropdown(cidResults);
        return;
      }
      if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (!isOpen) return;
        cidActiveIndex = (cidActiveIndex - 1 + cidResults.length) % cidResults.length;
        renderCidDropdown(cidResults);
        return;
      }
      if (event.key === 'Enter') {
        event.preventDefault();
        if (isOpen) {
          const pick = cidActiveIndex >= 0 ? cidActiveIndex : 0;
          selectCidResultByIndex(pick);
        } else {
          confirmCidManual(document.getElementById('aCidSearch').value);
        }
        return;
      }
      if (event.key === 'Escape') hideCidDropdown();
    }

    function onCidFilterChange() {
      const q = document.getElementById('aCidSearch').value;
      if (q && q.trim().length >= 2) searchCid(q);
    }

    function renderSelectedCids() {
      const box = document.getElementById('aCidSelected');
      const list = document.getElementById('aCidList');
      const empty = document.getElementById('aCidEmpty');
      if (!selectedCids.length) {
        box.style.display = 'none';
        list.innerHTML = '';
        if (empty) empty.style.display = '';
        return;
      }
      box.style.display = 'block';
      if (empty) empty.style.display = 'none';
      list.innerHTML = selectedCids.map((c, i) =>
        `<span class="cid-pill">
          ${escH(cleanCidText(c.code))} — ${escH(cleanCidText(c.description || 'Sem descrição'))}
          <button type="button" onclick="removeCidAt(${i})" title="Remover">×</button>
        </span>`
      ).join('');
    }

    function addCidToSelection({ code, description, version, uri, system, source }) {
      const normalizedCode = String(code || '').trim().toUpperCase();
      if (!normalizedCode) return;
      const normalizedVersion = String(version || '10').trim();
      const exists = selectedCids.some(c => String(c.code || '').toUpperCase() === normalizedCode && String(c.version || '') === normalizedVersion);
      if (exists) return;
      selectedCids.push({
        code: normalizedCode,
        description: cleanCidText(description),
        version: normalizedVersion,
        uri: uri || null,
        system: system || (normalizedVersion === '11' ? 'CID-11' : 'CID-10'),
        source: source || 'manual',
      });
      renderSelectedCids();
    }

    function removeCidAt(index) {
      selectedCids = selectedCids.filter((_, i) => i !== index);
      renderSelectedCids();
    }

    function searchCid(q) {
      const dd = document.getElementById('aCidDropdown');
      const filter = document.getElementById('aCidFilter')?.value || 'all';
      const term = String(q || '').trim();
      clearTimeout(cidTimer);
      if (cidAbortController) {
        cidAbortController.abort();
        cidAbortController = null;
      }
      if (!term || term.length < 2) {
        hideCidDropdown();
        return;
      }
      dd.innerHTML = '<div class="cid-option" style="cursor:default;color:var(--text-muted)">Buscando CIDs...</div>';
      dd.style.display = 'block';
      cidTimer = setTimeout(async () => {
        try {
          cidAbortController = new AbortController();
          const res = await fetch(`/api/prescriptions/cid/search?q=${encodeURIComponent(term)}&lang=pt&filter=${encodeURIComponent(filter)}`, {
            headers: h,
            signal: cidAbortController.signal,
          });
          const data = res.ok ? await res.json() : [];
          if (document.getElementById('aCidSearch').value.trim() !== term) return;
          const limited = Array.isArray(data) ? data.slice(0, 30) : [];
          if (!limited.length) {
            dd.innerHTML = '<div class="cid-option" style="cursor:default;color:var(--text-muted)">Nenhum CID encontrado.</div>';
            dd.style.display = 'block';
            cidResults = [];
            cidActiveIndex = -1;
            return;
          }
          cidActiveIndex = 0;
          renderCidDropdown(limited);
        } catch (e) {
          if (e?.name === 'AbortError') return;
          dd.innerHTML = '<div class="cid-option" style="cursor:default;color:var(--red)">Falha na busca. Tente novamente.</div>';
          dd.style.display = 'block';
        }
      }, 180);
    }

    function selectCid(code, desc, version, uri, system, source) {
      addCidToSelection({ code, description: desc, version, uri, system, source });
      document.getElementById('aCidSearch').value = '';
      hideCidDropdown();
    }

    function confirmCidManual(val, isBlur) {
      if (!val || !val.trim()) return;
      if (isBlur && cidResults.length) return;
      const parts = val.trim().split(' — ');
      const code = cleanCidText(parts[0]).toUpperCase();
      const desc = cleanCidText(parts.slice(1).join(' — '));
      addCidToSelection({
        code,
        description: desc,
        version: '10',
        uri: null,
        system: 'CID-10',
        source: 'manual',
      });
      document.getElementById('aCidSearch').value = '';
      hideCidDropdown();
    }

    function clearCid() {
      selectedCids = [];
      renderSelectedCids();
      document.getElementById('aCidSearch').value = '';
      hideCidDropdown();
    }

    document.getElementById('aCidDropdown').addEventListener('mousedown', (e) => e.preventDefault());
    document.getElementById('aCidDropdown').addEventListener('click', (e) => {
      const row = e.target.closest('.cid-option[data-idx]');
      if (!row) return;
      const idx = Number(row.getAttribute('data-idx'));
      if (Number.isNaN(idx)) return;
      selectCidResultByIndex(idx);
    });
    document.addEventListener('click', e => {
      if (!e.target.closest('.cid-search-wrap')) hideCidDropdown();
    });

    function escH(s) { return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }

    function cleanCidText(s) {
      return String(s || '')
        .replace(/<[^>]*>/g, ' ')
        .replace(/&nbsp;/gi, ' ')
        .replace(/&amp;/gi, '&')
        .replace(/&quot;/gi, '"')
        .replace(/&#39;/gi, "'")
        .replace(/&lt;/gi, '<')
        .replace(/&gt;/gi, '>')
        .replace(/\s+/g, ' ')
        .trim();
    }

