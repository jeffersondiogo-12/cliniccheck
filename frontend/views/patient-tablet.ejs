<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clinic Chek - Tablet do Paciente</title>
  <link rel="icon" type="image/svg+xml" href="/public/brand/clinic-check-favicon.svg">
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Sora:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-top:#edf8f0;
      --bg-mid:#eef6fb;
      --bg-bottom:#eef4ff;
      --card:#ffffff;
      --text:#12312b;
      --muted:#5e7d77;
      --border:#d7e7e2;
      --primary-a:#2ea56c;
      --primary-b:#1f8b7c;
      --primary-c:#1f8fc7;
      --primary-soft:#e8f8ef;
      --warn:#b45309;
      --warn-bg:#fff7e6;
      --danger:#dc2626;
      --danger-bg:#fff1f2;
      --ok:#15803d;
      --shadow:0 26px 70px rgba(14,68,52,.16);
      --radius-lg:30px;
      --radius-md:16px;
      --radius-sm:12px;
    }
    *{box-sizing:border-box;margin:0;padding:0;}
    body{min-height:100vh;font-family:'Manrope',sans-serif;color:var(--text);background:linear-gradient(180deg,var(--bg-top) 0%,var(--bg-mid) 54%,var(--bg-bottom) 100%);padding:18px;}
    .shell{width:min(1180px,100%);margin:0 auto;background:rgba(255,255,255,.68);border:1px solid rgba(255,255,255,.72);border-radius:var(--radius-lg);box-shadow:var(--shadow);overflow:hidden;backdrop-filter:blur(12px);}
    .topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 22px;border-bottom:1px solid var(--border);background:linear-gradient(120deg,#ffffff 0%,#f1fbf6 58%,#edf7ff 100%);}
    .brand{display:flex;align-items:center;gap:12px;}
    .brand-badge{width:46px;height:46px;border-radius:16px;background:linear-gradient(135deg,var(--primary-a),var(--primary-b),var(--primary-c));display:flex;align-items:center;justify-content:center;box-shadow:0 14px 24px rgba(31,143,199,.18);}
    .brand-badge img{width:26px;height:26px;object-fit:contain;}
    .brand h1{font-family:'Sora',sans-serif;font-size:24px;line-height:1.1;letter-spacing:-.4px;}
    .brand p{font-size:12px;color:var(--muted);margin-top:3px;}
    .meta{font-size:12px;color:var(--muted);text-align:right;line-height:1.45;}
    .content{padding:22px;display:grid;gap:18px;}
    .grid{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;align-items:start;}
    .card{background:var(--card);border:1px solid var(--border);border-radius:24px;box-shadow:0 12px 34px rgba(17,48,42,.06);overflow:hidden;}
    .card-head{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:10px;background:linear-gradient(90deg,#f9fffb 0%,#f4fbff 100%);}
    .card-head h2{font-size:14px;font-weight:800;color:#154a41;}
    .card-body{padding:18px;}
    .status-strip{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;}
    .chip{display:inline-flex;align-items:center;padding:5px 10px;border-radius:999px;font-size:10px;font-weight:800;letter-spacing:.3px;text-transform:uppercase;}
    .chip.ok{background:#edfdf3;color:var(--ok);}
    .chip.warn{background:var(--warn-bg);color:var(--warn);}
    .chip.neutral{background:#edf2f7;color:#4a5568;}
    .face-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;}
    .face-box{border:1px solid var(--border);border-radius:18px;overflow:hidden;background:#fbfdff;}
    .face-head{padding:8px 12px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.35px;}
    .face-head.ref{background:#e7f7f0;color:#196a45;}
    .face-head.live{background:#eef4ff;color:#1f5f9e;}
    .face-body{min-height:184px;display:flex;align-items:center;justify-content:center;padding:10px;background:linear-gradient(180deg,#ffffff 0%,#f8fbfd 100%);}
    .face-body img,.face-body video{width:100%;max-height:180px;border-radius:12px;object-fit:cover;display:block;}
    .placeholder{font-size:11px;color:var(--muted);text-align:center;line-height:1.5;}
    .placeholder svg{width:34px;height:34px;display:block;margin:0 auto 8px;fill:#c5d7d1;}
    .notice{background:#fefce8;border:1px solid #facc15;border-radius:16px;padding:12px 14px;font-size:12px;color:#7c5b00;line-height:1.55;display:flex;gap:10px;align-items:flex-start;margin-bottom:14px;}
    .notice strong{display:block;font-size:12px;margin-bottom:4px;}
    .notice svg{width:16px;height:16px;fill:#d69e2e;flex-shrink:0;margin-top:2px;}
    .camera-wrap{position:relative;border-radius:20px;overflow:hidden;background:#000;aspect-ratio:4/3;display:none;max-width:420px;margin:0 auto;}
    .camera-wrap video{width:100%;height:100%;object-fit:cover;display:block;}
    .camera-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;}
    .guide{width:148px;height:180px;border:2px dashed rgba(255,255,255,.52);border-radius:50%;opacity:.65;}
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
    .field{display:flex;flex-direction:column;gap:6px;}
    .field.span2{grid-column:span 2;}
    .field label{font-size:10px;font-weight:800;color:#1f4b43;text-transform:uppercase;letter-spacing:.55px;}
    .field input,.field select,.field textarea{border:1.5px solid var(--border);border-radius:14px;padding:11px 12px;font-size:12px;font-family:'Manrope',sans-serif;background:#fff;outline:none;color:var(--text);transition:border-color .18s, box-shadow .18s, background .18s;}
    .field textarea{min-height:90px;resize:vertical;}
    .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--primary-b);box-shadow:0 0 0 4px rgba(31,143,199,.12);}
    .actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px;}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:none;border-radius:14px;padding:11px 16px;font-size:12px;font-weight:800;font-family:'Manrope',sans-serif;cursor:pointer;text-decoration:none;transition:transform .15s,box-shadow .2s,opacity .2s;}
    .btn svg{width:15px;height:15px;fill:currentColor;}
    .btn.primary{background:linear-gradient(135deg,var(--primary-a),var(--primary-b),var(--primary-c));color:#fff;box-shadow:0 12px 24px rgba(31,143,199,.22);}
    .btn.secondary{background:#f4fbff;color:#1f5f9e;border:1px solid var(--border);}
    .btn.ghost{background:#fff;color:#376154;border:1px solid var(--border);}
    .btn.danger{background:var(--danger-bg);color:var(--danger);border:1px solid #fecdd3;}
    .btn:disabled{opacity:.55;cursor:not-allowed;transform:none;}
    .btn:hover:not(:disabled){transform:translateY(-1px);}
    .steps{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:16px;}
    .step{display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;border:1px solid var(--border);background:#fff;font-size:11px;font-weight:800;color:#4d6a63;}
    .step.active{background:var(--primary-soft);color:#13644a;border-color:#bfe9d0;}
    .step.done{background:#eefaf5;color:var(--ok);border-color:#c9efd8;}
    .step .dot{width:16px;height:16px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:#dbe7e2;color:#6b7f79;font-size:10px;}
    .step.active .dot{background:var(--primary-b);color:#fff;}
    .step.done .dot{background:var(--ok);color:#fff;}
    .banner{margin-top:14px;padding:12px 14px;border-radius:14px;font-size:12px;line-height:1.6;display:none;}
    .banner.ok{display:block;background:#f0fdf4;border:1px solid #bbf7d0;color:var(--ok);}
    .banner.err{display:block;background:#fff1f2;border:1px solid #fecdd3;color:var(--danger);}
    .banner.info{display:block;background:#eef4ff;border:1px solid #bfdbfe;color:#1e3a8a;}
    .banner strong{display:block;font-size:12px;margin-bottom:4px;}
    .suggestion-box{border:1px dashed #b7d7cf;border-radius:16px;padding:14px;background:#fbfffd;display:grid;gap:10px;}
    .suggestion-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
    .suggestion-item{padding:10px;border:1px solid var(--border);border-radius:12px;background:#fff;font-size:11px;line-height:1.45;color:var(--text-md);}
    .suggestion-item b{display:block;color:var(--text);margin-bottom:3px;font-size:11px;}
    .summary-card{padding:14px;border:1px solid var(--border);border-radius:18px;background:#fcfeff;}
    .summary-card h3{font-size:13px;margin-bottom:8px;}
    .summary-line{font-size:11px;color:var(--text-md);line-height:1.55;margin-top:4px;}
    .hidden{display:none!important;}
    .spin{display:inline-block;width:13px;height:13px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:-2px;}
    .alert{display:none;padding:10px 12px;border-radius:12px;font-size:11px;font-weight:700;line-height:1.45;}
    .alert.ok{display:block;background:#f0fdf4;color:var(--ok);border:1px solid #bbf7d0;}
    .alert.err{display:block;background:#fff1f2;color:var(--danger);border:1px solid #fecdd3;}
    @keyframes spin{to{transform:rotate(360deg);}}
    @media (max-width: 980px){.grid{grid-template-columns:1fr;}.face-grid{grid-template-columns:1fr;}}
    @media (max-width: 720px){body{padding:10px;}.shell{border-radius:24px;}.topbar{padding:16px;flex-direction:column;align-items:flex-start;}.meta{text-align:left;}.content{padding:14px;}.form-grid{grid-template-columns:1fr;}.field.span2{grid-column:span 1;}.suggestion-grid{grid-template-columns:1fr;}.actions .btn{width:100%;}}
  </style>
  <link rel="stylesheet" href="/public/css/global-palette.css">
  <link rel="stylesheet" href="/public/css/clinic-refresh.css">
</head>
<body>
  <div class="shell">
    <header class="topbar">
      <div class="brand">
        <div class="brand-badge"><img src="/public/brand/clinic-check-mark.svg" alt="Clinic Chek"></div>
        <div>
          <h1>Tablet do Paciente</h1>
          <p id="pageSubtitle">Preparando reconhecimento facial e formulário da consulta.</p>
        </div>
      </div>
      <div class="meta" id="pageMeta">Sessao protegida por token temporario</div>
    </header>

    <main class="content">
      <div class="steps">
        <div class="step active" id="stepBadge1"><span class="dot">1</span>Reconhecimento facial</div>
        <div class="step" id="stepBadge2"><span class="dot">2</span>Preencher dados</div>
        <div class="step" id="stepBadge3"><span class="dot">3</span>Enviar ao medico</div>
      </div>

      <div class="grid">
        <section class="card">
          <div class="card-head">
            <h2>Validação biométrica</h2>
            <span class="chip warn" id="faceStatusChip">Aguardando</span>
          </div>
          <div class="card-body">
            <div class="status-strip" id="sessionChips"></div>

            <div class="face-grid">
              <div class="face-box">
                <div class="face-head ref">Foto de cadastro</div>
                <div class="face-body" id="referenceFaceBox">
                  <div class="placeholder">
                    <svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
                    Carregando foto de referencia...
                  </div>
                </div>
              </div>
              <div class="face-box">
                <div class="face-head live">Sua foto agora</div>
                <div class="face-body" id="liveFaceBox">
                  <div class="placeholder">
                    <svg viewBox="0 0 24 24"><path d="M9 3L7.17 5H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2h-3.17L15 3H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"/></svg>
                    Abra a câmera para confirmar sua identidade
                  </div>
                </div>
              </div>
            </div>

            <div class="notice" id="faceNotice">
              <svg viewBox="0 0 24 24"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
              <div>
                <strong>Validação facial obrigatória</strong>
                A recepção deve entregar este tablet para o paciente após a checagem do rosto. Somente depois da validação o formulário será liberado.
              </div>
            </div>

            <div class="camera-wrap" id="cameraWrap">
              <video id="cameraVideo" autoplay playsinline muted></video>
              <div class="camera-overlay"><div class="guide"></div></div>
              <canvas id="cameraCanvas" class="hidden"></canvas>
            </div>

            <div class="actions">
              <button class="btn secondary" type="button" id="openCameraBtn">
                <svg viewBox="0 0 24 24"><path d="M9 3L7.17 5H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2h-3.17L15 3H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"/></svg>
                Abrir câmera
              </button>
              <button class="btn primary" type="button" id="captureFaceBtn" disabled>
                <svg viewBox="0 0 24 24"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0-5l2.3 3h4.7v2h2v6h-2v6h2v2h-6.7L12 23l-2.3-3H3v-2h2v-6H3V7h2V5h4.7L12 2z"/></svg>
                Capturar e validar
              </button>
              <button class="btn ghost" type="button" id="retakeBtn" disabled>Refazer captura</button>
            </div>

            <div class="banner err" id="faceErr"></div>
            <div class="banner ok" id="faceOk"></div>
          </div>
        </section>

        <section class="card">
          <div class="card-head">
            <h2>Dados do paciente</h2>
            <span class="chip neutral" id="patientNameChip">Carregando</span>
          </div>
          <div class="card-body">
            <div class="suggestion-box" id="suggestionBox">
              <div class="suggestion-grid">
                <div class="suggestion-item"><b>Consulta</b><span id="suggestConsultation">Sem consulta vinculada</span></div>
                <div class="suggestion-item"><b>Médico</b><span id="suggestDoctor">-</span></div>
                <div class="suggestion-item"><b>Contato</b><span id="suggestContact">-</span></div>
                <div class="suggestion-item"><b>Documento</b><span id="suggestDocument">-</span></div>
              </div>
              <div class="summary-card">
                <h3>Escolha o modo do formulário</h3>
                <div class="summary-line">Você pode começar com os dados sugeridos da clínica ou limpar tudo e preencher do zero.</div>
                <div class="actions">
                  <button class="btn primary" type="button" id="useSuggestedBtn">Usar dados sugeridos</button>
                  <button class="btn ghost" type="button" id="clearFormBtn">Começar do zero</button>
                </div>
              </div>
            </div>

            <form id="tabletForm" class="hidden" style="margin-top:16px;">
              <div class="form-grid">
                <div class="field span2">
                  <label>Nome completo</label>
                  <input type="text" id="patientNameInput" placeholder="Nome completo">
                </div>
                <div class="field">
                  <label>E-mail</label>
                  <input type="email" id="patientEmailInput" placeholder="email@dominio.com">
                </div>
                <div class="field">
                  <label>Telefone</label>
                  <input type="text" id="patientPhoneInput" placeholder="(11) 99999-9999">
                </div>
                <div class="field">
                  <label>Documento</label>
                  <input type="text" id="patientDocumentInput" placeholder="CPF / RG">
                </div>
                <div class="field">
                  <label>Data de nascimento</label>
                  <input type="date" id="patientBirthInput">
                </div>
                <div class="field span2">
                  <label>Endereço</label>
                  <input type="text" id="patientAddressInput" placeholder="Rua, número, bairro, cidade">
                </div>
                <div class="field span2">
                  <label>Motivo principal</label>
                  <input type="text" id="chiefComplaintInput" placeholder="Ex: dor, retorno, acompanhamento">
                </div>
                <div class="field span2">
                  <label>Sintomas / observações</label>
                  <textarea id="symptomsInput" placeholder="Descreva os sintomas principais"></textarea>
                </div>
                <div class="field">
                  <label>Alergias</label>
                  <input type="text" id="allergiesInput" placeholder="Ex: dipirona, látex">
                </div>
                <div class="field">
                  <label>Medicamentos em uso</label>
                  <input type="text" id="medicationsInput" placeholder="Ex: losartana 50mg">
                </div>
                <div class="field span2">
                  <label>Histórico / observações adicionais</label>
                  <textarea id="observationsInput" placeholder="Observações que o médico precisa ver antes da consulta"></textarea>
                </div>
                <div class="field span2">
                  <label>Contato de emergência</label>
                  <div class="form-grid" style="grid-template-columns:1fr 1fr;gap:10px;">
                    <input type="text" id="emergencyNameInput" placeholder="Nome do contato">
                    <input type="text" id="emergencyPhoneInput" placeholder="Telefone do contato">
                  </div>
                </div>
              </div>

              <div class="actions">
                <button class="btn primary" type="submit" id="submitBtn" disabled>
                  <svg viewBox="0 0 24 24"><path d="M5 20h14v-2H5v2zm7-18l5 5h-3v4H10V7H7l5-5z"/></svg>
                  Enviar ao médico
                </button>
                <button class="btn secondary" type="button" id="saveDraftBtn">Salvar rascunho local</button>
              </div>

              <div class="banner info" id="submitInfo"></div>
              <div class="alert ok" id="submitOk"></div>
              <div class="alert err" id="submitErr"></div>
            </form>
          </div>
        </section>
      </div>

      <section class="card">
        <div class="card-head">
          <h2>Resumo da entrega</h2>
          <span class="chip neutral">Pré-prontuário do tablet</span>
        </div>
        <div class="card-body">
          <div class="summary-line">Os dados enviados aqui ficam registrados para o médico revisar, selecionar como base e transformar em prontuário completo.</div>
          <div class="summary-line">A tela foi pensada para uso em tablet na recepção, com o paciente validado por rosto antes de preencher qualquer informação.</div>
        </div>
      </section>
    </main>
  </div>

  <script>
    const tabletToken = '<%= token %>';
    const threshold = 70;
    const storageKey = `tabletDraft:${tabletToken}`;
    let sessionData = null;
    let cameraStream = null;
    let referenceFaceHash = null;
    let liveFaceImage = null;
    let faceVerified = false;

    function esc(v) {
      return String(v || '').replace(/[&<>"']/g, (s) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;','\'':'&#39;' }[s]));
    }

    function byId(id) {
      return document.getElementById(id);
    }

    function setBanner(el, text, kind) {
      if (!el) return;
      if (!text) {
        el.className = 'banner';
        el.textContent = '';
        return;
      }
      el.className = `banner ${kind || 'info'}`;
      el.innerHTML = text;
    }

    function setAlert(id, text, ok) {
      const el = byId(id);
      if (!el) return;
      el.className = ok ? 'alert ok' : 'alert err';
      el.textContent = text || '';
      el.style.display = text ? 'block' : 'none';
    }

    async function loadImageHash(src) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          canvas.width = 8;
          canvas.height = 8;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, 8, 8);
          const { data } = ctx.getImageData(0, 0, 8, 8);
          const pixels = [];
          for (let i = 0; i < data.length; i += 4) {
            pixels.push((data[i] + data[i + 1] + data[i + 2]) / 3);
          }
          const avg = pixels.reduce((sum, value) => sum + value, 0) / pixels.length;
          const bits = pixels.map((value) => (value >= avg ? '1' : '0')).join('');
          resolve(bits);
        };
        img.onerror = reject;
        img.src = src;
      });
    }

    function hammingDistance(hashA, hashB) {
      if (!hashA || !hashB || hashA.length !== hashB.length) return 64;
      let distance = 0;
      for (let i = 0; i < hashA.length; i += 1) {
        if (hashA[i] !== hashB[i]) distance += 1;
      }
      return distance;
    }

    function loadFromStorage() {
      try {
        return JSON.parse(localStorage.getItem(storageKey) || 'null');
      } catch (_e) {
        return null;
      }
    }

    function saveToStorage(payload) {
      localStorage.setItem(storageKey, JSON.stringify(payload));
    }

    function currentFormPayload() {
      return {
        patient_name: byId('patientNameInput').value.trim(),
        patient_email: byId('patientEmailInput').value.trim(),
        patient_phone: byId('patientPhoneInput').value.trim(),
        patient_document: byId('patientDocumentInput').value.trim(),
        patient_birth_date: byId('patientBirthInput').value || null,
        patient_address: byId('patientAddressInput').value.trim(),
        chief_complaint: byId('chiefComplaintInput').value.trim(),
        symptoms: byId('symptomsInput').value.trim(),
        allergies: byId('allergiesInput').value.trim(),
        medications: byId('medicationsInput').value.trim(),
        observations: byId('observationsInput').value.trim(),
        emergency_contact_name: byId('emergencyNameInput').value.trim(),
        emergency_contact_phone: byId('emergencyPhoneInput').value.trim(),
        captured_face: liveFaceImage,
      };
    }

    function fillFormWith(data, forceEmpty = false) {
      const source = forceEmpty ? {} : data || {};
      byId('patientNameInput').value = source.patient_name || '';
      byId('patientEmailInput').value = source.patient_email || '';
      byId('patientPhoneInput').value = source.patient_phone || '';
      byId('patientDocumentInput').value = source.patient_document || '';
      byId('patientBirthInput').value = source.patient_birth_date ? String(source.patient_birth_date).slice(0, 10) : '';
      byId('patientAddressInput').value = source.patient_address || '';
      byId('chiefComplaintInput').value = source.chief_complaint || '';
      byId('symptomsInput').value = source.symptoms || '';
      byId('allergiesInput').value = source.allergies || '';
      byId('medicationsInput').value = source.medications || '';
      byId('observationsInput').value = source.observations || '';
      byId('emergencyNameInput').value = source.emergency_contact_name || '';
      byId('emergencyPhoneInput').value = source.emergency_contact_phone || '';
      byId('submitInfo').innerHTML = forceEmpty
        ? 'Formulário limpo. Preencha do zero ou reative os dados sugeridos quando quiser.'
        : 'Dados sugeridos carregados. Revise e ajuste antes de enviar ao médico.';
      byId('submitInfo').className = 'banner info';
      byId('tabletForm').classList.remove('hidden');
      byId('stepBadge2').classList.add('active');
      byId('submitBtn').disabled = !faceVerified;
      saveToStorage(currentFormPayload());
    }

    function renderSessionInfo(data) {
      const chips = byId('sessionChips');
      const pieces = [];
      if (data.patient?.name) pieces.push(`<span class="chip neutral">Paciente: ${esc(data.patient.name)}</span>`);
      if (data.consultation?.doctor_name) pieces.push(`<span class="chip neutral">Médico: ${esc(data.consultation.doctor_name)}</span>`);
      if (data.consultation?.consultation_at) pieces.push(`<span class="chip neutral">Consulta: ${new Date(data.consultation.consultation_at).toLocaleString('pt-BR')}</span>`);
      if (data.session?.status) pieces.push(`<span class="chip warn">Status: ${esc(data.session.status)}</span>`);
      chips.innerHTML = pieces.join('');

      byId('patientNameChip').textContent = data.patient?.name || 'Paciente';
      byId('suggestConsultation').textContent = data.consultation?.consultation_at ? new Date(data.consultation.consultation_at).toLocaleString('pt-BR') : 'Sem consulta vinculada';
      byId('suggestDoctor').textContent = data.consultation?.doctor_name || '-';
      byId('suggestContact').textContent = `${data.patient?.email || '-'}${data.patient?.phone ? ' · ' + data.patient.phone : ''}`;
      byId('suggestDocument').textContent = data.patient?.document_id || '-';
      byId('pageMeta').textContent = data.session?.expires_at ? `Sessão expira em ${new Date(data.session.expires_at).toLocaleString('pt-BR')}` : 'Sessão protegida por token temporário';

      const refBox = byId('referenceFaceBox');
      if (data.reference_face) {
        refBox.innerHTML = `<img src="${data.reference_face}" alt="Foto de cadastro">`;
      } else {
        refBox.innerHTML = `<div class="placeholder"><svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>Sem foto de referência cadastrada</div>`;
      }
    }

    async function compareFaces(referenceSrc, liveSrc) {
      const [refHash, liveHash] = await Promise.all([loadImageHash(referenceSrc), loadImageHash(liveSrc)]);
      const distance = hammingDistance(refHash, liveHash);
      const similarity = Math.max(0, Math.round(100 - ((distance / 64) * 100)));
      return { similarity, distance };
    }

    async function loadSession() {
      const res = await fetch(`/api/patient/tablet/${tabletToken}`);
      const data = await res.json();
      if (!res.ok) {
        byId('pageSubtitle').textContent = data.error || 'Sessão indisponível.';
        setBanner(byId('faceNotice'), data.error || 'Sessão inválida ou expirada.', 'err');
        byId('openCameraBtn').disabled = true;
        byId('captureFaceBtn').disabled = true;
        byId('submitBtn').disabled = true;
        return;
      }

      sessionData = data;
      renderSessionInfo(data);
      fillFormWith(data.suggested_data || {}, false);
      if (data.reference_face) {
        referenceFaceHash = await loadImageHash(data.reference_face);
      }

      if (data.session?.face_verified) {
        faceVerified = true;
        byId('faceStatusChip').textContent = 'Verificado';
        byId('faceStatusChip').className = 'chip ok';
        byId('submitBtn').disabled = false;
        byId('stepBadge1').classList.add('done');
        byId('stepBadge2').classList.add('active');
        setBanner(byId('faceOk'), 'Identidade já verificada. O formulário está pronto para revisão.', 'ok');
      }
    }

    function stopCamera() {
      if (cameraStream) {
        cameraStream.getTracks().forEach((track) => track.stop());
        cameraStream = null;
      }
      byId('cameraWrap').style.display = 'none';
    }

    async function openCamera() {
      setAlert('faceErr', '');
      try {
        cameraStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: 640, height: 480 } });
        byId('cameraVideo').srcObject = cameraStream;
        byId('cameraWrap').style.display = 'block';
        byId('captureFaceBtn').disabled = false;
      } catch (_error) {
        setAlert('faceErr', 'Não foi possível abrir a câmera. Verifique as permissões do navegador.');
      }
    }

    async function captureAndVerify() {
      const video = byId('cameraVideo');
      const canvas = byId('cameraCanvas');
      if (!video.videoWidth || !video.videoHeight) {
        setAlert('faceErr', 'A câmera ainda não está pronta. Tente novamente em alguns segundos.');
        return;
      }

      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
      liveFaceImage = canvas.toDataURL('image/jpeg', 0.85);
      byId('liveFaceBox').innerHTML = `<img src="${liveFaceImage}" alt="Captura facial">`;

      if (!referenceFaceHash) {
        setAlert('faceErr', 'Não existe foto de referência cadastrada para comparação facial.');
        return;
      }

      const liveHash = await loadImageHash(liveFaceImage);
      const distance = hammingDistance(referenceFaceHash, liveHash);
      const similarity = Math.max(0, Math.round(100 - ((distance / 64) * 100)));

      if (similarity < threshold) {
        setAlert('faceErr', `Reconhecimento facial abaixo do limite. Similaridade: ${similarity}%`);
        byId('faceStatusChip').textContent = 'Não aprovado';
        byId('faceStatusChip').className = 'chip warn';
        return;
      }

      const verifyRes = await fetch(`/api/patient/tablet/${tabletToken}/verify`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ faceImage: liveFaceImage, matchPercent: similarity }),
      });
      const verifyData = await verifyRes.json();
      if (!verifyRes.ok) {
        setAlert('faceErr', verifyData.error || 'Não foi possível validar a face.');
        return;
      }

      faceVerified = true;
      byId('faceStatusChip').textContent = `Verificado ${verifyData.face_similarity}%`;
      byId('faceStatusChip').className = 'chip ok';
      byId('stepBadge1').classList.add('done');
      byId('stepBadge2').classList.add('active');
      byId('submitBtn').disabled = false;
      byId('retakeBtn').disabled = false;
      byId('captureFaceBtn').disabled = true;
      stopCamera();
      setAlert('faceOk', `Reconhecimento facial aprovado com ${verifyData.face_similarity}% de similaridade. O formulário foi liberado.`, true);
      byId('tabletForm').classList.remove('hidden');
      byId('stepBadge3').classList.remove('done');
    }

    byId('useSuggestedBtn').addEventListener('click', () => {
      fillFormWith(sessionData?.suggested_data || {}, false);
      byId('stepBadge2').classList.add('active');
    });

    byId('clearFormBtn').addEventListener('click', () => {
      fillFormWith({}, true);
    });

    byId('saveDraftBtn').addEventListener('click', () => {
      saveToStorage(currentFormPayload());
      setAlert('submitOk', 'Rascunho salvo neste dispositivo.', true);
    });

    byId('openCameraBtn').addEventListener('click', openCamera);
    byId('captureFaceBtn').addEventListener('click', captureAndVerify);
    byId('retakeBtn').addEventListener('click', async () => {
      faceVerified = false;
      byId('submitBtn').disabled = true;
      byId('faceStatusChip').textContent = 'Aguardando';
      byId('faceStatusChip').className = 'chip warn';
      byId('liveFaceBox').innerHTML = '<div class="placeholder"><svg viewBox="0 0 24 24"><path d="M9 3L7.17 5H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2h-3.17L15 3H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"/></svg>Abra a câmera para tentar novamente</div>';
      await openCamera();
    });

    byId('tabletForm').addEventListener('submit', async (event) => {
      event.preventDefault();
      setAlert('submitErr', '');
      setAlert('submitOk', '');
      if (!faceVerified) {
        setAlert('submitErr', 'Faça o reconhecimento facial antes de enviar os dados.');
        return;
      }

      const payload = {
        intakeMode: sessionData?.session?.intake_mode || 'BLANK',
        intakeData: currentFormPayload(),
      };

      const btn = byId('submitBtn');
      btn.disabled = true;
      btn.innerHTML = '<span class="spin"></span>Enviando...';

      try {
        const res = await fetch(`/api/patient/tablet/${tabletToken}/submit`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || 'Erro ao enviar dados.');
        }

        setAlert('submitOk', 'Dados enviados com sucesso. O médico já pode ver este pré-prontuário.', true);
        byId('submitInfo').className = 'banner ok';
        byId('submitInfo').innerHTML = 'Os dados foram registrados para revisão médica.';
        byId('stepBadge3').classList.add('done');
        btn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M5 20h14v-2H5v2zm7-18l5 5h-3v4H10V7H7l5-5z"/></svg> Enviar ao médico';
      } catch (error) {
        setAlert('submitErr', error.message || 'Erro ao enviar dados.');
        btn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M5 20h14v-2H5v2zm7-18l5 5h-3v4H10V7H7l5-5z"/></svg> Enviar ao médico';
        btn.disabled = false;
      }
    });

    (async () => {
      try {
        const draft = loadFromStorage();
        await loadSession();
        if (draft && typeof draft === 'object' && Object.keys(draft).length > 0) {
          fillFormWith(draft, false);
        }
      } catch (_error) {
        await loadSession();
      }
    })();
  </script>
</body>
</html>