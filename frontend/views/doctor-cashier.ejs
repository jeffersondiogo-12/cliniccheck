            <div class="toolbar" style="margin-bottom:14px;">
              <input type="text" id="searchPendingInput" placeholder="Buscar paciente...">
              <button class="btn btn-outline btn-sm" id="refreshPendingBtn"><i class="fas fa-sync"></i></button>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Paciente</th>
                    <th>Procedimento / Descrição</th>
                    <th>Médico</th>
                    <th>Origem</th>
                    <th>Valor</th>
                    <th>Criado em</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody id="pendingTbody">
                  <tr><td colspan="7" class="empty-state">Carregando...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- ========== ABA: HISTÓRICO ========== -->
      <div class="tab-panel" id="tab-historico">
        <div class="card">
          <div class="card-header">
            <span><i class="fas fa-receipt"></i> Recebidos / Cancelados</span>
            <select id="historyStatusFilter" style="padding:6px 10px;border-radius:8px;border:1px solid var(--sb-border);background:var(--sb-surface);color:var(--sb-text);font-size:12px;">
              <option value="PAID">Pagos</option>
              <option value="CANCELED">Cancelados</option>
              <option value="ALL">Todos</option>
            </select>
          </div>
          <div class="card-body">
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Paciente</th>
                    <th>Descrição</th>
                    <th>Valor</th>
                    <th>Forma Pgto.</th>
                    <th>Recebido / Cancelado em</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="historyTbody">
                  <tr><td colspan="6" class="empty-state">Carregando...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>

  <!-- ============================================================
  MODAL: ABRIR CAIXA
  ============================================================ -->
  <div class="modal-overlay" id="openSessionOverlay">
    <div class="modal">
      <div class="modal-header">
        <h3>Abrir Caixa</h3>
        <button class="modal-close" onclick="closeOpenSessionModal()">&times;</button>
      </div>
      <div class="modal-body">
        <div class="form-grid">
          <div class="form-group span2">
            <label>Valor de abertura (fundo de troco)</label>
            <input type="number" id="openingAmountInput" min="0" step="0.01" placeholder="0,00" value="0">
          </div>
        </div>
        <div class="alert-err" id="openSessionErr"></div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-outline" onclick="closeOpenSessionModal()">Cancelar</button>
        <button class="btn btn-solid" id="confirmOpenSessionBtn"><i class="fas fa-door-open"></i> Abrir Caixa</button>
      </div>
    </div>
  </div>

  <!-- ============================================================
  FECHAMENTO DE CAIXA — sempre em 2 passos: conferência do que
  aconteceu na sessão, depois conferência de valores por forma de
  pagamento (com o total do sistema ao lado do campo pra preencher).
  ============================================================ -->
  <div class="modal-overlay" id="reconciliationOverlay">
    <div class="modal" style="max-width:660px;">
      <div class="modal-header">
        <h3><i class="fas fa-list-check"></i> Passo 1 de 2 — Conferência de Recebimentos</h3>
        <button class="modal-close" onclick="closeReconciliationModal()">&times;</button>
      </div>
      <div class="modal-body">
        <div id="reconciliationPendingBanner" style="display:none;padding:10px 12px;border-radius:9px;background:#fff8e1;color:#8a6100;font-size:12.5px;margin-bottom:14px;"></div>
        <div style="font-size:12.5px;font-weight:700;color:var(--sb-text-secondary);margin-bottom:6px;">Recebido nesta sessão (deu baixa)</div>
        <div id="reconciliationTotalsByMethod" style="font-size:12.5px;color:var(--sb-text-secondary);margin-bottom:10px;line-height:1.8;"></div>
        <div class="table-wrap" style="max-height:200px;overflow-y:auto;">
          <table>
            <thead><tr><th>Cliente</th><th>Descrição</th><th>Forma</th><th>Valor</th></tr></thead>
            <tbody id="reconciliationReceivedTbody"></tbody>
          </table>
        </div>
        <div style="font-size:12.5px;font-weight:700;color:var(--sb-text-secondary);margin:16px 0 6px;">Ainda em aberto (não recebido — vira a receber / inadimplência)</div>
        <div class="table-wrap" style="max-height:160px;overflow-y:auto;">
          <table>
            <thead><tr><th>Cliente</th><th>Descrição</th><th>Valor</th></tr></thead>
            <tbody id="reconciliationPendingTbody"></tbody>
          </table>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-outline" onclick="closeReconciliationModal()">Cancelar</button>
        <button class="btn btn-solid" id="goToCloseValuesBtn">Continuar para conferência de valores <i class="fas fa-arrow-right"></i></button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="closeValuesOverlay">
    <div class="modal" style="max-width:600px;">
      <div class="modal-header">
        <h3><i class="fas fa-scale-balanced"></i> Passo 2 de 2 — Conferência de Valores</h3>
        <button class="modal-close" onclick="closeCloseValuesModal()">&times;</button>
      </div>
      <div class="modal-body">
        <p style="font-size:12px;color:var(--sb-text-muted);margin-bottom:12px;">
          Confira fisicamente cada forma de pagamento (dinheiro na gaveta, comprovantes de maquininha, extrato do Pix...)
          e preencha o quanto foi realmente conferido. O sistema calcula a diferença na hora.
        </p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Forma de pagamento</th><th>Total no sistema</th><th>Conferido</th><th>Diferença</th></tr></thead>
            <tbody id="closeValuesTbody"></tbody>
          </table>
        </div>
        <div class="form-group span2" style="margin-top:14px;">
          <label>Observações</label>
          <textarea id="closingNotesInput" rows="2" placeholder="Opcional — ex: motivo de uma diferença"></textarea>
        </div>
        <div class="alert-err" id="closeValuesErr"></div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-outline" onclick="voltarParaConferencia()">Voltar</button>
        <button class="btn btn-red" id="confirmCloseSessionBtn"><i class="fas fa-door-closed"></i> Fechar Caixa</button>
      </div>
    </div>
  </div>


