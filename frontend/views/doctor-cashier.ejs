          <div class="empty-state">Carregando...</div>
        </div>
      </div>

      <!-- ABAS -->
      <div class="tabs-row" id="caixaTabs">
        <button type="button" class="tab-btn active" data-tab="visao-geral"><i class="fas fa-chart-pie"></i> Visão Geral</button>
        <button type="button" class="tab-btn" data-tab="a-receber"><i class="fas fa-list"></i> A Receber</button>
        <button type="button" class="tab-btn" data-tab="historico"><i class="fas fa-receipt"></i> Histórico</button>
      </div>

      <!-- ========== ABA: VISÃO GERAL ========== -->
      <div class="tab-panel active" id="tab-visao-geral">
        <div class="stats-row" id="statsRow">
          <div class="stat-card accent-yellow">
            <div class="icon yellow"><i class="fas fa-clock"></i></div>
            <div class="info">
              <div class="stat-val" id="statPendingAmount">R$ 0,00</div>
              <div class="stat-label">A receber (<span id="statPendingCount">0</span>)</div>
            </div>
          </div>
          <div class="stat-card accent-green">
            <div class="icon green"><i class="fas fa-hand-holding-usd"></i></div>
            <div class="info">
              <div class="stat-val" id="statPaidAmount">R$ 0,00</div>
              <div class="stat-label">Recebido nesta sessão</div>
            </div>
          </div>
          <div class="stat-card accent-blue">
            <div class="icon blue"><i class="fas fa-wallet"></i></div>
            <div class="info">
              <div class="stat-val" id="statOpeningAmount">R$ 0,00</div>
              <div class="stat-label">Valor de abertura</div>
            </div>
          </div>
          <div class="stat-card accent-purple">
            <div class="icon purple"><i class="fas fa-receipt"></i></div>
            <div class="info">
              <div class="stat-val" id="statAvgTicket">R$ 0,00</div>
              <div class="stat-label">Ticket médio geral</div>
            </div>
          </div>
        </div>

        <div class="charts-grid">
          <div class="chart-card">
            <h4><i class="fas fa-chart-bar" style="color:var(--sb-accent);"></i> Recebimentos — últimos 7 dias</h4>
            <div class="chart-card-body" id="chartDailyReceivedWrap">
              <canvas id="chartDailyReceived"></canvas>
            </div>
          </div>
          <div class="chart-card">
            <h4><i class="fas fa-chart-pie" style="color:var(--sb-accent);"></i> Formas de pagamento</h4>
            <div class="chart-card-body" id="chartPaymentMethodsWrap">
              <canvas id="chartPaymentMethods"></canvas>
            </div>
          </div>
          <div class="chart-card" style="grid-column: 1 / -1;">
            <h4><i class="fas fa-scale-balanced" style="color:var(--sb-accent);"></i> Histórico de diferenças no fechamento <span style="font-weight:400;color:var(--sb-text-muted);font-size:11px;">— últimas sessões fechadas, por forma de pagamento</span></h4>
            <div class="chart-card-body" id="chartDifferencesWrap">
              <canvas id="chartDifferences"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- ========== ABA: A RECEBER ========== -->
