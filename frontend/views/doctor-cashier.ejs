        <div class="alert-ok" id="newChargeOk"></div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-outline" onclick="closeNewChargeModal()">Cancelar</button>
        <button class="btn btn-solid" id="confirmNewChargeBtn"><i class="fas fa-plus"></i> Lançar</button>
      </div>
