    }

    document.getElementById('chargeProcedureTypeSelect').addEventListener('change', (e) => {
      const pt = procedureTypesById[e.target.value];
      if (pt) {
        if (!document.getElementById('chargeDescriptionInput').value.trim()) {
          document.getElementById('chargeDescriptionInput').value = pt.name;
        }
        if (pt.price != null) {
          document.getElementById('chargeAmountInput').value = Number(pt.price).toFixed(2);
        }
      }
    });

    // ── BUSCA DE PACIENTE (autocomplete) ──
    let patientSearchTimer = null;
    document.getElementById('chargePatientSearch').addEventListener('input', (e) => {
      document.getElementById('chargePatientId').value = '';
      const q = e.target.value.trim();
      clearTimeout(patientSearchTimer);
      const resultsEl = document.getElementById('chargePatientResults');
      if (q.length < 2) { resultsEl.style.display = 'none'; return; }
      patientSearchTimer = setTimeout(async () => {
        try {
          const rows = await apiGet(`/api/reception/patients?search=${encodeURIComponent(q)}`);
          if (rows.length === 0) {
            resultsEl.innerHTML = '<div class="patient-result-item">Nenhum paciente encontrado.</div>';
          } else {
            resultsEl.innerHTML = rows.map(p => `
              <div class="patient-result-item" onclick='selectChargePatient(${JSON.stringify(p.id)}, ${JSON.stringify(p.name)})'>
                ${esc(p.name)}<small>${esc(p.phone || p.email || '')}</small>
              </div>
            `).join('');
          }
          resultsEl.style.display = 'block';
        } catch (e) { /* silencioso */ }
      }, 300);
    });

    function selectChargePatient(id, name){
      document.getElementById('chargePatientId').value = id;
      document.getElementById('chargePatientSearch').value = name;
      document.getElementById('chargePatientResults').style.display = 'none';
    }

    document.addEventListener('click', (e) => {
      if (!e.target.closest('#chargePatientSearch') && !e.target.closest('#chargePatientResults')) {
        document.getElementById('chargePatientResults').style.display = 'none';
      }
    });

    // ── MODAL: NOVO LANÇAMENTO ──
    async function openNewChargeModal(){
      document.getElementById('chargePatientSearch').value = '';
      document.getElementById('chargePatientId').value = '';
      document.getElementById('chargeProcedureTypeSelect').value = '';
      document.getElementById('chargeDescriptionInput').value = '';
      document.getElementById('chargeAmountInput').value = '';
      document.getElementById('chargeDiscountInput').value = '0';
      document.getElementById('chargeNotesInput').value = '';
      document.getElementById('ownerEmailInput').value = '';
      document.getElementById('ownerPasswordInput').value = '';
      document.getElementById('newChargeErr').style.display = 'none';
      document.getElementById('newChargeOk').style.display = 'none';
      document.getElementById('newChargeOverlay').classList.add('show');
      await Promise.all([loadProcedureTypesForCharge(), loadDoctorsForCharge()]);
    }
    function closeNewChargeModal(){ document.getElementById('newChargeOverlay').classList.remove('show'); }
    document.getElementById('openNewChargeBtn').addEventListener('click', openNewChargeModal);

    document.getElementById('confirmNewChargeBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('newChargeErr');
      const okEl = document.getElementById('newChargeOk');
      errEl.style.display = 'none'; okEl.style.display = 'none';

      const patientId = document.getElementById('chargePatientId').value;
      if (!patientId) { errEl.textContent = 'Selecione um paciente da lista de busca.'; errEl.style.display = 'block'; return; }

      const body = {
        patientId,
        doctorId: document.getElementById('chargeDoctorSelect').value || null,
        procedureTypeId: document.getElementById('chargeProcedureTypeSelect').value || null,
        description: document.getElementById('chargeDescriptionInput').value.trim() || null,
        amount: document.getElementById('chargeAmountInput').value !== '' ? Number(document.getElementById('chargeAmountInput').value) : null,
        discountAmount: document.getElementById('chargeDiscountInput').value !== '' ? Number(document.getElementById('chargeDiscountInput').value) : 0,
        notes: document.getElementById('chargeNotesInput').value.trim() || null,
        ownerEmail: document.getElementById('ownerEmailInput').value.trim(),
        ownerPassword: document.getElementById('ownerPasswordInput').value,
      };

      const btn = document.getElementById('confirmNewChargeBtn');
      btn.disabled = true;
      btn.innerHTML = '<span class="spin"></span>Lançando...';
      try {
        await apiSend('/api/cashier/transactions', 'POST', body);
        okEl.textContent = 'Lançamento criado com sucesso!';
        okEl.style.display = 'block';
        await loadPending();
        await loadSession();
        setTimeout(closeNewChargeModal, 900);
      } catch (e) {
        errEl.textContent = e.message; errEl.style.display = 'block';
      }
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-plus"></i> Lançar';
    });

    // ── MODAL: RECEBER PAGAMENTO (aceita dividir em mais de uma forma, como um PDV) ──
    function renderPaymentMethodButtons(){
      const wrap = document.getElementById('paymentMethodButtons');
      wrap.innerHTML = SPLITTABLE_PAYMENT_METHODS.map((code) => {
        const info = PAYMENT_METHOD_LABELS[code];
        return `
          <div class="payment-method-btn" data-method="${code}" onclick="addReceiveLeg('${code}')">
            <i class="fas ${info.icon}"></i> ${info.label}
          </div>`;
      }).join('');
    }

    function receiveLegsSum(){
      return Math.round(receiveLegs.reduce((acc, l) => acc + (Number(l.amount) || 0), 0) * 100) / 100;
    }

    function addReceiveLeg(code){
      if (receiveLegs.some((l) => l.method === code)) return; // já adicionada — ajusta o valor direto no campo
      const remaining = Math.round((receiveAmount - receiveLegsSum()) * 100) / 100;
      receiveLegs.push({ method: code, amount: remaining > 0 ? remaining : receiveAmount });
      renderReceiveLegs();
    }
    function removeReceiveLeg(code){
      receiveLegs = receiveLegs.filter((l) => l.method !== code);
      renderReceiveLegs();
    }
    function setReceiveLegAmount(code, value){
      const leg = receiveLegs.find((l) => l.method === code);
      if (leg) leg.amount = Number(String(value).replace(',', '.')) || 0;
      updateReceiveRemainingNote();
    }
    function renderReceiveLegs(){
      const wrap = document.getElementById('receiveLegsWrap');
      wrap.innerHTML = receiveLegs.length === 0
        ? '<div class="receive-legs-empty">Nenhuma forma de pagamento adicionada ainda.</div>'
        : receiveLegs.map((l) => {
            const info = PAYMENT_METHOD_LABELS[l.method];
            return `
              <div class="receive-leg-row">
                <span class="receive-leg-icon" style="color:${info.color};"><i class="fas ${info.icon}"></i></span>
                <span class="receive-leg-label">${info.label}</span>
                <input type="number" step="0.01" min="0.01" class="receive-leg-input" value="${Number(l.amount).toFixed(2)}" oninput="setReceiveLegAmount('${l.method}', this.value)">
                <button type="button" class="receive-leg-remove" onclick="removeReceiveLeg('${l.method}')" title="Remover"><i class="fas fa-times"></i></button>
              </div>`;
          }).join('');
      document.querySelectorAll('#paymentMethodButtons .payment-method-btn').forEach((el) => {
        el.classList.toggle('selected', receiveLegs.some((l) => l.method === el.getAttribute('data-method')));
      });
      updateReceiveRemainingNote();
    }
    function updateReceiveRemainingNote(){
      const el = document.getElementById('receiveRemaining');
      const remaining = Math.round((receiveAmount - receiveLegsSum()) * 100) / 100;
      if (receiveLegs.length === 0) { el.innerHTML = ''; return; }
      if (Math.abs(remaining) < 0.005) {
        el.innerHTML = `<span style="color:#10b981;"><i class="fas fa-check-circle"></i> Total confere: ${fmtMoney(receiveLegsSum())}</span>`;
      } else if (remaining > 0) {
        el.innerHTML = `<span style="color:#f59e0b;"><i class="fas fa-triangle-exclamation"></i> Faltam ${fmtMoney(remaining)} para completar o valor.</span>`;
      } else {
        el.innerHTML = `<span style="color:#ef4444;"><i class="fas fa-triangle-exclamation"></i> Excedeu em ${fmtMoney(Math.abs(remaining))} — ajuste os valores.</span>`;
      }
    }

    function openReceiveModal(id, description, amount){
      receiveTxId = id;
      receiveAmount = Math.round(Number(amount) * 100) / 100;
      receiveLegs = [];
      document.getElementById('receiveNotesInput').value = '';
      document.getElementById('receiveErr').style.display = 'none';
      document.getElementById('receiveSummary').innerHTML = `Confirmar recebimento de <strong>${fmtMoney(amount)}</strong> referente a <strong>${esc(description)}</strong>.`;
      renderPaymentMethodButtons();
      renderReceiveLegs();
      document.getElementById('receiveOverlay').classList.add('show');
    }
    function closeReceiveModal(){ document.getElementById('receiveOverlay').classList.remove('show'); }

    document.getElementById('confirmReceiveBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('receiveErr');
      errEl.style.display = 'none';
      if (receiveLegs.length === 0) { errEl.textContent = 'Selecione ao menos uma forma de pagamento.'; errEl.style.display = 'block'; return; }
      for (const leg of receiveLegs) {
        if (!(Number(leg.amount) > 0)) {
          errEl.textContent = `Informe um valor válido para ${PAYMENT_METHOD_LABELS[leg.method]?.label || leg.method}.`;
          errEl.style.display = 'block';
          return;
        }
      }
      const sum = receiveLegsSum();
      if (Math.abs(sum - receiveAmount) > 0.01) {
        errEl.textContent = `A soma das formas de pagamento (${fmtMoney(sum)}) precisa ser igual ao valor do lançamento (${fmtMoney(receiveAmount)}).`;
        errEl.style.display = 'block';
        return;
      }
      const btn = document.getElementById('confirmReceiveBtn');
      btn.disabled = true;
      try {
        await apiSend(`/api/cashier/transactions/${receiveTxId}/receive`, 'POST', {
          payments: receiveLegs.map((l) => ({ method: l.method, amount: Number(l.amount) })),
          notes: document.getElementById('receiveNotesInput').value.trim() || null,
        });
        closeReceiveModal();
        await loadPending();
        await loadHistory();
        await loadSession();
        await loadChartsData();
      } catch (e) {
        errEl.textContent = e.message; errEl.style.display = 'block';
      }
      btn.disabled = false;
    });

    // ── MODAL: HISTÓRICO DE SESSÕES ──
    async function openSessionsHistoryModal(){
      document.getElementById('sessionsHistoryOverlay').classList.add('show');
      const tbody = document.getElementById('sessionsHistoryTbody');
      tbody.innerHTML = '<tr><td colspan="8" class="empty-state">Carregando...</td></tr>';
      try {
        const rows = await apiGet('/api/cashier/sessions?limit=50');
        if (rows.length === 0) {
          tbody.innerHTML = '<tr><td colspan="8" class="empty-state">Nenhuma sessão de caixa registrada.</td></tr>';
          return;
        }
        tbody.innerHTML = rows.map(s => {
          const diff = s.closing_difference != null ? Number(s.closing_difference) : null;
          const diffHtml = diff == null ? '—' :
            (diff === 0 ? '<span class="diff-zero">R$ 0,00</span>' :
              (diff > 0 ? `<span class="diff-positive">+${fmtMoney(diff)}</span>` : `<span class="diff-negative">${fmtMoney(diff)}</span>`));
          let receivedHtml = '—';
          if (s.closing_totals_json?.byMethod) {
            const totalSystem = Object.values(s.closing_totals_json.byMethod).reduce((a, m) => a + Number(m.system || 0), 0);
            receivedHtml = fmtMoney(totalSystem - Number(s.opening_amount || 0));
          }
          const comprovanteHtml = s.status === 'CLOSED'
            ? `<button class="btn btn-outline btn-xs" onclick="baixarComprovante('/api/cashier/session/${s.id}/comprovante-fechamento', 'comprovante-fechamento-${s.id.slice(0,8)}.pdf')"><i class="fas fa-file-pdf"></i></button>`
            : `<button class="btn btn-outline btn-xs" onclick="baixarComprovante('/api/cashier/session/${s.id}/comprovante-abertura', 'comprovante-abertura-${s.id.slice(0,8)}.pdf')"><i class="fas fa-file-pdf"></i></button>`;
          return `
            <tr>
              <td>${fmtDateTime(s.opened_at)}</td>
              <td>${fmtDateTime(s.closed_at)}</td>
              <td>${esc(s.opened_by_name || '—')}</td>
              <td>${fmtMoney(s.opening_amount)}</td>
              <td>${receivedHtml}</td>
              <td>${diffHtml}</td>
              <td>${s.status === 'OPEN' ? '<span class="badge badge-green">Aberto</span>' : '<span class="badge badge-gray">Fechado</span>'}</td>
              <td>${comprovanteHtml}</td>
            </tr>`;
        }).join('');
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="8" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }
    function closeSessionsHistoryModal(){ document.getElementById('sessionsHistoryOverlay').classList.remove('show'); }
    document.getElementById('sessionsHistoryBtn').addEventListener('click', openSessionsHistoryModal);

    // Fecha modais clicando fora
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
      overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('show'); });
    });

    // ── INIT ──
    loadSession();
    loadPending();
    loadHistory();
    loadChartsData();

    // Socket.io — atualização em tempo real do caixa (compartilhado por médico + recepção)
    (function() {
      const _d = JSON.parse(localStorage.getItem('doctorData') || '{}');
      if (!_d.id) return;
      const _sock = io({ transports: ['websocket', 'polling'] });
      _sock.on('connect', () => {
        _sock.emit('join_doctor', _d.id);
        if (_d.clinicId) _sock.emit('join_clinic', _d.clinicId);
      });
      ['cash_transaction_created', 'cash_transaction_paid', 'cash_transaction_canceled', 'cash_transaction_updated'].forEach((evt) => {
        _sock.on(evt, () => { loadPending(); loadHistory(); loadSession(); loadChartsData(); });
      });
      ['cash_session_opened', 'cash_session_closed'].forEach((evt) => {
        _sock.on(evt, () => { loadSession(); });
      });
    })();
  </script>

  <script src="/socket.io/socket.io.js"></script>
</body>
</html>