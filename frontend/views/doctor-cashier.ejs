    }

    async function loadDoctorsForCharge(){
      try {
        const rows = await apiGet('/api/reception/doctors');
        const select = document.getElementById('chargeDoctorSelect');
        select.innerHTML = '<option value="">— Não vincular a um médico —</option>';
        rows.forEach(d => {
          const opt = document.createElement('option');
          opt.value = d.id;
          opt.textContent = d.name;
          select.appendChild(opt);
        });
        if (doctorData.id && rows.some(d => d.id === doctorData.id)) {
