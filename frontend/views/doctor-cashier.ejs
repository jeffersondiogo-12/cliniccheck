                <th>Diferença</th>
                <th>Status</th>
                <th>Comprovante</th>
              </tr>
            </thead>
            <tbody id="sessionsHistoryTbody">
              <tr><td colspan="8" class="empty-state">Carregando...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-outline" onclick="closeSessionsHistoryModal()">Fechar</button>
      </div>
    </div>
  </div>

  <script>
    // ============================================================
    // SIDEBAR (mesmo da primeira tela)
    // ============================================================
    (function initSidebar() {
      const sidebar = document.querySelector('.sidebar');
      const toggleBtn = document.getElementById('sidebarToggleBtn');
      const overlay = document.getElementById('sidebarOverlay');
      let isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
      if (isCollapsed) sidebar.classList.add('collapsed');

      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (window.innerWidth <= 992) {
          sidebar.classList.toggle('open');
          overlay.classList.toggle('active');
          document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
        } else {
          isCollapsed = !isCollapsed;
          sidebar.classList.toggle('collapsed', isCollapsed);
          localStorage.setItem('sidebarCollapsed', String(isCollapsed));
        }
      });

      overlay.addEventListener('click', function() {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      });

      window.addEventListener('resize', function() {
        if (window.innerWidth > 992) {
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        }
      });

      // Tema
      const themeToggle = document.getElementById('themeToggle');
      const currentTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', currentTheme);
      themeToggle.addEventListener('click', function() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const newTheme = isDark ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      });

      // Grupos colapsáveis
      document.querySelectorAll('.sb-group-btn').forEach((btn) => {
        btn.addEventListener('click', function() {
          const group = this.closest('.sb-group');
          if (group) group.classList.toggle('open');
        });
      });

      // Dados do usuário
      const doctorToken = localStorage.getItem('doctorToken');
      const receptionToken = localStorage.getItem('receptionToken');
      const token = doctorToken || receptionToken;
      const isReceptionSession = !doctorToken && !!receptionToken;
      const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');
      const nameEl = document.getElementById('sidebarName');
      const roleEl = document.getElementById('sidebarRole');
      const clinicEl = document.getElementById('sidebarClinic');
      if (nameEl) nameEl.textContent = doctorData.name || 'Profissional';
      if (roleEl) roleEl.textContent = isReceptionSession ? 'Recepcionista' : (doctorData.isClinicOwner ? 'Owner da Clinica' : 'Profissional');
      if (clinicEl) clinicEl.textContent = 'Clinica: ' + (doctorData.clinicName || '--');

      // Logout
      document.getElementById('logoutBtn').addEventListener('click', function() {
        localStorage.removeItem('doctorToken'); localStorage.removeItem('doctorData');
        localStorage.removeItem('receptionToken'); localStorage.removeItem('receptionData');
        window.location.href = isReceptionSession ? '/recepcao/login' : '/medico/login';
      });

      // Permissões (opcional)
      if (token) {
        fetch(isReceptionSession ? '/api/auth/permissions-receptionist' : '/api/auth/permissions', { headers: { Authorization: 'Bearer ' + token } })
          .then((r) => r.ok ? r.json() : null)
          .then((data) => {
            if (!data || !Array.isArray(data.pages)) return;
            const allowed = new Set((data.pages || []).filter((p) => p.can_view).map((p) => p.code));
            document.querySelectorAll('#sidebarNav .nav-item[data-page]').forEach((item) => {
              const rawCodes = item.getAttribute('data-page-codes') || item.getAttribute('data-page') || '';
              const pageCodes = rawCodes.split(',').map((code) => code.trim()).filter(Boolean);
              const canSee = pageCodes.some((code) => allowed.has(code));
              item.hidden = !canSee;
            });
            document.querySelectorAll('.sb-group').forEach((g) => {
              const hasVisible = Array.from(g.querySelectorAll('.nav-item')).some((i) => !i.hidden);
              g.style.display = hasVisible ? '' : 'none';
            });
          })
          .catch(() => {});
      }
    })();

    // ============================================================
    // ABAS DA PÁGINA (novo — não interfere na lógica original)
    // ============================================================
    (function initCaixaTabs() {
      const tabButtons = document.querySelectorAll('#caixaTabs .tab-btn');
      const panels = document.querySelectorAll('.tab-panel');
      function activate(tabId) {
        tabButtons.forEach((b) => b.classList.toggle('active', b.dataset.tab === tabId));
        panels.forEach((p) => p.classList.toggle('active', p.id === 'tab-' + tabId));
      }
      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => activate(btn.dataset.tab));
      });
    })();

    // ============================================================
    // LÓGICA DA PÁGINA DE CAIXA
    // ============================================================
    const doctorToken = localStorage.getItem('doctorToken');
    const receptionToken = localStorage.getItem('receptionToken');
    const token = doctorToken || receptionToken;
    const isReceptionSession = !doctorToken && !!receptionToken;
    if (!token) window.location.href = '/medico/login';
    const H = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };
    const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');

    const PAYMENT_METHOD_LABELS = {
      DINHEIRO: { label: 'Dinheiro', icon: 'fa-money-bill-wave', color: '#10b981' },
      CARTAO_DEBITO: { label: 'Cartão Débito', icon: 'fa-credit-card', color: '#2563eb' },
      CARTAO_CREDITO: { label: 'Cartão Crédito', icon: 'fa-credit-card', color: '#7c3aed' },
      PIX: { label: 'PIX', icon: 'fa-bolt', color: '#06b6d4' },
      CONVENIO: { label: 'Convênio', icon: 'fa-file-invoice', color: '#f59e0b' },
      MISTO: { label: 'Misto', icon: 'fa-layer-group', color: '#64748b' },
    };
    // Formas "reais" que podem compor um recebimento — MISTO nunca é uma perna,
    // é so o marcador do lancamento quando ele usa mais de uma forma.
    const SPLITTABLE_PAYMENT_METHODS = Object.keys(PAYMENT_METHOD_LABELS).filter((m) => m !== 'MISTO');

    // Mostra "Dinheiro + Pix" a partir das pernas de um recebimento (payments: [{method, amount}]).
    function paymentBreakdownLabel(row){
      if (Array.isArray(row.payments) && row.payments.length > 1) {
        return row.payments.map((p) => `${PAYMENT_METHOD_LABELS[p.method]?.label || p.method} (${fmtMoney(p.amount)})`).join(' + ');
      }
      return PAYMENT_METHOD_LABELS[row.payment_method]?.label || row.payment_method || '—';
    }

    let currentSession = null;
    let procedureTypesById = {};
    let receiveTxId = null;
    let receiveAmount = 0;
    let receiveLegs = []; // [{ method, amount }] — pernas do recebimento (1 ou mais formas de pagamento)
    let chartDailyReceived = null;
    let chartPaymentMethods = null;
    let chartDifferences = null;

    function esc(v){ return String(v==null?'':v).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    function fmtMoney(v){ return Number(v||0).toLocaleString('pt-BR', { style:'currency', currency:'BRL' }); }
    function fmtDateTime(v){
      if(!v) return '—';
      const d = new Date(v);
      if (isNaN(d.getTime())) return '—';
      return d.toLocaleString('pt-BR', { day:'2-digit', month:'2-digit', year:'2-digit', hour:'2-digit', minute:'2-digit' });
    }
    function originLabel(o){ return o === 'AUTO_SIGNATURE' ? 'Assinatura' : 'Manual'; }
    function statusBadge(s){
      if (s === 'PENDING') return '<span class="badge badge-yellow">Pendente</span>';
      if (s === 'PAID') return '<span class="badge badge-green">Pago</span>';
      if (s === 'CANCELED') return '<span class="badge badge-red">Cancelado</span>';
      return '<span class="badge badge-gray">' + esc(s) + '</span>';
    }

    async function apiGet(url){
      const res = await fetch(url, { headers: H });
      const data = await res.json().catch(() => null);
      if (!res.ok) throw new Error(data?.error || 'Falha na requisição.');
      return data;
    }
    async function apiSend(url, method, body){
      const res = await fetch(url, { method, headers: H, body: body != null ? JSON.stringify(body) : undefined });
      const data = await res.json().catch(() => null);
      if (!res.ok) {
        const err = new Error(data?.error || 'Falha na requisição.');
        err.data = data;
        throw err;
      }
      return data;
    }

    // PDFs de comprovante exigem o header Authorization — um <a href> ou
    // window.open comum não manda esse header, então o navegador cai na
    // rota sem token e recebe "Acesso restrito". Por isso baixamos via
    // fetch autenticado e convertemos a resposta em blob pra download.
    async function baixarComprovante(url, filename) {
      try {
        const res = await fetch(url, { headers: { Authorization: 'Bearer ' + token } });
        if (!res.ok) {
          const data = await res.json().catch(() => null);
          throw new Error(data?.error || 'Não foi possível baixar o comprovante.');
        }
        const blob = await res.blob();
        const blobUrl = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = blobUrl; a.download = filename;
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(blobUrl), 2000);
      } catch (e) {
        alert(e.message);
      }
    }

    // ── SESSÃO DE CAIXA ──
    async function loadSession(){
      try {
        const data = await apiGet('/api/cashier/session/current');
        currentSession = data.session;
        renderSession(data);
      } catch (e) {
        document.getElementById('sessionBody').innerHTML = '<div class="empty-state">Erro ao carregar sessão de caixa.</div>';
      }
    }

    function renderSession(data){
      const { session, totals } = data;
      const badge = document.getElementById('sessionBadge');
      const actionsWrap = document.getElementById('sessionActionsWrap');
      const body = document.getElementById('sessionBody');

      if (session) {
        badge.innerHTML = '<i class="fas fa-circle" style="color:#10b981;"></i> Caixa Aberto';
        actionsWrap.innerHTML = `
          <button class="btn btn-outline btn-sm" onclick="baixarComprovante('/api/cashier/session/${session.id}/comprovante-abertura', 'comprovante-abertura.pdf')"><i class="fas fa-file-pdf"></i> Comprovante de Abertura</button>
          <button class="btn btn-outline btn-sm" id="sangriaBtn"><i class="fas fa-arrow-up"></i> Sangria</button>
          <button class="btn btn-outline btn-sm" id="aporteBtn"><i class="fas fa-arrow-down"></i> Aporte</button>
          <button class="btn btn-red btn-sm" id="closeSessionBtn"><i class="fas fa-door-closed"></i> Fechar Caixa</button>
        `;
        body.innerHTML = `
          <div class="session-row">
            <div class="session-info">
              <span class="dot open"></span>
              <span class="label">Aberto por <strong>${esc(session.opened_by_name || '—')}</strong> em <strong>${fmtDateTime(session.opened_at)}</strong></span>
            </div>
            <div class="session-info">
              <span class="label">Valor de abertura: <strong>${fmtMoney(session.opening_amount)}</strong></span>
            </div>
          </div>
          <div id="movementsList" style="margin-top:12px;"></div>`;
        document.getElementById('closeSessionBtn').addEventListener('click', openCloseSessionModal);
        document.getElementById('sangriaBtn').addEventListener('click', () => openMovementModal('SANGRIA'));
        document.getElementById('aporteBtn').addEventListener('click', () => openMovementModal('APORTE'));
        loadMovements(session.id);
      } else {
        badge.innerHTML = '<i class="fas fa-circle" style="color:#94a3b8;"></i> Caixa Fechado';
        actionsWrap.innerHTML = '<button class="btn btn-solid btn-sm" id="openSessionBtn"><i class="fas fa-door-open"></i> Abrir Caixa</button>';
        body.innerHTML = '<div class="empty-state">Nenhum caixa aberto no momento. Abra o caixa para registrar recebimentos.</div>';
        document.getElementById('openSessionBtn').addEventListener('click', openOpenSessionModal);
      }

      document.getElementById('statPendingAmount').textContent = fmtMoney(totals.pendingAmount);
      document.getElementById('statPendingCount').textContent = totals.pendingCount;
      document.getElementById('statPaidAmount').textContent = fmtMoney(totals.paidTotal);
      document.getElementById('statOpeningAmount').textContent = session ? fmtMoney(session.opening_amount) : fmtMoney(0);
    }

    // ── SANGRIA / APORTE ──
    async function loadMovements(sessionId){
      const el = document.getElementById('movementsList');
      if (!el) return;
      try {
        const rows = await apiGet(`/api/cashier/session/${sessionId}/movements`);
        if (rows.length === 0) { el.innerHTML = ''; return; }
        el.innerHTML = '<div style="font-size:12px;color:var(--sb-text-muted);margin-bottom:6px;">Movimentações desta sessão:</div>' +
          rows.map(m => `
            <div style="display:flex;justify-content:space-between;font-size:12.5px;padding:4px 0;border-bottom:1px dashed var(--sb-border);">
              <span>${m.type === 'SANGRIA' ? '<i class="fas fa-arrow-up" style="color:#ef4444;"></i> Sangria' : '<i class="fas fa-arrow-down" style="color:#10b981;"></i> Aporte'} — ${esc(m.reason || 'sem motivo informado')} <span style="color:var(--sb-text-muted);">(${esc(m.created_by_name || '—')})</span></span>
              <strong>${fmtMoney(m.amount)}</strong>
            </div>
          `).join('');
      } catch (e) { /* silencioso */ }
    }

    let movementType = null;
    function openMovementModal(type){
      movementType = type;
      document.getElementById('movementModalTitle').textContent = type === 'SANGRIA' ? 'Registrar Sangria' : 'Registrar Aporte';
      document.getElementById('movementAmountInput').value = '';
      document.getElementById('movementReasonInput').value = '';
      document.getElementById('movementErr').style.display = 'none';
      document.getElementById('movementOverlay').classList.add('show');
    }
    function closeMovementModal(){ document.getElementById('movementOverlay').classList.remove('show'); }

    document.getElementById('confirmMovementBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('movementErr');
      errEl.style.display = 'none';
      const amount = document.getElementById('movementAmountInput').value;
      if (!amount || isNaN(Number(amount)) || Number(amount) <= 0) {
        errEl.textContent = 'Informe um valor maior que zero.'; errEl.style.display = 'block'; return;
      }
      try {
        await apiSend(`/api/cashier/session/${currentSession.id}/movements`, 'POST', {
          type: movementType,
          amount: Number(amount),
          reason: document.getElementById('movementReasonInput').value.trim() || null,
        });
        closeMovementModal();
        await loadSession();
      } catch (e) {
        errEl.textContent = e.message; errEl.style.display = 'block';
      }
    });

    function openOpenSessionModal(){
      document.getElementById('openingAmountInput').value = '0';
      document.getElementById('openSessionErr').style.display = 'none';
      document.getElementById('openSessionOverlay').classList.add('show');
    }
    function closeOpenSessionModal(){ document.getElementById('openSessionOverlay').classList.remove('show'); }

    document.getElementById('confirmOpenSessionBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('openSessionErr');
      errEl.style.display = 'none';
      const btn = document.getElementById('confirmOpenSessionBtn');
      const openingAmount = document.getElementById('openingAmountInput').value || '0';
      btn.disabled = true;
      try {
        await apiSend('/api/cashier/session/open', 'POST', { openingAmount: Number(openingAmount) });
        closeOpenSessionModal();
        await loadSession();
      } catch (e) {
        errEl.textContent = e.message; errEl.style.display = 'block';
      }
      btn.disabled = false;
    });

    function openCloseSessionModal(){
      if (!currentSession) return;
      openReconciliationModal();
    }

    function closeReconciliationModal(){ document.getElementById('reconciliationOverlay').classList.remove('show'); }
    let reconciliationDataCache = null;

    async function openReconciliationModal() {
      const recTbody = document.getElementById('reconciliationReceivedTbody');
      const pendTbody = document.getElementById('reconciliationPendingTbody');
      recTbody.innerHTML = '<tr><td colspan="4" class="empty-state">Carregando...</td></tr>';
      pendTbody.innerHTML = '<tr><td colspan="3" class="empty-state">Carregando...</td></tr>';
      document.getElementById('reconciliationOverlay').classList.add('show');
      try {
        const data = await apiGet(`/api/cashier/session/${currentSession.id}/reconciliation`);
        reconciliationDataCache = data;
        document.getElementById('reconciliationTotalsByMethod').innerHTML =
          Object.entries(data.received.totalsByMethod).map(([m, v]) => `${PAYMENT_METHOD_LABELS[m]?.label || m}: <strong>${fmtMoney(v)}</strong>`).join(' &nbsp;·&nbsp; ')
          || 'Nenhum recebimento nesta sessão.';
        recTbody.innerHTML = data.received.items.map(i => `
          <tr><td>${esc(i.patient_name)}</td><td>${esc(i.description)}</td><td>${esc(paymentBreakdownLabel(i))}</td><td>${fmtMoney(i.amount)}</td></tr>
        `).join('') || '<tr><td colspan="4" class="empty-state">Nenhum recebimento nesta sessão.</td></tr>';
        pendTbody.innerHTML = data.pending.items.map(i => `
          <tr><td>${esc(i.patient_name)}</td><td>${esc(i.description)}</td><td>${fmtMoney(i.amount)}</td></tr>
        `).join('') || '<tr><td colspan="3" class="empty-state">Nada em aberto.</td></tr>';
        const banner = document.getElementById('reconciliationPendingBanner');
        if (data.pending.items.length > 0) {
          banner.style.display = 'block';
          banner.innerHTML = `🟡 Há <strong>${fmtMoney(data.pending.total)}</strong> ainda não recebido (${data.pending.items.length} conta(s)). Vai continuar como <strong>a receber</strong> e, se não for pago, entra na inadimplência.`;
        } else {
          banner.style.display = 'none';
        }
      } catch (e) {
        recTbody.innerHTML = `<tr><td colspan="4" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }

    document.getElementById('goToCloseValuesBtn').addEventListener('click', () => {
      closeReconciliationModal();
      openCloseValuesModal();
    });

    function closeCloseValuesModal(){ document.getElementById('closeValuesOverlay').classList.remove('show'); }
    function voltarParaConferencia(){ closeCloseValuesModal(); openReconciliationModal(); }

    function recalcCloseValuesDiff(row, systemVal) {
      const input = row.querySelector('.cv-conferido');
      const diffEl = row.querySelector('.cv-diferenca');
      const conferido = Number(input.value);
      if (input.value === '' || isNaN(conferido)) { diffEl.textContent = '—'; row.removeAttribute('data-match'); return; }
      const diff = Math.round((conferido - systemVal) * 100) / 100;
      diffEl.textContent = (diff > 0 ? '+' : '') + fmtMoney(diff);
      row.setAttribute('data-match', Math.abs(diff) < 0.01 ? 'ok' : 'off');
    }

    async function openCloseValuesModal() {
      const tbody = document.getElementById('closeValuesTbody');
      tbody.innerHTML = '<tr><td colspan="4" class="empty-state">Carregando...</td></tr>';
      document.getElementById('closeValuesErr').style.display = 'none';
      document.getElementById('closingNotesInput').value = '';
      document.getElementById('closeValuesOverlay').classList.add('show');
      try {
        const sessionData = await apiGet('/api/cashier/session/current');
        const opening = Number(sessionData.session.opening_amount || 0);
        const paidByMethod = sessionData.totals.paidByMethod || {};
        const methods = new Set(['DINHEIRO', ...Object.keys(paidByMethod)]);
        const systemByMethod = {};
        methods.forEach((m) => {
          systemByMethod[m] = m === 'DINHEIRO' ? opening + (paidByMethod.DINHEIRO || 0) : (paidByMethod[m] || 0);
        });
        tbody.innerHTML = [...methods].map((m) => `
          <tr data-method="${m}">
            <td>${PAYMENT_METHOD_LABELS[m]?.label || m}${m === 'DINHEIRO' ? ' <span style="font-size:10px;color:var(--sb-text-muted);">(inclui abertura)</span>' : ''}</td>
            <td>${fmtMoney(systemByMethod[m])}</td>
            <td><input type="number" class="cv-conferido" step="0.01" placeholder="0,00" style="width:110px;"></td>
            <td class="cv-diferenca" style="font-weight:600;">—</td>
          </tr>
        `).join('');
        tbody.querySelectorAll('tr').forEach((row) => {
          const method = row.dataset.method;
          row.querySelector('.cv-conferido').addEventListener('input', () => recalcCloseValuesDiff(row, systemByMethod[method]));
        });
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="4" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }

    document.getElementById('confirmCloseSessionBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('closeValuesErr');
      errEl.style.display = 'none';
      const conferredByMethod = {};
      let hasMissing = false;
      document.querySelectorAll('#closeValuesTbody tr').forEach((row) => {
        const val = row.querySelector('.cv-conferido')?.value;
        if (val === '' || val === undefined || isNaN(Number(val))) { hasMissing = true; return; }
        conferredByMethod[row.dataset.method] = Number(val);
      });
      if (hasMissing || Object.keys(conferredByMethod).length === 0) {
        errEl.textContent = 'Preencha o valor conferido de todas as formas de pagamento.'; errEl.style.display = 'block'; return;
      }
      const btn = document.getElementById('confirmCloseSessionBtn');
      btn.disabled = true;
      try {
        const updated = await apiSend(`/api/cashier/session/${currentSession.id}/close`, 'POST', {
          conferredByMethod,
          notes: document.getElementById('closingNotesInput').value.trim() || null,
        });
        closeCloseValuesModal();
        const diff = Number(updated.closing_difference || 0);
        const diffMsg = diff === 0 ? 'sem diferença no dinheiro' : (diff > 0 ? `com sobra de ${fmtMoney(diff)} em dinheiro` : `com falta de ${fmtMoney(Math.abs(diff))} em dinheiro`);
        if (confirm(`Caixa fechado ${diffMsg}. Baixar o comprovante de fechamento agora?`)) {
          baixarComprovante(`/api/cashier/session/${updated.id}/comprovante-fechamento`, 'comprovante-fechamento.pdf');
        }
        await loadSession();
        await loadHistory();
        await loadChartsData();
      } catch (e) {
        errEl.textContent = e.message; errEl.style.display = 'block';
      }
      btn.disabled = false;
    });

    // ── A RECEBER (PENDENTES) ──
    async function loadPending(){
      const tbody = document.getElementById('pendingTbody');
      tbody.innerHTML = '<tr><td colspan="7" class="empty-state">Carregando...</td></tr>';
      try {
        const search = document.getElementById('searchPendingInput').value.trim();
        const url = '/api/cashier/transactions?status=PENDING' + (search ? `&search=${encodeURIComponent(search)}` : '');
        const rows = await apiGet(url);
        if (rows.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="empty-state">Nenhum lançamento pendente.</td></tr>';
          return;
        }
        tbody.innerHTML = rows.map(r => `
          <tr>
            <td>${esc(r.patient_name)}</td>
            <td class="td-desc">${esc(r.procedure_type_name || r.description)}</td>
            <td>${esc(r.doctor_name || '—')}</td>
            <td><span class="badge ${r.origin === 'AUTO_SIGNATURE' ? 'badge-purple' : 'badge-blue'}">${originLabel(r.origin)}</span></td>
            <td>${fmtMoney(Number(r.amount) - Number(r.discount_amount||0))}</td>
            <td>${fmtDateTime(r.created_at)}</td>
            <td>
              <button class="btn btn-green btn-xs" onclick='openReceiveModal(${JSON.stringify(r.id)}, ${JSON.stringify(r.procedure_type_name || r.description)}, ${Number(r.amount) - Number(r.discount_amount||0)})'>
                <i class="fas fa-hand-holding-usd"></i> Receber
              </button>
              <button class="btn btn-outline btn-xs" onclick="cancelCharge('${r.id}')" title="Cancelar lançamento">
                <i class="fas fa-times"></i>
              </button>
            </td>
          </tr>
        `).join('');
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="7" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }

    document.getElementById('refreshPendingBtn').addEventListener('click', loadPending);
    let pendingSearchTimer = null;
    document.getElementById('searchPendingInput').addEventListener('input', () => {
      clearTimeout(pendingSearchTimer);
      pendingSearchTimer = setTimeout(loadPending, 350);
    });

    async function cancelCharge(id){
      if (!confirm('Cancelar este lançamento? Esta ação não pode ser desfeita.')) return;
      try {
        await apiSend(`/api/cashier/transactions/${id}/cancel`, 'POST', {});
        await loadPending();
        await loadHistory();
        await loadSession();
        await loadChartsData();
      } catch (e) {
        alert(e.message);
      }
    }

    // ── HISTÓRICO (PAGOS / CANCELADOS) ──
    async function loadHistory(){
      const tbody = document.getElementById('historyTbody');
      tbody.innerHTML = '<tr><td colspan="6" class="empty-state">Carregando...</td></tr>';
      try {
        const status = document.getElementById('historyStatusFilter').value;
        const rows = await apiGet(`/api/cashier/transactions?status=${status}`);
        const filtered = status === 'ALL' ? rows.filter(r => r.status !== 'PENDING') : rows;
        if (filtered.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" class="empty-state">Nenhum registro encontrado.</td></tr>';
          return;
        }
        tbody.innerHTML = filtered.map(r => `
          <tr>
            <td>${esc(r.patient_name)}</td>
            <td class="td-desc">${esc(r.procedure_type_name || r.description)}</td>
            <td>${fmtMoney(Number(r.amount) - Number(r.discount_amount||0))}</td>
            <td>${r.payment_method ? esc(paymentBreakdownLabel(r)) : '—'}</td>
            <td>${fmtDateTime(r.paid_at || r.canceled_at)}</td>
            <td>${statusBadge(r.status)}</td>
          </tr>
        `).join('');
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="6" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }
    document.getElementById('historyStatusFilter').addEventListener('change', loadHistory);

    // ── GRÁFICOS DA ABA "VISÃO GERAL" (novo) ──
    // Usa sempre os lançamentos PAGOS (independente do filtro da aba Histórico),
    // buscados uma vez aqui, para os dois gráficos e o ticket médio.
    async function loadChartsData(){
      let rows = [];
      try {
        rows = await apiGet('/api/cashier/transactions?status=PAID');
      } catch (e) {
        rows = [];
      }
      renderDailyReceivedChart(Array.isArray(rows) ? rows : []);
      renderPaymentMethodsChart(Array.isArray(rows) ? rows : []);
      renderAvgTicket(Array.isArray(rows) ? rows : []);

      let sessions = [];
      try {
        sessions = await apiGet('/api/cashier/sessions?limit=8');
      } catch (e) {
        sessions = [];
      }
      renderDifferencesChart(Array.isArray(sessions) ? sessions : []);
    }

    function renderDifferencesChart(sessions){
      const wrap = document.getElementById('chartDifferencesWrap');
      if (chartDifferences) { chartDifferences.destroy(); chartDifferences = null; }
      const closed = sessions.filter((s) => s.status === 'CLOSED' && s.closing_totals_json?.byMethod).reverse();
      if (!closed.length) {
        wrap.innerHTML = '<div class="chart-empty"><i class="fas fa-scale-balanced"></i>Nenhum fechamento conferido ainda.</div>';
        return;
      }
      if (!document.getElementById('chartDifferences')) {
        wrap.innerHTML = '<canvas id="chartDifferences"></canvas>';
      }
      const methodsPresent = new Set();
      closed.forEach((s) => Object.keys(s.closing_totals_json.byMethod).forEach((m) => methodsPresent.add(m)));
      const labels = closed.map((s) => fmtDateTime(s.closed_at).split(' ')[0]);
      const datasets = [...methodsPresent].map((m) => ({
        label: PAYMENT_METHOD_LABELS[m]?.label || m,
        backgroundColor: PAYMENT_METHOD_LABELS[m]?.color || '#94a3b8',
        data: closed.map((s) => Number((s.closing_totals_json.byMethod[m]?.difference || 0).toFixed(2))),
        borderRadius: 4,
      }));
      const ctx = document.getElementById('chartDifferences').getContext('2d');
      chartDifferences = new Chart(ctx, {
        type: 'bar',
        data: { labels, datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { stacked: false, ticks: { color: chartTextColor(), font: { size: 10 } }, grid: { display: false } },
            y: { ticks: { color: chartTextColor(), font: { size: 10 }, callback: (v) => fmtMoney(v) }, grid: { color: chartGridColor() } },
          },
          plugins: {
            legend: { position: 'bottom', labels: { color: chartTextColor(), boxWidth: 10, font: { size: 11 } } },
            tooltip: { callbacks: { label: (c) => `${c.dataset.label}: ${fmtMoney(c.parsed.y)}` } },
          },
        },
      });
    }

    function chartTextColor(){
      return getComputedStyle(document.documentElement).getPropertyValue('--sb-text-secondary').trim() || '#334155';
    }
    function chartGridColor(){
      const dark = document.documentElement.getAttribute('data-theme') === 'dark';
      return dark ? 'rgba(255,255,255,0.06)' : 'rgba(15,23,42,0.06)';
    }

    function renderDailyReceivedChart(rows){
      const wrap = document.getElementById('chartDailyReceivedWrap');
      const canvas = document.getElementById('chartDailyReceived');
      if (chartDailyReceived) { chartDailyReceived.destroy(); chartDailyReceived = null; }

      const dias = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
      const hoje = new Date();
      hoje.setHours(0,0,0,0);
      const buckets = [];
      for (let i = 6; i >= 0; i -= 1) {
        const d = new Date(hoje);
        d.setDate(d.getDate() - i);
        buckets.push({ date: d, total: 0 });
      }
      rows.forEach((r) => {
        if (!r.paid_at) return;
        const d = new Date(r.paid_at);
        d.setHours(0,0,0,0);
        const bucket = buckets.find((b) => b.date.getTime() === d.getTime());
        if (bucket) bucket.total += Number(r.amount || 0) - Number(r.discount_amount || 0);
      });

      const temDados = buckets.some((b) => b.total > 0);
      if (!temDados) {
        wrap.innerHTML = '<div class="chart-empty"><i class="fas fa-chart-bar"></i>Sem recebimentos nos últimos 7 dias.</div>';
        return;
      }
      if (!document.getElementById('chartDailyReceived')) {
        wrap.innerHTML = '<canvas id="chartDailyReceived"></canvas>';
      }
      const ctx = document.getElementById('chartDailyReceived').getContext('2d');
      chartDailyReceived = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: buckets.map((b) => dias[b.date.getDay()] + ' ' + b.date.getDate()),
          datasets: [{
            label: 'Recebido',
            data: buckets.map((b) => Number(b.total.toFixed(2))),
            backgroundColor: 'rgba(37, 99, 235, 0.75)',
            borderRadius: 6,
            maxBarThickness: 42,
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: { callbacks: { label: (c) => fmtMoney(c.parsed.y) } },
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { color: chartTextColor(), callback: (v) => fmtMoney(v) },
              grid: { color: chartGridColor() },
            },
            x: {
              ticks: { color: chartTextColor() },
              grid: { display: false },
            },
          },
        },
      });
    }

    function renderPaymentMethodsChart(rows){
      const wrap = document.getElementById('chartPaymentMethodsWrap');
      if (chartPaymentMethods) { chartPaymentMethods.destroy(); chartPaymentMethods = null; }

      const totals = {};
      rows.forEach((r) => {
        // Usa as pernas de pagamento quando existem — um recebimento MISTO
        // precisa contar em cada forma que ele efetivamente usou, não tudo
        // junto num único fatia "Misto" sem sentido pra esse gráfico.
        if (Array.isArray(r.payments) && r.payments.length > 0) {
          r.payments.forEach((p) => { totals[p.method] = (totals[p.method] || 0) + Number(p.amount || 0); });
        } else {
          const metodo = r.payment_method || 'OUTRO';
          totals[metodo] = (totals[metodo] || 0) + (Number(r.amount || 0) - Number(r.discount_amount || 0));
        }
      });
      const metodos = Object.keys(totals).filter((m) => totals[m] > 0);

      if (!metodos.length) {
        wrap.innerHTML = '<div class="chart-empty"><i class="fas fa-chart-pie"></i>Sem recebimentos registrados ainda.</div>';
        return;
      }
      if (!document.getElementById('chartPaymentMethods')) {
        wrap.innerHTML = '<canvas id="chartPaymentMethods"></canvas>';
      }
      const ctx = document.getElementById('chartPaymentMethods').getContext('2d');
      chartPaymentMethods = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: metodos.map((m) => PAYMENT_METHOD_LABELS[m]?.label || m),
          datasets: [{
            data: metodos.map((m) => Number(totals[m].toFixed(2))),
            backgroundColor: metodos.map((m) => PAYMENT_METHOD_LABELS[m]?.color || '#94a3b8'),
            borderWidth: 2,
            borderColor: getComputedStyle(document.documentElement).getPropertyValue('--sb-surface').trim() || '#fff',
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '62%',
          plugins: {
            legend: { position: 'bottom', labels: { color: chartTextColor(), boxWidth: 10, font: { size: 11 } } },
            tooltip: { callbacks: { label: (c) => `${c.label}: ${fmtMoney(c.parsed)}` } },
          },
        },
      });
    }

    function renderAvgTicket(rows){
      const el = document.getElementById('statAvgTicket');
      if (!el) return;
      if (!rows.length) { el.textContent = fmtMoney(0); return; }
      const total = rows.reduce((sum, r) => sum + (Number(r.amount || 0) - Number(r.discount_amount || 0)), 0);
      el.textContent = fmtMoney(total / rows.length);
    }

    // Redesenha os gráficos ao trocar de tema (cores de texto/grade mudam)
    document.getElementById('themeToggle')?.addEventListener('click', () => {
      setTimeout(() => { loadChartsData(); }, 50);
    });

    // ── TIPOS DE PROCEDIMENTO E MÉDICOS (para o modal de novo lançamento) ──
    async function loadProcedureTypesForCharge(){
      try {
        const rows = await apiGet('/api/cashier/procedure-types');
        procedureTypesById = {};
        const select = document.getElementById('chargeProcedureTypeSelect');
        select.innerHTML = '<option value="">— Lançamento manual (sem tipo cadastrado) —</option>';
        rows.forEach(pt => {
          procedureTypesById[pt.id] = pt;
          const opt = document.createElement('option');
          opt.value = pt.id;
          opt.textContent = pt.name + (pt.price != null ? ` (${fmtMoney(pt.price)})` : '');
          select.appendChild(opt);
        });
