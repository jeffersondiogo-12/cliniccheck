    document.getElementById('openNewCardBtn').addEventListener('click', async () => {
      if (allContracts.length === 0) await loadContracts();
      document.getElementById('cardContract').innerHTML = '<option value="">Selecione...</option>' + allContracts.map(c => `<option value="${c.id}">${esc(c.operator_name)}</option>`).join('');
      document.getElementById('cardPlan').innerHTML = '<option value="">— Nenhum —</option>';
