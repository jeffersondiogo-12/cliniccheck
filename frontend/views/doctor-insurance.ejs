    // ── GUIAS ──
    let claimItemCounter = 0;
    let allPatientInsuranceForClaim = [];
    function addClaimItemRow(prefill){
      const itemId = `ci_${claimItemCounter++}`;
      const wrap = document.createElement('div');
      wrap.className = 'form-grid';
      wrap.id = itemId;
      wrap.style.cssText = 'border:1px solid var(--sb-border);border-radius:var(--sb-radius);padding:12px;margin-bottom:10px;';
      wrap.innerHTML = `
                                          <div class="form-group span2">
                                            <label>Descrição *</label>
                                            <input type="text" class="ci-desc" value="${esc(prefill?.description || '')}"></div>
                                            <div class="form-group">
                                              <label>Qtd.</label>
                                              <input type="number" class="ci-qty" value="${prefill?.quantity || 1}" min="1"></div>
                                              <div class="form-group">
                                                <label>Valor Unitário (R$) *</label>
                                                <input type="number" class="ci-value" step="0.01" value="${prefill?.unitValue || ''}"></div>
                                                <div class="form-group span2" style="text-align:right;">
                                                  <button class="btn btn-outline btn-xs" type="button" onclick="document.getElementById('${itemId}').remove(); recalcClaimTotal();">Remover item</button>
                                                </div>
      `;
      document.getElementById('claimItemsList').appendChild(wrap);
      wrap.querySelectorAll('.ci-qty, .ci-value').forEach(el => el.addEventListener('input', recalcClaimTotal));
    }
    function recalcClaimTotal(){
      let total = 0;
      document.querySelectorAll('#claimItemsList > div').forEach(row => {
        const qty = Number(row.querySelector('.ci-qty')?.value || 0);
        const val = Number(row.querySelector('.ci-value')?.value || 0);
        total += qty * val;
      });
      document.getElementById('claimTotalDisplay').textContent = fmtMoney(total);
    }
    document.getElementById('addClaimItemBtn').addEventListener('click', () => addClaimItemRow());

    async function loadClaims(){
      const tbody = document.getElementById('claimsTbody');
      tbody.innerHTML = `<tr>
                                                <td colspan="8" class="empty-state">Carregando...</td>
                                              </tr>`;
      try {
        const status = document.getElementById('claimsStatusFilter').value;
        const rows = await apiGet(`/api/insurance/claims?status=${status}`);
        tbody.innerHTML = rows.map(c => `
                                              <tr>
                                                <td>${esc(c.patient_name)}</td>
                                                <td>${esc(c.operator_name)}</td>
                                                <td>${esc(c.card_number)}</td>
                                                <td>${esc(c.type)}</td>
                                                <td>${fmtMoney(c.total_value)}</td>
                                                <td>
                                                  <span class="badge ${CLAIM_STATUS_BADGE[c.status] || 'badge-gray'}">${CLAIM_STATUS_LABELS[c.status] || c.status}</span>
                                                </td>
                                                <td>${fmtDate(c.created_at)}</td>
                                                <td>
              ${c.status === 'RASCUNHO' ? `<button class="btn btn-teal btn-xs" onclick="emitClaim('${c.id}')">Emitir</button>
                                                  <button class="btn btn-outline btn-xs" onclick="cancelClaim('${c.id}')">
                                                    <i class="fas fa-times"></i>
                                                  </button>` : ''}
              ${['GLOSADA_PARCIAL','GLOSADA_TOTAL'].includes(c.status) ? `<button class="btn btn-outline btn-xs" onclick='openAppealModal(${JSON.stringify(c.id)})'>Recorrer</button>` : ''}
              ${c.status === 'EMITIDA' ? '<span style="color:var(--sb-text-muted);font-size:11px;">Aguardando lote</span>' : ''}
                                                </td>
                                              </tr>
        `).join('') || `<tr>
                                              <td colspan="8" class="empty-state">Nenhuma guia encontrada.</td>
                                            </tr>`;
      } catch (e) { tbody.innerHTML = `<tr>
                                            <td colspan="8" class="empty-state">${esc(e.message)}</td>
                                          </tr>`; }
    }
    document.getElementById('claimsStatusFilter').addEventListener('change', loadClaims);
    document.getElementById('refreshClaimsBtn').addEventListener('click', loadClaims);

    async function emitClaim(id){
      try { await apiSend(`/api/insurance/claims/${id}/emit`, 'POST', {}); loadClaims(); }
      catch (e) { alert(e.message); }
    }
    async function cancelClaim(id){
      if (!confirm('Cancelar esta guia?')) return;
      try { await apiSend(`/api/insurance/claims/${id}/cancel`, 'POST', {}); loadClaims(); }
      catch (e) { alert(e.message); }
    }

    document.getElementById('openNewClaimBtn').addEventListener('click', async () => {
      try { allPatientInsuranceForClaim = await apiGet('/api/insurance/patient-insurance'); } catch (_e) { allPatientInsuranceForClaim = []; }
      document.getElementById('claimPatientInsurance').innerHTML = allPatientInsuranceForClaim.map(pi =>
        `                                          <option value="${pi.id}">${esc(pi.patient_name)} — ${esc(pi.operator_name)} (${esc(pi.card_number)})</option>`
      ).join('') || '<option value="">Nenhuma carteirinha cadastrada — cadastre uma na aba Carteirinhas.</option>';
      document.getElementById('claimAuthNumber').value = '';
      document.getElementById('claimItemsList').innerHTML = '';
