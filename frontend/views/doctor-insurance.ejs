                                                                        </div>
                                                                        <script>
    // ============================================================
    // SIDEBAR (mesmo da primeira tela)
    // ============================================================
    (function initSidebar() {
      const sidebar = document.querySelector('.sidebar');
      const toggleBtn = document.getElementById('sidebarToggleBtn');
      const overlay = document.getElementById('sidebarOverlay');
      let isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
      if (isCollapsed) sidebar.classList.add('collapsed');

      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (window.innerWidth <= 992) {
          sidebar.classList.toggle('open');
          overlay.classList.toggle('active');
          document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
        } else {
          isCollapsed = !isCollapsed;
          sidebar.classList.toggle('collapsed', isCollapsed);
          localStorage.setItem('sidebarCollapsed', String(isCollapsed));
        }
      });

      overlay.addEventListener('click', function() {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      });

      window.addEventListener('resize', function() {
        if (window.innerWidth > 992) {
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        }
      });

      // Tema
      const themeToggle = document.getElementById('themeToggle');
      const currentTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', currentTheme);
      themeToggle.addEventListener('click', function() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const newTheme = isDark ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      });

      // Grupos colapsáveis
      document.querySelectorAll('.sb-group-btn').forEach((btn) => {
        btn.addEventListener('click', function() {
          const group = this.closest('.sb-group');
          if (group) group.classList.toggle('open');
        });
      });

      // Dados do usuário
      const doctorToken = localStorage.getItem('doctorToken');
      const receptionToken = localStorage.getItem('receptionToken');
      const token = doctorToken || receptionToken;
      const isReceptionSession = !doctorToken && !!receptionToken;
      const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');
      const nameEl = document.getElementById('sidebarName');
      const roleEl = document.getElementById('sidebarRole');
      const clinicEl = document.getElementById('sidebarClinic');
      if (nameEl) nameEl.textContent = doctorData.name || 'Profissional';
      if (roleEl) roleEl.textContent = isReceptionSession ? 'Recepcionista' : (doctorData.isClinicOwner ? 'Owner da Clinica' : 'Profissional');
      if (clinicEl) clinicEl.textContent = 'Clinica: ' + (doctorData.clinicName || '--');

      // Logout
      document.getElementById('logoutBtn').addEventListener('click', function() {
        localStorage.removeItem('doctorToken'); localStorage.removeItem('doctorData');
        localStorage.removeItem('receptionToken'); localStorage.removeItem('receptionData');
        window.location.href = isReceptionSession ? '/recepcao/login' : '/medico/login';
      });

      // Permissões (opcional)
      if (token) {
        fetch(isReceptionSession ? '/api/auth/permissions-receptionist' : '/api/auth/permissions', { headers: { Authorization: 'Bearer ' + token } })
          .then((r) => r.ok ? r.json() : null)
          .then((data) => {
            if (!data || !Array.isArray(data.pages)) return;
            const allowed = new Set((data.pages || []).filter((p) => p.can_view).map((p) => p.code));
            document.querySelectorAll('#sidebarNav .nav-item[data-page]').forEach((item) => {
              const rawCodes = item.getAttribute('data-page-codes') || item.getAttribute('data-page') || '';
              const pageCodes = rawCodes.split(',').map((code) => code.trim()).filter(Boolean);
              const canSee = pageCodes.some((code) => allowed.has(code));
              item.hidden = !canSee;
            });
            document.querySelectorAll('.sb-group').forEach((g) => {
              const hasVisible = Array.from(g.querySelectorAll('.nav-item')).some((i) => !i.hidden);
              g.style.display = hasVisible ? '' : 'none';
            });
          })
          .catch(() => {});
      }
    })();

    // ============================================================
    // CONVÊNIOS / GLOSAS
    // ============================================================
    const doctorToken = localStorage.getItem('doctorToken');
    const receptionToken = localStorage.getItem('receptionToken');
    const token = doctorToken || receptionToken;
    const isReceptionSession = !doctorToken && !!receptionToken;
    if (!token) window.location.href = '/medico/login';
    const H = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };
    const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');

    const CLAIM_STATUS_LABELS = {
      RASCUNHO: 'Rascunho', EMITIDA: 'Emitida', ENVIADA: 'Enviada', PAGA: 'Paga',
      GLOSADA_PARCIAL: 'Glosada parcial', GLOSADA_TOTAL: 'Glosada total', EM_RECURSO: 'Em recurso', FINALIZADA: 'Finalizada',
    };
    const CLAIM_STATUS_BADGE = {
      RASCUNHO: 'badge-gray', EMITIDA: 'badge-blue', ENVIADA: 'badge-purple', PAGA: 'badge-green',
      GLOSADA_PARCIAL: 'badge-yellow', GLOSADA_TOTAL: 'badge-red', EM_RECURSO: 'badge-yellow', FINALIZADA: 'badge-green',
    };

    function esc(v){ return String(v==null?'':v).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    function fmtMoney(v){ return Number(v||0).toLocaleString('pt-BR', { style:'currency', currency:'BRL' }); }
    function fmtDate(v){ if(!v) return '—'; return new Date(v).toLocaleDateString('pt-BR', { timeZone: 'UTC' }); }
    function fmtDateTime(v){ if(!v) return '—'; return new Date(v).toLocaleString('pt-BR'); }

    // ── EXPORTAÇÃO — todo relatório desta tela pode ser baixado, não só visualizado ──
    function downloadCSV(filename, headers, rows){
      const cell = (v) => {
        const s = v == null ? '' : String(v);
        return /[";\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
      };
      const lines = [headers.map(cell).join(';')].concat(rows.map(r => r.map(cell).join(';')));
      const csv = '\uFEFF' + lines.join('\r\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    async function apiGet(url){
      const res = await fetch(url, { headers: H });
      const data = await res.json().catch(() => null);
      if (!res.ok) throw new Error(data?.error || 'Falha na requisição.');
      return data;
    }
    async function apiSend(url, method, body){
      const res = await fetch(url, { method, headers: H, body: body != null ? JSON.stringify(body) : undefined });
      const data = await res.json().catch(() => null);
      if (!res.ok) throw new Error(data?.error || 'Falha na requisição.');
      return data;
    }
    function closeModal(id){ document.getElementById(id).classList.remove('show'); }
    function openModal(id){ document.getElementById(id).classList.add('show'); }
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
      overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('show'); });
    });

    // ── TABS ──
    const loadedTabs = new Set();
    const tabLoaders = {
      operators: loadOperators,
      contracts: loadContracts,
      cards: loadCards,
      claims: loadClaims,
      batches: () => { loadBatches(); loadConciliacao(); },
      appeals: () => { loadGlosasReport(); loadAppeals(); },
      billing: loadBilling,
      projection: loadReceivablesProjection,
    };
    document.querySelectorAll('.report-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        document.querySelectorAll('.report-tab').forEach((b) => b.classList.toggle('active', b === btn));
        document.querySelectorAll('.report-panel').forEach((p) => p.classList.toggle('active', p.id === `panel-${tab}`));
        if (!loadedTabs.has(tab)) { loadedTabs.add(tab); tabLoaders[tab]?.(); }
      });
    });

    // ── OPERADORAS ──
    let allOperators = [];
    async function loadOperators(){
      const tbody = document.getElementById('operatorsTbody');
      tbody.innerHTML = '<tr><td colspan="6" class="empty-state">Carregando...</td></tr>';
      try {
        allOperators = await apiGet('/api/insurance/operators');
        tbody.innerHTML = allOperators.map(o => `
                                                                        <tr>
                                                                          <td>${esc(o.name)}</td>
                                                                          <td>${esc(o.cnpj || '—')}</td>
                                                                          <td>${esc(o.ans_registry || '—')}</td>
                                                                          <td>${esc(o.contact_phone || o.contact_email || '—')}</td>
                                                                          <td>
                                                                            <input type="number" min="1" step="1" value="${o.average_payment_days || 45}" style="width:64px;padding:6px 8px;border:1px solid var(--sb-border);border-radius:6px;background:var(--sb-surface);color:var(--sb-text);font-size:12px;" onchange="updateOperatorAvgDays('${o.id}', this.value)"></td>
                                                                            <td>
                                                                              <span class="badge ${o.active ? 'badge-green' : 'badge-gray'}">${o.active ? 'Ativa' : 'Inativa'}</span>
                                                                            </td>
                                                                            <td>
                                                                              <button class="btn btn-outline btn-xs" onclick="toggleOperatorActive('${o.id}', ${!o.active})">${o.active ? 'Desativar' : 'Ativar'}</button>
                                                                            </td>
                                                                          </tr>
        `).join('') || `<tr>
                                                                          <td colspan="7" class="empty-state">Nenhuma operadora cadastrada.</td>
                                                                        </tr>`;

        const sel = document.getElementById('planOperatorSelect');
        sel.innerHTML = '<option value="">Selecione uma operadora...</option>' + allOperators.map(o => `<option value="${o.id}">${esc(o.name)}</option>`).join('');
        document.getElementById('ctOperator').innerHTML = allOperators.map(o => `<option value="${o.id}">${esc(o.name)}</option>`).join('');
      } catch (e) {
        tbody.innerHTML = `<tr>
                                                                        <td colspan="6" class="empty-state">${esc(e.message)}</td>
                                                                      </tr>`;
      }
    }
    async function toggleOperatorActive(id, newActive){
      try { await apiSend(`/api/insurance/operators/${id}`, 'PUT', { active: newActive }); loadOperators(); }
      catch (e) { alert(e.message); }
    }

    document.getElementById('openNewOperatorBtn').addEventListener('click', () => {
      ['opName','opCnpj','opAns','opPhone','opEmail'].forEach(id => document.getElementById(id).value = '');
      document.getElementById('opAvgDays').value = '45';
      document.getElementById('operatorModalErr').style.display = 'none';
      openModal('operatorModal');
    });
    document.getElementById('confirmOperatorBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('operatorModalErr');
      errEl.style.display = 'none';
      const name = document.getElementById('opName').value.trim();
      if (!name) { errEl.textContent = 'Informe o nome.'; errEl.style.display = 'block'; return; }
      try {
        await apiSend('/api/insurance/operators', 'POST', {
          name, cnpj: document.getElementById('opCnpj').value.trim() || null,
          ansRegistry: document.getElementById('opAns').value.trim() || null,
          contactPhone: document.getElementById('opPhone').value.trim() || null,
          contactEmail: document.getElementById('opEmail').value.trim() || null,
          averagePaymentDays: document.getElementById('opAvgDays').value || 45,
        });
        closeModal('operatorModal'); loadOperators();
      } catch (e) { errEl.textContent = e.message; errEl.style.display = 'block'; }
    });
    async function updateOperatorAvgDays(id, value){
      const days = Math.max(1, parseInt(value, 10) || 45);
      try { await apiSend(`/api/insurance/operators/${id}`, 'PUT', { averagePaymentDays: days }); }
      catch (e) { alert(e.message); }
    }

    // ── PLANOS ──
    async function loadPlans(operatorId){
      const tbody = document.getElementById('plansTbody');
      if (!operatorId) { tbody.innerHTML = `<tr>
                                                                      <td colspan="3" class="empty-state">Selecione uma operadora.</td>
                                                                    </tr>`; return; }
      tbody.innerHTML = `<tr>
                                                                    <td colspan="3" class="empty-state">Carregando...</td>
                                                                  </tr>`;
      try {
        const rows = await apiGet(`/api/insurance/operators/${operatorId}/plans`);
        tbody.innerHTML = rows.map(p => `<tr>
                                                                  <td>${esc(p.name)}</td>
                                                                  <td>${esc(p.segmentation || '—')}</td>
                                                                  <td>${esc(p.coverage_area || '—')}</td>
                                                                </tr>`).join('')
          || `<tr>
                                                                  <td colspan="3" class="empty-state">Nenhum plano cadastrado.</td>
                                                                </tr>`;
      } catch (e) { tbody.innerHTML = `<tr>
                                                                <td colspan="3" class="empty-state">${esc(e.message)}</td>
                                                              </tr>`; }
    }
    document.getElementById('planOperatorSelect').addEventListener('change', (e) => {
      document.getElementById('openNewPlanBtn').disabled = !e.target.value;
      loadPlans(e.target.value);
    });
    document.getElementById('openNewPlanBtn').addEventListener('click', () => {
      document.getElementById('plName').value = '';
      document.getElementById('planModalErr').style.display = 'none';
      openModal('planModal');
    });
    document.getElementById('confirmPlanBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('planModalErr');
      errEl.style.display = 'none';
      const operatorId = document.getElementById('planOperatorSelect').value;
      const name = document.getElementById('plName').value.trim();
      if (!name) { errEl.textContent = 'Informe o nome do plano.'; errEl.style.display = 'block'; return; }
      try {
