      document.getElementById('cardPatientId').value = '';
      const q = e.target.value.trim();
      clearTimeout(cardPatientSearchTimer);
      const resultsEl = document.getElementById('cardPatientResults');
      if (q.length < 2) { resultsEl.style.display = 'none'; return; }
      cardPatientSearchTimer = setTimeout(async () => {
        try {
          const rows = await apiGet(`/api/reception/patients?search=${encodeURIComponent(q)}`);
          resultsEl.innerHTML = rows.length === 0
            ? '<div class="patient-result-item">Nenhum paciente encontrado.</div>'
            : rows.map(p => `<div class="patient-result-item" onclick='selectCardPatient(${JSON.stringify(p.id)}, ${JSON.stringify(p.name)})'>${esc(p.name)}</div>`).join('');
          resultsEl.style.display = 'block';
        } catch (_e) {}
      }, 300);
    });
