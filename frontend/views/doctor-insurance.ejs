    /* BADGES */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 2px 10px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 600;
      gap: 4px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
    .badge-blue {
      background: var(--sb-accent-dim);
      color: var(--sb-accent);
    }
    .badge-green {
      background: rgba(16, 185, 129, 0.12);
      color: #10b981;
    }
    .badge-yellow {
      background: rgba(245, 158, 11, 0.12);
      color: #f59e0b;
    }
    .badge-red {
      background: rgba(239, 68, 68, 0.08);
      color: #ef4444;
    }
    .badge-gray {
      background: var(--sb-elevated);
      color: var(--sb-text-muted);
    }
    .badge-purple {
      background: rgba(124, 58, 237, 0.12);
      color: #7c3aed;
    }
    .badge-teal {
      background: rgba(6, 182, 212, 0.12);
      color: #06b6d4;
    }
    .badge-sig {
      background: rgba(124, 58, 237, 0.12);
      color: #7c3aed;
      font-size: 9px;
    }

    /* EMPTY STATE */
    .empty-state {
      padding: 48px 20px;
      text-align: center;
      color: var(--sb-text-muted);
    }
    .empty-state i {
      font-size: 48px;
      color: var(--sb-border);
      margin-bottom: 12px;
      display: block;
    }
    .empty-state h3 {
      font-size: 14px;
      font-weight: 600;
      color: var(--sb-text);
      margin-bottom: 4px;
    }
    .empty-state p {
      font-size: 12px;
    }

    /* ============================================================
       FORMULÁRIOS (padrão da sidebar)
       ============================================================ */
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .form-grid.cols3 {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .form-group.span2 {
      grid-column: span 2;
    }
    .form-group.span3 {
      grid-column: span 3;
    }
    .form-group label {
      font-size: 11px;
      font-weight: 600;
      color: var(--sb-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.3px;
      transition: color var(--sb-transition);
    }
    .form-group label .req {
      color: #ef4444;
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 9px 14px;
      border: 1px solid var(--sb-border);
      border-radius: var(--sb-radius);
      font-size: 13px;
      font-family: var(--sb-font);
      color: var(--sb-text);
      background: var(--sb-surface);
      outline: none;
      transition: background var(--sb-transition), border-color var(--sb-transition), color var(--sb-transition), box-shadow var(--sb-transition), transform 0.15s ease;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--sb-accent);
      box-shadow: 0 0 0 3px var(--sb-accent-dim);
      transform: scale(1.01);
    }
    .form-group input::placeholder,
    .form-group textarea::placeholder {
      color: var(--sb-text-muted);
      font-weight: 300;
      transition: color var(--sb-transition);
    }
    .form-group textarea {
      resize: vertical;
      min-height: 80px;
    }
    .checkbox-row {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 9px 14px;
      border: 1px solid var(--sb-border);
      border-radius: var(--sb-radius);
      background: var(--sb-surface);
      cursor: pointer;
      transition: border-color 0.2s, background var(--sb-transition), border-color var(--sb-transition);
    }
    .checkbox-row:hover {
      border-color: var(--sb-accent);
    }
    .checkbox-row input {
      width: 16px;
      height: 16px;
      cursor: pointer;
      accent-color: var(--sb-accent);
    }
    .checkbox-row label {
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      color: var(--sb-text);
      text-transform: none;
      letter-spacing: 0;
    }

    @media (max-width: 768px) {
      .form-grid, .form-grid.cols3 {
        grid-template-columns: 1fr;
      }
      .form-group.span2, .form-group.span3 {
        grid-column: span 1;
      }
    }

    /* ============================================================
       BOTÕES (padrão da sidebar)
       ============================================================ */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      border: none;
      border-radius: var(--sb-radius);
      font-size: 12px;
      font-weight: 600;
      font-family: var(--sb-font);
      cursor: pointer;
      transition: background var(--sb-transition), color var(--sb-transition), border-color var(--sb-transition), box-shadow var(--sb-transition), transform 0.2s ease;
      text-decoration: none;
      text-transform: none;
      letter-spacing: 0.2px;
      position: relative;
      overflow: hidden;
    }
    .btn::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,255,255,0.15), transparent 60%);
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
    }
    .btn:hover::after {
      opacity: 1;
    }
    .btn i {
      font-size: 14px;
    }
    .btn-solid {
      background: var(--sb-accent);
      color: #fff;
      box-shadow: 0 4px 16px rgba(37, 99, 235, 0.3);
    }
    .btn-solid:hover {
      background: #1d4ed8;
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 6px 24px rgba(37, 99, 235, 0.4);
    }
    .btn-solid:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }
    .btn-outline {
      background: transparent;
      color: var(--sb-text-secondary);
      border: 1px solid var(--sb-border);
    }
    .btn-outline:hover {
      border-color: var(--sb-accent);
      background: var(--sb-accent-dim);
      color: var(--sb-text);
      transform: translateY(-2px) scale(1.02);
    }
    .btn-teal {
      background: #06b6d4;
      color: #fff;
      box-shadow: 0 4px 16px rgba(6, 182, 212, 0.3);
    }
    .btn-teal:hover {
      background: #0891b2;
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 6px 24px rgba(6, 182, 212, 0.4);
    }
    .btn-sm {
      padding: 5px 14px;
      font-size: 11px;
    }
    .btn-xs {
      padding: 3px 10px;
      font-size: 10px;
    }
    .btn-red {
      background: rgba(239, 68, 68, 0.08);
      color: #ef4444;
      border: 1px solid rgba(239, 68, 68, 0.15);
    }
    .btn-red:hover {
      background: rgba(239, 68, 68, 0.12);
      transform: translateY(-2px) scale(1.02);
    }
    .btn-green {
      background: rgba(16, 185, 129, 0.08);
      color: #10b981;
      border: 1px solid rgba(16, 185, 129, 0.15);
    }
    .btn-green:hover {
      background: rgba(16, 185, 129, 0.12);
      transform: translateY(-2px) scale(1.02);
    }

    .info-banner {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 10px 14px;
      border-radius: var(--sb-radius);
      background: var(--sb-accent-dim);
      border-left: 3px solid var(--sb-accent);
      font-size: 12.5px;
      color: var(--sb-text-secondary);
      margin-bottom: 16px;
    }
    .info-banner i {
      color: var(--sb-accent);
      margin-top: 1px;
    }

    /* ============================================================
       ALERTAS
       ============================================================ */
    .alert-msg {
      padding: 12px 16px;
      border-radius: var(--sb-radius);
      font-size: 13px;
      margin-top: 12px;
      display: none;
      font-weight: 500;
      transition: background var(--sb-transition), color var(--sb-transition), border-color var(--sb-transition), transform 0.2s ease;
    }
    .alert-msg.show {
      display: block;
      animation: fadeUp 0.3s ease;
    }
    .alert-ok {
      background: rgba(16, 185, 129, 0.12);
      color: #10b981;
      border-left: 3px solid #10b981;
    }
    .alert-err {
      background: rgba(239, 68, 68, 0.08);
      color: #ef4444;
      border-left: 3px solid #ef4444;
    }

    .spin {
      display: inline-block;
      width: 14px;
      height: 14px;
      border: 2px solid rgba(255, 255, 255, 0.2);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      vertical-align: middle;
      margin-right: 6px;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ============================================================
       MODAIS
       ============================================================ */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
      z-index: 200;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal-overlay.show {
      display: flex;
    }
    .modal {
      background: var(--sb-surface);
      border-radius: var(--sb-radius);
      width: 100%;
      max-width: 640px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: var(--sb-shadow-hover);
      border: 1px solid var(--sb-border);
      transition: background var(--sb-transition), border-color var(--sb-transition);
    }
    .modal-header {
      padding: 14px 20px;
      border-bottom: 1px solid var(--sb-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--sb-elevated);
      position: sticky;
      top: 0;
      z-index: 1;
      transition: border-color var(--sb-transition), background var(--sb-transition);
    }
    .modal-header h3 {
      font-size: 15px;
      font-weight: 600;
      color: var(--sb-text);
    }
    .modal-close {
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      color: var(--sb-text-muted);
      width: 32px;
      height: 32px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s, color 0.15s;
    }
    .modal-close:hover {
      background: var(--sb-accent-dim);
      color: var(--sb-text);
    }
    .modal-body {
      padding: 20px;
    }
    .modal-foot {
      padding: 12px 20px;
      border-top: 1px solid var(--sb-border);
      display: flex;
      gap: 10px;
      justify-content: flex-end;
      transition: border-color var(--sb-transition);
    }

    /* CATEGORIA LIST */
    .cat-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .cat-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1px solid var(--sb-border);
      border-radius: 999px;
      padding: 4px 10px;
      transition: background var(--sb-transition), border-color var(--sb-transition);
    }
    .cat-item .cat-name {
      font-size: 11px;
      font-weight: 600;
      color: var(--sb-text-secondary);
    }
    .cat-item .cat-name.default {
      color: #166534;
    }
    .cat-item .cat-name.inactive {
      color: var(--sb-text-muted);
    }

    .charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
    @media (max-width: 1100px) { .charts-grid { grid-template-columns: 1fr; } }
    .report-tabs {
      display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px;
      border-bottom: 1px solid var(--sb-border); padding-bottom: 12px;
    }
    .report-tab {
      padding: 8px 16px; border-radius: 20px; border: 1px solid var(--sb-border);
      background: var(--sb-surface); color: var(--sb-text-secondary); font-size: 12.5px; font-weight: 600;
      cursor: pointer; transition: all 0.2s ease; white-space: nowrap;
    }
    .report-tab:hover { border-color: var(--sb-accent); color: var(--sb-text); }
    .report-tab.active { background: var(--sb-accent); color: #fff; border-color: var(--sb-accent); }
    .report-panel { display: none; }
    .report-panel.active { display: block; }
    .pill-select {
      display: inline-block; padding: 8px 12px; border-radius: var(--sb-radius); border: 1px solid var(--sb-border);
      background: var(--sb-surface); cursor: pointer; font-size: 12.5px; margin: 0 8px 8px 0;
    }
    .pill-select.selected { border-color: var(--sb-accent); background: var(--sb-accent-dim); color: var(--sb-accent); font-weight:600; }
