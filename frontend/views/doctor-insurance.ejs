      document.getElementById('claimModalErr').style.display = 'none';
      openModal('claimModal');
    });

    document.getElementById('confirmClaimBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('claimModalErr');
      errEl.style.display = 'none';
      const patientInsuranceId = document.getElementById('claimPatientInsurance').value;
      if (!patientInsuranceId) { errEl.textContent = 'Selecione a carteirinha do paciente.'; errEl.style.display = 'block'; return; }

      const items = [];
      let hasInvalid = false;
      document.querySelectorAll('#claimItemsList > div').forEach(row => {
        const description = row.querySelector('.ci-desc').value.trim();
        const quantity = Number(row.querySelector('.ci-qty').value || 1);
        const unitValue = Number(row.querySelector('.ci-value').value || 0);
        if (!description || !unitValue) hasInvalid = true;
        items.push({ description, quantity, unitValue });
      });
      if (items.length === 0 || hasInvalid) { errEl.textContent = 'Preencha descrição e valor de todos os itens.'; errEl.style.display = 'block'; return; }

      try {
        await apiSend('/api/insurance/claims', 'POST', {
          patientInsuranceId, type: document.getElementById('claimType').value,
          authorizationNumber: document.getElementById('claimAuthNumber').value.trim() || null, items,
        });
        closeModal('claimModal'); loadClaims();
      } catch (e) { errEl.textContent = e.message; errEl.style.display = 'block'; }
    });

