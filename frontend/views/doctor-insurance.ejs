    async function openAddClaimsModal(batchId, contractId){
      currentBatchIdForModals = batchId;
      const listEl = document.getElementById('availableClaimsList');
      listEl.innerHTML = '<div class="empty-state">Carregando...</div>';
      document.getElementById('addClaimsModalErr').style.display = 'none';
      openModal('addClaimsModal');
      try {
        const claims = await apiGet(`/api/insurance/claims?status=EMITIDA&contractId=${contractId}`);
        listEl.innerHTML = claims.length === 0 ? '<div class="empty-state">Nenhuma guia emitida disponível para este contrato.</div>' :
          claims.map(c => `
                                    <label style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--sb-border);font-size:13px;">
                                      <input type="checkbox" class="add-claim-cb" value="${c.id}">
              ${esc(c.patient_name)} — ${fmtMoney(c.total_value)} <span style="color:var(--sb-text-muted);">(${fmtDate(c.created_at)})</span>
                                      </label>
          `).join('');
      } catch (e) { listEl.innerHTML = `<div class="empty-state">${esc(e.message)}</div>`; }
    }
    document.getElementById('confirmAddClaimsBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('addClaimsModalErr');
      errEl.style.display = 'none';
      const claimIds = Array.from(document.querySelectorAll('.add-claim-cb:checked')).map(cb => cb.value);
      if (claimIds.length === 0) { errEl.textContent = 'Selecione ao menos uma guia.'; errEl.style.display = 'block'; return; }
      try {
        await apiSend(`/api/insurance/batches/${currentBatchIdForModals}/add-claims`, 'POST', { claimIds });
        closeModal('addClaimsModal'); loadBatches();
      } catch (e) { errEl.textContent = e.message; errEl.style.display = 'block'; }
    });

    async function closeBatch(id){
      if (!confirm('Marcar este lote como enviado à operadora?')) return;
      try { await apiSend(`/api/insurance/batches/${id}/close`, 'POST', {}); loadBatches(); }
      catch (e) { alert(e.message); }
    }

    async function openBatchReturnModal(batchId){
      currentBatchIdForModals = batchId;
      const listEl = document.getElementById('batchReturnItemsList');
      listEl.innerHTML = '<div class="empty-state">Carregando...</div>';
      document.getElementById('batchReturnModalErr').style.display = 'none';
      openModal('batchReturnModal');
      try {
        const claims = await apiGet(`/api/insurance/claims?batchId=${batchId}`);
        listEl.innerHTML = claims.map(c => `
                                      <div class="form-grid" style="border:1px solid var(--sb-border);border-radius:var(--sb-radius);padding:10px;margin-bottom:8px;" data-claim-id="${c.id}">
                                        <div class="form-group span2" style="margin-bottom:0;">
                                          <label style="font-weight:600;">${esc(c.patient_name)} — Faturado: ${fmtMoney(c.total_value)}</label>
                                        </div>
                                        <div class="form-group">
                                          <label>Valor Pago (R$)</label>
                                          <input type="number" class="br-paid" step="0.01" value="${c.total_value}"></div>
                                          <div class="form-group">
                                            <label>Valor Glosado (R$)</label>
                                            <input type="number" class="br-glossed" step="0.01" value="0"></div>
                                            <div class="form-group span2">
                                              <label>Motivo da Glosa (se houver)</label>
                                              <input type="text" class="br-reason"></div>
                                            </div>
        `).join('') || '<div class="empty-state">Nenhuma guia neste lote.</div>';
      } catch (e) { listEl.innerHTML = `<div class="empty-state">${esc(e.message)}</div>`; }
    }
    document.getElementById('confirmBatchReturnBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('batchReturnModalErr');
      errEl.style.display = 'none';
      const items = Array.from(document.querySelectorAll('#batchReturnItemsList > div')).map(row => ({
        claimId: row.getAttribute('data-claim-id'),
        paidValue: Number(row.querySelector('.br-paid').value || 0),
        glossedValue: Number(row.querySelector('.br-glossed').value || 0),
        glosaReason: row.querySelector('.br-reason').value.trim() || null,
      }));
      if (items.length === 0) { errEl.textContent = 'Nenhuma guia para conciliar.'; errEl.style.display = 'block'; return; }
      try {
        await apiSend(`/api/insurance/batches/${currentBatchIdForModals}/return`, 'POST', { items });
        closeModal('batchReturnModal'); loadBatches(); loadConciliacao();
      } catch (e) { errEl.textContent = e.message; errEl.style.display = 'block'; }
    });

    let lastConciliacaoRows = [];
    async function loadConciliacao(){
      const tbody = document.getElementById('conciliacaoTbody');
      tbody.innerHTML = `<tr>
                                            <td colspan="7" class="empty-state">Carregando...</td>
                                          </tr>`;
      try {
        const rows = await apiGet('/api/insurance/reports/conciliacao');
        lastConciliacaoRows = rows;
        tbody.innerHTML = rows.map(r => {
          const glosaPct = r.total_billed > 0 ? Math.round((r.total_glossed / r.total_billed) * 10000) / 100 : 0;
          return `
                                          <tr>
                                            <td>${esc(r.operator_name)}</td>
                                            <td>${new Date(r.competence_month).toLocaleDateString('pt-BR', { month:'2-digit', year:'numeric', timeZone:'UTC' })}</td>
                                            <td>
                                              <span class="badge ${r.status === 'CONCILIADO' ? 'badge-green' : (r.status === 'ENVIADO' ? 'badge-purple' : 'badge-gray')}">${r.status}</span>
                                            </td>
                                            <td>${fmtMoney(r.total_billed)}</td>
                                            <td>${fmtMoney(r.total_paid)}</td>
                                            <td>${fmtMoney(r.total_glossed)}</td>
                                            <td>${glosaPct}%</td>
                                          </tr>`;
        }).join('') || `<tr>
                                          <td colspan="7" class="empty-state">Nenhum lote conciliado ainda.</td>
                                        </tr>`;
      } catch (e) { tbody.innerHTML = `<tr>
                                        <td colspan="7" class="empty-state">${esc(e.message)}</td>
                                      </tr>`; }
    }
    document.getElementById('downloadConciliacaoBtn').addEventListener('click', () => {
      downloadCSV('conciliacao.csv', ['Operadora','Competência','Status','Faturado','Pago','Glosado','% Glosa'], lastConciliacaoRows.map(r => {
        const glosaPct = r.total_billed > 0 ? Math.round((r.total_glossed / r.total_billed) * 10000) / 100 : 0;
        return [r.operator_name, new Date(r.competence_month).toLocaleDateString('pt-BR', { month:'2-digit', year:'numeric', timeZone:'UTC' }), r.status, r.total_billed, r.total_paid, r.total_glossed, glosaPct + '%'];
      }));
    });

    // ── GLOSAS ──
    let lastGlosasRows = [];
    async function loadGlosasReport(){
      const tbody = document.getElementById('glosasReportTbody');
      tbody.innerHTML = `<tr>
                                      <td colspan="4" class="empty-state">Carregando...</td>
                                    </tr>`;
      try {
        const rows = await apiGet('/api/insurance/reports/glosas');
        lastGlosasRows = rows;
        tbody.innerHTML = rows.map(r => `
                                    <tr>
                                      <td>${esc(r.operator_name)}</td>
                                      <td>
                                        <span class="badge ${CLAIM_STATUS_BADGE[r.status] || 'badge-gray'}">${CLAIM_STATUS_LABELS[r.status] || r.status}</span>
                                      </td>
                                      <td>${r.count}</td>
                                      <td>${fmtMoney(r.total_glossed)}</td>
                                    </tr>
        `).join('') || `<tr>
                                    <td colspan="4" class="empty-state">Nenhuma glosa registrada.</td>
                                  </tr>`;
      } catch (e) { tbody.innerHTML = `<tr>
                                  <td colspan="4" class="empty-state">${esc(e.message)}</td>
                                </tr>`; }
    }
    document.getElementById('downloadGlosasBtn').addEventListener('click', () => {
      downloadCSV('glosas-por-operadora.csv', ['Operadora','Status da Guia','Qtd.','Total Glosado'], lastGlosasRows.map(r => [r.operator_name, CLAIM_STATUS_LABELS[r.status] || r.status, r.count, r.total_glossed]));
    });

    // ── FATURAMENTO POR CONVÊNIO ──
    let lastBillingData = { byOperatorDoctor: [], byProcedure: [] };
    async function loadBilling(){
      const opTbody = document.getElementById('billingOpDocTbody');
      const procTbody = document.getElementById('billingProcTbody');
      opTbody.innerHTML = `<tr>
                                <td colspan="7" class="empty-state">Carregando...</td>
                              </tr>`;
      procTbody.innerHTML = `<tr>
                              <td colspan="5" class="empty-state">Carregando...</td>
                            </tr>`;
      try {
        const from = document.getElementById('billingFrom').value;
        const to = document.getElementById('billingTo').value;
        const data = await apiGet(`/api/insurance/reports/billing?from=${from}&to=${to}`);
        lastBillingData = data;
        opTbody.innerHTML = data.byOperatorDoctor.map(r => `
                            <tr>
                              <td>${esc(r.operatorName)}</td>
                              <td>${esc(r.doctorName)}</td>
                              <td>${r.claims}</td>
                              <td>${fmtMoney(r.billed)}</td>
                              <td>${fmtMoney(r.paid)}</td>
                              <td>${fmtMoney(r.glossed)}</td>
                              <td>${r.glosaPct}%</td>
                            </tr>
        `).join('') || `<tr>
                            <td colspan="7" class="empty-state">Nenhuma guia emitida no período.</td>
                          </tr>`;
        procTbody.innerHTML = data.byProcedure.map(r => `
                          <tr>
                            <td>${esc(r.operatorName)}</td>
                            <td>${esc(r.procedureName)}</td>
                            <td>${esc(r.tussCode || '—')}</td>
                            <td>${r.quantity}</td>
                            <td>${fmtMoney(r.billed)}</td>
                          </tr>
        `).join('') || `<tr>
                          <td colspan="5" class="empty-state">Nenhum item faturado no período.</td>
                        </tr>`;
      } catch (e) {
        opTbody.innerHTML = `<tr>
                        <td colspan="7" class="empty-state">${esc(e.message)}</td>
                      </tr>`;
        procTbody.innerHTML = '';
      }
    }
    document.getElementById('billingRefreshBtn').addEventListener('click', loadBilling);
    document.getElementById('downloadBillingOpDocBtn').addEventListener('click', () => {
      downloadCSV('faturamento-por-operadora-profissional.csv', ['Operadora','Profissional','Guias','Faturado','Pago','Glosado','% Glosa'],
        lastBillingData.byOperatorDoctor.map(r => [r.operatorName, r.doctorName, r.claims, r.billed, r.paid, r.glossed, r.glosaPct + '%']));
    });
    document.getElementById('downloadBillingProcBtn').addEventListener('click', () => {
      downloadCSV('faturamento-por-procedimento.csv', ['Operadora','Procedimento','TUSS','Quantidade','Faturado'],
        lastBillingData.byProcedure.map(r => [r.operatorName, r.procedureName, r.tussCode || '', r.quantity, r.billed]));
    });

    // ── PROJEÇÃO DE RECEBÍVEIS ──
    let lastProjectionRows = [];
    async function loadReceivablesProjection(){
      const tbody = document.getElementById('projectionTbody');
      tbody.innerHTML = `<tr>
                      <td colspan="8" class="empty-state">Carregando...</td>
                    </tr>`;
      try {
        const data = await apiGet('/api/insurance/reports/receivables-projection');
        lastProjectionRows = data.operators;
        document.getElementById('projectionKpis').innerHTML = `
                    <div class="stat-card">
                      <div class="icon blue">
                        <i class="fas fa-hand-holding-dollar"></i>
                      </div>
                      <div class="info">
                        <div class="stat-val">${fmtMoney(data.totals.pendingTotal)}</div>
                        <div class="stat-label">Total pendente de convênios</div>
                      </div>
                    </div>
                    <div class="stat-card">
                      <div class="icon green">
                        <i class="fas fa-calendar-check"></i>
                      </div>
                      <div class="info">
                        <div class="stat-val">${fmtMoney(data.totals.bucket30)}</div>
                        <div class="stat-label">Previsto p/ 30 dias</div>
                      </div>
                    </div>
                    <div class="stat-card">
                      <div class="icon purple">
                        <i class="fas fa-calendar"></i>
                      </div>
                      <div class="info">
                        <div class="stat-val">${fmtMoney(data.totals.bucket60 + data.totals.bucket90)}</div>
                        <div class="stat-label">Previsto p/ 31–90 dias</div>
                      </div>
                    </div>
                    <div class="stat-card">
                      <div class="icon amber">
                        <i class="fas fa-triangle-exclamation"></i>
                      </div>
                      <div class="info">
                        <div class="stat-val">${fmtMoney(data.totals.bucket90Plus)}</div>
                        <div class="stat-label">Acima de 90 dias</div>
                      </div>
                    </div>
        `;
        tbody.innerHTML = data.operators.map(o => `
                    <tr>
                      <td>${esc(o.operatorName)}</td>
                      <td>${o.averagePaymentDays} dias</td>
                      <td>${o.claims}</td>
                      <td>${fmtMoney(o.pendingTotal)}</td>
                      <td>${fmtMoney(o.bucket30)}</td>
                      <td>${fmtMoney(o.bucket60)}</td>
                      <td>${fmtMoney(o.bucket90)}</td>
                      <td>${fmtMoney(o.bucket90Plus)}</td>
                    </tr>
        `).join('') || `<tr>
                    <td colspan="8" class="empty-state">Nenhuma guia pendente de recebimento.</td>
                  </tr>`;
      } catch (e) { tbody.innerHTML = `<tr>
                  <td colspan="8" class="empty-state">${esc(e.message)}</td>
                </tr>`; }
    }
    document.getElementById('downloadProjectionBtn').addEventListener('click', () => {
      downloadCSV('projecao-recebiveis-convenio.csv', ['Operadora','Prazo médio (dias)','Guias pendentes','Total pendente','Até 30 dias','31–60 dias','61–90 dias','90+ dias'],
        lastProjectionRows.map(o => [o.operatorName, o.averagePaymentDays, o.claims, o.pendingTotal, o.bucket30, o.bucket60, o.bucket90, o.bucket90Plus]));
    });

    async function loadAppeals(){
      const tbody = document.getElementById('appealsTbody');
      tbody.innerHTML = `<tr>
                <td colspan="6" class="empty-state">Carregando...</td>
              </tr>`;
      try {
        const status = document.getElementById('appealsStatusFilter').value;
        const rows = await apiGet(`/api/insurance/appeals?status=${status}`);
        tbody.innerHTML = rows.map(a => `
              <tr>
                <td>${esc(a.patient_name)}</td>
                <td>${esc(a.operator_name)}</td>
                <td>${fmtMoney(a.total_glossed)}</td>
                <td>${fmtDate(a.protocol_date)}</td>
                <td>
                  <span class="badge ${a.status === 'ACEITO' ? 'badge-green' : (a.status === 'NEGADO' ? 'badge-red' : 'badge-yellow')}">${a.status === 'PENDENTE' ? 'Pendente' : (a.status === 'ACEITO' ? 'Aceito' : 'Negado')}</span>
                </td>
                <td>${a.status === 'PENDENTE' ? `<button class="btn btn-outline btn-xs" onclick='openResolveAppealModal(${JSON.stringify(a.id)})'>Resolver</button>` : '—'}
                </td>
              </tr>
        `).join('') || `<tr>
              <td colspan="6" class="empty-state">Nenhum recurso encontrado.</td>
            </tr>`;
      } catch (e) { tbody.innerHTML = `<tr>
            <td colspan="6" class="empty-state">${esc(e.message)}</td>
          </tr>`; }
    }
    document.getElementById('appealsStatusFilter').addEventListener('change', loadAppeals);

    let currentClaimIdForAppeal = null;
    function openAppealModal(claimId){
      currentClaimIdForAppeal = claimId;
      document.getElementById('appealJustification').value = '';
      document.getElementById('appealModalErr').style.display = 'none';
      openModal('appealModal');
    }
    document.getElementById('confirmAppealBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('appealModalErr');
      errEl.style.display = 'none';
      const justification = document.getElementById('appealJustification').value.trim();
      if (!justification) { errEl.textContent = 'Informe a justificativa.'; errEl.style.display = 'block'; return; }
      try {
        await apiSend(`/api/insurance/claims/${currentClaimIdForAppeal}/appeal`, 'POST', { justification });
        closeModal('appealModal'); loadClaims(); loadAppeals();
      } catch (e) { errEl.textContent = e.message; errEl.style.display = 'block'; }
    });

    let currentAppealIdForResolve = null;
    function openResolveAppealModal(appealId){
      currentAppealIdForResolve = appealId;
      document.getElementById('resolveAppealStatus').value = 'ACEITO';
      document.getElementById('resolveAppealValue').value = '';
      document.getElementById('resolveAppealNotes').value = '';
      document.getElementById('resolveAppealModalErr').style.display = 'none';
      openModal('resolveAppealModal');
    }
    document.getElementById('resolveAppealStatus').addEventListener('change', (e) => {
      document.getElementById('resolveAppealValueWrap').style.display = e.target.value === 'ACEITO' ? 'block' : 'none';
    });
    document.getElementById('confirmResolveAppealBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('resolveAppealModalErr');
      errEl.style.display = 'none';
      try {
        await apiSend(`/api/insurance/appeals/${currentAppealIdForResolve}/resolve`, 'POST', {
          status: document.getElementById('resolveAppealStatus').value,
          additionalPaidValue: document.getElementById('resolveAppealValue').value ? Number(document.getElementById('resolveAppealValue').value) : 0,
          responseNotes: document.getElementById('resolveAppealNotes').value.trim() || null,
        });
        closeModal('resolveAppealModal'); loadAppeals(); loadGlosasReport();
      } catch (e) { errEl.textContent = e.message; errEl.style.display = 'block'; }
    });

    // ── INIT ──
    (function initBillingDefaults(){
      const to = new Date();
      const from = new Date(); from.setDate(from.getDate() - 89);
      document.getElementById('billingTo').value = to.toISOString().slice(0, 10);
      document.getElementById('billingFrom').value = from.toISOString().slice(0, 10);
    })();
    loadOperators();

    // Socket.io — atualiza guias e lotes quando houver mudanças (outra aba/usuário)
    (function() {
      const _d = JSON.parse(localStorage.getItem('doctorData') || '{}');
      if (!_d.id) return;
      const _sock = io({ transports: ['websocket', 'polling'] });
      _sock.on('connect', () => {
        _sock.emit('join_doctor', _d.id);
        if (_d.clinicId) _sock.emit('join_clinic', _d.clinicId);
      });
      ['insurance_claim_created', 'insurance_claim_updated', 'insurance_batch_reconciled'].forEach((evt) => {
        _sock.on(evt, () => { loadedTabs.forEach((tab) => tabLoaders[tab]?.()); });
      });
    })();
        </script>

        <script src="/socket.io/socket.io.js"></script>
      </body>
    </html>
