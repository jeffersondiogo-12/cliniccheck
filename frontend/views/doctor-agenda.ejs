<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Clinic Chek · Agenda</title>
  <link rel="icon" type="image/svg+xml" href="/public/brand/clinic-check-favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/main.min.css" />

  <style>
    /* ============================================================
       TEMA CLARO / ESCURO — MESMO SISTEMA DA TELA DE REFERÊNCIA
       ============================================================ */
    :root {
      --bg-base: #edf2f7;
      --bg-surface: #f7fafc;
      --bg-card: #ffffff;
      --bg-card-hover: #f0f5ff;
      --bg-elevated: #eef2f7;
      --bg-input: #ffffff;
      --border-subtle: #e2e8f0;
      --border-card: #e2e8f0;
      --text-primary: #2d3748;
      --text-secondary: #4a5568;
      --text-muted: #718096;
      --accent-1: #4a90d9;
      --accent-1-dim: #e8f0fe;
      --accent-2: #6bc5b8;
      --accent-2-dim: #e6f7f2;
      --accent-3: #b794f4;
      --accent-3-dim: #f0e8ff;
      --accent-4: #f6ad55;
      --accent-4-dim: #fef5e7;
      --accent-5: #6fcf97;
      --accent-5-dim: #eafaf1;
      --red: #e53e3e;
      --red-bg: #fff5f5;
      --shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
      --shadow-hover: 0 8px 30px rgba(0, 0, 0, 0.10);
      --radius: 12px;
      --font: 'Inter', system-ui, -apple-system, sans-serif;
      --sidebar-width: 280px;
      --sidebar-collapsed: 72px;
      --transition: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    [data-theme="dark"] {
      --bg-base: #0b1120;
      --bg-surface: #111c2e;
      --bg-card: #162033;
      --bg-card-hover: #1c2a42;
      --bg-elevated: #1e2d45;
      --bg-input: #111c2e;
      --border-subtle: rgba(255, 255, 255, 0.06);
      --border-card: rgba(255, 255, 255, 0.07);
      --text-primary: #f0f4ff;
      --text-secondary: #b0c4e8;
      --text-muted: #7a8aa8;
      --accent-1: #3b82f6;
      --accent-1-dim: rgba(59, 130, 246, 0.15);
      --accent-2: #06b6d4;
      --accent-2-dim: rgba(6, 182, 212, 0.12);
      --accent-3: #8b5cf6;
      --accent-3-dim: rgba(139, 92, 246, 0.12);
      --accent-4: #f59e0b;
      --accent-4-dim: rgba(245, 158, 11, 0.12);
      --accent-5: #10b981;
      --accent-5-dim: rgba(16, 185, 129, 0.12);
      --red: #f87171;
      --red-bg: rgba(239, 68, 68, 0.08);
      --shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
      --shadow-hover: 0 12px 40px rgba(0, 0, 0, 0.45);
    }

    /* ============================================================
       RESET E BASE
       ============================================================ */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: var(--font);
      background: var(--bg-base);
      color: var(--text-primary);
      display: flex;
      min-height: 100vh;
      transition: background var(--transition), color var(--transition);
    }

    /* ============================================================
       SIDEBAR (copiada da referência com ajustes)
       ============================================================ */
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--sidebar-width);
      background: var(--bg-surface);
      border-right: 1px solid var(--border-subtle);
      color: var(--text-primary);
      font-family: var(--font);
      z-index: 1000;
      display: flex;
      flex-direction: column;
      transition: width var(--transition), transform var(--transition), background var(--transition);
      box-shadow: var(--shadow);
      overflow: hidden;
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
    }

    .sidebar.collapsed {
      width: var(--sidebar-collapsed);
    }
    .sidebar.collapsed .sb-brand-title,
    .sidebar.collapsed .sidebar-user,
    .sidebar.collapsed .sb-group-btn span:not(.caret),
    .sidebar.collapsed .nav-item span,
    .sidebar.collapsed .sidebar-footer .btn-logout span,
    .sidebar.collapsed .sb-toggle-label {
      opacity: 0;
      pointer-events: none;
      width: 0;
      overflow: hidden;
      transition: opacity 0.2s;
    }
    .sidebar.collapsed .sb-brand-icon {
      margin-right: 0;
    }
    .sidebar.collapsed .nav-item {
      justify-content: center;
      padding: 10px !important;
    }
    .sidebar.collapsed .nav-item i {
      margin-right: 0;
      font-size: 18px;
    }
    .sidebar.collapsed .sb-group-btn {
      justify-content: center;
      padding: 6px 0;
    }
    .sidebar.collapsed .sb-group-btn .caret {
      display: none;
    }
    .sidebar.collapsed .sidebar-footer .btn-logout {
      justify-content: center;
      padding: 10px !important;
    }
    .sidebar.collapsed .sidebar-footer .btn-logout i {
      margin-right: 0;
    }

    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 999;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .sidebar-overlay.active {
      opacity: 1;
    }

    /* HEADER / BRAND */
    .sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 20px 14px;
      border-bottom: 1px solid var(--border-subtle);
      flex-shrink: 0;
    }
    .sb-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      overflow: hidden;
    }
    .sb-brand-icon {
      width: 38px;
      height: 38px;
      background: linear-gradient(135deg, var(--accent-1), #06b6d4);
      border-radius: var(--radius);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 18px;
      flex-shrink: 0;
      transition: transform 0.3s ease;
    }
    .sb-brand-icon:hover {
      transform: rotate(-8deg) scale(1.05);
    }
    .sb-brand-title {
      display: flex;
      flex-direction: column;
      white-space: nowrap;
      overflow: hidden;
      transition: opacity 0.2s;
    }
    .sb-brand-title h2 {
      font-size: 17px;
      font-weight: 700;
      color: var(--text-primary);
      letter-spacing: -0.3px;
      background: linear-gradient(135deg, var(--text-primary) 60%, var(--accent-1));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .sb-brand-title small {
      font-size: 10px;
      color: var(--text-muted);
      font-weight: 400;
      -webkit-text-fill-color: var(--text-muted);
    }

    .sb-toggle-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 18px;
      cursor: pointer;
      padding: 6px 8px;
      border-radius: 8px;
      transition: background 0.2s, transform 0.3s;
      flex-shrink: 0;
    }
    .sb-toggle-btn:hover {
      background: var(--bg-elevated);
      color: var(--text-primary);
    }
    .sb-toggle-btn:active {
      transform: scale(0.9);
    }

    /* USER CARD */
    .sidebar-user {
      margin: 12px 16px 8px;
      padding: 14px 16px;
      background: var(--bg-elevated);
      border-radius: var(--radius);
      border: 1px solid var(--border-subtle);
      transition: background 0.3s, opacity 0.2s;
      flex-shrink: 0;
    }
    .sidebar-user .name {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
    }
    .sidebar-user .role {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 2px;
    }
    .sidebar-user .clinic {
      font-size: 11px;
      color: var(--accent-1);
      margin-top: 4px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .sidebar-user .clinic i {
      font-size: 10px;
    }

    /* NAVEGAÇÃO */
    .sidebar-nav {
      flex: 1;
      padding: 8px 12px 8px;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--border-subtle) transparent;
    }
    .sidebar-nav::-webkit-scrollbar {
      width: 4px;
    }
    .sidebar-nav::-webkit-scrollbar-thumb {
      background: var(--border-subtle);
      border-radius: 10px;
    }

    .sb-group {
      margin-top: 4px;
    }
    .sb-group + .sb-group {
      margin-top: 6px;
      padding-top: 8px;
      border-top: 1px solid var(--border-subtle);
    }

    .sb-group-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: transparent;
      border: 0;
      color: var(--text-muted);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      padding: 6px 10px;
      cursor: pointer;
      font-family: var(--font);
      border-radius: 6px;
      transition: color 0.25s, background 0.25s;
    }
    .sb-group-btn:hover {
      color: var(--accent-1);
      background: var(--accent-1-dim);
    }
    .sb-group-btn .caret {
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      font-size: 9px;
    }
    .sb-group.open .sb-group-btn .caret {
      transform: rotate(90deg);
      color: var(--accent-1);
    }

    .sb-group-list {
      display: flex;
      flex-direction: column;
      gap: 2px;
      overflow: hidden;
      max-height: 0;
      opacity: 0;
      transform: translateY(-6px);
      transition: max-height 0.4s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.3s ease,
        transform 0.3s ease;
      pointer-events: none;
    }
    .sb-group.open .sb-group-list {
      max-height: 600px;
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 9px 12px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none;
      transition: background 0.2s, color 0.2s, transform 0.15s, padding 0.2s;
      position: relative;
      background: transparent;
      border: none;
      cursor: pointer;
      width: 100%;
      text-align: left;
      font-family: var(--font);
      overflow: hidden;
    }
    .nav-item i {
      width: 20px;
      font-size: 15px;
      color: var(--text-muted);
      flex-shrink: 0;
      transition: color 0.2s, transform 0.3s;
    }
    .nav-item span {
      white-space: nowrap;
      overflow: hidden;
      transition: opacity 0.2s;
    }

    .nav-item::before {
      content: '';
      position: absolute;
      left: 0;
      top: 6px;
      bottom: 6px;
      width: 3px;
      border-radius: 0 4px 4px 0;
      background: var(--accent-1);
      transform: scaleY(0);
      transform-origin: center;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .nav-item:hover {
      background: var(--accent-1-dim);
      color: var(--text-primary);
      transform: translateX(3px);
    }
    .nav-item:hover i {
      color: var(--accent-1);
      transform: scale(1.1) rotate(-4deg);
    }
    .nav-item:hover::before {
      transform: scaleY(0.5);
    }

    .nav-item.active {
      background: var(--accent-1-dim);
      color: var(--text-primary);
      font-weight: 600;
      box-shadow: inset 3px 0 0 var(--accent-1);
    }
    .nav-item.active::before {
      transform: scaleY(1);
    }
    .nav-item.active i {
      color: var(--accent-1);
    }
    .nav-item:active {
      transform: scale(0.97);
    }
    .nav-item[hidden] {
      display: none !important;
    }

    /* FOOTER — TEMA E LOGOUT */
    .sidebar-footer {
      padding: 12px 16px 16px;
      border-top: 1px solid var(--border-subtle);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .theme-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 6px 10px;
      border-radius: 8px;
      background: var(--bg-elevated);
      border: 1px solid var(--border-subtle);
      transition: background 0.3s;
    }
    .theme-toggle .sb-toggle-label {
      font-size: 12px;
      font-weight: 500;
      color: var(--text-muted);
      transition: opacity 0.2s;
    }
    .theme-toggle .toggle-switch {
      position: relative;
      width: 40px;
      height: 22px;
      background: var(--border-subtle);
      border-radius: 12px;
      cursor: pointer;
      transition: background 0.3s;
      flex-shrink: 0;
    }
    .theme-toggle .toggle-switch .slider {
      position: absolute;
      top: 2px;
      left: 2px;
      width: 18px;
      height: 18px;
      background: #fff;
      border-radius: 50%;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }
    [data-theme="dark"] .theme-toggle .toggle-switch {
      background: var(--accent-1);
    }
    [data-theme="dark"] .theme-toggle .toggle-switch .slider {
      transform: translateX(18px);
      background: #fff;
    }

    .btn-logout {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      width: 100%;
      border: none;
      border-radius: 8px;
      background: rgba(239, 68, 68, 0.08);
      color: #ef4444;
      font-size: 13px;
      font-weight: 500;
      font-family: var(--font);
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
    }
    .btn-logout i {
      font-size: 15px;
    }
    .btn-logout span {
      transition: opacity 0.2s;
    }
    .btn-logout:hover {
      background: rgba(239, 68, 68, 0.16);
    }
    .btn-logout:active {
      transform: scale(0.97);
    }

    /* RESPONSIVIDADE SIDEBAR */
    @media (max-width: 992px) {
      .sidebar {
        transform: translateX(-100%);
        width: var(--sidebar-width);
        border-right: none;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.2);
      }
      .sidebar.open {
        transform: translateX(0);
      }
      .sidebar-overlay {
        display: block;
      }
      .sidebar-overlay.active {
        display: block;
      }
      .sidebar.collapsed {
        width: var(--sidebar-width);
      }
      .sidebar.collapsed .sb-brand-title,
      .sidebar.collapsed .sidebar-user,
      .sidebar.collapsed .sb-group-btn span:not(.caret),
      .sidebar.collapsed .nav-item span,
      .sidebar.collapsed .sidebar-footer .btn-logout span,
      .sidebar.collapsed .sb-toggle-label {
        opacity: 1;
        pointer-events: auto;
        width: auto;
        overflow: visible;
      }
      .sidebar.collapsed .nav-item {
        justify-content: flex-start;
        padding: 9px 12px !important;
      }
      .sidebar.collapsed .nav-item i {
        font-size: 15px;
        margin-right: 0;
      }
      .sidebar.collapsed .sb-group-btn {
        justify-content: space-between;
        padding: 6px 10px;
      }
      .sidebar.collapsed .sb-group-btn .caret {
        display: inline;
      }
      .sidebar.collapsed .sidebar-footer .btn-logout {
        justify-content: flex-start;
        padding: 10px 14px !important;
      }
      .sidebar.collapsed .sidebar-footer .btn-logout i {
        margin-right: 0;
      }
    }

    @media (max-width: 480px) {
      .sidebar {
        width: 100%;
        max-width: 320px;
      }
      .sb-brand-title h2 {
        font-size: 15px;
      }
    }

    /* ============================================================
       MAIN / TOPBAR / CONTENT (mesmo estilo da referência)
       ============================================================ */
    .main {
      margin-left: var(--sidebar-width);
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      background: var(--bg-base);
      transition: background var(--transition), margin-left var(--transition);
    }

    .topbar {
      padding: 16px 32px;
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 40;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition: background var(--transition), border-color var(--transition);
    }
    .topbar h1 {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.3px;
      color: var(--text-primary);
      transition: color var(--transition);
    }
    .topbar .meta {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
      transition: color var(--transition);
    }
    .topbar-actions {
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .topbar-actions .badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--text-secondary);
      background: var(--bg-elevated);
      padding: 4px 14px 4px 10px;
      border-radius: 20px;
      border: 1px solid var(--border-subtle);
      transition: background var(--transition), border-color var(--transition), color var(--transition);
    }
    .topbar-actions .badge i {
      color: var(--accent-5);
      font-size: 10px;
      transition: color var(--transition);
    }

    .content {
      padding: 24px 32px 40px;
      flex: 1;
    }

    /* ============================================================
       CARDS E BOTÕES (da referência)
       ============================================================ */
    .card {
      background: var(--bg-card);
      border-radius: var(--radius);
      border: 1px solid var(--border-card);
      overflow: hidden;
      margin-bottom: 20px;
      box-shadow: var(--shadow);
      transition: background var(--transition), border-color var(--transition), box-shadow var(--transition), transform 0.25s ease;
    }
    .card:hover {
      box-shadow: var(--shadow-hover);
      transform: translateY(-4px) scale(1.002);
      border-color: var(--accent-1);
    }
    .card-header {
      padding: 16px 22px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: rgba(255, 255, 255, 0.02);
      transition: border-color var(--transition), background var(--transition);
    }
    .card-header h3 {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 8px;
      transition: color var(--transition);
    }
    .card-header h3 i {
      color: var(--accent-1);
      font-size: 16px;
      transition: color var(--transition);
    }
    .card-body {
      padding: 20px 22px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      border: none;
      border-radius: var(--radius);
      font-size: 12px;
      font-weight: 600;
      font-family: var(--font);
      cursor: pointer;
      transition: background var(--transition), color var(--transition), border-color var(--transition), box-shadow var(--transition), transform 0.2s ease;
      text-decoration: none;
      text-transform: none;
      letter-spacing: 0.2px;
      position: relative;
      overflow: hidden;
    }
    .btn::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255, 255, 255, 0.15), transparent 60%);
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
    }
    .btn:hover::after {
      opacity: 1;
    }
    .btn i {
      font-size: 14px;
    }
    .btn-solid {
      background: var(--accent-1);
      color: #fff;
      box-shadow: 0 4px 16px rgba(74, 144, 217, 0.3);
    }
    .btn-solid:hover {
      background: #3b7ec8;
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 6px 24px rgba(74, 144, 217, 0.4);
    }
    .btn-outline {
      background: transparent;
      color: var(--text-secondary);
      border: 1px solid var(--border-card);
    }
    .btn-outline:hover {
      border-color: var(--accent-1);
      background: var(--accent-1-dim);
      color: var(--text-primary);
      transform: translateY(-2px) scale(1.02);
    }
    .btn-sm {
      padding: 5px 14px;
      font-size: 11px;
    }
    .btn-red {
      background: var(--red-bg);
      color: var(--red);
      border: 1px solid rgba(229, 62, 62, 0.15);
    }
    .btn-red:hover {
      background: rgba(229, 62, 62, 0.12);
      transform: translateY(-2px) scale(1.02);
    }
    .btn-gcal {
      background: #4285F4;
      color: #fff;
      border: none;
    }
    .btn-gcal:hover {
      background: #3367D6;
      transform: translateY(-2px) scale(1.02);
    }

    .search-input {
      padding: 8px 14px;
      border: 1px solid var(--border-card);
      border-radius: var(--radius);
      font-size: 13px;
      font-family: var(--font);
      background: var(--bg-input);
      color: var(--text-primary);
      outline: none;
      min-width: 200px;
      transition: background var(--transition), border-color var(--transition), color var(--transition), box-shadow var(--transition), transform 0.2s ease;
    }
    .search-input:focus {
      border-color: var(--accent-1);
      box-shadow: 0 0 0 3px var(--accent-1-dim);
      transform: scale(1.01);
    }
    .search-input::placeholder {
      color: var(--text-muted);
      transition: color var(--transition);
    }

    /* TABELA */
    .table-wrap {
      overflow-x: auto;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    thead th {
      padding: 10px 14px;
      text-align: left;
      font-size: 10px;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid var(--border-subtle);
      background: rgba(255, 255, 255, 0.02);
      transition: color var(--transition), border-color var(--transition), background var(--transition);
    }
    tbody tr {
      border-bottom: 1px solid var(--border-subtle);
      transition: background 0.2s ease, border-color var(--transition), transform 0.15s ease;
    }
    tbody tr:last-child {
      border-bottom: none;
    }
    tbody tr:hover {
      background: var(--bg-card-hover);
      transform: scale(1.002);
    }
    tbody td {
      padding: 11px 14px;
      color: var(--text-secondary);
      vertical-align: middle;
      transition: color var(--transition);
    }
    tbody td strong {
      color: var(--text-primary);
      font-weight: 500;
      transition: color var(--transition);
    }

    /* BADGES */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 12px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: 600;
      gap: 4px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      transition: background var(--transition), color var(--transition), transform 0.2s ease;
    }
    .badge:hover {
      transform: scale(1.06);
    }
    .badge-green {
      background: var(--accent-5-dim);
      color: var(--accent-5);
    }
    .badge-gray {
      background: var(--bg-elevated);
      color: var(--text-muted);
    }
    .badge-orange {
      background: var(--accent-4-dim);
      color: var(--accent-4);
    }

    /* ALERTAS */
    .alert-banner {
      padding: 12px 16px;
      border-radius: var(--radius);
      font-size: 13px;
      margin-bottom: 16px;
      display: none;
      font-weight: 500;
      transition: background var(--transition), color var(--transition), border-color var(--transition), transform 0.2s ease;
    }
    .alert-banner.show {
      display: block;
      animation: fadeUp 0.3s ease;
    }
    .alert-ok {
      background: var(--accent-5-dim);
      color: var(--accent-5);
      border-left: 3px solid var(--accent-5);
    }
    .alert-err {
      background: var(--red-bg);
      color: var(--red);
      border-left: 3px solid var(--red);
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ============================================================
       COMPONENTES ESPECÍFICOS DA AGENDA (adaptados)
       ============================================================ */
    .gcal-box {
      background: var(--bg-card);
      border-radius: var(--radius);
      border: 1px solid var(--border-card);
      padding: 18px 22px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      box-shadow: var(--shadow);
      transition: background var(--transition), border-color var(--transition), box-shadow var(--transition), transform 0.25s ease;
    }
    .gcal-box:hover {
      box-shadow: var(--shadow-hover);
      transform: translateY(-3px);
      border-color: var(--accent-2);
    }
    .gcal-box .gcal-info h4 {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 4px;
      transition: color var(--transition);
    }
    .gcal-box .gcal-info p {
      font-size: 12px;
      color: var(--text-muted);
      transition: color var(--transition);
    }
    .gcal-box .gcal-icon {
      width: 44px;
      height: 44px;
      background: var(--bg-elevated);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border-subtle);
      flex-shrink: 0;
      transition: background var(--transition), border-color var(--transition);
    }
    .gcal-box .gcal-icon svg {
      width: 24px;
      height: 24px;
      fill: #4285F4;
    }
    .gcal-status-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      transition: background var(--transition), color var(--transition);
    }
    .status-connected {
      background: var(--accent-5-dim);
      color: var(--accent-5);
    }
    .status-disconnected {
      background: var(--bg-elevated);
      color: var(--text-muted);
    }

    /* FULLCALENDAR — ajustes de tema */
    .fc {
      --fc-border-color: var(--border-subtle);
      --fc-button-bg-color: var(--accent-1);
      --fc-button-hover-bg-color: #3b7ec8;
      --fc-button-active-bg-color: #2e6ab0;
      --fc-button-text-color: #fff;
      --fc-today-bg-color: var(--accent-1-dim);
      --fc-neutral-bg-color: var(--bg-surface);
      --fc-page-bg-color: var(--bg-card);
      --fc-event-bg-color: var(--accent-1);
      --fc-event-text-color: #fff;
      font-family: var(--font);
    }
    .fc-daygrid-day {
      transition: background 0.2s;
    }
    .fc-daygrid-day:hover {
      background: var(--bg-card-hover);
    }
    .fc .fc-button-primary {
      background: var(--accent-1);
      border: none;
      font-weight: 500;
    }
    .fc .fc-button-primary:hover {
      background: #3b7ec8;
    }
    .fc .fc-button-primary:focus {
      box-shadow: 0 0 0 3px var(--accent-1-dim);
    }
    .fc .fc-toolbar-title {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--text-primary);
    }

    /* RESPONSIVO GERAL */
    @media (max-width: 992px) {
      .main {
        margin-left: 0;
      }
      .topbar {
        padding: 12px 18px;
        flex-wrap: wrap;
        gap: 8px;
      }
      .topbar h1 {
        font-size: 18px;
      }
      .content {
        padding: 16px;
      }
      .gcal-box {
        flex-direction: column;
        align-items: stretch;
      }
      .search-input {
        min-width: 120px;
      }
    }

    @media (max-width: 640px) {
      .card-body {
        padding: 14px;
      }
      .table-wrap table {
        min-width: 500px;
      }
    }
  </style>
</head>
