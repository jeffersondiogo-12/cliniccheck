  <script>
    (function() {
      // ============================================================
      // SIDEBAR — TOGGLE, TEMA, LOGOUT (mesmo código da referência)
      // ============================================================
      const sidebar = document.querySelector('.sidebar');
      const toggleBtn = document.getElementById('sidebarToggleBtn');
      const overlay = document.getElementById('sidebarOverlay');
      let isCollapsed = false;

      const savedCollapse = localStorage.getItem('sidebarCollapsed');
      if (savedCollapse === 'true') {
        sidebar.classList.add('collapsed');
        isCollapsed = true;
      }

      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (window.innerWidth <= 992) {
          sidebar.classList.toggle('open');
          overlay.classList.toggle('active');
          document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
        } else {
          isCollapsed = !isCollapsed;
          sidebar.classList.toggle('collapsed', isCollapsed);
          localStorage.setItem('sidebarCollapsed', String(isCollapsed));
        }
      });

      overlay.addEventListener('click', function() {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      });

      window.addEventListener('resize', function() {
        if (window.innerWidth > 992) {
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        }
      });

      // TEMA
      const themeToggle = document.getElementById('themeToggle');
      const currentTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', currentTheme);

      themeToggle.addEventListener('click', function() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const newTheme = isDark ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      });

      // LOGOUT
      document.getElementById('logoutBtn').addEventListener('click', function() {
        localStorage.removeItem('doctorToken'); localStorage.removeItem('doctorData');
        localStorage.removeItem('receptionToken'); localStorage.removeItem('receptionData');
        window.location.href = isReceptionSession ? '/recepcao/login' : '/medico/login';
      });

      // ============================================================
      // DADOS DO USUÁRIO E PERMISSÕES (simplificado)
      // ============================================================
      const doctorToken = localStorage.getItem('doctorToken');
      const receptionToken = localStorage.getItem('receptionToken');
      const token = doctorToken || receptionToken;
      const isReceptionSession = !doctorToken && !!receptionToken;
      const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');
      if (!token) { window.location.href = '/medico/login'; }

      const nameEl = document.getElementById('sidebarName');
      const roleEl = document.getElementById('sidebarRole');
      const clinicEl = document.getElementById('sidebarClinic');
      if (nameEl) nameEl.textContent = doctorData.name || 'Profissional';
      if (roleEl) roleEl.textContent = isReceptionSession ? 'Recepcionista' : (doctorData.isClinicOwner ? 'Owner da Clínica' : 'Profissional');
      if (clinicEl) clinicEl.textContent = 'Clínica: ' + (doctorData.clinicName || '--');

      const headers = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };

      // ============================================================
      // PERMISSÕES — esconde da sidebar as páginas que este usuário
      // não pode ver (os itens já nascem com "hidden" no HTML pra não
      // aparecer nem um instante antes desta checagem terminar).
      // ============================================================
      document.querySelectorAll('#sidebarNav .nav-item[data-page]').forEach((item) => {
        item.hidden = true;
      });
      fetch(isReceptionSession ? '/api/auth/permissions-receptionist' : '/api/auth/permissions', { headers })
        .then((r) => r.ok ? r.json() : null)
        .then((data) => {
          if (!data || !Array.isArray(data.pages)) return;
          const allowed = new Set((data.pages || []).filter((p) => p.can_view).map((p) => p.code));
          document.querySelectorAll('#sidebarNav .nav-item[data-page]').forEach((item) => {
            const rawCodes = item.getAttribute('data-page-codes') || item.getAttribute('data-page') || '';
            const pageCodes = rawCodes.split(',').map((code) => code.trim()).filter(Boolean);
            if (!pageCodes.length) { item.hidden = false; return; }
            const canSee = pageCodes.some((code) => allowed.has(code));
            item.hidden = !canSee;
          });
          document.querySelectorAll('.sb-group').forEach((g) => {
            const hasVisible = Array.from(g.querySelectorAll('.nav-item')).some((i) => !i.hidden);
            g.style.display = hasVisible ? '' : 'none';
          });
        })
        .catch(() => {});

      // Verifica se é admin para exibir "Equipe"
      fetch('/api/auth/me', { headers })
        .then(r => r.ok ? r.json() : null)
        .then(me => {
          if (me && (me.role === 'ADMIN' || me.isAdmin)) {
            const navTeam = document.getElementById('navTeamItem');
            if (navTeam) navTeam.style.display = '';
          }
        })
        .catch(() => {});

      // ============================================================
      // LÓGICA DA AGENDA
      // ============================================================
      let allAgendaItems = [];
      let calendar = null;

      function initCalendar() {
        if (calendar) return;
        const el = document.getElementById('agendaCalendar');
        if (!el || typeof FullCalendar === 'undefined') return;
        calendar = new FullCalendar.Calendar(el, {
          initialView: 'dayGridMonth',
          locale: 'pt-br',
          height: 'auto',
          headerToolbar: {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek',
          },
          buttonText: {
            today: 'Hoje',
            month: 'Mês',
            week: 'Semana',
            day: 'Dia',
            list: 'Lista',
          },
          eventTimeFormat: { hour: '2-digit', minute: '2-digit', hour12: false },
        });
        calendar.render();
      }

      function syncCalendarEvents(items) {
        if (!calendar) return;
        calendar.removeAllEvents();
        items.forEach((i) => {
          const dur = Number(i.duration_min || 30);
          const start = new Date(i.consultation_at);
          const end = new Date(start.getTime() + dur * 60 * 1000);
          calendar.addEvent({
            id: String(i.id),
            title: `${i.patient_name || 'Paciente'} - ${i.summary || 'Consulta'}`,
            start,
            end,
            color: i.google_event_id ? '#1a8f85' : '#0f4c81',
            extendedProps: {
              doctorName: i.doctor_name,
              hasGoogle: Boolean(i.google_event_id),
            },
          });
        });
      }

      function renderAgendaList(items) {
        const tbody = document.getElementById('agendaList');
        if (!items.length) {
          tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:28px;color:var(--text-muted);font-size:11px">Nenhuma consulta encontrada</td></tr>`;
          return;
        }
        tbody.innerHTML = items.map(i => {
          const dt = new Date(i.consultation_at);
          const dtStr = dt.toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
          const gcalCell = i.google_event_id
            ? '<span style="font-size:10px;color:var(--accent-5);font-weight:600;"><i class="fas fa-check-circle"></i> No Google Agenda</span>'
            : `<a href="${i.google_calendar_link}" target="_blank" class="btn btn-outline btn-sm"><i class="fas fa-plus"></i> Adicionar</a>`;
          const teleCell = i.modality === 'TELECONSULTA'
            ? `<a href="/medico/teleconsulta/${i.id}" class="btn btn-outline btn-sm"><i class="fas fa-video"></i> Entrar</a>`
            : `<button type="button" class="btn btn-outline btn-sm" onclick="habilitarTeleconsulta('${i.id}', this)"><i class="fas fa-video"></i> Habilitar</button>`;
          return `<tr>
            <td style="font-weight:500;">${dtStr}</td>
            <td>${i.patient_name || '-'}</td>
            <td>${i.summary || '-'}</td>
            <td style="color:var(--text-muted)">${i.duration_min ? i.duration_min + ' min' : '-'}</td>
            <td>${gcalCell}</td>
            <td>${teleCell}</td>
          </tr>`;
        }).join('');
      }

      async function habilitarTeleconsulta(consultationId, btnEl) {
        if (btnEl) { btnEl.disabled = true; btnEl.textContent = 'Habilitando…'; }
        try {
          const res = await fetch(`/api/teleconsultation/consultations/${consultationId}/enable`, { method: 'POST', headers });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'Não foi possível habilitar a teleconsulta.');
          window.location.href = `/medico/teleconsulta/${consultationId}`;
        } catch (err) {
          alert(err.message);
          if (btnEl) { btnEl.disabled = false; btnEl.innerHTML = '<i class="fas fa-video"></i> Habilitar'; }
        }
      }

      function applyAgendaSearch() {
        const q = (document.getElementById('agendaSearch').value || '').trim().toLowerCase();
        if (!q) {
          renderAgendaList(allAgendaItems);
          return;
        }
        const filtered = allAgendaItems.filter((i) => {
          const dt = i.consultation_at ? new Date(i.consultation_at).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
          return (i.patient_name || '').toLowerCase().includes(q)
            || (i.summary || '').toLowerCase().includes(q)
            || dt.toLowerCase().includes(q);
        });
        renderAgendaList(filtered);
      }

      // ============================================================
      // SOLICITAÇÕES DE AGENDAMENTO (portfólio público)
      // ============================================================
      function formatRequestDate(isoDate, time) {
        const label = new Date(`${isoDate}T12:00:00-03:00`).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' });
        return `${label} às ${time}`;
      }

      function renderBookingRequests(items) {
        const tbody = document.getElementById('bookingRequestsList');
        const card = document.getElementById('bookingRequestsCard');
        const countBadge = document.getElementById('bookingRequestsCount');
        if (!items.length) {
          card.style.display = 'none';
          return;
        }
        card.style.display = '';
        const pendingCount = items.filter((i) => i.status === 'pending').length;
        if (pendingCount > 0) {
          countBadge.textContent = `${pendingCount} pendente${pendingCount > 1 ? 's' : ''}`;
          countBadge.style.display = '';
        } else {
          countBadge.style.display = 'none';
        }
        tbody.innerHTML = items.map((item) => {
          const isoDate = String(item.requested_date).slice(0, 10);
          const statusBadge = item.status === 'confirmed'
            ? '<span class="badge badge-green">Confirmado no Google</span>'
            : '<span class="badge badge-orange">Pendente</span>';
          const actions = item.status === 'pending'
            ? `<button class="btn btn-outline btn-sm" onclick="confirmBookingRequest('${item.id}')"><i class="fas fa-sync"></i> Tentar de novo</button>
               <button class="btn btn-red btn-sm" onclick="cancelBookingRequest('${item.id}')"><i class="fas fa-times"></i> Cancelar</button>`
            : `<button class="btn btn-red btn-sm" onclick="cancelBookingRequest('${item.id}')"><i class="fas fa-times"></i> Cancelar</button>`;
          return `<tr>
            <td>${formatRequestDate(isoDate, item.requested_time)}</td>
            <td>${(item.patient_name || '').replace(/[<>]/g, '')}</td>
            <td>${(item.patient_phone || '—').replace(/[<>]/g, '')}</td>
            <td>${statusBadge}</td>
            <td style="display:flex;gap:6px;flex-wrap:wrap;">${actions}</td>
          </tr>`;
        }).join('');
      }

      async function loadBookingRequests() {
        try {
          const res = await fetch('/api/portfolio/me/booking-requests', { headers });
          if (!res.ok) return;
          const items = await res.json();
          renderBookingRequests(items);
        } catch {}
      }

      async function confirmBookingRequest(id) {
        try {
          const res = await fetch(`/api/portfolio/me/booking-requests/${id}/confirm`, { method: 'POST', headers });
          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            alert(err.error || 'Não foi possível confirmar essa solicitação.');
          }
        } catch {
          alert('Erro de conexão ao confirmar.');
        }
        loadBookingRequests();
        loadAgenda();
      }

      async function cancelBookingRequest(id) {
        if (!confirm('Cancelar esse agendamento? Ele será removido do Google Calendar e o horário volta a ficar disponível pra outros pacientes.')) return;
        try {
          const res = await fetch(`/api/portfolio/me/booking-requests/${id}/cancel`, { method: 'POST', headers });
          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            alert(err.error || 'Não foi possível cancelar essa solicitação.');
          }
        } catch {
          alert('Erro de conexão ao cancelar.');
        }
        loadBookingRequests();
        loadAgenda();
      }

      window.confirmBookingRequest = confirmBookingRequest;
      window.cancelBookingRequest = cancelBookingRequest;

      async function loadAgenda() {
        const tbody = document.getElementById('agendaList');
        tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:20px;color:var(--text-muted);font-size:11px">Carregando agenda...</td></tr>`;
        try {
          const res = await fetch('/api/reception/agenda', { headers });
          if (!res.ok) throw new Error();
          allAgendaItems = await res.json();
          initCalendar();
          syncCalendarEvents(allAgendaItems);
          applyAgendaSearch();
        } catch {
          tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:20px;color:var(--red);font-size:11px">Erro ao carregar agenda</td></tr>`;
        }
      }

      document.getElementById('agendaSearch').addEventListener('input', applyAgendaSearch);

      // ============================================================
      // GOOGLE CALENDAR STATUS
      // ============================================================
      async function checkGcalStatus() {
        try {
          const res = await fetch('/api/auth/google/status', { headers });
          if (!res.ok) { showDisconnected(); return; }
          const data = await res.json();
          if (data.connected) {
            document.getElementById('gcalBadge').textContent = 'Conectado';
            document.getElementById('gcalBadge').className = 'gcal-status-badge status-connected';
            document.getElementById('gcalStatusText').textContent = 'Integração ativa. Consultas são adicionadas automaticamente ao Google Calendar.';
            document.getElementById('gcalConnectBtn').style.display = 'none';
            document.getElementById('gcalDisconnectBtn').style.display = '';
          } else if (data.setupRequired) {
            showDisconnected();
            const err = document.getElementById('bannerErr');
            err.textContent = data.error || 'Google Calendar não está pronto no banco. Rode a migration de schema.';
            err.style.display = 'block';
          } else {
            showDisconnected();
          }
        } catch { showDisconnected(); }
      }

      function showDisconnected() {
        document.getElementById('gcalBadge').textContent = 'Desconectado';
        document.getElementById('gcalBadge').className = 'gcal-status-badge status-disconnected';
        document.getElementById('gcalStatusText').textContent = 'Conecte sua conta Google para adicionar consultas automaticamente ao Google Calendar.';
        document.getElementById('gcalConnectBtn').style.display = '';
        document.getElementById('gcalDisconnectBtn').style.display = 'none';
      }

      async function connectGoogle() {
        try {
          const res = await fetch('/api/auth/google/authorize', { headers });
          if (!res.ok) {
            let msg = 'Erro ao obter URL de autorização do Google Calendar.';
            try { const err = await res.json(); if (err?.error) msg = err.error; } catch {}
            alert(msg);
            return;
          }
          const data = await res.json();
          window.location.href = data.url;
        } catch { alert('Erro de conexão.'); }
      }

      async function disconnectGoogle() {
        if (!confirm('Desconectar Google Calendar? Os eventos já criados não serão removidos.')) return;
        try {
          const res = await fetch('/api/auth/google/disconnect', { method: 'POST', headers });
          if (res.ok) { showDisconnected(); }
        } catch {}
      }

      window.connectGoogle = connectGoogle;
      window.disconnectGoogle = disconnectGoogle;
      window.loadAgenda = loadAgenda;

      // ============================================================
      // TRATAMENTO DE PARÂMETROS OAUTH
      // ============================================================
      (function handleOAuthParams() {
        const params = new URLSearchParams(location.search);
        const bannerOk = document.getElementById('bannerOk');
        const bannerErr = document.getElementById('bannerErr');

        if (params.get('gcal') === 'connected') {
          bannerOk.textContent = 'Google Calendar conectado com sucesso! As consultas serão adicionadas automaticamente.';
          bannerOk.style.display = 'block';
          history.replaceState({}, '', '/medico/agenda');
        } else if (params.get('gcal') === 'denied') {
          bannerErr.textContent = 'Autorização negada pelo Google. Clique em "Conectar Google Calendar" para tentar novamente.';
          bannerErr.style.display = 'block';
          history.replaceState({}, '', '/medico/agenda');
        } else if (params.get('gcal') === 'invalid-grant') {
          bannerErr.textContent = 'Google retornou invalid_grant. Verifique a Redirect URI no Google Cloud e gere nova autorização.';
          bannerErr.style.display = 'block';
          history.replaceState({}, '', '/medico/agenda');
        } else if (params.get('gcal') === 'schema') {
          bannerErr.textContent = 'Banco sem colunas do Google Calendar. Execute o supabase/schema.sql atualizado e tente novamente.';
          bannerErr.style.display = 'block';
          history.replaceState({}, '', '/medico/agenda');
        }
      })();

      // ============================================================
      // SOCKET.IO — ATUALIZAÇÕES EM TEMPO REAL
      // ============================================================
      (function setupSocket() {
        const docId = doctorData.id;
        if (!docId) return;
        const socket = io({ transports: ['websocket', 'polling'] });
        socket.on('connect', () => socket.emit('join_doctor', docId));
        socket.on('consultation_created', () => loadAgenda());
        socket.on('agenda_updated', () => loadAgenda());
        socket.on('booking_request_created', () => loadBookingRequests());
        socket.on('booking_request_updated', () => loadBookingRequests());
      })();

      // ============================================================
      // INICIALIZAÇÃO
      // ============================================================
      checkGcalStatus();
      loadBookingRequests();
      loadAgenda();
    })();
  </script>
</body>
</html>