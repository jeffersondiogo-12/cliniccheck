    function populatePatientSelects() {
      ['sPatientsSelect', 'surgeriesFilter'].forEach(id => {
        const sel = document.getElementById(id);
        const curVal = sel.value;
        sel.innerHTML = id === 'surgeriesFilter' ? '<option value="">Todos os pacientes</option>' : '<option value="">Selecione o paciente</option>';
        allPatients.forEach(p => { const o = document.createElement('option'); o.value = p.id; o.textContent = p.name; sel.appendChild(o); });
        if (curVal) sel.value = curVal;
      });

      const selectedPatientId = document.getElementById('sPatientsSelect').value;
      if (selectedPatientId) {
        loadMedicalRecordsByPatientDashboard(selectedPatientId);
      }
    }

    async function loadMedicalRecordsByPatientDashboard(patientId) {
      const recordSelect = document.getElementById('sMedicalRecordSelect');
      if (!recordSelect) return;

      if (!patientId) {
        recordSelect.innerHTML = '<option value="">Selecione um paciente para listar prontuários</option>';
        return;
      }

      recordSelect.innerHTML = '<option value="">Carregando prontuários...</option>';
      try {
        const res = await fetch(`/api/patients/${patientId}/medical-records`, { headers });
        const records = res.ok ? await res.json() : [];
        if (!Array.isArray(records) || records.length === 0) {
          recordSelect.innerHTML = '<option value="">Nenhum prontuário disponível</option>';
          return;
        }
        recordSelect.innerHTML = '<option value="">Selecione o prontuário</option>';
        records.forEach((record) => {
          const option = document.createElement('option');
          option.value = record.id;
          option.textContent = `${record.title || 'Prontuário'}${record.is_primary ? ' (principal)' : ''}`;
          recordSelect.appendChild(option);
        });
      } catch {
        recordSelect.innerHTML = '<option value="">Erro ao carregar prontuários</option>';
      }
    }

    function populateSurgerySelects() {
      const sel = document.getElementById('dSurgerySelect');
      sel.innerHTML = '<option value="">Selecione o procedimento</option>';
      allSurgeries
        .filter(s => s.status === 'DRAFT' || s.status === 'scheduled')
        .forEach(s => {
        const o = document.createElement('option');
        o.value = s.id;
        o.textContent = `${s.patient_name||'Paciente'} — ${s.title||'Procedimento'} (${s.procedure_type||''})`;
        sel.appendChild(o);
      });
      // Stats
      const pending = allSurgeries.filter(s => s.status !== 'cancelled' && s.document_status && s.document_status !== 'SIGNED').length;
      const signed = allSurgeries.filter(s => s.document_status === 'SIGNED').length;
      document.getElementById('statPending').textContent = pending;
      document.getElementById('statSigned').textContent = signed;
      updateDoctorPulse();
    }

    function updateDoctorPulse() {
      const pending = Number(document.getElementById('statPending').textContent) || 0;
      const signed = Number(document.getElementById('statSigned').textContent) || 0;
      const total = pending + signed;
      const pct = total ? Math.round((signed / total) * 100) : 0;

      const pctEl = document.getElementById('doctorPulsePct');
      const barEl = document.getElementById('doctorPulseBar');
      const timeEl = document.getElementById('doctorPulseTime');
      if (pctEl) pctEl.textContent = `${pct}%`;
      if (barEl) barEl.style.width = `${pct}%`;
      if (timeEl) {
        timeEl.textContent = new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
      }
    }

    function populateTemplateSelects() {
      const sel = document.getElementById('dTemplateSelect');
      sel.innerHTML = '<option value="">Selecione o modelo</option>';
      allTemplates.forEach(t => {
        const o = document.createElement('option'); o.value = t.id;
        o.textContent = `${t.name}${t.procedure_type ? ' (' + t.procedure_type + ')' : ''}`;
        sel.appendChild(o);
      });
    }

