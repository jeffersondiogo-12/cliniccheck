              <div class="cam-box">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
                  <span style="font-weight:600; font-size:13px; color:var(--text-secondary);"><i class="fas fa-camera"></i> Foto de Cadastro (Biometria)</span>
                  <span style="font-size:12px;color:var(--text-muted);">Usada na verificação de assinatura</span>
                </div>
                <div id="camStatus" style="font-size:13px;color:var(--text-muted);margin-bottom:8px;">Sem foto capturada</div>
                <video id="camVideo" class="cam-video" autoplay playsinline muted style="display:none"></video>
                <canvas id="camCanvas" style="display:none"></canvas>
                <img id="camPreview" class="cam-preview" alt="Foto do paciente" style="display:none">
                <div class="cam-actions">
                  <button type="button" class="btn btn-outline btn-sm" id="camStartBtn"><i class="fas fa-video"></i> Abrir câmera</button>
                  <button type="button" class="btn btn-solid btn-sm" id="camCaptureBtn" style="display:none"><i class="fas fa-camera"></i> Capturar</button>
                  <button type="button" class="btn btn-outline btn-sm" id="camRetakeBtn" style="display:none"><i class="fas fa-redo"></i> Refazer</button>
                </div>
              </div>

              <div style="margin-top:18px;display:flex;gap:12px;flex-wrap:wrap;">
                <button type="submit" class="btn btn-solid" id="patientSubmitBtn"><i class="fas fa-save"></i> Cadastrar Paciente</button>
                <button type="button" class="btn btn-outline" onclick="goSection('patients-history')">Ir para Histórico</button>
              </div>
              <div class="alert-msg alert-ok" id="patientOk"></div>
