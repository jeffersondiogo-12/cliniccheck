      const err = document.getElementById('docErr');
      const linkArea = document.getElementById('docLinkArea');
      ok.style.display = 'none'; err.style.display = 'none'; linkArea.style.display = 'none';
      btn.disabled = true; btn.innerHTML = '<span class="spin"></span>Gerando...';
      try {
        const res = await fetch('/api/documents/generate', {
          method: 'POST', headers,
          body: JSON.stringify({
            surgeryId: document.getElementById('dSurgerySelect').value,
            templateId: document.getElementById('dTemplateSelect').value || undefined,
            title: document.getElementById('dTitle').value.trim() || 'Termo de Consentimento Informado',
          })
        });
        const data = await res.json();
        if (res.ok && data.accessToken) {
          const link = `${window.location.origin}/paciente/assinar/${data.accessToken}`;
          document.getElementById('docLink').textContent = link;
          linkArea.style.display = 'block';
          ok.textContent = 'Documento gerado! Copie o link e envie ao paciente.';
          ok.style.display = 'block';
          await loadSurgeries();
          await loadDocuments();
        } else {
          err.textContent = data.error || 'Erro ao gerar documento.';
          err.style.display = 'block';
        }
      } catch {
        err.textContent = 'Erro de conexão.';
        err.style.display = 'block';
      }
      btn.disabled = false; btn.innerHTML = '<i class="fas fa-file-pdf"></i> Gerar PDF + DOCX + Link';
    });

    document.getElementById('copyLinkBtn').addEventListener('click', () => {
      navigator.clipboard.writeText(document.getElementById('docLink').textContent).then(() => {
        document.getElementById('copyLinkBtn').textContent = '✓ Copiado!';
        setTimeout(() => { document.getElementById('copyLinkBtn').innerHTML = '<i class="fas fa-copy"></i> Copiar Link'; }, 2500);
      });
    });

    async function loadDocuments(statusFilter = '') {
      try {
        const res = await fetch('/api/surgeries', { headers });
        if (!res.ok) return;
        const surgeries = await res.json();
        const tbody = document.getElementById('documentsList');
        const q = (document.getElementById('documentsHistorySearch')?.value || '').trim().toLowerCase();
        let list = surgeries.filter(s => {
          const hasDocumentContext = s.document_status || s.access_token || s.surgery_document_id;
          if (!hasDocumentContext) return false;
          const isSigned = String(s.document_status || '').toUpperCase() === 'SIGNED';
          return isSigned || s.status !== 'cancelled';
        });
        if (statusFilter === 'SIGNED') {
          list = list.filter(s => s.document_status === 'SIGNED');
        } else if (statusFilter) {
          list = list.filter(s => s.status === statusFilter);
        }
        if (q) {
          list = list.filter((s) =>
            String(s.patient_name || '').toLowerCase().includes(q)
            || String(s.title || '').toLowerCase().includes(q)
            || String(s.status || '').toLowerCase().includes(q)
            || String(s.document_status || '').toLowerCase().includes(q)
          );
        }

        if (!list.length) { tbody.innerHTML = `<tr><td colspan="4" style="text-align:center;padding:28px;color:var(--text-muted);font-size:11px">Nenhum documento encontrado</td></tr>`; return; }
        tbody.innerHTML = list.map(s => {
          const badge = docStatusBadge(s.document_status);
          const surgeryBadge = statusBadge(s.status);
          const legal = legalEvidenceBadge(s.document_evidence);
          const notes = evidenceInline(s.document_evidence);
          const actions = s.access_token && s.status !== 'cancelled'
            ? `<div style="display:flex;gap:6px;flex-wrap:wrap">
                <a href="/paciente/assinar/${s.access_token}" target="_blank" class="btn btn-outline btn-sm">Abrir</a>
                <a href="/api/documents/${s.surgery_document_id}/download/pdf" class="btn btn-outline btn-sm" title="Baixar PDF"><i class="fas fa-file-pdf"></i> PDF</a>
                <a href="/api/documents/${s.surgery_document_id}/download/docx" class="btn btn-outline btn-sm" title="Baixar DOCX"><i class="fas fa-file-word"></i> DOCX</a>
               </div>`
            : '—';
          return `<tr><td>${s.patient_name||'—'}</td><td>${s.title||'—'}</td><td><div class="stacked-badges">${surgeryBadge}${badge}${legal}</div>${notes}</td><td>${actions}</td></tr>`;
        }).join('');
      } catch {}
    }

    async function loadDoctorAgenda() {
      const tbody = document.getElementById('doctorAgendaList');
      if (!tbody) return;
      tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:20px;color:var(--text-muted);font-size:11px">Carregando agenda...</td></tr>';
      const formatAgendaDateTime = (value) => {
        if (!value) return '—';
        return new Date(value).toLocaleString('pt-BR', {
          dateStyle:'short',
          timeStyle:'short',
          timeZone: 'America/Sao_Paulo',
        });
      };
      try {
        const res = await fetch('/api/reception/agenda', { headers });
        if (!res.ok) throw new Error();
        const q = (document.getElementById('doctorAgendaSearch')?.value || '').trim().toLowerCase();
        const rawItems = await res.json();
        const items = q
          ? rawItems.filter((i) => {
            const dt = formatAgendaDateTime(i.consultation_at).toLowerCase();
            return String(i.patient_name || '').toLowerCase().includes(q)
              || String(i.summary || '').toLowerCase().includes(q)
              || dt.includes(q);
          })
          : rawItems;
        if (!items.length) {
          tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:20px;color:var(--text-muted);font-size:11px">Nenhuma consulta encontrada</td></tr>';
          return;
        }
        tbody.innerHTML = items.map(i => `
          <tr>
            <td style="color:var(--text-muted)">${formatAgendaDateTime(i.consultation_at)}</td>
            <td>${i.patient_name || '—'}</td>
            <td>${i.summary || '—'}</td>
            <td><a href="${i.google_calendar_link}" target="_blank" class="btn btn-outline btn-sm">Adicionar</a></td>
          </tr>
        `).join('');
      } catch {
        tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:20px;color:var(--red);font-size:11px">Erro ao carregar agenda</td></tr>';
      }
    }

    // ── HELPERS ──
    function fmtDate(d) {
      if (!d) return '—';
      return new Date(d).toLocaleDateString('pt-BR', { day:'2-digit', month:'2-digit', year:'numeric' });
    }
    function statusBadge(s) {
      const map = { DRAFT:'badge-gray', scheduled:'badge-blue', completed:'badge-green', cancelled:'badge-red', SIGNED:'badge-green', AWAITING_SIGNATURE:'badge-yellow' };
      const labels = { DRAFT:'Rascunho', scheduled:'Agendado', completed:'Concluído', cancelled:'Cancelado', SIGNED:'Assinado', AWAITING_SIGNATURE:'Aguard. Assinatura' };
      return `<span class="badge ${map[s]||'badge-gray'}">${labels[s]||s||'—'}</span>`;
    }
    function docStatusBadge(s) {
      const map = { PENDING_SIGNATURE:'badge-yellow', SIGNED:'badge-green' };
      const labels = { PENDING_SIGNATURE:'Pendente', SIGNED:'Assinado' };
      return `<span class="badge ${map[s]||'badge-gray'}">${labels[s]||s||'—'}</span>`;
    }
    function legalEvidenceBadge(evidence) {
      if (!evidence) return '';
      const map = {
        QUALIFIED: 'badge-green',
        AUTHENTICATED: 'badge-teal',
        QUALIFIED_REQUIRED: 'badge-yellow',
        PENDING: 'badge-yellow',
        SIGNED: 'badge-blue',
      };
      return `<span class="badge ${map[evidence.legalStatus] || 'badge-blue'}">${evidence.legalLabel}</span>`;
    }
    function evidenceInline(evidence) {
      if (!evidence) return '';
      const tags = [];
      if (evidence.biometrics?.completed) tags.push('<span class="inline-tag">Biometria</span>');
      if (evidence.auditTrail?.completed) tags.push('<span class="inline-tag">Auditoria</span>');
      if (evidence.timestamp?.completed) tags.push('<span class="inline-tag">TSA</span>');
      if (evidence.qualifiedSignature?.required) tags.push(`<span class="inline-tag">${evidence.qualifiedSignature.completed ? 'ICP-Brasil ok' : 'ICP-Brasil obrigatório'}</span>`);
      const refs = [];
      if (evidence.qualifiedSignature?.ref) {
        refs.push(`<div class="table-note"><strong>Protocolo ICP-Brasil:</strong> ${evidence.qualifiedSignature.ref}</div>`);
      }
      if (evidence.timestamp?.at) {
        const tsDate = new Date(evidence.timestamp.at).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'medium' });
        const tsProv = evidence.timestamp.provider ? ` via ${evidence.timestamp.provider}` : '';
        refs.push(`<div class="table-note"><strong>Carimbo de tempo:</strong> ${tsDate}${tsProv}</div>`);
      }
      return `<div class="inline-tags">${tags.join('')}</div><div class="table-note">${evidence.procedureClassification?.reason || evidence.qualifiedSignature?.reason || 'Resumo jurídico indisponível.'}</div>${refs.join('')}`;
    }

    // ── INIT ──
    (async () => {
      await loadDoctorProfile();
      const initialSection = new URLSearchParams(window.location.search).get('section') || 'dashboard';
      goSection(initialSection);
      await Promise.all([loadPatients(), loadSurgeries(), loadTemplates()]);
      loadDocuments(document.getElementById('documentsFilter').value || '');
      loadDoctorAgenda();
      initCertificatePanel();
    })();
  </script>

  <!-- ========== MODAL CERTIFICADO DIGITAL ========== -->
  <div class="cert-modal-overlay" id="certModalOverlay">
    <div class="cert-modal">
      <div class="cert-modal-head">
        <h3>Selecionar Certificado Digital</h3>
        <button class="cert-modal-close" onclick="closeCertModal()">&times;</button>
      </div>
      <div class="cert-modal-body">
        <div id="certExtBanner" class="cert-ext-banner" style="display:none;">
          Para usar certificados instalados no computador (A1/A3/token USB), instale a
          <a href="https://www.lacunasoftware.com/web-pki/" target="_blank" rel="noopener">extensão Lacuna Web PKI</a>
          no seu navegador (Chrome, Edge ou Firefox). É gratuita.
          <br><br>
          Enquanto isso, use o upload manual de arquivo (.pfx) abaixo.
        </div>
        <ul class="cert-list" id="certList"></ul>
        <div id="certListLoading" style="text-align:center;padding:24px;color:var(--text-muted);font-size:13px;">Carregando certificados...</div>
        <div class="cert-upload-area" id="certUploadArea" style="display:none">
          <label>Ou envie o arquivo do certificado (.pfx / .p12):</label>
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <input type="file" id="certFileInput" accept=".pfx,.p12" style="font-size:13px;flex:1;">
            <input type="password" id="certFilePassword" placeholder="Senha (se houver)" style="width:140px;padding:6px 12px;border:1px solid var(--border-card);border-radius:var(--radius);font-size:13px;font-family:var(--font);background:var(--bg-base);color:var(--text-primary);">
          </div>
          <button class="btn btn-outline btn-sm" style="margin-top:10px;" onclick="readUploadedCert()">Ler Certificado</button>
          <div id="certUploadMsg" style="font-size:13px;margin-top:8px;"></div>
        </div>
        <div style="display:flex;gap:8px;margin-top:20px;justify-content:flex-end;">
          <button class="btn btn-outline btn-sm" onclick="closeCertModal()">Cancelar</button>
          <button class="btn btn-teal btn-sm" id="certConfirmBtn" disabled onclick="confirmCertSelection()">Usar este certificado</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Lacuna Web PKI (CDN gratuito) -->
  <script src="https://cdn.lacunasoftware.com/libs/web-pki/lacuna-web-pki-2.16.1.min.js"></script>
  <script>
  // ═══════════════════════════════════════════════════════════════
  // CERTIFICADO DIGITAL — Web PKI + fallback upload
  // ═══════════════════════════════════════════════════════════════
  const CERT_STORAGE_KEY = 'clinica_doctor_cert';
  let selectedCertThumbprint = null;
  let selectedCertData = null;
  let pki = null;
  let webPkiAvailable = false;

  // Carrega/lê o certificado salvo (localStorage → DB)
  async function initCertificatePanel() {
    const bar = document.getElementById('certBar');
    if (!bar) return;

    // Tenta recuperar do DB
    try {
      const res = await fetch('/api/certificates/me', { headers });
      if (res.ok) {
        const data = await res.json();
        if (data.connected && data.certificate?.providerType === 'WEBPKI_LOCAL') {
          const exp = data.certificate.tokenExpiresAt;
          const isExpired = exp && new Date(exp) < new Date();
          renderCertBar({
            commonName: data.certificate.providerAccountId || 'Certificado Configurado',
            expiresAt: exp,
            expired: isExpired,
          });
          // Salva no localStorage para uso offline/rápido
          localStorage.setItem(CERT_STORAGE_KEY, JSON.stringify({
            commonName: data.certificate.providerAccountId,
            expiresAt: exp,
            providerSubject: data.certificate.providerSubject,
          }));
          return;
        }
      }
    } catch (_) {}

    // Fallback localStorage
    const stored = localStorage.getItem(CERT_STORAGE_KEY);
    if (stored) {
      try {
        const c = JSON.parse(stored);
        if (c.expiresAt && new Date(c.expiresAt) > new Date()) {
          renderCertBar({ commonName: c.commonName, expiresAt: c.expiresAt, expired: false });
          return;
        }
      } catch (_) {}
    }

    renderCertBar(null);
  }

  function renderCertBar(cert) {
    const bar = document.getElementById('certBar');
    if (!bar) return;
    if (!cert) {
      bar.className = 'cert-bar is-none';
      bar.innerHTML = `
        <div class="cert-icon"><i class="fas fa-shield-alt"></i></div>
        <div class="cert-info">
          <div class="cert-name">Nenhum certificado digital configurado</div>
          <div class="cert-meta">Configure uma vez e o sistema usará automaticamente ao gerar documentos.</div>
        </div>
        <div class="cert-actions">
          <button class="btn btn-teal btn-sm" onclick="openCertModal()">
            <i class="fas fa-certificate"></i> Configurar Certificado
          </button>
        </div>`;
      return;
    }
    const expDate = cert.expiresAt ? new Date(cert.expiresAt) : null;
    const daysLeft = expDate ? Math.floor((expDate - Date.now()) / 86400000) : null;
    const isWarn = cert.expired || (daysLeft !== null && daysLeft < 30);
    bar.className = `cert-bar ${cert.expired ? 'is-warn' : 'is-ok'}`;
    bar.innerHTML = `
      <div class="cert-icon"><i class="fas fa-shield-alt"></i></div>
      <div class="cert-info">
        <div class="cert-name">${escHtml(cert.commonName || 'Certificado Digital')}</div>
        <div class="cert-meta">${cert.expired ? '⚠ Certificado vencido — configure um novo.' : (daysLeft !== null ? `Válido por mais ${daysLeft} dia(s)` : 'Ativo')}</div>
      </div>
      <div class="cert-actions">
        <button class="btn btn-outline btn-sm" onclick="openCertModal()">Alterar</button>
        <button class="btn btn-outline btn-sm" style="color:var(--red);border-color:var(--red);" onclick="removeCert()">Remover</button>
      </div>`;
  }

  function escHtml(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // Abre modal e tenta listar certificados via Web PKI
  async function openCertModal() {
    document.getElementById('certModalOverlay').classList.add('open');
    document.getElementById('certConfirmBtn').disabled = true;
    document.getElementById('certList').innerHTML = '';
    document.getElementById('certListLoading').style.display = 'block';
    document.getElementById('certExtBanner').style.display = 'none';
    document.getElementById('certUploadArea').style.display = 'none';
    selectedCertThumbprint = null;
    selectedCertData = null;

    // Inicializa Web PKI
    try {
      if (!pki) {
        pki = new LacunaWebPKI();
      }
      await new Promise((resolve, reject) => {
        pki.init({
          ready: resolve,
          notInstalled: () => reject(new Error('NOT_INSTALLED')),
        });
      });
      webPkiAvailable = true;
      await listWebPkiCerts();
    } catch (e) {
      webPkiAvailable = false;
      document.getElementById('certListLoading').style.display = 'none';
      document.getElementById('certExtBanner').style.display = 'block';
      document.getElementById('certUploadArea').style.display = 'block';
    }
  }

  function closeCertModal() {
    document.getElementById('certModalOverlay').classList.remove('open');
  }

  async function listWebPkiCerts() {
    try {
      const certs = await new Promise((resolve, reject) => {
        pki.listCertificates({
          success: resolve,
          error: reject,
        });
      });

      document.getElementById('certListLoading').style.display = 'none';
      document.getElementById('certUploadArea').style.display = 'block';

      const list = document.getElementById('certList');
      if (!certs || !certs.length) {
        list.innerHTML = '<li style="text-align:center;padding:16px;color:var(--text-muted);font-size:11px;">Nenhum certificado encontrado no computador.</li>';
        return;
      }

      list.innerHTML = certs.map(c => {
        const exp = c.validityEnd ? new Date(c.validityEnd) : null;
        const daysLeft = exp ? Math.floor((exp - Date.now()) / 86400000) : null;
        const expClass = daysLeft === null ? '' : (daysLeft < 0 ? 'warn' : daysLeft < 30 ? 'warn' : 'ok');
        const expText = daysLeft === null ? '' : (daysLeft < 0 ? `Vencido em ${exp.toLocaleDateString('pt-BR')}` : `Válido até ${exp.toLocaleDateString('pt-BR')}`);
        return `<li class="cert-list-item" data-thumbprint="${escHtml(c.thumbprint)}" onclick="selectCert(this, ${escHtml(JSON.stringify(c))})">
          <div class="cn">${escHtml(c.subjectName || c.commonName || 'Desconhecido')}</div>
          <div class="issuer">${escHtml(c.issuerName || c.issuer || '')}</div>
          ${expText ? `<div class="expiry ${expClass}">${expText}</div>` : ''}
        </li>`;
      }).join('');
    } catch (e) {
      document.getElementById('certListLoading').textContent = 'Erro ao listar certificados: ' + (e.message || e);
    }
  }

  function selectCert(el, certData) {
    document.querySelectorAll('.cert-list-item').forEach(i => i.classList.remove('selected'));
    el.classList.add('selected');
    selectedCertThumbprint = el.dataset.thumbprint;
    selectedCertData = certData;
    document.getElementById('certConfirmBtn').disabled = false;
  }

  async function confirmCertSelection() {
    if (!selectedCertThumbprint && !selectedCertData) return;
    const btn = document.getElementById('certConfirmBtn');
    btn.disabled = true;
    btn.textContent = 'Salvando...';

    const certInfo = selectedCertData || {};
    const commonName = certInfo.subjectName || certInfo.commonName || 'Certificado Digital';
    const expiresAt = certInfo.validityEnd || null;

    try {
      const res = await fetch('/api/certificates/webpki/save', {
        method: 'POST',
        headers,
        body: JSON.stringify({
          thumbprint: selectedCertThumbprint,
          commonName,
          expiresAt,
          subjectDn: certInfo.subjectName || certInfo.dn || null,
        }),
      });
      if (!res.ok) throw new Error('Erro ao salvar');

      localStorage.setItem(CERT_STORAGE_KEY, JSON.stringify({ commonName, expiresAt }));
      closeCertModal();
      renderCertBar({ commonName, expiresAt, expired: false });
    } catch (e) {
      alert('Erro ao salvar certificado: ' + e.message);
    }
    btn.disabled = false;
    btn.textContent = 'Usar este certificado';
  }

  // Leitura via upload de arquivo .pfx (mobile / sem extensão)
  async function readUploadedCert() {
    const fileInput = document.getElementById('certFileInput');
    const password = document.getElementById('certFilePassword').value;
    const msg = document.getElementById('certUploadMsg');

    if (!fileInput.files || !fileInput.files[0]) {
      msg.textContent = 'Selecione um arquivo .pfx ou .p12.';
      msg.style.color = 'var(--red)';
      return;
    }

    msg.textContent = 'Lendo certificado...';
    msg.style.color = 'var(--text-muted)';

    const formData = new FormData();
    formData.append('certificate', fileInput.files[0]);
    if (password) formData.append('password', password);

    try {
      const authHeader = headers['Authorization'];
      const res = await fetch('/api/certificates/read', {
        method: 'POST',
        headers: { 'Authorization': authHeader },
        body: formData,
      });
      const data = await res.json();
      if (!res.ok || !data.valid) {
        msg.textContent = data.error || 'Não foi possível ler o certificado.';
        msg.style.color = 'var(--red)';
        return;
      }

      // Usa commonName do subject como "thumbprint" simulado para upload
      const thumbprint = `UPLOAD_${Date.now()}`;
      selectedCertThumbprint = thumbprint;
      selectedCertData = {
        subjectName: data.subject.commonName,
        issuerName: data.issuer.commonName,
        validityEnd: data.validity.notAfter,
        thumbprint,
        _fromUpload: true,
      };

      // Mostra como item selecionado
      const exp = new Date(data.validity.notAfter);
      const daysLeft = Math.floor((exp - Date.now()) / 86400000);
      const list = document.getElementById('certList');
      const existing = list.querySelector('[data-thumbprint="' + thumbprint + '"]');
      if (!existing) {
        const li = document.createElement('li');
        li.className = 'cert-list-item selected';
        li.dataset.thumbprint = thumbprint;
        li.innerHTML = `<div class="cn">${escHtml(data.subject.commonName || 'Certificado')}</div>
          <div class="issuer">${escHtml(data.issuer.commonName || '')}</div>
          <div class="expiry ${daysLeft < 0 ? 'warn' : 'ok'}">Válido até ${exp.toLocaleDateString('pt-BR')}</div>`;
        list.appendChild(li);
      }

      document.getElementById('certConfirmBtn').disabled = false;
      msg.textContent = `Certificado lido: ${data.subject.commonName || 'OK'}`;
      msg.style.color = 'var(--accent-5)';
    } catch (e) {
      msg.textContent = 'Erro de conexão.';
      msg.style.color = 'var(--red)';
    }
  }

  async function removeCert() {
    if (!confirm('Remover o certificado digital configurado?')) return;
    await fetch('/api/certificates/webpki/remove', { method: 'DELETE', headers });
    localStorage.removeItem(CERT_STORAGE_KEY);
    renderCertBar(null);
  }

  // Fecha modal ao clicar fora
  document.getElementById('certModalOverlay').addEventListener('click', e => {
    if (e.target === e.currentTarget) closeCertModal();
  });
  </script>

  <!-- socket.io - atualizações em tempo real -->
  <script src="/socket.io/socket.io.js"></script>
  <script>
  (function(){
    const _tok = localStorage.getItem('doctorToken');
    const _doc = JSON.parse(localStorage.getItem('doctorData')||'{}');
    if (!_tok || !_doc.id) return;
    const _sock = io({ transports: ['websocket','polling'] });
    _sock.on('connect', () => _sock.emit('join_doctor', _doc.id));

    const reloadProcedures = () => {
      if (typeof loadSurgeries === 'function') loadSurgeries();
      if (typeof loadDocuments === 'function') loadDocuments(document.getElementById('documentsFilter')?.value || '');
    };
    const reloadPatients = () => { if (typeof loadPatients === 'function') loadPatients(); };
    const reloadTemplates = () => { if (typeof loadTemplates === 'function') loadTemplates(); };
    const reloadAgenda = () => { if (typeof loadDoctorAgenda === 'function') loadDoctorAgenda(); };
    const reloadTeam = () => { if (typeof loadTeamData === 'function') loadTeamData(); };

    _sock.on('procedure_created', reloadProcedures);
    _sock.on('procedure_updated', reloadProcedures);
    _sock.on('procedure_type_created', reloadProcedures);
    _sock.on('procedure_type_updated', reloadProcedures);
    _sock.on('procedure_type_deleted', reloadProcedures);

    _sock.on('patient_created', reloadPatients);
    _sock.on('patient_updated', reloadPatients);

    _sock.on('template_created', reloadTemplates);
    _sock.on('template_updated', reloadTemplates);
    _sock.on('template_deleted', reloadTemplates);

    _sock.on('document_generated', reloadProcedures);
    _sock.on('document_signed', reloadProcedures);

    _sock.on('consultation_created', reloadAgenda);
    _sock.on('agenda_updated', reloadAgenda);

    _sock.on('clinic_member_added', reloadTeam);
    _sock.on('clinic_member_role_updated', reloadTeam);
    _sock.on('clinic_member_removed', reloadTeam);
  })();
  </script>
