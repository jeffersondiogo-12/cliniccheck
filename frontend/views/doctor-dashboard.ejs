    async function editPatient(id) {
      const p = allPatients.find(item => String(item.id) === String(id));
      if (!p) return;

      const name = prompt('Nome do paciente:', p.name || '');
      if (name === null) return;
      const email = prompt('E-mail:', p.email || '');
      if (email === null) return;
      const phone = prompt('Telefone:', p.phone || '');
      if (phone === null) return;
      const birthDate = prompt('Data de nascimento (YYYY-MM-DD):', p.birth_date ? String(p.birth_date).slice(0, 10) : '');
      if (birthDate === null) return;
      const documentId = prompt('CPF/RG:', p.document_id || '');
      if (documentId === null) return;
      const address = prompt('Endereço:', p.address || '');
      if (address === null) return;

      try {
        const res = await fetch(`/api/patients/${id}`, {
          method: 'PUT',
          headers,
          body: JSON.stringify({
            name: name.trim(),
            email: email.trim(),
            phone: phone.trim(),
            birthDate: birthDate.trim(),
            documentId: documentId.trim(),
            address: address.trim(),
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Erro ao atualizar paciente');
        await loadPatients();
      } catch (e) {
        alert(e.message || 'Erro ao atualizar paciente.');
      }
    }

    async function editSurgery(id) {
      const s = allSurgeries.find(item => String(item.id) === String(id));
      if (!s) return;

      const title = prompt('Nome/descrição do procedimento:', s.title || '');
      if (title === null) return;
      const procedureType = prompt('Tipo do procedimento:', s.procedure_type || '');
      if (procedureType === null) return;
      const dateValue = prompt('Data (YYYY-MM-DD):', s.scheduled_at ? String(s.scheduled_at).slice(0, 10) : '');
      if (dateValue === null) return;
      const status = prompt('Status (DRAFT, scheduled, completed, cancelled):', s.status || 'DRAFT');
      if (status === null) return;
      const notes = prompt('Observações:', s.notes || '');
      if (notes === null) return;

      try {
        const res = await fetch(`/api/surgeries/${id}`, {
          method: 'PUT',
          headers,
          body: JSON.stringify({
            title: title.trim(),
            procedureType: procedureType.trim(),
            scheduledAt: dateValue.trim(),
            status: status.trim(),
            notes: notes.trim(),
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Erro ao atualizar procedimento');
        await loadSurgeries();
        await loadDocuments(document.getElementById('documentsFilter').value || '');
      } catch (e) {
        alert(e.message || 'Erro ao atualizar procedimento.');
      }
    }

