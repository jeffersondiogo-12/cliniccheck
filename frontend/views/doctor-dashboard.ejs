  <!-- ============================================================
  SCRIPTS (INTEGRALMENTE MANTIDOS)
  ============================================================ -->
  <script>
    // ============================================================
    // INICIALIZAÇÃO DO TEMA (sincroniza com a sidebar)
    // ============================================================
    (function initTheme() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();

    // ============================================================
    // CÓDIGO ORIGINAL (mantido intacto)
    // ============================================================
    const doctorToken = localStorage.getItem('doctorToken');
    const receptionToken = localStorage.getItem('receptionToken');
    const token = doctorToken || receptionToken;
    const isReceptionSession = !doctorToken && !!receptionToken;
    const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');
    if (!token) { window.location.href = '/medico/login'; }
    if (doctorData.name) document.getElementById('sidebarName').textContent = doctorData.name;

    const headers = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };

    let allPatients = [];
    let allSurgeries = [];
    let allTemplates = [];
    let isAdminDoctor = false;

    // ── NAVEGAÇÃO ──
    const sectionMeta = {
      dashboard: ['Dashboard', 'Visão geral do sistema'],
      team: ['Equipe', 'Cadastro de medicos e recepcionistas'],
      patients: ['Cadastro de Paciente', 'Cadastrar novo paciente'],
      'patients-history': ['Histórico de Pacientes', 'Lista de cadastros com edição'],
      procedures: ['Cadastro de Procedimento', 'Cadastrar novo procedimento'],
      'procedures-history': ['Histórico de Procedimentos', 'Lista de procedimentos com edição'],
      'template-editor': ['Editor de Modelos', 'Criar e editar modelos de documentos'],
      documents: ['Gerar Documento', 'Gerar documento para assinatura'],
      'documents-history': ['Histórico de Documentos', 'Rascunhos, agendados, finalizados e assinados'],
      agenda: ['Agenda', 'Consultas marcadas e atalhos para Google Agenda'],
    };

    document.querySelectorAll('.nav-item[data-section]').forEach(btn => {
      btn.addEventListener('click', () => goSection(btn.dataset.section));
    });

    function goSection(s) {
      if (s === 'team' && !isAdminDoctor) {
        s = 'dashboard';
      }
      document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
      document.querySelector(`.nav-item[data-section="${s}"]`)?.classList.add('active');
      document.querySelectorAll('.section').forEach(sec => sec.classList.remove('active'));
      document.getElementById(`sec-${s}`)?.classList.add('active');
      const [title, meta] = sectionMeta[s] || [s, ''];
      document.getElementById('topbarTitle').textContent = title;
      document.getElementById('topbarMeta').textContent = meta;
      const nextUrl = new URL(window.location.href);
      nextUrl.searchParams.set('section', s);
      window.history.replaceState({}, '', nextUrl.toString());

      if (s === 'team' && isAdminDoctor) {
        loadTeamData();
      }
    }

    document.getElementById('logoutBtn').addEventListener('click', () => {
      localStorage.removeItem('doctorToken'); localStorage.removeItem('doctorData');
        localStorage.removeItem('receptionToken'); localStorage.removeItem('receptionData');
        window.location.href = isReceptionSession ? '/recepcao/login' : '/medico/login';
    });

    // ── LOAD DATA ──
    async function loadPatients() {
      try {
        const res = await fetch('/api/patients', { headers });
        if (!res.ok) throw new Error();
        allPatients = await res.json();
        renderPatientsList();
        populatePatientSelects();
        document.getElementById('statPatients').textContent = allPatients.length;
        const tbody = document.getElementById('dashPatientsList');
        const recent = allPatients.slice(-5).reverse();
        if (!recent.length) { tbody.innerHTML = `<tr><td colspan="4" style="text-align:center;padding:18px;color:var(--text-muted);font-size:11px">Nenhum paciente</td></tr>`; renderDashboardInsights(); return; }
        tbody.innerHTML = recent.map(p => `<tr><td>${p.name}</td><td style="color:var(--text-muted)">${p.email}</td><td style="color:var(--text-muted)">${fmtDate(p.created_at)}</td><td><a class="btn btn-outline btn-sm" href="/medico/pacientes/${p.id}">Perfil</a></td></tr>`).join('');
        renderDashboardInsights();
        updateDoctorPulse();
      } catch { document.getElementById('statPatients').textContent = '—'; }
    }

    async function loadSurgeries() {
      try {
        const res = await fetch('/api/surgeries', { headers });
        if (!res.ok) throw new Error();
        allSurgeries = await res.json();
        renderSurgeriesList('');
        populateSurgerySelects();
        document.getElementById('statSurgeries').textContent = allSurgeries.length;
        const tbody = document.getElementById('dashSurgeriesList');
        const recent = allSurgeries.slice(-5).reverse();
        if (!recent.length) { tbody.innerHTML = `<tr><td colspan="3" style="text-align:center;padding:18px;color:var(--text-muted);font-size:11px">Nenhum procedimento</td></tr>`; renderDashboardInsights(); return; }
        tbody.innerHTML = recent.map(s => `<tr><td>${s.patient_name||'—'}</td><td>${s.title||'—'}</td><td><span class="badge badge-gray">${s.procedure_type||'—'}</span></td></tr>`).join('');
        renderDashboardInsights();
        updateDoctorPulse();
      } catch { document.getElementById('statSurgeries').textContent = '—'; }
    }

    function renderDashboardInsights() {
      const lgpdPending = allPatients.filter((p) => !p.lgpd_consent_version || !p.lgpd_consent_at);
      const missingRecord = allSurgeries.filter((s) => s.status !== 'cancelled' && !s.medical_record_id);

      const lgpdCountEl = document.getElementById('lgpdPendingCount');
      const lgpdListEl = document.getElementById('lgpdPendingList');
      const mrCountEl = document.getElementById('mrPendingCount');
      const mrListEl = document.getElementById('recordPendingList');
      if (!lgpdCountEl || !lgpdListEl || !mrCountEl || !mrListEl) return;

      lgpdCountEl.textContent = String(lgpdPending.length);
      mrCountEl.textContent = String(missingRecord.length);

      lgpdListEl.innerHTML = lgpdPending.length
        ? lgpdPending.slice(0, 8).map((p) => `<div class="insight-item"><div class="name">${p.name || 'Paciente'}</div><div class="meta">${p.email || 'Sem e-mail'} · LGPD pendente</div><div class="actions"><a class="btn btn-outline btn-sm" href="/medico/pacientes/${p.id}">Abrir Perfil</a></div></div>`).join('')
        : '<div style="font-size:11px;color:var(--text-muted);">Nenhuma pendência de LGPD.</div>';

      mrListEl.innerHTML = missingRecord.length
        ? missingRecord.slice(0, 8).map((s) => `<div class="insight-item"><div class="name">${s.patient_name || 'Paciente'} · ${s.title || 'Procedimento'}</div><div class="meta">Sem prontuário vinculado</div><div class="actions"><a class="btn btn-outline btn-sm" href="/medico/pacientes/${s.patient_id}">Perfil do Paciente</a><button class="btn btn-outline btn-sm" onclick="goSection('procedures-history')">Ir para Procedimentos</button></div></div>`).join('')
        : '<div style="font-size:11px;color:var(--text-muted);">Todos os procedimentos ativos têm prontuário.</div>';
    }

    async function loadTemplates() {
      try {
        const res = await fetch('/api/templates', { headers });
        if (!res.ok) throw new Error();
        allTemplates = await res.json();
        renderTemplatesGrid();
        populateTemplateSelects();
      } catch {}
    }

    async function loadDoctorProfile() {
      try {
        const res = await fetch('/api/auth/me', { headers });
        if (!res.ok) return;
        const me = await res.json();
        isAdminDoctor = me?.role === 'ADMIN' || doctorData?.isAdmin === true;

        const navTeam = document.getElementById('navTeamItem');
        const secTeam = document.getElementById('sec-team');
        if (isAdminDoctor) {
          if (navTeam) navTeam.style.display = '';
          if (secTeam) secTeam.style.display = '';
        } else {
          if (navTeam) navTeam.style.display = 'none';
          if (secTeam) secTeam.style.display = 'none';
        }
      } catch {}
    }

    async function loadTeamData() {
      if (!isAdminDoctor) return;

      const doctorsBody = document.getElementById('doctorsTeamList');
      const recepBody = document.getElementById('receptionistsTeamList');

      try {
        const [docsRes, recRes] = await Promise.all([
          fetch('/api/auth/team/doctors', { headers }),
          fetch('/api/auth/team/receptionists', { headers }),
        ]);

        const doctors = docsRes.ok ? await docsRes.json() : [];
        const receptionists = recRes.ok ? await recRes.json() : [];

        doctorsBody.innerHTML = doctors.length
          ? doctors.map(d => `<tr><td>${d.name || '—'}</td><td>${d.email || '—'}</td><td>${d.crm || '—'}</td><td>${statusBadge(d.role || 'DOCTOR')}</td></tr>`).join('')
          : '<tr><td colspan="4" style="text-align:center;padding:20px;color:var(--text-muted);font-size:11px">Nenhum medico cadastrado</td></tr>';

        recepBody.innerHTML = receptionists.length
          ? receptionists.map(r => `<tr><td>${r.name || '—'}</td><td>${r.email || '—'}</td><td>${r.active ? '<span class="badge badge-green">Ativa</span>' : '<span class="badge badge-red">Inativa</span>'}</td></tr>`).join('')
          : '<tr><td colspan="3" style="text-align:center;padding:20px;color:var(--text-muted);font-size:11px">Nenhuma recepcionista cadastrada</td></tr>';
      } catch {
        doctorsBody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:20px;color:var(--red);font-size:11px">Erro ao carregar equipe</td></tr>';
        recepBody.innerHTML = '<tr><td colspan="3" style="text-align:center;padding:20px;color:var(--red);font-size:11px">Erro ao carregar equipe</td></tr>';
      }
    }

    function renderPatientsList() {
      const tbody = document.getElementById('patientsList');
      const q = (document.getElementById('patientsHistorySearch')?.value || '').trim().toLowerCase();
      const list = !q
        ? allPatients
        : allPatients.filter((p) =>
          String(p.name || '').toLowerCase().includes(q)
          || String(p.email || '').toLowerCase().includes(q)
          || String(p.phone || '').toLowerCase().includes(q)
        );
      if (!list.length) { tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:28px;color:var(--text-muted);font-size:11px">Nenhum paciente encontrado</td></tr>`; return; }
      tbody.innerHTML = list.map(p => `<tr>
        <td><strong>${p.name}</strong></td>
        <td style="color:var(--text-muted)">${p.email}<br><small>${p.phone||'—'}</small></td>
        <td>${p.reference_face_path ? `<img src="${p.reference_face_path}" style="width:32px;height:32px;border-radius:50%;object-fit:cover;border:2px solid var(--accent-5)">` : '<span style="color:var(--text-muted);font-size:10px">Sem foto</span>'}</td>
        <td style="color:var(--text-muted)">${fmtDate(p.created_at)}</td>
        <td><div style="display:flex;gap:6px;flex-wrap:wrap;"><a class="btn btn-outline btn-sm" href="/medico/pacientes/${p.id}">Perfil</a><button class="btn btn-outline btn-sm" onclick="editPatient('${p.id}')">Editar</button></div></td>
      </tr>`).join('');
    }

    function renderSurgeriesList(filterPatientId) {
      const tbody = document.getElementById('surgeriesList');
      const q = (document.getElementById('surgeriesHistorySearch')?.value || '').trim().toLowerCase();
      let list = allSurgeries.filter(s => s.status !== 'cancelled');
      if (filterPatientId) {
        list = list.filter(s => String(s.patient_id) === String(filterPatientId));
        // Ao filtrar por paciente, só exibe procedimentos ativos (rascunho, em aberto, agendado)
        list = list.filter(s => ['DRAFT','AWAITING_SIGNATURE','scheduled'].includes(s.status));
      }
      if (q) {
        list = list.filter((s) =>
          String(s.patient_name || '').toLowerCase().includes(q)
          || String(s.title || '').toLowerCase().includes(q)
          || String(s.procedure_type || '').toLowerCase().includes(q)
          || String(s.status || '').toLowerCase().includes(q)
        );
      }
      if (!list.length) { tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:28px;color:var(--text-muted);font-size:11px">Nenhum procedimento encontrado</td></tr>`; return; }
      tbody.innerHTML = list.map(s => `<tr>
        <td>${s.patient_name||'—'}</td>
        <td>${s.title||'—'}</td>
        <td><span class="badge badge-gray">${s.procedure_type||'—'}</span></td>
        <td style="color:var(--text-muted)">${fmtDate(s.scheduled_at)}</td>
        <td>${statusBadge(s.status)}</td>
        <td><button class="btn btn-outline btn-sm" onclick="editSurgery('${s.id}')">Editar</button></td>
      </tr>`).join('');
    }

