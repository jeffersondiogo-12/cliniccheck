<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clinic Chek · Documentos</title>
  <link rel="icon" type="image/svg+xml" href="/public/brand/clinic-check-favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    /* ============================================================
       SISTEMA DE TEMAS — CLARO EQUILIBRADO / ESCURO
       ============================================================ */
    :root {
      /* TEMA CLARO — tons suaves, fundo acinzentado */
      --bg-base: #edf2f7;
      --bg-surface: #f7fafc;
      --bg-card: #ffffff;
      --bg-card-hover: #f0f5ff;
      --bg-elevated: #eef2f7;
      --bg-input: #ffffff;
      --border-subtle: #e2e8f0;
      --border-card: #e2e8f0;
      --text-primary: #2d3748;
      --text-secondary: #4a5568;
      --text-muted: #718096;
      --accent-1: #4a90d9;
      --accent-1-dim: #e8f0fe;
      --accent-2: #6bc5b8;
      --accent-2-dim: #e6f7f2;
      --accent-3: #b794f4;
      --accent-3-dim: #f0e8ff;
      --accent-4: #f6ad55;
      --accent-4-dim: #fef5e7;
      --accent-5: #6fcf97;
      --accent-5-dim: #eafaf1;
      --red: #e53e3e;
      --red-bg: #fff5f5;
      --shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
      --shadow-hover: 0 8px 30px rgba(0, 0, 0, 0.10);
      --radius: 12px;
      --font: 'Inter', system-ui, -apple-system, sans-serif;
      --sidebar-width: 260px;
      --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* TEMA ESCURO (mantido) */
    [data-theme="dark"] {
      --bg-base: #0b1120;
      --bg-surface: #111c2e;
      --bg-card: #162033;
      --bg-card-hover: #1c2a42;
      --bg-elevated: #1e2d45;
      --bg-input: #111c2e;
      --border-subtle: rgba(255, 255, 255, 0.06);
      --border-card: rgba(255, 255, 255, 0.07);
      --text-primary: #f0f4ff;
      --text-secondary: #b0c4e8;
      --text-muted: #7a8aa8;
      --accent-1: #3b82f6;
      --accent-1-dim: rgba(59, 130, 246, 0.15);
      --accent-2: #06b6d4;
      --accent-2-dim: rgba(6, 182, 212, 0.12);
      --accent-3: #8b5cf6;
      --accent-3-dim: rgba(139, 92, 246, 0.12);
      --accent-4: #f59e0b;
      --accent-4-dim: rgba(245, 158, 11, 0.12);
      --accent-5: #10b981;
      --accent-5-dim: rgba(16, 185, 129, 0.12);
      --red: #f87171;
      --red-bg: rgba(239, 68, 68, 0.08);
      --shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
      --shadow-hover: 0 12px 40px rgba(0, 0, 0, 0.45);
    }

    /* ============================================================
       RESET E BASE
       ============================================================ */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: var(--font);
      background: var(--bg-base);
      color: var(--text-primary);
      display: flex;
      min-height: 100vh;
      transition: background var(--transition), color var(--transition);
    }

    /* ============================================================
       MAIN
       ============================================================ */
    .main {
      margin-left: var(--sidebar-width);
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      background: var(--bg-base);
      transition: background var(--transition), margin-left var(--transition);
    }

    /* ============================================================
       TOPBAR
       ============================================================ */
    .topbar {
      padding: 16px 32px;
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 40;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition: background var(--transition), border-color var(--transition);
    }
    .topbar h1 {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.3px;
      color: var(--text-primary);
      transition: color var(--transition);
    }
    .topbar .meta {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
      transition: color var(--transition);
    }
    .topbar-actions {
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .topbar-actions .badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--text-secondary);
      background: var(--bg-elevated);
      padding: 4px 14px 4px 10px;
      border-radius: 20px;
      border: 1px solid var(--border-subtle);
      transition: background var(--transition), border-color var(--transition), color var(--transition);
    }
    .topbar-actions .badge i {
      color: var(--accent-5);
      font-size: 10px;
      transition: color var(--transition);
    }

    /* ============================================================
       CONTENT
       ============================================================ */
    .content {
      padding: 24px 32px 40px;
      flex: 1;
    }

    /* ============================================================
       SEÇÕES (toggle)
       ============================================================ */
    .section {
      display: none;
      animation: fadeUp 0.3s ease;
    }
    .section.active {
      display: block;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ============================================================
       CARDS E GRIDS — COM ANIMAÇÕES DE HOVER
       ============================================================ */
    .card {
      background: var(--bg-card);
      border-radius: var(--radius);
      border: 1px solid var(--border-card);
      overflow: hidden;
      margin-bottom: 20px;
      box-shadow: var(--shadow);
      transition: background var(--transition), border-color var(--transition), box-shadow var(--transition), transform 0.25s ease;
    }
    .card:hover {
      box-shadow: var(--shadow-hover);
      transform: translateY(-4px) scale(1.002);
      border-color: var(--accent-1);
    }
    .card-header {
      padding: 16px 22px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: rgba(255, 255, 255, 0.02);
      transition: border-color var(--transition), background var(--transition);
    }
    .card-header h3 {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 8px;
      transition: color var(--transition);
    }
    .card-header h3 i {
      color: var(--accent-1);
      font-size: 16px;
      transition: color var(--transition);
    }
    .card-header .badge {
      font-size: 11px;
      font-weight: 500;
    }
    .card-body {
      padding: 20px 22px;
    }

    /* ============================================================
       STATS GRID
       ============================================================ */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-bottom: 28px;
    }
    .stat-card {
      background: var(--bg-card);
      border-radius: var(--radius);
      padding: 20px 22px;
      border: 1px solid var(--border-card);
      box-shadow: var(--shadow);
      display: flex;
      align-items: center;
      gap: 16px;
      transition: background var(--transition), border-color var(--transition), box-shadow var(--transition), transform 0.25s ease;
      cursor: default;
    }
    .stat-card:hover {
      transform: translateY(-5px) scale(1.005);
      background: var(--bg-card-hover);
      box-shadow: var(--shadow-hover);
      border-color: var(--accent-1);
    }
    .stat-card .icon {
      width: 48px;
      height: 48px;
      border-radius: var(--radius);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
      transition: background var(--transition), color var(--transition), transform 0.3s ease;
    }
    .stat-card:hover .icon {
      transform: scale(1.08) rotate(-2deg);
    }
    .stat-card .icon.blue {
      background: var(--accent-1-dim);
      color: var(--accent-1);
    }
    .stat-card .icon.teal {
      background: var(--accent-2-dim);
      color: var(--accent-2);
    }
    .stat-card .icon.yellow {
      background: var(--accent-4-dim);
      color: var(--accent-4);
    }
    .stat-card .icon.green {
      background: var(--accent-5-dim);
      color: var(--accent-5);
    }
    .stat-card .info {
      flex: 1;
      min-width: 0;
    }
    .stat-card .label {
      font-size: 12px;
      color: var(--text-muted);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      transition: color var(--transition);
    }
    .stat-card .value {
      font-size: 28px;
      font-weight: 800;
      color: var(--text-primary);
      line-height: 1.2;
      transition: color var(--transition);
    }
    .stat-card .sub {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 2px;
      transition: color var(--transition);
    }
    .stat-card .trend {
      font-size: 11px;
      font-weight: 600;
      padding: 2px 12px;
      border-radius: 20px;
      background: var(--accent-5-dim);
      color: var(--accent-5);
      transition: background var(--transition), color var(--transition), transform 0.2s ease;
    }
    .stat-card:hover .trend {
      transform: scale(1.05);
    }

    /* ============================================================
       GRIDS AUXILIARES
       ============================================================ */
    .grid2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .insight-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 8px;
    }
    .pulse-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 18px;
      margin-bottom: 24px;
    }

    /* ============================================================
       PULSE CARD
       ============================================================ */
    .pulse-card {
      background: var(--bg-card);
      border-radius: var(--radius);
      border: 1px solid var(--border-card);
      padding: 18px 22px;
      box-shadow: var(--shadow);
      transition: background var(--transition), border-color var(--transition), box-shadow var(--transition), transform 0.25s ease;
    }
    .pulse-card:hover {
      box-shadow: var(--shadow-hover);
      transform: translateY(-3px);
      border-color: var(--accent-2);
    }
    .pulse-title {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: color var(--transition);
    }
    .pulse-title i {
      font-size: 14px;
      color: var(--accent-2);
      transition: color var(--transition);
    }
    .pulse-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13px;
      color: var(--text-secondary);
      gap: 12px;
      transition: color var(--transition);
    }
    .pulse-row strong {
      color: var(--text-primary);
      font-weight: 600;
      transition: color var(--transition);
    }
    .pulse-progress {
      height: 6px;
      border-radius: 999px;
      overflow: hidden;
      background: var(--bg-elevated);
      margin-top: 10px;
      transition: background var(--transition);
    }
    .pulse-progress > i {
      display: block;
      height: 100%;
      width: 0;
      background: linear-gradient(90deg, var(--accent-1), var(--accent-2));
      transition: width 0.6s ease, background var(--transition);
    }
    .quick-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 10px;
    }

    /* ============================================================
       TABELAS
       ============================================================ */
    .table-wrap {
      overflow-x: auto;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    thead th {
      padding: 10px 14px;
      text-align: left;
      font-size: 10px;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid var(--border-subtle);
      background: rgba(255, 255, 255, 0.02);
      transition: color var(--transition), border-color var(--transition), background var(--transition);
    }
    tbody tr {
      border-bottom: 1px solid var(--border-subtle);
      transition: background 0.2s ease, border-color var(--transition), transform 0.15s ease;
    }
    tbody tr:last-child {
      border-bottom: none;
    }
    tbody tr:hover {
      background: var(--bg-card-hover);
      transform: scale(1.002);
    }
    tbody td {
      padding: 11px 14px;
      color: var(--text-secondary);
      vertical-align: middle;
      transition: color var(--transition);
    }
    tbody td strong {
      color: var(--text-primary);
      font-weight: 500;
      transition: color var(--transition);
    }

    /* ============================================================
       BADGES
       ============================================================ */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 12px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: 600;
      gap: 4px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      transition: background var(--transition), color var(--transition), transform 0.2s ease;
    }
    .badge:hover {
      transform: scale(1.06);
    }
    .badge-blue {
      background: var(--accent-1-dim);
      color: var(--accent-1);
    }
    .badge-green {
      background: var(--accent-5-dim);
      color: var(--accent-5);
    }
    .badge-yellow {
      background: var(--accent-4-dim);
      color: var(--accent-4);
    }
    .badge-red {
      background: var(--red-bg);
      color: var(--red);
    }
    .badge-gray {
      background: var(--bg-elevated);
      color: var(--text-muted);
    }
    .badge-teal {
      background: var(--accent-2-dim);
      color: var(--accent-2);
    }
    .badge-purple {
      background: var(--accent-3-dim);
      color: var(--accent-3);
    }
    .stacked-badges {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      align-items: center;
      margin-bottom: 4px;
    }
    .inline-tags {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 6px;
    }
    .inline-tag {
      display: inline-flex;
      padding: 2px 10px;
      border-radius: 999px;
      font-size: 9px;
      font-weight: 600;
      background: var(--bg-elevated);
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
      text-transform: uppercase;
      letter-spacing: 0.3px;
      transition: background var(--transition), color var(--transition), border-color var(--transition), transform 0.2s ease;
    }
    .inline-tag:hover {
      transform: scale(1.05);
    }
    .table-note {
      font-size: 10px;
      color: var(--text-muted);
      margin-top: 4px;
      line-height: 1.45;
      transition: color var(--transition);
    }

    /* ============================================================
       FILTROS
       ============================================================ */
    .header-tools {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }
    .table-search,
    .filter-select {
      padding: 7px 14px;
      border: 1px solid var(--border-card);
      border-radius: var(--radius);
      font-size: 13px;
      font-family: var(--font);
      background: var(--bg-input);
      color: var(--text-primary);
      outline: none;
      min-width: 160px;
      transition: background var(--transition), border-color var(--transition), color var(--transition), box-shadow var(--transition), transform 0.2s ease;
    }
    .table-search:focus,
    .filter-select:focus {
      border-color: var(--accent-1);
      box-shadow: 0 0 0 3px var(--accent-1-dim);
      transform: scale(1.01);
    }
    .table-search::placeholder {
      color: var(--text-muted);
      transition: color var(--transition);
    }
    .filter-select option {
      background: var(--bg-input);
      color: var(--text-primary);
    }

    /* ============================================================
       BOTÕES — COM ANIMAÇÕES
       ============================================================ */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      border: none;
      border-radius: var(--radius);
      font-size: 12px;
      font-weight: 600;
      font-family: var(--font);
      cursor: pointer;
      transition: background var(--transition), color var(--transition), border-color var(--transition), box-shadow var(--transition), transform 0.2s ease;
      text-decoration: none;
      text-transform: none;
      letter-spacing: 0.2px;
      position: relative;
      overflow: hidden;
    }
    .btn::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,255,255,0.15), transparent 60%);
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
    }
    .btn:hover::after {
      opacity: 1;
    }
    .btn i {
      font-size: 14px;
    }
    .btn-solid {
      background: var(--accent-1);
      color: #fff;
      box-shadow: 0 4px 16px rgba(74, 144, 217, 0.3);
    }
    .btn-solid:hover {
      background: #3b7ec8;
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 6px 24px rgba(74, 144, 217, 0.4);
    }
    .btn-solid:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }
    .btn-outline {
      background: transparent;
      color: var(--text-secondary);
      border: 1px solid var(--border-card);
    }
    .btn-outline:hover {
      border-color: var(--accent-1);
      background: var(--accent-1-dim);
      color: var(--text-primary);
      transform: translateY(-2px) scale(1.02);
    }
    .btn-teal {
      background: var(--accent-2);
      color: #fff;
      box-shadow: 0 4px 16px rgba(107, 197, 184, 0.3);
    }
    .btn-teal:hover {
      background: #5ab8a9;
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 6px 24px rgba(107, 197, 184, 0.4);
    }
    .btn-sm {
      padding: 5px 14px;
      font-size: 11px;
    }
    .btn-red {
      background: var(--red-bg);
      color: var(--red);
      border: 1px solid rgba(229, 62, 62, 0.15);
    }
    .btn-red:hover {
      background: rgba(229, 62, 62, 0.12);
      transform: translateY(-2px) scale(1.02);
    }

    /* ============================================================
       FORMULÁRIOS
       ============================================================ */
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .form-grid.cols1 {
      grid-template-columns: 1fr;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .form-group.span2 {
      grid-column: span 2;
    }
    .form-group label {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.3px;
      transition: color var(--transition);
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 9px 14px;
      border: 1px solid var(--border-card);
      border-radius: var(--radius);
      font-size: 13px;
      font-family: var(--font);
      color: var(--text-primary);
      background: var(--bg-input);
      outline: none;
      transition: background var(--transition), border-color var(--transition), color var(--transition), box-shadow var(--transition), transform 0.15s ease;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--accent-1);
      box-shadow: 0 0 0 3px var(--accent-1-dim);
      transform: scale(1.01);
    }
    .form-group input::placeholder,
    .form-group textarea::placeholder {
      color: var(--text-muted);
      font-weight: 300;
      transition: color var(--transition);
    }
    .form-group textarea {
      resize: vertical;
      min-height: 80px;
    }
    .form-group select option {
      background: var(--bg-input);
      color: var(--text-primary);
    }

    /* ============================================================
       ALERTAS
       ============================================================ */
    .alert-msg {
      padding: 12px 16px;
      border-radius: var(--radius);
      font-size: 13px;
      margin-top: 12px;
      display: none;
      font-weight: 500;
      transition: background var(--transition), color var(--transition), border-color var(--transition), transform 0.2s ease;
    }
    .alert-msg.show {
      display: block;
      animation: fadeUp 0.3s ease;
    }
    .alert-ok {
      background: var(--accent-5-dim);
      color: var(--accent-5);
      border-left: 3px solid var(--accent-5);
    }
    .alert-err {
      background: var(--red-bg);
      color: var(--red);
      border-left: 3px solid var(--red);
    }

    .spin {
      display: inline-block;
      width: 14px;
      height: 14px;
      border: 2px solid rgba(255, 255, 255, 0.2);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      vertical-align: middle;
      margin-right: 6px;
    }
    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* ============================================================
       CÂMERA
       ============================================================ */
    .cam-box {
      border: 1.5px dashed var(--border-card);
      border-radius: var(--radius);
      padding: 16px;
      margin-top: 12px;
      transition: border-color var(--transition), background var(--transition);
    }
    .cam-box:hover {
      border-color: var(--accent-1);
      background: var(--accent-1-dim);
    }
    .cam-preview,
    .cam-video {
      max-width: 240px;
      border-radius: var(--radius);
      display: block;
      margin: 8px auto 0;
    }
    .cam-actions {
      display: flex;
      gap: 8px;
      margin-top: 10px;
      justify-content: center;
      flex-wrap: wrap;
    }

    /* ============================================================
       MODELOS
       ============================================================ */
    .tpl-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .tpl-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-card);
      border-radius: var(--radius);
      padding: 16px;
      position: relative;
      transition: background var(--transition), border-color var(--transition), transform 0.25s ease, box-shadow var(--transition);
    }
    .tpl-card:hover {
      transform: translateY(-3px);
      border-color: var(--accent-3);
      box-shadow: var(--shadow-hover);
    }
    .tpl-card h4 {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 4px;
      transition: color var(--transition);
    }
    .tpl-card .tpl-type {
      font-size: 11px;
      color: var(--text-muted);
      transition: color var(--transition);
    }
    .tpl-card .tpl-del {
      position: absolute;
      top: 12px;
      right: 12px;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--text-muted);
      font-size: 14px;
      transition: color 0.15s, transform 0.2s ease;
    }
    .tpl-card .tpl-del:hover {
      color: var(--red);
      transform: scale(1.2) rotate(10deg);
    }

    /* ============================================================
       CERTIFICADO
       ============================================================ */
    .cert-bar {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 18px;
      border-radius: var(--radius);
      border: 1px solid var(--border-card);
      background: var(--bg-card);
      margin-bottom: 18px;
      flex-wrap: wrap;
      transition: background var(--transition), border-color var(--transition), transform 0.2s ease;
    }
    .cert-bar:hover {
      transform: scale(1.003);
    }
    .cert-bar.is-ok {
      border-color: rgba(111, 207, 151, 0.4);
      background: var(--accent-5-dim);
    }
    .cert-bar.is-warn {
      border-color: rgba(246, 173, 85, 0.4);
      background: var(--accent-4-dim);
    }
    .cert-bar.is-none {
      border-color: var(--border-card);
      background: var(--bg-card);
    }
    .cert-icon {
      width: 40px;
      height: 40px;
      border-radius: var(--radius);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 18px;
      transition: background var(--transition), color var(--transition), transform 0.3s ease;
    }
    .cert-bar:hover .cert-icon {
      transform: scale(1.08) rotate(-4deg);
    }
    .cert-bar.is-ok .cert-icon {
      background: var(--accent-5-dim);
      color: var(--accent-5);
    }
    .cert-bar.is-warn .cert-icon {
      background: var(--accent-4-dim);
      color: var(--accent-4);
    }
    .cert-bar.is-none .cert-icon {
      background: var(--bg-elevated);
      color: var(--text-muted);
    }
    .cert-info {
      flex: 1;
      min-width: 0;
    }
    .cert-info .cert-name {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
      transition: color var(--transition);
    }
    .cert-info .cert-meta {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
      transition: color var(--transition);
    }
    .cert-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    /* ============================================================
       MODAL CERTIFICADO
       ============================================================ */
    .cert-modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(4px);
      z-index: 200;
      align-items: center;
      justify-content: center;
    }
    .cert-modal-overlay.open {
      display: flex;
    }
    .cert-modal {
      background: var(--bg-surface);
      border-radius: var(--radius);
      max-width: 540px;
      width: 100%;
      margin: 16px;
      overflow: hidden;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5);
      border: 1px solid var(--border-card);
      transition: background var(--transition), border-color var(--transition), transform 0.25s ease;
    }
    .cert-modal:hover {
      transform: scale(1.005);
    }
    .cert-modal-head {
      padding: 18px 22px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: border-color var(--transition);
    }
    .cert-modal-head h3 {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
      transition: color var(--transition);
    }
    .cert-modal-close {
      background: none;
      border: none;
      font-size: 24px;
      color: var(--text-muted);
      cursor: pointer;
      transition: color 0.15s, transform 0.2s ease;
    }
    .cert-modal-close:hover {
      color: var(--text-primary);
      transform: rotate(90deg);
    }
    .cert-modal-body {
      padding: 22px;
    }
    .cert-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 280px;
      overflow-y: auto;
    }
    .cert-list-item {
      padding: 12px 16px;
      border: 2px solid var(--border-card);
      border-radius: var(--radius);
      cursor: pointer;
      transition: all 0.2s ease;
      background: var(--bg-card);
    }
    .cert-list-item:hover {
      border-color: var(--accent-1);
      background: var(--accent-1-dim);
      transform: translateX(4px);
    }
    .cert-list-item.selected {
      border-color: var(--accent-2);
      background: var(--accent-2-dim);
    }
    .cert-list-item .cn {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
    }
    .cert-list-item .issuer {
      font-size: 12px;
      color: var(--text-muted);
    }
    .cert-list-item .expiry {
      font-size: 12px;
      margin-top: 3px;
    }
    .cert-list-item .expiry.ok {
      color: var(--accent-5);
    }
    .cert-list-item .expiry.warn {
      color: var(--accent-4);
    }
    .cert-ext-banner {
      padding: 14px;
      background: var(--accent-1-dim);
      border: 1px solid rgba(74, 144, 217, 0.2);
      border-radius: var(--radius);
      font-size: 13px;
      color: var(--text-secondary);
      text-align: center;
      transition: background var(--transition), border-color var(--transition), color var(--transition);
    }
    .cert-ext-banner a {
      color: var(--accent-1);
      font-weight: 600;
      text-decoration: none;
    }
    .cert-ext-banner a:hover {
      text-decoration: underline;
    }
    .cert-upload-area {
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid var(--border-subtle);
      transition: border-color var(--transition);
    }
    .cert-upload-area label {
      font-size: 12px;
      font-weight: 500;
      color: var(--text-muted);
      display: block;
      margin-bottom: 8px;
      transition: color var(--transition);
    }
    .cert-upload-area input[type="file"] {
      color: var(--text-secondary);
      font-size: 13px;
      transition: color var(--transition);
    }
    .cert-upload-area input[type="password"] {
      padding: 6px 12px;
      border: 1px solid var(--border-card);
      border-radius: var(--radius);
      background: var(--bg-base);
      color: var(--text-primary);
      font-size: 13px;
      font-family: var(--font);
      outline: none;
      width: 140px;
      transition: background var(--transition), border-color var(--transition), color var(--transition), transform 0.15s ease;
    }
    .cert-upload-area input[type="password"]:focus {
      border-color: var(--accent-1);
      transform: scale(1.02);
    }

    /* ============================================================
       INSIGHT ITEMS
       ============================================================ */
    .insight-list {
      display: grid;
      gap: 8px;
      max-height: 260px;
      overflow: auto;
    }
    .insight-item {
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius);
      padding: 12px 14px;
      background: rgba(255, 255, 255, 0.02);
      transition: border-color var(--transition), background var(--transition), transform 0.2s ease, box-shadow var(--transition);
    }
    .insight-item:hover {
      transform: translateX(4px);
      border-color: var(--accent-1);
      background: var(--accent-1-dim);
      box-shadow: var(--shadow-hover);
    }
    .insight-item .name {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      transition: color var(--transition);
    }
    .insight-item .meta {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
      transition: color var(--transition);
    }
    .insight-item .actions {
      margin-top: 8px;
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    /* ============================================================
       RESPONSIVO
       ============================================================ */
    @media (max-width: 1200px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .grid2 {
        grid-template-columns: 1fr;
      }
      .insight-grid {
        grid-template-columns: 1fr;
      }
      .pulse-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 992px) {
      .main {
        margin-left: 0;
      }
    }

    @media (max-width: 900px) {
      body {
        display: block;
      }
      .main {
        margin-left: 0;
      }
      .topbar {
        padding: 12px 18px;
        flex-wrap: wrap;
        gap: 8px;
      }
      .topbar h1 {
        font-size: 18px;
      }
      .content {
        padding: 16px;
      }
      .card-header {
        flex-wrap: wrap;
      }
      .form-grid {
        grid-template-columns: 1fr;
      }
      .form-group.span2 {
        grid-column: span 1;
      }
      .tpl-grid {
        grid-template-columns: 1fr;
      }
      .stats-grid {
        gap: 12px;
      }
      .stat-card {
        padding: 16px;
      }
      .stat-card .value {
        font-size: 24px;
      }
      .btn {
        width: 100%;
        justify-content: center;
      }
      .btn-sm {
        width: auto;
      }
      .table-wrap table {
        min-width: 500px;
      }
      .header-tools .table-search {
        min-width: 130px;
      }
      .quick-actions {
        grid-template-columns: 1fr 1fr;
      }
      .quick-actions .btn {
        width: 100%;
      }
      .cert-actions .btn {
        width: auto;
      }
    }

    @media (max-width: 640px) {
      .stats-grid {
        grid-template-columns: 1fr;
      }
      .stat-card .value {
        font-size: 22px;
      }
      .card-body {
        padding: 14px;
      }
      .topbar-actions .badge {
        font-size: 10px;
        padding: 2px 10px 2px 8px;
      }
      .cert-modal {
        margin: 12px;
      }
    }

    /* ============================================================
       UTILITÁRIOS
       ============================================================ */
    .text-muted {
      color: var(--text-muted);
    }
    .text-secondary {
      color: var(--text-secondary);
    }
    .mt-8 {
      margin-top: 8px;
    }
    .mt-12 {
      margin-top: 12px;
    }
    .gap-8 {
      gap: 8px;
    }
    .flex-wrap {
      flex-wrap: wrap;
    }
    .flex {
      display: flex;
    }
    .items-center {
      align-items: center;
    }
    .justify-between {
      justify-content: space-between;
    }

    /* ============================================================
       CORREÇÕES PARA O TEMA
       ============================================================ */
    .card-header .badge {
      background: var(--bg-elevated);
      color: var(--text-secondary);
      transition: background var(--transition), color var(--transition);
    }
    .badge-blue {
      background: var(--accent-1-dim);
      color: var(--accent-1);
    }
    .badge-green {
      background: var(--accent-5-dim);
      color: var(--accent-5);
    }
    .badge-yellow {
      background: var(--accent-4-dim);
      color: var(--accent-4);
    }
    .badge-red {
      background: var(--red-bg);
      color: var(--red);
    }
    .badge-gray {
      background: var(--bg-elevated);
      color: var(--text-muted);
    }
    .badge-teal {
      background: var(--accent-2-dim);
      color: var(--accent-2);
    }
    .btn-outline {
      border-color: var(--border-card);
    }
    .btn-outline:hover {
      border-color: var(--accent-1);
      background: var(--accent-1-dim);
    }
    .cert-modal {
      background: var(--bg-surface);
    }
    .cert-list-item {
      background: var(--bg-card);
    }
    .cert-list-item.selected {
      border-color: var(--accent-2);
      background: var(--accent-2-dim);
    }
    .cert-ext-banner {
      background: var(--accent-1-dim);
      border-color: rgba(74, 144, 217, 0.2);
    }

    /* ============================================================
       AJUSTES ADICIONAIS PARA O TEMA CLARO EQUILIBRADO
       ============================================================ */
    /* Fundo da página mais suave, não totalmente branco */
    [data-theme="light"] .stat-card,
    [data-theme="light"] .card,
    [data-theme="light"] .pulse-card,
    [data-theme="light"] .cert-bar {
      background: #ffffff;
    }
    [data-theme="light"] .topbar {
      background: #f7fafc;
    }
    [data-theme="light"] .sidebar-user {
      background: #edf2f7;
    }

    /* ============================================================
       TABS (Gerar Documento / Histórico) — específico desta página
       ============================================================ */
    .tabs-row {
      display: flex;
      gap: 8px;
      margin-bottom: 22px;
      flex-wrap: wrap;
    }
    .tab-btn {
      padding: 10px 20px;
      border: 1px solid var(--border-card);
      border-radius: var(--radius);
      background: var(--bg-card);
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 600;
      font-family: var(--font);
      cursor: pointer;
      transition: background var(--transition), border-color var(--transition), color var(--transition), box-shadow var(--transition);
    }
    .tab-btn:hover {
      border-color: var(--accent-1);
      color: var(--accent-1);
    }
    .tab-btn.active {
      background: var(--accent-1);
      color: #fff;
      border-color: var(--accent-1);
      box-shadow: 0 4px 16px rgba(74, 144, 217, 0.3);
    }
  </style>
<body>

  <!-- ========== SIDEBAR (partial compartilhado) ========== -->
  <%- include('partials/doctor-sidebar') %>

  <!-- ========== MAIN ========== -->
  <main class="main">
    <header class="topbar">
      <div>
        <h1>Documentos</h1>
        <div class="meta">Geração e histórico de documentos para assinatura</div>
      </div>
      <div class="topbar-actions">
        <a href="/medico" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> Dashboard</a>
      </div>
    </header>

    <div class="content">

      <div class="tabs-row">
        <button class="tab-btn active" id="tabGen" onclick="showTab('gen')"><i class="fas fa-file-signature"></i> Gerar Documento</button>
        <button class="tab-btn" id="tabHistory" onclick="showTab('history')"><i class="fas fa-folder-open"></i> Histórico</button>
      </div>

      <!-- ========== GERAR DOCUMENTO ========== -->
      <div id="paneGen">
        <div id="certBar" class="cert-bar is-none">
          <div class="cert-icon"><i class="fas fa-shield-alt"></i></div>
          <div class="cert-info"><div class="cert-name">Verificando certificado...</div></div>
        </div>
        <div class="card">
          <div class="card-header"><h3><i class="fas fa-file-signature" style="color:var(--accent-2);"></i> Gerar Documento</h3></div>
          <div class="card-body">
            <form id="docForm">
              <div class="form-grid cols1">
                <div class="form-group"><label>Procedimento (somente rascunho, agendado ou em atendimento)</label>
                  <input type="text" id="dSurgerySearch" class="table-search" placeholder="Pesquisar por nome/ID do procedimento ou paciente..." style="margin-bottom:8px;width:100%;">
                  <select id="dSurgerySelect"><option value="">Selecione o procedimento</option></select>
                </div>
                <div class="form-group"><label>Modelo de Documento</label>
                  <select id="dTemplateSelect"><option value="">Selecione o modelo</option></select>
                </div>
                <div class="form-group"><label>Título do Documento</label>
                  <input type="text" id="dTitle" placeholder="Ex: Termo de Consentimento Informado">
                </div>
              </div>
              <div style="margin-top:16px;display:flex;gap:12px;flex-wrap:wrap;">
                <button type="submit" class="btn btn-teal" id="docSubmitBtn"><i class="fas fa-file-pdf"></i> Gerar PDF + DOCX + Link</button>
                <button type="button" class="btn btn-outline" onclick="showTab('history')">Ver Histórico</button>
              </div>
              <div class="alert-msg alert-ok" id="docOk"></div>
              <div class="alert-msg alert-err" id="docErr"></div>
            </form>
            <div id="docLinkArea" style="display:none;margin-top:18px;padding:16px;background:var(--accent-1-dim);border-radius:var(--radius);border:1px solid rgba(74,144,217,0.2);">
              <div style="font-weight:600; font-size:13px; color:var(--accent-1); margin-bottom:6px;"><i class="fas fa-link"></i> Link de Assinatura para o Paciente</div>
              <div style="font-size:13px;color:var(--text-secondary);word-break:break-all;" id="docLink"></div>
              <button class="btn btn-outline btn-sm" style="margin-top:10px;" id="copyLinkBtn"><i class="fas fa-copy"></i> Copiar Link</button>
            </div>
          </div>
        </div>
      </div>

      <!-- ========== HISTÓRICO ========== -->
      <div id="paneHistory" style="display:none">
        <div class="card">
          <div class="card-header">
            <h3><i class="fas fa-folder-open"></i> Histórico de Documentos</h3>
            <div class="header-tools">
              <input type="text" id="searchDoc" class="table-search" placeholder="Buscar paciente...">
              <select id="statusFilter" class="filter-select">
                <option value="">Todos os status</option>
                <option value="DRAFT">Rascunhos</option>
                <option value="scheduled">Agendados</option>
                <option value="AWAITING_SIGNATURE">Em atendimento</option>
                <option value="SIGNED">Assinados</option>
              </select>
            </div>
          </div>
          <div class="card-body" style="padding:0">
            <div class="table-wrap">
              <table>
                <thead><tr><th>Paciente</th><th>Procedimento</th><th>Status</th><th>Ações</th></tr></thead>
                <tbody id="documentsList"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>

  <!-- ========== MODAL CERTIFICADO DIGITAL ========== -->
  <div class="cert-modal-overlay" id="certModalOverlay">
    <div class="cert-modal">
      <div class="cert-modal-head">
        <h3>Selecionar Certificado Digital</h3>
        <button class="cert-modal-close" onclick="closeCertModal()">&times;</button>
      </div>
      <div class="cert-modal-body">
        <div id="certExtBanner" class="cert-ext-banner" style="display:none">
          Para usar certificados instalados no computador (A1/A3/token USB), instale a
          <a href="https://www.lacunasoftware.com/web-pki/" target="_blank" rel="noopener">extensão Lacuna Web PKI</a>
          no seu navegador (Chrome, Edge ou Firefox). É gratuita.
          <br><br>Enquanto isso, use o upload de arquivo (.pfx) abaixo.
        </div>
        <ul class="cert-list" id="certList"></ul>
        <div id="certListLoading" style="text-align:center;padding:24px;color:var(--text-muted);font-size:12px;">Carregando certificados...</div>
        <div class="cert-upload-area" id="certUploadArea" style="display:none">
          <label>Ou envie o arquivo do certificado (.pfx / .p12):</label>
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <input type="file" id="certFileInput" accept=".pfx,.p12" style="font-size:12px;flex:1;">
            <input type="password" id="certFilePassword" placeholder="Senha (se houver)" style="width:140px;padding:6px 12px;border:1px solid var(--border-card);border-radius:8px;font-size:12px;font-family:inherit;background:var(--bg-input);color:var(--text-primary);">
          </div>
          <button class="btn btn-outline btn-sm" style="margin-top:10px;" onclick="readUploadedCert()">Ler Certificado</button>
          <div id="certUploadMsg" style="font-size:12px;margin-top:8px;"></div>
        </div>
        <div style="display:flex;gap:8px;margin-top:20px;justify-content:flex-end;">
          <button class="btn btn-outline btn-sm" onclick="closeCertModal()">Cancelar</button>
          <button class="btn btn-teal btn-sm" id="certConfirmBtn" disabled onclick="confirmCertSelection()">Usar este certificado</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Lacuna Web PKI -->
  <script src="https://cdn.lacunasoftware.com/libs/web-pki/lacuna-web-pki-2.16.1.min.js"></script>

  <script>
    // ============================================================
    // INICIALIZAÇÃO DO TEMA (sincroniza com a sidebar)
    // ============================================================
    (function initTheme() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();

    const doctorToken = localStorage.getItem('doctorToken');
    const receptionToken = localStorage.getItem('receptionToken');
    const token = doctorToken || receptionToken;
    const isReceptionSession = !doctorToken && !!receptionToken;
    const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');
    if (!token) window.location.href = '/medico/login';
    if (doctorData.name) document.getElementById('sidebarName').textContent = doctorData.name;
    document.getElementById('logoutBtn').addEventListener('click', () => {
      localStorage.removeItem('doctorToken'); localStorage.removeItem('doctorData');
        localStorage.removeItem('receptionToken'); localStorage.removeItem('receptionData');
        window.location.href = isReceptionSession ? '/recepcao/login' : '/medico/login';
    });

    const h = { 'Content-Type':'application/json','Authorization':'Bearer '+token };
    async function syncAdminNav() {
      try {
        const res = await fetch('/api/auth/me', { headers: h });
        if (!res.ok) return;
        const me = await res.json();
        const isAdmin = me?.role === 'ADMIN' || doctorData?.isAdmin === true;
        if (isAdmin) {
          const navTeam = document.getElementById('navTeamItem');
          if (navTeam) navTeam.style.display = '';
        }
      } catch {}
    }

    function showTab(t) {
      document.getElementById('paneGen').style.display = t==='gen' ? '' : 'none';
      document.getElementById('paneHistory').style.display = t==='history' ? '' : 'none';
      document.getElementById('tabGen').classList.toggle('active', t==='gen');
      document.getElementById('tabHistory').classList.toggle('active', t==='history');
      if (t==='history') loadDocuments();
    }

    function statusBadge(s) {
      const map={DRAFT:'badge-gray',scheduled:'badge-blue',completed:'badge-green',cancelled:'badge-red',SIGNED:'badge-green',AWAITING_SIGNATURE:'badge-yellow'};
      const lbl={DRAFT:'Rascunho',scheduled:'Agendado',completed:'Concluído',cancelled:'Cancelado',SIGNED:'Assinado',AWAITING_SIGNATURE:'Em atendimento'};
      return `<span class="badge ${map[s]||'badge-gray'}">${lbl[s]||s||'—'}</span>`;
    }
    function docStatusBadge(s) {
      const map={PENDING_SIGNATURE:'badge-yellow',SIGNED:'badge-green'};
      const lbl={PENDING_SIGNATURE:'Pendente',SIGNED:'Assinado'};
      return `<span class="badge ${map[s]||'badge-gray'}">${lbl[s]||s||'—'}</span>`;
    }
    function legalEvidenceBadge(evidence) {
      if (!evidence) return '';
      const map={QUALIFIED:'badge-green',AUTHENTICATED:'badge-teal',QUALIFIED_REQUIRED:'badge-yellow',PENDING:'badge-yellow',SIGNED:'badge-blue'};
      return `<span class="badge ${map[evidence.legalStatus]||'badge-blue'}">${evidence.legalLabel}</span>`;
    }
    function evidenceInline(evidence) {
      if (!evidence) return '';
      const tags=[];
      if (evidence.biometrics?.completed) tags.push('<span class="inline-tag">Biometria</span>');
      if (evidence.auditTrail?.completed) tags.push('<span class="inline-tag">Auditoria</span>');
      if (evidence.timestamp?.completed) tags.push('<span class="inline-tag">TSA</span>');
      if (evidence.qualifiedSignature?.required) tags.push(`<span class="inline-tag">${evidence.qualifiedSignature.completed?'ICP-Brasil ok':'ICP-Brasil obrigatório'}</span>`);
      const refs=[];
      if (evidence.qualifiedSignature?.ref) refs.push(`<div class="table-note"><strong>Protocolo ICP-Brasil:</strong> ${evidence.qualifiedSignature.ref}</div>`);
      if (evidence.timestamp?.at) {
        const tsDate=new Date(evidence.timestamp.at).toLocaleString('pt-BR',{dateStyle:'short',timeStyle:'medium'});
        refs.push(`<div class="table-note"><strong>Carimbo de tempo:</strong> ${tsDate}${evidence.timestamp.provider?' via '+evidence.timestamp.provider:''}</div>`);
      }
      return `<div class="inline-tags">${tags.join('')}</div><div class="table-note">${evidence.procedureClassification?.reason||evidence.qualifiedSignature?.reason||''}</div>${refs.join('')}`;
    }

    let allEligibleSurgeries = [];

    function applySurgeryFilter() {
      const q = (document.getElementById('dSurgerySearch').value || '').trim().toLowerCase();
      const filtered = !q
        ? allEligibleSurgeries
        : allEligibleSurgeries.filter(s =>
            (s.patient_name || '').toLowerCase().includes(q)
            || (s.patient_email || '').toLowerCase().includes(q)
            || (s.patient_document_id || '').toLowerCase().replace(/[^a-z0-9]/g,'').includes(q.replace(/[^a-z0-9]/g,''))
            || (s.title || '').toLowerCase().includes(q)
            || String(s.id || '').toLowerCase().includes(q)
            || String(s.patient_id || '').toLowerCase().includes(q)
            || String(s.procedure_type || '').toLowerCase().includes(q)
          );

      const sel = document.getElementById('dSurgerySelect');
      sel.innerHTML = '<option value="">Selecione o procedimento</option>';
      filtered.forEach((s) => {
        const o = document.createElement('option');
        o.value = s.id;
        const emailHint = s.patient_email ? ` <${s.patient_email}>` : '';
        o.textContent = `${s.patient_name || 'Paciente'}${emailHint} — ${s.title || 'Procedimento'} (${s.procedure_type || 'Sem tipo'}) · ID ${String(s.id || '').slice(0, 8)}`;
        sel.appendChild(o);
      });
    }

    async function load() {
      const [sRes, tRes] = await Promise.all([
        fetch('/api/surgeries',{headers:h}),
        fetch('/api/templates',{headers:h}),
      ]);
      const surgeries = sRes.ok ? await sRes.json() : [];
      const templates = tRes.ok ? await tRes.json() : [];

      allEligibleSurgeries = surgeries.filter(s => s.status === 'DRAFT' || s.status === 'scheduled' || s.status === 'AWAITING_SIGNATURE');
      applySurgeryFilter();

      const tsel = document.getElementById('dTemplateSelect');
      tsel.innerHTML = '<option value="">Selecione o modelo</option>';
      templates.forEach(t=>{
        const o=document.createElement('option'); o.value=t.id;
        o.textContent=`${t.name}${t.procedure_type?' ('+t.procedure_type+')':''}`;
        tsel.appendChild(o);
      });
    }

    document.getElementById('dSurgerySearch').addEventListener('input', applySurgeryFilter);

    let allDocs = [];
    async function loadDocuments() {
      const res = await fetch('/api/surgeries',{headers:h});
      allDocs = res.ok ? await res.json() : [];
      renderDocs();
    }

    function renderDocs() {
      const q = (document.getElementById('searchDoc').value||'').toLowerCase();
      const sf = document.getElementById('statusFilter').value;
      let list = allDocs.filter((s) => {
        const hasDocumentContext = s.document_status || s.access_token || s.surgery_document_id;
        if (!hasDocumentContext) return false;
        const status = String(s.status || '').toUpperCase();
        const isSigned = String(s.document_status || '').toUpperCase() === 'SIGNED';
        return isSigned || ['DRAFT', 'SCHEDULED', 'AWAITING_SIGNATURE'].includes(status);
      });
      if (sf==='SIGNED') list=list.filter(s=>s.document_status==='SIGNED');
      else if (sf) list=list.filter(s=>s.status===sf);
      if (q) list=list.filter(s=>(s.patient_name||'').toLowerCase().includes(q)||(s.title||'').toLowerCase().includes(q));

      const tbody=document.getElementById('documentsList');
      if (!list.length){tbody.innerHTML='<tr><td colspan="4" style="text-align:center;padding:28px;color:var(--muted);font-size:11px">Nenhum documento encontrado</td></tr>';return;}
      tbody.innerHTML = list.map(s=>{
        const badge=docStatusBadge(s.document_status);
        const surgBadge=statusBadge(s.status);
        const legal=legalEvidenceBadge(s.document_evidence);
        const notes=evidenceInline(s.document_evidence);
        const actions=s.access_token
          ? `<div style="display:flex;gap:6px;flex-wrap:wrap">
               <a href="/paciente/assinar/${s.access_token}" target="_blank" class="btn btn-outline btn-sm">Abrir</a>
               <a href="/api/documents/${s.surgery_document_id}/download/pdf" class="btn btn-outline btn-sm" title="Baixar PDF"><i class="fas fa-file-pdf"></i> PDF</a>
               <a href="/api/documents/${s.surgery_document_id}/download/docx" class="btn btn-outline btn-sm" title="Baixar DOCX"><i class="fas fa-file-word"></i> DOCX</a>
             </div>`
          : '—';
        return `<tr><td>${s.patient_name||'—'}</td><td>${s.title||'—'}</td><td><div class="stacked-badges">${surgBadge}${badge}${legal}</div>${notes}</td><td>${actions}</td></tr>`;
      }).join('');
    }

    document.getElementById('searchDoc').addEventListener('input', renderDocs);
    document.getElementById('statusFilter').addEventListener('change', renderDocs);

    // GERAR DOCUMENTO
    document.getElementById('docForm').addEventListener('submit', async e => {
      e.preventDefault();
      const btn=document.getElementById('docSubmitBtn');
      const ok=document.getElementById('docOk');
      const err=document.getElementById('docErr');
      const linkArea=document.getElementById('docLinkArea');
      ok.style.display='none'; err.style.display='none'; linkArea.style.display='none';

      // Validação: procedimento (e paciente) obrigatório
      const surgeryId = document.getElementById('dSurgerySelect').value;
      if (!surgeryId) {
        err.textContent = 'Selecione um procedimento (com paciente vinculado) antes de gerar o documento.';
        err.style.display = 'block';
        return;
      }

      // Validação: procedimento crítico exige certificado
      const surgery = allEligibleSurgeries.find(s => String(s.id) === String(surgeryId));
      const isCritical = surgery && (surgery.procedure_classification === 'CRITICO' || surgery.require_qualified_signature === true);
      if (isCritical && !certIsConfigured) {
        err.textContent = '⚠ Este procedimento é classificado como CRÍTICO (ICP-Brasil obrigatório). Configure seu certificado digital antes de gerar o documento.';
        err.style.display = 'block';
        // Destaca a barra de cert
        const bar = document.getElementById('certBar');
        if (bar) { bar.style.outline = '3px solid #e53e3e'; bar.style.outlineOffset = '2px'; setTimeout(()=>{bar.style.outline='';bar.style.outlineOffset='';},3000); }
        return;
      }

      btn.disabled=true; btn.innerHTML='<span class="spin"></span>Gerando...';
      try {
        const res = await fetch('/api/documents/generate',{method:'POST',headers:h,body:JSON.stringify({
          surgeryId,
          templateId: document.getElementById('dTemplateSelect').value||undefined,
          title: document.getElementById('dTitle').value.trim()||'Termo de Consentimento Informado',
        })});
        const data = await res.json();
        if (res.ok && data.accessToken) {
          const link=`${window.location.origin}/paciente/assinar/${data.accessToken}`;
          document.getElementById('docLink').textContent=link;
          linkArea.style.display='block';
          ok.textContent='Documento gerado! Copie o link e envie ao paciente.';
          ok.style.display='block';
          await load();
        } else { err.textContent=data.error||'Erro ao gerar documento.'; err.style.display='block'; }
      } catch { err.textContent='Erro de conexão.'; err.style.display='block'; }
      btn.disabled=false; btn.innerHTML='<i class="fas fa-file-pdf"></i> Gerar PDF + DOCX + Link';
    });

    document.getElementById('copyLinkBtn').addEventListener('click', () => {
      navigator.clipboard.writeText(document.getElementById('docLink').textContent).then(()=>{
        document.getElementById('copyLinkBtn').innerHTML='<i class="fas fa-check"></i> Copiado!';
        setTimeout(()=>{document.getElementById('copyLinkBtn').innerHTML='<i class="fas fa-copy"></i> Copiar Link';},2500);
      });
    });

    const urlTab = new URLSearchParams(location.search).get('tab');
    if (urlTab==='history') showTab('history');

    syncAdminNav();
    load();

  // ═══════════════════════════════════════════════════════════════
  // CERTIFICADO DIGITAL
  // ═══════════════════════════════════════════════════════════════
  const CERT_STORAGE_KEY = 'clinica_doctor_cert';
  let certIsConfigured = false;
  let selectedCertThumbprint = null;
  let selectedCertData = null;
  let pki = null;

  async function initCertificatePanel() {
    const bar = document.getElementById('certBar');
    if (!bar) return;
    try {
      const res = await fetch('/api/certificates/me', { headers: h });
      if (res.ok) {
        const data = await res.json();
        if (data.connected && data.certificate?.providerType === 'WEBPKI_LOCAL') {
          const exp = data.certificate.tokenExpiresAt;
          const isExpired = exp && new Date(exp) < new Date();
          certIsConfigured = !isExpired;
          renderCertBar({ commonName: data.certificate.providerAccountId || 'Certificado Configurado', expiresAt: exp, expired: isExpired });
          localStorage.setItem(CERT_STORAGE_KEY, JSON.stringify({ commonName: data.certificate.providerAccountId, expiresAt: exp }));
          updateNavCertLabel(data.certificate.providerAccountId);
          return;
        }
      }
    } catch (_) {}
    const stored = localStorage.getItem(CERT_STORAGE_KEY);
    if (stored) {
      try {
        const c = JSON.parse(stored);
        if (c.expiresAt && new Date(c.expiresAt) > new Date()) {
          certIsConfigured = true;
          renderCertBar({ commonName: c.commonName, expiresAt: c.expiresAt, expired: false });
          updateNavCertLabel(c.commonName);
          return;
        }
      } catch (_) {}
    }
    certIsConfigured = false;
    renderCertBar(null);
  }

  function updateNavCertLabel(name) {
    const lbl = document.getElementById('navCertLabel');
    if (lbl && name) lbl.textContent = '✓ ' + name.split(':')[0].substring(0,22);
  }

  function escHtml(s) {
    return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function renderCertBar(cert) {
    const bar = document.getElementById('certBar');
    if (!bar) return;
    if (!cert) {
      bar.className = 'cert-bar is-none';
      bar.innerHTML = `
        <div class="cert-icon"><i class="fas fa-shield-alt"></i></div>
        <div class="cert-info">
          <div class="cert-name">Nenhum certificado digital configurado</div>
          <div class="cert-meta">Obrigatório para procedimentos críticos (ICP-Brasil). Configure antes de gerar documentos críticos.</div>
        </div>
        <div class="cert-actions">
          <button class="btn btn-teal btn-sm" onclick="openCertModal()">
            <i class="fas fa-certificate"></i>
            Configurar Certificado
          </button>
        </div>`;
      return;
    }
    const expDate = cert.expiresAt ? new Date(cert.expiresAt) : null;
    const daysLeft = expDate ? Math.floor((expDate - Date.now()) / 86400000) : null;
    bar.className = `cert-bar ${cert.expired ? 'is-warn' : 'is-ok'}`;
    bar.innerHTML = `
      <div class="cert-icon"><i class="fas fa-shield-alt"></i></div>
      <div class="cert-info">
        <div class="cert-name">${escHtml(cert.commonName || 'Certificado Digital')}</div>
        <div class="cert-meta">${cert.expired ? '⚠ Certificado vencido — configure um novo.' : (daysLeft !== null ? `Válido por mais ${daysLeft} dia(s)` : 'Ativo')}</div>
      </div>
      <div class="cert-actions">
        <button class="btn btn-outline btn-sm" onclick="openCertModal()">Alterar</button>
        <button class="btn btn-outline btn-sm" style="color:var(--red);border-color:var(--red);" onclick="removeCert()">Remover</button>
      </div>`;
  }

  async function openCertModal() {
    document.getElementById('certModalOverlay').classList.add('open');
    document.getElementById('certConfirmBtn').disabled = true;
    document.getElementById('certList').innerHTML = '';
    document.getElementById('certListLoading').style.display = 'block';
    document.getElementById('certExtBanner').style.display = 'none';
    document.getElementById('certUploadArea').style.display = 'none';
    selectedCertThumbprint = null; selectedCertData = null;
    try {
      if (!pki) pki = new LacunaWebPKI();
      await new Promise((resolve, reject) => { pki.init({ ready: resolve, notInstalled: () => reject(new Error('NOT_INSTALLED')) }); });
      await listWebPkiCerts();
    } catch (_) {
      document.getElementById('certListLoading').style.display = 'none';
      document.getElementById('certExtBanner').style.display = 'block';
      document.getElementById('certUploadArea').style.display = 'block';
    }
  }

  function closeCertModal() { document.getElementById('certModalOverlay').classList.remove('open'); }

  async function listWebPkiCerts() {
    try {
      const certs = await new Promise((res, rej) => { pki.listCertificates({ success: res, error: rej }); });
      document.getElementById('certListLoading').style.display = 'none';
      document.getElementById('certUploadArea').style.display = 'block';
      const list = document.getElementById('certList');
      if (!certs || !certs.length) { list.innerHTML = '<li style="text-align:center;padding:16px;color:var(--muted);font-size:11px;">Nenhum certificado encontrado no computador.</li>'; return; }
      list.innerHTML = certs.map(c => {
        const exp = c.validityEnd ? new Date(c.validityEnd) : null;
        const daysLeft = exp ? Math.floor((exp - Date.now()) / 86400000) : null;
        const expClass = daysLeft === null ? '' : (daysLeft < 0 ? 'warn' : daysLeft < 30 ? 'warn' : 'ok');
        const expText = daysLeft === null ? '' : (daysLeft < 0 ? `Vencido em ${exp.toLocaleDateString('pt-BR')}` : `Válido até ${exp.toLocaleDateString('pt-BR')}`);
        return `<li class="cert-list-item" data-thumbprint="${escHtml(c.thumbprint)}" onclick="selectCert(this, ${escHtml(JSON.stringify(c))})"><div class="cn">${escHtml(c.subjectName||c.commonName||'Desconhecido')}</div><div class="issuer">${escHtml(c.issuerName||c.issuer||'')}</div>${expText?`<div class="expiry ${expClass}">${expText}</div>`:''}</li>`;
      }).join('');
    } catch (e) { document.getElementById('certListLoading').textContent = 'Erro ao listar: ' + (e.message||e); }
  }

  function selectCert(el, certData) {
    document.querySelectorAll('.cert-list-item').forEach(i => i.classList.remove('selected'));
    el.classList.add('selected');
    selectedCertThumbprint = el.dataset.thumbprint;
    selectedCertData = certData;
    document.getElementById('certConfirmBtn').disabled = false;
  }

  async function confirmCertSelection() {
    if (!selectedCertThumbprint && !selectedCertData) return;
    const btn = document.getElementById('certConfirmBtn');
    btn.disabled = true; btn.textContent = 'Salvando...';
    const certInfo = selectedCertData || {};
    const commonName = certInfo.subjectName || certInfo.commonName || 'Certificado Digital';
    const expiresAt = certInfo.validityEnd || null;
    try {
      const res = await fetch('/api/certificates/webpki/save', { method:'POST', headers:h, body:JSON.stringify({ thumbprint:selectedCertThumbprint, commonName, expiresAt, subjectDn:certInfo.subjectName||certInfo.dn||null }) });
      if (!res.ok) throw new Error('Erro ao salvar');
      localStorage.setItem(CERT_STORAGE_KEY, JSON.stringify({ commonName, expiresAt }));
      certIsConfigured = true;
      closeCertModal();
      renderCertBar({ commonName, expiresAt, expired: false });
      updateNavCertLabel(commonName);
    } catch (e) { alert('Erro ao salvar certificado: ' + e.message); }
    btn.disabled = false; btn.textContent = 'Usar este certificado';
  }

  async function readUploadedCert() {
    const fileInput = document.getElementById('certFileInput');
    const password = document.getElementById('certFilePassword').value;
    const msg = document.getElementById('certUploadMsg');
    if (!fileInput.files || !fileInput.files[0]) { msg.textContent='Selecione um arquivo .pfx ou .p12.'; msg.style.color='var(--red)'; return; }
    msg.textContent='Lendo certificado...'; msg.style.color='var(--muted)';
    const formData = new FormData();
    formData.append('certificate', fileInput.files[0]);
    if (password) formData.append('password', password);
    try {
      const res = await fetch('/api/certificates/read', { method:'POST', headers:{'Authorization':'Bearer '+token}, body:formData });
      const data = await res.json();
      if (!res.ok || !data.valid) { msg.textContent=data.error||'Não foi possível ler o certificado.'; msg.style.color='var(--red)'; return; }
      const thumbprint = `UPLOAD_${Date.now()}`;
      selectedCertThumbprint = thumbprint;
      selectedCertData = { subjectName:data.subject.commonName, issuerName:data.issuer.commonName, validityEnd:data.validity.notAfter, thumbprint, _fromUpload:true };
      const exp = new Date(data.validity.notAfter);
      const daysLeft = Math.floor((exp - Date.now()) / 86400000);
      const list = document.getElementById('certList');
      if (!list.querySelector('[data-thumbprint="'+thumbprint+'"]')) {
        const li = document.createElement('li');
        li.className = 'cert-list-item selected';
        li.dataset.thumbprint = thumbprint;
        li.innerHTML = `<div class="cn">${escHtml(data.subject.commonName||'Certificado')}</div><div class="issuer">${escHtml(data.issuer.commonName||'')}</div><div class="expiry ${daysLeft<0?'warn':'ok'}">Válido até ${exp.toLocaleDateString('pt-BR')}</div>`;
        list.appendChild(li);
      }
      document.getElementById('certConfirmBtn').disabled = false;
      msg.textContent = `Certificado lido: ${data.subject.commonName||'OK'}`; msg.style.color='var(--green)';
    } catch (_) { msg.textContent='Erro de conexão.'; msg.style.color='var(--red)'; }
  }

  async function removeCert() {
    if (!confirm('Remover o certificado digital configurado?')) return;
    await fetch('/api/certificates/webpki/remove', { method:'DELETE', headers:h });
    localStorage.removeItem(CERT_STORAGE_KEY);
    certIsConfigured = false;
    renderCertBar(null);
    const navCertLbl = document.getElementById('navCertLabel');
    if (navCertLbl) navCertLbl.textContent = 'Certificado Digital';
  }

  document.getElementById('certModalOverlay').addEventListener('click', e => { if (e.target===e.currentTarget) closeCertModal(); });

  initCertificatePanel();
  </script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    (function(){
      const _d = JSON.parse(localStorage.getItem('doctorData')||'{}');
      if (!_d.id) return;
      const _sock = io({ transports: ['websocket','polling'] });
      _sock.on('connect', () => _sock.emit('join_doctor', _d.id));
      _sock.on('procedure_created', () => { if(typeof load==='function') load(); if(typeof loadDocuments==='function') loadDocuments(); });
      _sock.on('procedure_updated', () => { if(typeof loadDocuments==='function') loadDocuments(); if(typeof load==='function') load(); });
      _sock.on('procedure_type_created', () => { if(typeof load==='function') load(); });
      _sock.on('procedure_type_updated', () => { if(typeof load==='function') load(); });
      _sock.on('procedure_type_deleted', () => { if(typeof load==='function') load(); });
      _sock.on('template_created', () => { if(typeof load==='function') load(); });
      _sock.on('template_updated', () => { if(typeof load==='function') load(); });
      _sock.on('template_deleted', () => { if(typeof load==='function') load(); });
      _sock.on('document_generated', () => { if(typeof loadDocuments==='function') loadDocuments(); });
      _sock.on('document_signed', () => { if(typeof loadDocuments==='function') loadDocuments(); });
    })();
  </script>
</body>
</html>