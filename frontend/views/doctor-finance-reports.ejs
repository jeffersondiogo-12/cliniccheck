  <!-- MODAL: editar percentual de comissao (somente owner) -->
  <div class="modal-overlay" id="commEditOverlay">
    <div class="modal">
      <div class="modal-header">
        <h3>Definir Comissão</h3>
        <button class="modal-close" onclick="closeCommEditModal()">&times;</button>
      </div>
      <div class="modal-body">
        <div class="form-grid">
          <div class="form-group span2">
            <label id="commEditDoctorLabel">Médico</label>
            <input type="number" id="commEditPercentage" min="0" max="100" step="0.01" placeholder="Ex: 30">
          </div>
        </div>
        <div class="alert-err" id="commEditErr"></div>
      </div>
