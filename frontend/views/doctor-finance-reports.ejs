    function openCommEditModal(doctorId, doctorName, currentPct){
      commEditDoctorId = doctorId;
      document.getElementById('commEditDoctorLabel').textContent = `Percentual de comissão — ${doctorName}`;
      document.getElementById('commEditPercentage').value = currentPct != null ? currentPct : '';
      document.getElementById('commEditErr').style.display = 'none';
      document.getElementById('commEditOverlay').classList.add('show');
    }
    function closeCommEditModal(){ document.getElementById('commEditOverlay').classList.remove('show'); }
    document.getElementById('commEditOverlay').addEventListener('click', (e) => { if (e.target === e.currentTarget) closeCommEditModal(); });

    document.getElementById('confirmCommEditBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('commEditErr');
      errEl.style.display = 'none';
      const pct = document.getElementById('commEditPercentage').value;
      if (pct === '' || isNaN(Number(pct)) || Number(pct) < 0 || Number(pct) > 100) {
        errEl.textContent = 'Informe um percentual válido entre 0 e 100.'; errEl.style.display = 'block'; return;
      }
      try {
        await apiSend(`/api/finance/commission-rates/${commEditDoctorId}`, 'PUT', { commissionPercentage: Number(pct) });
        closeCommEditModal();
        loadCommissions();
      } catch (e) {
        errEl.textContent = e.message; errEl.style.display = 'block';
      }
    });

