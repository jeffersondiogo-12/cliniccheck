      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script>
    // ============================================================
    // SIDEBAR (mesmo da primeira tela — nenhuma lógica alterada)
    // ============================================================
    (function initSidebar() {
      const sidebar = document.querySelector('.sidebar');
      const toggleBtn = document.getElementById('sidebarToggleBtn');
      const overlay = document.getElementById('sidebarOverlay');
      let isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
      if (isCollapsed) sidebar.classList.add('collapsed');

      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (window.innerWidth <= 992) {
          sidebar.classList.toggle('open');
          overlay.classList.toggle('active');
          document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
        } else {
          isCollapsed = !isCollapsed;
          sidebar.classList.toggle('collapsed', isCollapsed);
          localStorage.setItem('sidebarCollapsed', String(isCollapsed));
        }
      });

      overlay.addEventListener('click', function() {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      });

      window.addEventListener('resize', function() {
        if (window.innerWidth > 992) {
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        }
      });

      // Tema
      const themeToggle = document.getElementById('themeToggle');
      const currentTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', currentTheme);
      themeToggle.addEventListener('click', function() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const newTheme = isDark ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      });

      // Grupos colapsáveis (afeta tanto a sidebar principal quanto a navegação de relatórios)
      document.querySelectorAll('.sb-group-btn').forEach((btn) => {
        btn.addEventListener('click', function() {
          const group = this.closest('.sb-group');
          if (group) group.classList.toggle('open');
        });
      });

      // Dados do usuário
      const doctorToken = localStorage.getItem('doctorToken');
      const receptionToken = localStorage.getItem('receptionToken');
      const token = doctorToken || receptionToken;
      const isReceptionSession = !doctorToken && !!receptionToken;
      const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');
      const nameEl = document.getElementById('sidebarName');
      const roleEl = document.getElementById('sidebarRole');
      const clinicEl = document.getElementById('sidebarClinic');
      if (nameEl) nameEl.textContent = doctorData.name || 'Profissional';
      if (roleEl) roleEl.textContent = isReceptionSession ? 'Recepcionista' : (doctorData.isClinicOwner ? 'Owner da Clinica' : 'Profissional');
      if (clinicEl) clinicEl.textContent = 'Clinica: ' + (doctorData.clinicName || '--');

      // Logout
      document.getElementById('logoutBtn').addEventListener('click', function() {
        localStorage.removeItem('doctorToken'); localStorage.removeItem('doctorData');
        localStorage.removeItem('receptionToken'); localStorage.removeItem('receptionData');
        window.location.href = isReceptionSession ? '/recepcao/login' : '/medico/login';
      });

      // Permissões (opcional) — filtra apenas itens da sidebar principal
      if (token) {
        fetch(isReceptionSession ? '/api/auth/permissions-receptionist' : '/api/auth/permissions', { headers: { Authorization: 'Bearer ' + token } })
          .then((r) => r.ok ? r.json() : null)
          .then((data) => {
            if (!data || !Array.isArray(data.pages)) return;
            const allowed = new Set((data.pages || []).filter((p) => p.can_view).map((p) => p.code));
            document.querySelectorAll('#sidebarNav .nav-item[data-page]').forEach((item) => {
              const rawCodes = item.getAttribute('data-page-codes') || item.getAttribute('data-page') || '';
              const pageCodes = rawCodes.split(',').map((code) => code.trim()).filter(Boolean);
              const canSee = pageCodes.some((code) => allowed.has(code));
              item.hidden = !canSee;
            });
            document.querySelectorAll('#sidebarNav .sb-group').forEach((g) => {
              const hasVisible = Array.from(g.querySelectorAll('.nav-item')).some((i) => !i.hidden);
              g.style.display = hasVisible ? '' : 'none';
            });
          })
          .catch(() => {});
      }
    })();

    // ============================================================
    // RELATÓRIOS FINANCEIROS
    // ============================================================
    const doctorToken = localStorage.getItem('doctorToken');
    const receptionToken = localStorage.getItem('receptionToken');
    const token = doctorToken || receptionToken;
    const isReceptionSession = !doctorToken && !!receptionToken;
    if (!token) window.location.href = '/medico/login';
    const H = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };
    const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');

    const EXPENSE_CATEGORY_LABELS = {
      ALUGUEL: 'Aluguel', FORNECEDORES: 'Fornecedores', SALARIOS: 'Salários', IMPOSTOS: 'Impostos',
      MARKETING: 'Marketing', EQUIPAMENTOS: 'Equipamentos', MANUTENCAO: 'Manutenção', OUTROS: 'Outros',
    };
    const PAYMENT_LABELS = {
      DINHEIRO: 'Dinheiro', CARTAO_DEBITO: 'Cartão Débito', CARTAO_CREDITO: 'Cartão Crédito',
      PIX: 'PIX', CONVENIO: 'Convênio',
    };
    const CHART_COLORS = ['#0f4c81', '#10b981', '#f59e0b', '#8b5cf6', '#ef4444', '#06b6d4'];
    const REPORT_META = {
      dre: { group: 'Visão Geral', label: 'DRE' },
      cashflow: { group: 'Visão Geral', label: 'Fluxo de Caixa' },
      projection: { group: 'Visão Geral', label: 'Projeção' },
      'revenue-evolution': { group: 'Visão Geral', label: 'Evolução de Receita' },
      accounts: { group: 'Contas', label: 'A Pagar / Receber' },
      overdue: { group: 'Contas', label: 'Inadimplência' },
      'payment-methods': { group: 'Análises', label: 'Forma de Pagamento' },
      'avg-ticket': { group: 'Análises', label: 'Ticket Médio' },
      commissions: { group: 'Análises', label: 'Repasse Médico' },
      profitability: { group: 'Análises', label: 'Lucratividade' },
      'patients-ranking': { group: 'Pacientes', label: 'Ranking (Ticket)' },
      'patients-inactive': { group: 'Pacientes', label: 'Pacientes Inativos' },
      'patients-birthdays': { group: 'Pacientes', label: 'Aniversariantes' },
    };

    function esc(v){ return String(v==null?'':v).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    function fmtMoney(v){ return Number(v||0).toLocaleString('pt-BR', { style:'currency', currency:'BRL' }); }
    function fmtMoneyShort(v){
      const n = Number(v||0);
      if (Math.abs(n) >= 1000) return (n/1000).toLocaleString('pt-BR',{maximumFractionDigits:1}) + 'k';
      return n.toLocaleString('pt-BR', { maximumFractionDigits: 0 });
    }
    function fmtDate(v){ if(!v) return '—'; return new Date(v).toLocaleDateString('pt-BR'); }
    function todayISO(){ return new Date().toISOString().slice(0,10); }
    function daysAgoISO(n){ const d = new Date(); d.setDate(d.getDate()-n); return d.toISOString().slice(0,10); }

    // ── EXPORTAÇÃO — todo relatório desta tela pode ser baixado, não só visualizado ──
    function downloadCSV(filename, headers, rows){
      const cell = (v) => {
        const s = v == null ? '' : String(v);
        return /[";\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
      };
      const lines = [headers.map(cell).join(';')].concat(rows.map(r => r.map(cell).join(';')));
      const csv = '\uFEFF' + lines.join('\r\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }
    function cssVar(name){ return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }
    function pctChange(curr, prev){
      if (!prev) return null;
      return ((curr - prev) / Math.abs(prev)) * 100;
    }
    function trendHtml(curr, prev, invert){
      const p = pctChange(curr, prev);
      if (p === null || !isFinite(p)) return '';
      const good = invert ? p <= 0 : p >= 0;
      const dir = p >= 0 ? 'up' : 'down';
      const cls = Math.abs(p) < 0.5 ? 'flat' : (good ? 'up' : 'down');
      const icon = Math.abs(p) < 0.5 ? 'fa-minus' : (p >= 0 ? 'fa-arrow-up' : 'fa-arrow-down');
      return `<span class="stat-trend ${cls}"><i class="fas ${icon}"></i> ${Math.abs(p).toFixed(1)}% vs. mês anterior</span>`;
    }

    // ── Chart.js — defaults visuais alinhados ao tema ──
    Chart.defaults.font.family = "'Inter', system-ui, sans-serif";
    function refreshChartDefaults(){
      Chart.defaults.color = cssVar('--sb-text-secondary') || '#334155';
      Chart.defaults.borderColor = cssVar('--sb-border') || '#e2e8f0';
    }
    refreshChartDefaults();
    function scaleTextColor(){ return cssVar('--sb-text-muted') || '#64748b'; }
    function scaleGridColor(){ return cssVar('--sb-border') || '#e2e8f0'; }

    // Plugin: texto central em gráficos doughnut (usado no de forma de pagamento)
    const centerTextPlugin = {
      id: 'centerText',
      beforeDraw(chart) {
        const opt = chart.config.options.plugins && chart.config.options.plugins.centerText;
        if (!opt) return;
        const { ctx, chartArea } = chart;
        if (!chartArea) return;
        const { width, height, top, left } = chartArea;
        const total = (chart.data.datasets[0]?.data || []).reduce((a,b) => a + Number(b||0), 0);
        ctx.save();
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.font = '700 17px Inter, sans-serif';
        ctx.fillStyle = cssVar('--sb-text') || '#1e293b';
        ctx.fillText(fmtMoney(total), left + width / 2, top + height / 2 - 9);
        ctx.font = '600 10px Inter, sans-serif';
        ctx.fillStyle = cssVar('--sb-text-muted') || '#64748b';
        ctx.fillText(String(opt).toUpperCase(), left + width / 2, top + height / 2 + 11);
        ctx.restore();
      },
    };
    Chart.register(centerTextPlugin);

    async function apiGet(url){
      const res = await fetch(url, { headers: H });
      const data = await res.json().catch(() => null);
      if (!res.ok) throw new Error(data?.error || 'Falha na requisição.');
      return data;
    }
    async function apiSend(url, method, body){
      const res = await fetch(url, { method, headers: H, body: body != null ? JSON.stringify(body) : undefined });
      const data = await res.json().catch(() => null);
      if (!res.ok) throw new Error(data?.error || 'Falha na requisição.');
      return data;
    }

    // Skeleton helper para linhas de tabela em carregamento
    function skeletonRows(cols, rows = 4){
      let out = '';
      for (let r = 0; r < rows; r++) {
        out += '<tr class="skel-row">';
        for (let c = 0; c < cols; c++) {
          const w = 40 + Math.round(Math.random() * 45);
          out += `<td><div class="skel skel-line" style="width:${w}%;"></div></td>`;
        }
        out += '</tr>';
      }
      return out;
    }

    // ── NAVEGAÇÃO DE RELATÓRIOS ──
    const loadedTabs = new Set();
    const tabLoaders = {
      dre: loadDre,
      cashflow: loadCashflow,
      projection: loadProjection,
      'revenue-evolution': loadRevenueEvolution,
      accounts: loadAccounts,
      overdue: loadOverdue,
      'payment-methods': loadPaymentMethods,
      'avg-ticket': loadAverageTicket,
      commissions: loadCommissions,
      profitability: loadProfitability,
      'patients-ranking': loadPatientsRanking,
      'patients-inactive': loadPatientsInactive,
      'patients-birthdays': loadPatientsBirthdays,
    };

    function selectReportTab(tab){
      document.querySelectorAll('.reports-nav .nav-item[data-tab]').forEach((b) => b.classList.toggle('active', b.getAttribute('data-tab') === tab));
      document.querySelectorAll('.report-panel').forEach((p) => p.classList.toggle('active', p.id === `panel-${tab}`));
      const meta = REPORT_META[tab];
      if (meta) document.getElementById('crumbCurrent').textContent = meta.label;
      // Sempre recarrega ao clicar (não só na primeira vez) — em relatório
      // financeiro, dado desatualizado é pior do que uma chamada a mais.
      // (loadedTabs continua registrando quem já abriu, usado pelo toggle de tema.)
      loadedTabs.add(tab);
      tabLoaders[tab]?.();
      // O painel do relatório pode ficar fora da área visível dependendo de
      // onde a página estava rolada — traz ele pra vista automaticamente.
      requestAnimationFrame(() => {
        document.getElementById(`panel-${tab}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
    document.querySelectorAll('.reports-nav .nav-item[data-tab]').forEach((btn) => {
      btn.addEventListener('click', () => selectReportTab(btn.getAttribute('data-tab')));
    });

    // Re-renderiza gráficos abertos ao trocar de tema, para ajustar cores dos eixos/texto
    document.getElementById('themeToggle').addEventListener('click', () => {
      setTimeout(() => {
        refreshChartDefaults();
        loadedTabs.forEach((tab) => tabLoaders[tab]?.());
      }, 60);
    });

    // ── DRE ──
    let dreCompareChartInstance = null, dreCategoryChartInstance = null;
    let lastDreData = null;
    async function loadDre(){
      const body = document.getElementById('dreBody');
      body.innerHTML = '<div class="empty-state">Carregando...</div>';
      try {
        const month = document.getElementById('dreMonthPicker').value;
        const data = await apiGet(`/api/finance/reports/dre?month=${month}`);
        lastDreData = data;
        const catRows = Object.entries(data.expensesByCategory).map(([cat, val]) => `
          <tr><td style="padding-left:24px;">${esc(EXPENSE_CATEGORY_LABELS[cat] || cat)}</td><td style="text-align:right;">(${fmtMoney(val)})</td></tr>
        `).join('') || '<tr><td style="padding-left:24px;color:var(--sb-text-muted);">Nenhuma despesa paga no período</td><td></td></tr>';

        const profitColor = data.netProfit >= 0 ? '#10b981' : '#ef4444';
        const revBySource = data.revenueBySource || { particular: data.grossRevenue, convenio: 0 };
        body.innerHTML = `
          <table style="width:100%;font-size:14px;">
            <tr><td style="font-weight:700;">Receita Bruta</td><td style="text-align:right;font-weight:700;color:#10b981;">${fmtMoney(data.grossRevenue)}</td></tr>
            <tr><td style="padding-left:24px;color:var(--sb-text-muted);">Particular</td><td style="text-align:right;color:var(--sb-text-muted);">${fmtMoney(revBySource.particular)}</td></tr>
            <tr><td style="padding-left:24px;color:var(--sb-text-muted);">Convênios (guias pagas)</td><td style="text-align:right;color:var(--sb-text-muted);">${fmtMoney(revBySource.convenio)}</td></tr>
            <tr><td colspan="2" style="padding-top:14px;font-weight:700;">(-) Despesas</td></tr>
            ${catRows}
            <tr><td style="font-weight:600;padding-top:8px;border-top:1px solid var(--sb-border);">Total de Despesas</td><td style="text-align:right;font-weight:600;padding-top:8px;border-top:1px solid var(--sb-border);color:#ef4444;">(${fmtMoney(data.totalExpenses)})</td></tr>
            <tr><td style="font-weight:800;padding-top:16px;font-size:16px;">Lucro Líquido</td><td style="text-align:right;font-weight:800;padding-top:16px;font-size:16px;color:${profitColor};">${fmtMoney(data.netProfit)}</td></tr>
          </table>
          <div style="margin-top:20px;padding-top:16px;border-top:1px dashed var(--sb-border);font-size:12.5px;color:var(--sb-text-muted);">
            Mês anterior: Receita ${fmtMoney(data.previousPeriod.grossRevenue)} · Despesas ${fmtMoney(data.previousPeriod.totalExpenses)} · Lucro ${fmtMoney(data.previousPeriod.netProfit)}
          </div>
        `;

        // Gráfico: mês atual vs. mês anterior
        const compareCtx = document.getElementById('dreCompareChart');
        if (dreCompareChartInstance) dreCompareChartInstance.destroy();
        dreCompareChartInstance = new Chart(compareCtx, {
          type: 'bar',
          data: {
            labels: ['Receita', 'Despesas', 'Lucro Líquido'],
            datasets: [
              {
                label: 'Este mês',
                data: [data.grossRevenue, data.totalExpenses, data.netProfit],
                backgroundColor: '#0f4c81', borderRadius: 6, maxBarThickness: 42,
              },
              {
                label: 'Mês anterior',
                data: [data.previousPeriod.grossRevenue, data.previousPeriod.totalExpenses, data.previousPeriod.netProfit],
                backgroundColor: cssVar('--sb-border') || '#cbd5e1', borderRadius: 6, maxBarThickness: 42,
              },
            ],
          },
          options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, usePointStyle: true } } },
            scales: {
              x: { ticks: { color: scaleTextColor() }, grid: { display: false } },
              y: { ticks: { color: scaleTextColor(), callback: (v) => fmtMoneyShort(v) }, grid: { color: scaleGridColor() } },
            },
          },
        });

        // Gráfico: composição das despesas
        const catCtx = document.getElementById('dreCategoryChart');
        const catEntries = Object.entries(data.expensesByCategory).filter(([,v]) => Number(v) > 0);
        if (dreCategoryChartInstance) dreCategoryChartInstance.destroy();
        if (catEntries.length > 0) {
          dreCategoryChartInstance = new Chart(catCtx, {
            type: 'doughnut',
            data: {
              labels: catEntries.map(([cat]) => EXPENSE_CATEGORY_LABELS[cat] || cat),
              datasets: [{ data: catEntries.map(([,v]) => v), backgroundColor: CHART_COLORS, borderWidth: 0 }],
            },
            options: {
              responsive: true, maintainAspectRatio: false, cutout: '62%',
              plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, usePointStyle: true, font: { size: 11 } } }, centerText: 'Despesas' },
            },
          });
        }
      } catch (e) {
        body.innerHTML = `<div class="empty-state">${esc(e.message)}</div>`;
      }
    }
    document.getElementById('dreMonthPicker').addEventListener('change', loadDre);
    document.getElementById('dreDownloadBtn').addEventListener('click', () => {
      if (!lastDreData) return;
      const d = lastDreData;
      const rows = [
        ['Receita Bruta', d.grossRevenue],
        ['  Particular', (d.revenueBySource || {}).particular ?? d.grossRevenue],
        ['  Convênios (guias pagas)', (d.revenueBySource || {}).convenio ?? 0],
        ...Object.entries(d.expensesByCategory).map(([cat, val]) => ['  Despesa: ' + (EXPENSE_CATEGORY_LABELS[cat] || cat), -Math.abs(val)]),
        ['Total de Despesas', -Math.abs(d.totalExpenses)],
        ['Lucro Líquido', d.netProfit],
      ];
      downloadCSV(`dre-${document.getElementById('dreMonthPicker').value}.csv`, ['Linha', 'Valor'], rows);
    });

    // ── FLUXO DE CAIXA ──
    let cashflowChartInstance = null;
    let lastCashflowData = null;
    async function loadCashflow(){
      const tbody = document.getElementById('cashflowTbody');
      tbody.innerHTML = skeletonRows(5);
      try {
        const from = document.getElementById('cashflowFrom').value;
        const to = document.getElementById('cashflowTo').value;
        const data = await apiGet(`/api/finance/reports/cashflow?from=${from}&to=${to}`);
        lastCashflowData = data;
        document.getElementById('cashflowSummary').innerHTML = `
          Entradas: <strong style="color:#10b981;">${fmtMoney(data.totals.inflow)}</strong> &nbsp;·&nbsp;
          Saídas: <strong style="color:#ef4444;">${fmtMoney(data.totals.outflow)}</strong> &nbsp;·&nbsp;
          Líquido: <strong>${fmtMoney(data.totals.net)}</strong>
        `;
        const ctx = document.getElementById('cashflowChart');
        if (cashflowChartInstance) cashflowChartInstance.destroy();
        cashflowChartInstance = new Chart(ctx, {
          data: {
            labels: data.days.map(d => fmtDate(d.date)),
            datasets: [
              {
                type: 'bar',
                label: 'Fluxo diário líquido',
                data: data.days.map(d => d.net),
                backgroundColor: data.days.map(d => d.net >= 0 ? 'rgba(16,185,129,0.65)' : 'rgba(239,68,68,0.65)'),
                borderRadius: 4, maxBarThickness: 18, yAxisID: 'y',
                order: 2,
              },
              {
                type: 'line',
                label: 'Saldo acumulado',
                data: data.days.map(d => d.balance),
                borderColor: '#0f4c81', backgroundColor: 'rgba(15,76,129,0.08)',
                fill: true, tension: 0.3, pointRadius: 2, pointHoverRadius: 4,
                yAxisID: 'y1', order: 1,
              },
            ],
          },
          options: {
            responsive: true, maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
