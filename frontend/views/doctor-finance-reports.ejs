        const from = document.getElementById('profFrom').value;
        const to = document.getElementById('profTo').value;
        const data = await apiGet(`/api/finance/reports/profitability?groupBy=${groupBy}&from=${from}&to=${to}`);
        lastProfitabilityData = data;
        const headerLabel = { procedure: 'Procedimento', doctor: 'Profissional', specialty: 'Especialidade' }[groupBy] || 'Item';
        document.getElementById('profNameHeader').textContent = headerLabel;
        document.getElementById('profKpis').innerHTML = `
          <div class="stat-card"><div class="icon blue"><i class="fas fa-sack-dollar"></i></div><div class="info"><div class="stat-val">${fmtMoney(data.totals.revenue)}</div><div class="stat-label">Receita no período</div></div></div>
          <div class="stat-card"><div class="icon red"><i class="fas fa-user-md"></i></div><div class="info"><div class="stat-val">${fmtMoney(data.totals.cost)}</div><div class="stat-label">Custo (repasse médico)</div></div></div>
          <div class="stat-card"><div class="icon green"><i class="fas fa-chart-pie"></i></div><div class="info"><div class="stat-val">${fmtMoney(data.totals.margin)}</div><div class="stat-label">Margem (${data.totals.marginPct}%)</div></div></div>
        `;
        const top = [...data.rows].sort((a,b) => b.revenue - a.revenue).slice(0, 10);
        if (profChartInstance) profChartInstance.destroy();
        if (top.length > 0) {
          profChartInstance = new Chart(document.getElementById('profChart'), {
            type: 'bar',
            data: {
              labels: top.map(r => r.name),
              datasets: [
                { label: 'Receita', data: top.map(r => r.revenue), backgroundColor: '#0f4c81', borderRadius: 6, maxBarThickness: 26 },
                { label: 'Margem', data: top.map(r => r.margin), backgroundColor: '#10b981', borderRadius: 6, maxBarThickness: 26 },
              ],
            },
            options: {
              indexAxis: 'y', responsive: true, maintainAspectRatio: false,
              plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, usePointStyle: true } } },
              scales: {
                x: { ticks: { color: scaleTextColor(), callback: (v) => fmtMoneyShort(v) }, grid: { color: scaleGridColor() } },
                y: { ticks: { color: scaleTextColor() }, grid: { display: false } },
              },
            },
          });
        }
        tbody.innerHTML = data.rows.map(r => `
          <tr>
            <td>${esc(r.name)}</td><td>${r.count}</td><td>${fmtMoney(r.revenue)}</td><td>${fmtMoney(r.cost)}</td>
            <td>${fmtMoney(r.margin)}</td><td>${r.marginPct}%</td>
          </tr>
        `).join('') || '<tr><td colspan="6" class="empty-state">Nenhum atendimento pago no período.</td></tr>';
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="6" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }
    document.getElementById('profGroupBy').addEventListener('change', loadProfitability);
    document.getElementById('profRefreshBtn').addEventListener('click', loadProfitability);
    document.getElementById('profDownloadBtn').addEventListener('click', () => {
      if (!lastProfitabilityData) return;
      const headerLabel = { procedure: 'Procedimento', doctor: 'Profissional', specialty: 'Especialidade' }[lastProfitabilityData.groupBy] || 'Item';
      downloadCSV('lucratividade.csv', [headerLabel, 'Qtd.', 'Receita', 'Custo (Repasse)', 'Margem', 'Margem %'],
        lastProfitabilityData.rows.map(r => [r.name, r.count, r.revenue, r.cost, r.margin, r.marginPct + '%']));
    });

    // ── EVOLUÇÃO DE RECEITA ──
    let revChartInstance = null;
    let lastRevenueEvolutionData = null;
    async function loadRevenueEvolution(){
      const tbody = document.getElementById('revTbody');
      tbody.innerHTML = skeletonRows(5);
      try {
        const granularity = document.getElementById('revGranularity').value;
        const periods = document.getElementById('revPeriods').value;
        const data = await apiGet(`/api/finance/reports/revenue-evolution?granularity=${granularity}&periods=${periods}`);
        lastRevenueEvolutionData = data;
        const periodLabel = (p) => {
          const d = new Date(p);
          return granularity === 'month'
            ? d.toLocaleDateString('pt-BR', { month: 'short', year: '2-digit', timeZone: 'UTC' })
            : d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', timeZone: 'UTC' });
        };
        if (revChartInstance) revChartInstance.destroy();
        revChartInstance = new Chart(document.getElementById('revChart'), {
          data: {
            labels: data.rows.map(r => periodLabel(r.period)),
            datasets: [
              { type: 'bar', label: 'Particular', data: data.rows.map(r => r.particular), backgroundColor: '#0f4c81', borderRadius: 4, maxBarThickness: 26, stack: 'rev' },
              { type: 'bar', label: 'Convênio', data: data.rows.map(r => r.convenio), backgroundColor: '#7c3aed', borderRadius: 4, maxBarThickness: 26, stack: 'rev' },
            ],
          },
          options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, usePointStyle: true } } },
            scales: {
              x: { ticks: { color: scaleTextColor() }, grid: { display: false }, stacked: true },
              y: { ticks: { color: scaleTextColor(), callback: (v) => fmtMoneyShort(v) }, grid: { color: scaleGridColor() }, stacked: true },
            },
          },
        });
        tbody.innerHTML = data.rows.map(r => `
          <tr>
            <td>${periodLabel(r.period)}</td><td>${fmtMoney(r.particular)}</td><td>${fmtMoney(r.convenio)}</td><td>${fmtMoney(r.total)}</td>
            <td>${r.changePct != null ? (r.changePct >= 0 ? '+' : '') + r.changePct + '%' : '—'}</td>
          </tr>
        `).join('') || '<tr><td colspan="5" class="empty-state">Nenhum recebimento no período.</td></tr>';
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="5" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }
    document.getElementById('revGranularity').addEventListener('change', loadRevenueEvolution);
    document.getElementById('revPeriods').addEventListener('change', loadRevenueEvolution);
    document.getElementById('revRefreshBtn').addEventListener('click', loadRevenueEvolution);
    document.getElementById('revDownloadBtn').addEventListener('click', () => {
      if (!lastRevenueEvolutionData) return;
      downloadCSV('evolucao-de-receita.csv', ['Período','Particular','Convênio','Total','Variação'],
        lastRevenueEvolutionData.rows.map(r => [r.period, r.particular, r.convenio, r.total, r.changePct != null ? r.changePct + '%' : '']));
    });

    // ── RANKING DE PACIENTES ──
    let lastPatientsRankingData = null;
    async function loadPatientsRanking(){
      const tbody = document.getElementById('rankTbody');
      tbody.innerHTML = skeletonRows(6);
      try {
        const from = document.getElementById('rankFrom').value;
        const to = document.getElementById('rankTo').value;
        const data = await apiGet(`/api/finance/reports/patients-ranking?from=${from}&to=${to}`);
        lastPatientsRankingData = data;
        tbody.innerHTML = data.patients.map(p => `
          <tr>
            <td>${esc(p.name)}</td><td>${esc(p.phone || '—')}</td><td>${p.charges}</td>
            <td>${fmtMoney(p.total)}</td><td>${fmtMoney(p.averageTicket)}</td><td>${fmtDate(p.lastVisit)}</td>
          </tr>
        `).join('') || '<tr><td colspan="6" class="empty-state">Nenhum paciente com pagamento no período.</td></tr>';
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="6" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }
    document.getElementById('rankRefreshBtn').addEventListener('click', loadPatientsRanking);
    document.getElementById('rankDownloadBtn').addEventListener('click', () => {
      if (!lastPatientsRankingData) return;
      downloadCSV('ranking-pacientes.csv', ['Paciente','Telefone','Atendimentos','Valor Total','Ticket Médio','Último Atendimento'],
        lastPatientsRankingData.patients.map(p => [p.name, p.phone || '', p.charges, p.total, p.averageTicket, fmtDate(p.lastVisit)]));
    });

    // ── PACIENTES INATIVOS ──
    let lastPatientsInactiveData = [];
    async function loadPatientsInactive(){
      const tbody = document.getElementById('inactiveTbody');
      tbody.innerHTML = skeletonRows(4);
      try {
        const days = document.getElementById('inactiveDays').value;
        const data = await apiGet(`/api/finance/reports/patients-inactive?days=${days}`);
        lastPatientsInactiveData = data.patients;
        tbody.innerHTML = data.patients.map(p => `
          <tr><td>${esc(p.name)}</td><td>${esc(p.phone || '—')}</td><td>${fmtDate(p.lastVisit)}</td><td>${p.daysInactive} dias</td></tr>
        `).join('') || '<tr><td colspan="4" class="empty-state">Nenhum paciente inativo encontrado.</td></tr>';
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="4" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }
    document.getElementById('inactiveDays').addEventListener('change', loadPatientsInactive);
    document.getElementById('inactiveRefreshBtn').addEventListener('click', loadPatientsInactive);
    document.getElementById('inactiveDownloadBtn').addEventListener('click', () => {
      downloadCSV('pacientes-inativos.csv', ['Paciente','Telefone','Último Atendimento','Dias sem Retorno'],
        lastPatientsInactiveData.map(p => [p.name, p.phone || '', fmtDate(p.lastVisit), p.daysInactive]));
    });

    // ── ANIVERSARIANTES ──
    let lastPatientsBirthdaysData = [];
    async function loadPatientsBirthdays(){
      const tbody = document.getElementById('birthdayTbody');
      tbody.innerHTML = skeletonRows(3);
      try {
        const month = document.getElementById('birthdayMonth').value;
        const data = await apiGet(`/api/finance/reports/patients-birthdays?month=${month}`);
        lastPatientsBirthdaysData = data.patients;
        tbody.innerHTML = data.patients.map(p => `
          <tr><td>${esc(p.name)}</td><td>${fmtDate(p.birthDate)}</td><td>${esc(p.phone || '—')}</td></tr>
        `).join('') || '<tr><td colspan="3" class="empty-state">Nenhum aniversariante neste mês.</td></tr>';
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="3" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }
    document.getElementById('birthdayMonth').addEventListener('change', loadPatientsBirthdays);
    document.getElementById('birthdayDownloadBtn').addEventListener('click', () => {
      downloadCSV('aniversariantes.csv', ['Paciente','Data de Nascimento','Telefone'],
        lastPatientsBirthdaysData.map(p => [p.name, fmtDate(p.birthDate), p.phone || '']));
    });

    // ── INIT: datas padrao (ultimos 30 dias) e mes atual ──
    (function initDefaults(){
      const now = new Date();
      document.getElementById('dreMonthPicker').value = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}`;
      ['cashflowFrom','pmFrom','atFrom','commFrom','profFrom','rankFrom'].forEach(id => document.getElementById(id).value = daysAgoISO(29));
      ['cashflowTo','pmTo','atTo','commTo','profTo','rankTo'].forEach(id => document.getElementById(id).value = todayISO());
      const monthNames = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
      const birthdaySelect = document.getElementById('birthdayMonth');
      birthdaySelect.innerHTML = monthNames.map((m, i) => `<option value="${i+1}">${m}</option>`).join('');
      birthdaySelect.value = String(now.getMonth() + 1);
    })();

    loadDre();
    loadedTabs.add('dre');

    // Socket.io — atualiza os relatorios abertos quando houver mudancas no caixa/despesas
    (function() {
      const _d = JSON.parse(localStorage.getItem('doctorData') || '{}');
      if (!_d.id) return;
      const _sock = io({ transports: ['websocket', 'polling'] });
      _sock.on('connect', () => {
        _sock.emit('join_doctor', _d.id);
        if (_d.clinicId) _sock.emit('join_clinic', _d.clinicId);
      });
      ['cash_transaction_created', 'cash_transaction_paid', 'cash_transaction_canceled', 'cash_transaction_updated',
       'expense_created', 'expense_paid'].forEach((evt) => {
        _sock.on(evt, () => {
          loadedTabs.forEach((tab) => tabLoaders[tab]?.());
        });
      });
    })();
  </script>

  <script src="/socket.io/socket.io.js"></script>
</body>
</html>