    <!-- ============================================================
    SCRIPT — FUNCIONALIDADES DA SIDEBAR
    ============================================================ -->
    <script>
      (function initSidebar() {
        // ----- TOGGLE (abrir/fechar) -----
        const sidebar = document.querySelector('.sidebar');
        const toggleBtn = document.getElementById('sidebarToggleBtn');
        const overlay = document.getElementById('sidebarOverlay');
        let isCollapsed = false;

        // Verifica preferência salva
        const savedCollapse = localStorage.getItem('sidebarCollapsed');
        if (savedCollapse === 'true') {
          sidebar.classList.add('collapsed');
          isCollapsed = true;
        }

        toggleBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          if (window.innerWidth <= 992) {
            sidebar.classList.toggle('open');
            overlay.classList.toggle('active');
            document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
          } else {
            isCollapsed = !isCollapsed;
            sidebar.classList.toggle('collapsed', isCollapsed);
            localStorage.setItem('sidebarCollapsed', String(isCollapsed));
          }
        });

        overlay.addEventListener('click', function() {
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        });

        window.addEventListener('resize', function() {
          if (window.innerWidth > 992) {
            sidebar.classList.remove('open');
            overlay.classList.remove('active');
            document.body.style.overflow = '';
          }
        });

        // ----- TOGGLE TEMA (claro/escuro) -----
        const themeToggle = document.getElementById('themeToggle');
        const currentTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', currentTheme);

        themeToggle.addEventListener('click', function() {
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          const newTheme = isDark ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', newTheme);
          localStorage.setItem('theme', newTheme);
        });

        // ----- LÓGICA ORIGINAL (autenticação, permissões, etc) -----
        const doctorToken = localStorage.getItem('doctorToken');
        const receptionToken = localStorage.getItem('receptionToken');
        const token = doctorToken || receptionToken;
        const isReceptionSession = !doctorToken && !!receptionToken;
        const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');
        const nameEl = document.getElementById('sidebarName');
        const roleEl = document.getElementById('sidebarRole');
        const clinicEl = document.getElementById('sidebarClinic');

        if (nameEl) nameEl.textContent = doctorData.name || 'Profissional';
        if (roleEl) roleEl.textContent = isReceptionSession ? 'Recepcionista' : (doctorData.isClinicOwner ? 'Owner da Clinica' : 'Profissional');
        if (clinicEl) clinicEl.textContent = 'Clinica: ' + (doctorData.clinicName || '--');

        const logoutBtn = document.getElementById('logoutBtn');
        if (logoutBtn) {
          logoutBtn.addEventListener('click', function() {
            localStorage.removeItem('doctorToken'); localStorage.removeItem('doctorData');
        localStorage.removeItem('receptionToken'); localStorage.removeItem('receptionData');
        window.location.href = isReceptionSession ? '/recepcao/login' : '/medico/login';
          });
        }

        // Grupos colapsáveis
        document.querySelectorAll('.sb-group-btn').forEach((btn) => {
          btn.addEventListener('click', function() {
            const group = this.closest('.sb-group');
            if (group) group.classList.toggle('open');
          });
        });

        // Item ativo baseado na URL
        const path = window.location.pathname;
        document.querySelectorAll('#sidebarNav .nav-item').forEach((a) => {
          if (a.getAttribute('href') === path) a.classList.add('active');
        });

        if (!token) return;

        // Carrega dados do usuário
        fetch('/api/auth/me', { headers: { Authorization: 'Bearer ' + token } })
          .then((r) => (r.ok ? r.json() : null))
          .then((me) => {
            if (!me) return;
            if (nameEl && me.name) nameEl.textContent = me.name;
            if (roleEl) roleEl.textContent = me.isClinicOwner ? 'Owner da Clinica' : 'Profissional';
            if (clinicEl) clinicEl.textContent = 'Clinica: ' + (me.clinicName || '--');
          })
          .catch(() => {});

        // Permissões
        fetch(isReceptionSession ? '/api/auth/permissions-receptionist' : '/api/auth/permissions', { headers: { Authorization: 'Bearer ' + token } })
          .then((r) => r.ok ? r.json() : null)
          .then((data) => {
            if (!data || !Array.isArray(data.pages)) return;
            const allowed = new Set((data.pages || []).filter((p) => p.can_view).map((p) => p.code));
            document.querySelectorAll('#sidebarNav .nav-item[data-page]').forEach((item) => {
              const rawCodes = item.getAttribute('data-page-codes') || item.getAttribute('data-page') || '';
              const pageCodes = rawCodes.split(',').map((code) => code.trim()).filter(Boolean);
              const canSee = pageCodes.some((code) => allowed.has(code));
              item.hidden = !canSee;
            });
            document.querySelectorAll('.sb-group').forEach((g) => {
              const hasVisible = Array.from(g.querySelectorAll('.nav-item')).some((i) => !i.hidden);
              g.style.display = hasVisible ? '' : 'none';
            });
          })
          .catch(() => {});
      })();
    </script>
  </aside>

  <!-- ============================================================
       MAIN — CONTEÚDO DA PÁGINA DE PROCEDIMENTOS
       ============================================================ -->
  <main class="main">
    <header class="topbar">
      <div>
        <h1>Procedimentos</h1>
        <div class="meta">Cadastro e histórico de procedimentos</div>
      </div>
      <div class="topbar-actions">
        <span class="badge"><i class="fas fa-circle" style="color:var(--accent-5);font-size:10px;"></i> Online</span>
        <a href="/medico" class="btn btn-outline btn-sm">← Dashboard</a>
      </div>
    </header>

    <div class="content">

      <!-- TABS -->
      <div class="tabs-row">
        <button class="tab-btn active" id="tabNew" onclick="showTab('new')">Novo Procedimento</button>
        <button class="tab-btn" id="tabHistory" onclick="showTab('history')">Histórico</button>
        <a class="tab-btn" href="/medico/procedimentos/tipos" style="text-decoration:none;display:inline-flex;align-items:center;">Tipos de Procedimento</a>
      </div>

      <!-- NOVO PROCEDIMENTO -->
      <div id="paneNew">
        <div class="card">
          <div class="card-header"><h3><i class="fas fa-syringe" style="color:var(--accent-2);"></i> Cadastrar Procedimento</h3></div>
          <div class="card-body">
            <form id="surgeryForm">
              <div class="form-grid">
                <div class="form-group span2"><label>Paciente</label>
                  <input type="text" id="sPatientSearch" placeholder="Pesquisar paciente por nome ou ID...">
                  <select id="sPatientsSelect"><option value="">Selecione o paciente</option></select>
                </div>
                <div class="form-group span2"><label>Prontuário Médico (obrigatório)</label>
                  <div class="record-filter-box">
                    <div class="record-filter-line">
                      <input type="text" id="sMedicalRecordSearch" placeholder="Buscar prontuário por título, resumo ou data..." style="flex:1;min-width:240px;">
                      <label style="font-size:11px;color:var(--text-md);display:flex;align-items:center;gap:6px;">
                        <input type="checkbox" id="sMedicalRecordSameDay" checked>
                        Mesmo dia do procedimento
                      </label>
                    </div>
                    <select id="sMedicalRecordSelect" required>
                      <option value="">Selecione um paciente para listar prontuários</option>
                    </select>
                    <div class="record-hint">Use os filtros para encontrar prontuários concluídos no mesmo dia do procedimento.</div>
                  </div>
                </div>
                <div class="form-group"><label>Categoria do Procedimento</label>
                  <select id="sProcedureCategory"><option value="">Todas</option></select>
                </div>
                <div class="form-group"><label>Tipo de Procedimento</label>
                  <select id="sProcedureType">
                    <option value="">Carregando tipos...</option>
                  </select>
                </div>
                <div class="form-group span2"><label>Nome / Descrição do Procedimento</label>
                  <input type="text" id="sProcedure" required placeholder="Ex: Rinoplastia primária, Botox preventivo...">
                </div>
                <div class="form-group"><label>Data</label><input type="date" id="sDate"></div>
                <div class="form-group"><label>Status</label>
                  <select id="sStatus">
                    <option value="DRAFT">Rascunho</option>
                    <option value="scheduled">Agendado</option>
                    <option value="AWAITING_SIGNATURE">Em atendimento</option>
                    <option value="SIGNED">Assinado</option>
                    <option value="completed">Concluído</option>
                    <option value="cancelled">Cancelado</option>
                  </select>
                </div>
                <div class="form-group"><label>Classificação</label>
                  <select id="sClassification">
                    <option value="PADRAO" selected>Padrão</option>
                    <option value="CRITICO">Crítico (exige ICP-Brasil)</option>
                  </select>
                </div>
                <div class="form-group span2"><label>Observações clínicas</label>
                  <textarea id="sNotes" placeholder="Notas, detalhes, histórico..."></textarea>
                </div>
              </div>
              <div style="margin-top:18px;display:flex;gap:12px;flex-wrap:wrap;">
                <button type="submit" class="btn btn-solid" id="surgerySubmitBtn">
                  <i class="fas fa-save"></i> Registrar Procedimento
                </button>
                <button type="button" class="btn btn-outline" onclick="showTab('history')">Ver Histórico</button>
              </div>
              <div class="alert-msg alert-ok" id="surgeryOk"></div>
              <div class="alert-msg alert-err" id="surgeryErr"></div>
            </form>
          </div>
        </div>
      </div>

      <!-- HISTÓRICO -->
      <div id="paneHistory" style="display:none">
        <div class="card">
          <div class="card-header">
            <h3><i class="fas fa-list-ul"></i> Histórico de Procedimentos</h3>
            <div class="search-bar">
              <input type="text" id="searchProc" placeholder="Buscar procedimento...">
              <select id="statusFilter">
                <option value="">Todos os status</option>
                <option value="DRAFT">Rascunho</option>
                <option value="scheduled">Agendado</option>
                <option value="AWAITING_SIGNATURE">Em atendimento</option>
                <option value="completed">Concluído</option>
                <option value="cancelled">Cancelado</option>
                <option value="SIGNED">Assinado</option>
              </select>
              <select id="patientFilter"><option value="">Todos os pacientes</option></select>
            </div>
          </div>
          <div class="card-body" style="padding:0">
            <div class="table-wrap">
              <table>
                <thead><tr><th>Paciente</th><th>Procedimento</th><th>Tipo</th><th>Data</th><th>Status</th><th>Ações</th></tr></thead>
                <tbody id="surgeriesList"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>

  <!-- ============================================================
  MODAL EDITAR PROCEDIMENTO
  ============================================================ -->
  <div id="editModal">
    <div class="modal-box">
      <div class="modal-head">
        <h3>Editar Procedimento</h3>
        <button class="modal-close" onclick="closeEditModal()">&times;</button>
      </div>
      <div class="modal-body">
        <form id="editForm">
          <div class="form-grid">
            <div class="form-group span2"><label>Nome / Descrição</label><input type="text" id="eTitle" required></div>
            <div class="form-group"><label>Tipo</label>
              <select id="eProcedureType">
                <option value="">Selecione</option>
              </select>
            </div>
            <div class="form-group"><label>Data</label><input type="date" id="eDate"></div>
            <div class="form-group"><label>Status</label>
              <select id="eStatus">
                <option value="DRAFT">Rascunho</option>
                <option value="scheduled">Agendado</option>
                <option value="AWAITING_SIGNATURE">Em atendimento</option>
                <option value="SIGNED">Assinado</option>
                <option value="completed">Concluído</option>
                <option value="cancelled">Cancelado</option>
              </select>
            </div>
            <div class="form-group"><label>Classificação</label>
              <select id="eClassification">
                <option value="PADRAO">Padrão</option>
                <option value="CRITICO">Crítico (exige ICP-Brasil)</option>
              </select>
            </div>
            <div class="form-group span2"><label>Observações</label><textarea id="eNotes"></textarea></div>
          </div>
          <div style="display:flex;gap:10px;margin-top:16px;justify-content:flex-end;flex-wrap:wrap;">
            <button type="button" class="btn btn-outline btn-sm" onclick="closeEditModal()">Cancelar</button>
            <button type="submit" class="btn btn-solid btn-sm" id="editSaveBtn">Salvar</button>
          </div>
          <div class="alert-msg alert-err" id="editErr"></div>
        </form>
      </div>
    </div>
  </div>

  <!-- ============================================================
  SCRIPTS DA PÁGINA (preservados e adaptados)
  ============================================================ -->
  <script>
    (function initTheme() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();

    const doctorToken = localStorage.getItem('doctorToken');
    const receptionToken = localStorage.getItem('receptionToken');
    const token = doctorToken || receptionToken;
    const isReceptionSession = !doctorToken && !!receptionToken;
    const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');
    if (!token) window.location.href = '/medico/login';
    if (doctorData.name) document.getElementById('sidebarName').textContent = doctorData.name;

    const h = { 'Content-Type':'application/json','Authorization':'Bearer '+token };

    // ── DADOS GLOBAIS ──
    let allSurgeries = [], allPatients = [], allProcedureTypes = [], allProcedureCategories = [], editingId = null;
    const recordsByPatient = new Map();

    // ── FUNÇÕES ──
    function showTab(t) {
      document.getElementById('paneNew').style.display = t==='new' ? '' : 'none';
      document.getElementById('paneHistory').style.display = t==='history' ? '' : 'none';
      document.getElementById('tabNew').classList.toggle('active', t==='new');
      document.getElementById('tabHistory').classList.toggle('active', t==='history');
      if (t==='history') renderList();
    }

    function fmtDate(d) { if (!d) return '—'; return new Date(d).toLocaleDateString('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric'}); }
    function esc(v) { return String(v || '').replace(/[&<>"']/g, (s) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[s])); }
    function fmtCategory(v) {
      const map = { CIRURGIA:'Cirurgia', EXAME:'Exame', TRATAMENTO:'Tratamento', CONSULTA_ESPECIALIZADA:'Consulta Especializada', INTERNACAO:'Internacao', OUTRO:'Outro' };
      return map[v] || v || 'Sem categoria';
    }
    function normalizeText(v) {
      return String(v || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    }
    function toDateKey(v) {
      if (!v) return '';
      const d = new Date(v);
      if (Number.isNaN(d.getTime())) return '';
      return d.toISOString().slice(0, 10);
    }
    function statusBadge(s) {
      const map={DRAFT:'badge-gray',scheduled:'badge-blue',completed:'badge-green',cancelled:'badge-red',SIGNED:'badge-green',AWAITING_SIGNATURE:'badge-yellow'};
      const lbl={DRAFT:'Rascunho',scheduled:'Agendado',completed:'Concluído',cancelled:'Cancelado',SIGNED:'Assinado',AWAITING_SIGNATURE:'Em atendimento'};
      return `<span class="badge ${map[s]||'badge-gray'}">${lbl[s]||s||'—'}</span>`;
    }

    function fillPatientSelect(filteredPatients) {
      const sel = document.getElementById('sPatientsSelect');
      const list = filteredPatients || allPatients;
      sel.innerHTML = '<option value="">Selecione o paciente</option>' + list.map(p => {
        const suffix = p.id ? ` · ${String(p.id).slice(0, 8)}` : '';
        return `<option value="${p.id}">${esc(p.name || 'Paciente')}${suffix}</option>`;
      }).join('');
    }

    function fillProcedureTypeSelect() {
      const cat = document.getElementById('sProcedureCategory').value;
      const typeSel = document.getElementById('sProcedureType');
      const editSel = document.getElementById('eProcedureType');
      const filtered = allProcedureTypes.filter(t => !cat || String(t.category || '') === cat);
      const options = '<option value="">— Selecione o tipo —</option>' + filtered.map(t => `<option value="${esc(t.name)}">${esc(t.name)}${t.category ? ' · ' + esc(fmtCategory(t.category)) : ''}</option>`).join('');
      typeSel.innerHTML = options;
      editSel.innerHTML = '<option value="">Selecione</option>' + allProcedureTypes.map(t => `<option value="${esc(t.name)}">${esc(t.name)}${t.category ? ' · ' + esc(fmtCategory(t.category)) : ''}</option>`).join('');
    }

    async function loadMedicalRecordsByPatient(patientId, preferredRecordId = '') {
      const sel = document.getElementById('sMedicalRecordSelect');
      if (!patientId) {
        sel.innerHTML = '<option value="">Selecione um paciente para listar prontuários</option>';
        return;
      }

      sel.innerHTML = '<option value="">Carregando prontuários...</option>';
      try {
        const res = await fetch(`/api/patients/${patientId}/medical-records`, { headers: h });
        if (!res.ok) {
          sel.innerHTML = '<option value="">Não foi possível carregar os prontuários</option>';
          return;
        }

        const records = await res.json();
        recordsByPatient.set(String(patientId), records);
        if (!records.length) {
          sel.innerHTML = '<option value="">Nenhum prontuário encontrado para este paciente</option>';
          return;
        }

        const searchTerm = normalizeText(document.getElementById('sMedicalRecordSearch').value);
        const sameDayOnly = document.getElementById('sMedicalRecordSameDay').checked;
        const procedureDate = toDateKey(document.getElementById('sDate').value);

        let filtered = records.slice();
        if (sameDayOnly && procedureDate) {
          filtered = filtered.filter((r) => toDateKey(r.closed_at || r.updated_at || r.created_at) === procedureDate);
        }
        if (searchTerm) {
          filtered = filtered.filter((r) => {
            const text = normalizeText([r.title, r.summary, r.clinical_history, r.allergies, r.current_medications].join(' '));
            const dateText = normalizeText((r.closed_at || r.updated_at || r.created_at || '').slice(0, 10));
            return text.includes(searchTerm) || dateText.includes(searchTerm);
          });
        }

        if (!filtered.length) {
          sel.innerHTML = '<option value="">Nenhum prontuário elegível para os filtros atuais</option>';
          return;
        }

        sel.innerHTML = '<option value="">Selecione o prontuário</option>' + filtered.map((r) => {
          const refDate = r.closed_at || r.updated_at || r.created_at;
          const labelDate = refDate ? new Date(refDate).toLocaleDateString('pt-BR') : 'sem data';
          const statusLabel = String(r.status || '').toUpperCase() === 'COMPLETED' ? 'Concluído' : 'Em andamento';
          return `<option value="${r.id}">${esc(r.title || 'Prontuário')} · ${statusLabel} · ${labelDate}</option>`;
        }).join('');

        if (preferredRecordId) sel.value = preferredRecordId;
      } catch (_e) {
        sel.innerHTML = '<option value="">Erro ao carregar prontuários</option>';
      }
    }

    async function load() {
      const [pRes, sRes, ptRes, pcRes] = await Promise.all([
        fetch('/api/patients',{headers:h}),
        fetch('/api/surgeries',{headers:h}),
        fetch('/api/procedure-types',{headers:h}),
        fetch('/api/procedure-types/categories',{headers:h}),
      ]);
      allPatients = pRes.ok ? await pRes.json() : [];
      allSurgeries = sRes.ok ? await sRes.json() : [];
      allProcedureTypes = ptRes.ok ? await ptRes.json() : [];
      allProcedureCategories = pcRes.ok ? await pcRes.json() : [];

      fillPatientSelect();
      const pf = document.getElementById('patientFilter');
      pf.innerHTML = '<option value="">Todos os pacientes</option>' + allPatients.map(p => `<option value="${p.id}">${esc(p.name || 'Paciente')}</option>`).join('');

      const catSel = document.getElementById('sProcedureCategory');
      catSel.innerHTML = '<option value="">Todas</option>' + allProcedureCategories.map(c => `<option value="${esc(c.name)}">${esc(fmtCategory(c.name))}</option>`).join('');
      fillProcedureTypeSelect();

      renderList();
    }

    function renderList() {
      const q = (document.getElementById('searchProc').value||'').toLowerCase();
      const sf = document.getElementById('statusFilter').value;
      const pf = document.getElementById('patientFilter').value;
      let list = allSurgeries.filter(s => s.status !== 'cancelled');
      if (q) list = list.filter(s =>
        (s.title || '').toLowerCase().includes(q)
        || (s.patient_name || '').toLowerCase().includes(q)
        || String(s.id || '').toLowerCase().includes(q)
        || String(s.patient_id || '').toLowerCase().includes(q)
        || String(s.procedure_type || '').toLowerCase().includes(q)
      );
      if (sf) list = list.filter(s=>s.status===sf);
      if (pf) {
        list = list.filter(s=>String(s.patient_id)===pf);
        list = list.filter(s=>['DRAFT','AWAITING_SIGNATURE','scheduled'].includes(s.status));
      }

      const tbody = document.getElementById('surgeriesList');
      if (!list.length) { tbody.innerHTML='<tr><td colspan="6" style="text-align:center;padding:28px;color:var(--text-muted);font-size:11px">Nenhum procedimento encontrado</td></tr>'; return; }
      tbody.innerHTML = list.map(s=>{
        const signBtn = s.access_token && s.status !== 'cancelled'
          ? '<a href="/paciente/assinar/'+esc(s.access_token)+'" target="_blank" class="btn btn-outline btn-sm" style="margin-left:4px">Assinar</a>'
          : '';
        return `<tr>
          <td>${s.patient_name||'—'}</td>
          <td><strong>${s.title||'—'}</strong>${s.medical_record_title ? `<div style="font-size:10px;color:var(--text-muted);margin-top:2px;">Prontuário: ${esc(s.medical_record_title)}</div>` : ''}</td>
          <td><span class="badge badge-gray">${s.procedure_type||'—'}</span></td>
          <td style="color:var(--text-muted)">${fmtDate(s.scheduled_at)}</td>
          <td>${statusBadge(s.status)}</td>
          <td><button class="btn btn-outline btn-sm" onclick="openEdit('${s.id}')">Editar</button>${signBtn}</td>
        </tr>`;
      }).join('');
    }

    document.getElementById('searchProc').addEventListener('input', renderList);
    document.getElementById('statusFilter').addEventListener('change', renderList);
    document.getElementById('patientFilter').addEventListener('change', renderList);
    document.getElementById('sProcedureCategory').addEventListener('change', fillProcedureTypeSelect);
    document.getElementById('sPatientsSelect').addEventListener('change', (e) => {
      const patientId = e.target.value;
      loadMedicalRecordsByPatient(patientId);
    });
    document.getElementById('sDate').addEventListener('change', () => {
      const patientId = document.getElementById('sPatientsSelect').value;
      if (patientId) loadMedicalRecordsByPatient(patientId);
    });
    document.getElementById('sMedicalRecordSearch').addEventListener('input', () => {
      const patientId = document.getElementById('sPatientsSelect').value;
      if (patientId) loadMedicalRecordsByPatient(patientId);
    });
    document.getElementById('sMedicalRecordSameDay').addEventListener('change', () => {
      const patientId = document.getElementById('sPatientsSelect').value;
      if (patientId) loadMedicalRecordsByPatient(patientId);
    });
    document.getElementById('sPatientSearch').addEventListener('input', (e) => {
      const q = (e.target.value || '').trim().toLowerCase();
      if (!q) return fillPatientSelect();
      const filtered = allPatients.filter(p =>
        (p.name || '').toLowerCase().includes(q)
        || String(p.id || '').toLowerCase().includes(q)
      );
      fillPatientSelect(filtered);
    });

    // ── CADASTRO ──
    document.getElementById('surgeryForm').addEventListener('submit', async e => {
      e.preventDefault();
      const btn = document.getElementById('surgerySubmitBtn');
      const ok = document.getElementById('surgeryOk');
      const err = document.getElementById('surgeryErr');
      ok.style.display='none'; err.style.display='none';

      const patientId = document.getElementById('sPatientsSelect').value;
      const medicalRecordId = document.getElementById('sMedicalRecordSelect').value;
      if (!patientId || !medicalRecordId) {
        err.textContent='Selecione paciente e prontuário médico antes de registrar o procedimento.';
        err.style.display='block';
        return;
      }

      btn.disabled=true; btn.innerHTML='<span class="spin"></span>Salvando...';
      try {
        const res = await fetch('/api/surgeries',{method:'POST',headers:h,body:JSON.stringify({
          patientId,
          medicalRecordId,
          title: document.getElementById('sProcedure').value.trim(),
          procedureType: document.getElementById('sProcedureType').value,
          scheduledAt: document.getElementById('sDate').value,
          status: document.getElementById('sStatus').value,
          procedureClassification: document.getElementById('sClassification').value,
          requireQualifiedSignature: document.getElementById('sClassification').value === 'CRITICO',
          notes: document.getElementById('sNotes').value.trim(),
        })});
        const data = await res.json();
        if (res.ok) {
          ok.textContent='Procedimento registrado com sucesso!';
          ok.style.display='block';
          e.target.reset();
          document.getElementById('sMedicalRecordSelect').innerHTML = '<option value="">Selecione um paciente para listar prontuários</option>';
          await load();
        }
        else { err.textContent=data.error||'Erro ao registrar.'; err.style.display='block'; }
      } catch { err.textContent='Erro de conexão.'; err.style.display='block'; }
      btn.disabled=false; btn.innerHTML='<i class="fas fa-save"></i> Registrar Procedimento';
    });

    // ── EDITAR ──
    function openEdit(id) {
      const s = allSurgeries.find(x=>String(x.id)===id);
      if (!s) return;
      editingId = id;
      document.getElementById('eTitle').value = s.title||'';
      document.getElementById('eProcedureType').value = s.procedure_type||'';
      document.getElementById('eDate').value = s.scheduled_at ? String(s.scheduled_at).slice(0,10) : '';
      document.getElementById('eStatus').value = s.status||'DRAFT';
      document.getElementById('eClassification').value = s.procedure_classification || (s.require_qualified_signature ? 'CRITICO' : 'PADRAO');
      document.getElementById('eNotes').value = s.notes||'';
      document.getElementById('editErr').style.display='none';
      document.getElementById('editModal').style.display='flex';
    }
    function closeEditModal() { document.getElementById('editModal').style.display='none'; editingId=null; }

    document.getElementById('editForm').addEventListener('submit', async e => {
      e.preventDefault();
      if (!editingId) return;
      const btn = document.getElementById('editSaveBtn');
      const err = document.getElementById('editErr');
      err.style.display='none';
      btn.disabled=true; btn.textContent='Salvando...';
      try {
        const res = await fetch(`/api/surgeries/${editingId}`,{method:'PUT',headers:h,body:JSON.stringify({
          title: document.getElementById('eTitle').value.trim(),
          procedureType: document.getElementById('eProcedureType').value,
          scheduledAt: document.getElementById('eDate').value,
          status: document.getElementById('eStatus').value,
          procedureClassification: document.getElementById('eClassification').value,
          requireQualifiedSignature: document.getElementById('eClassification').value === 'CRITICO',
          notes: document.getElementById('eNotes').value.trim(),
        })});
        const data = await res.json();
        if (res.ok) { closeEditModal(); await load(); }
        else { err.textContent=data.error||'Erro ao salvar.'; err.style.display='block'; }
      } catch { err.textContent='Erro de conexão.'; err.style.display='block'; }
      btn.disabled=false; btn.textContent='Salvar';
    });

    // ── URL PARAM ──
    const urlTab = new URLSearchParams(location.search).get('tab');
    if (urlTab === 'history') showTab('history');

    // ── INICIALIZAÇÃO ──
    load();

    // ── SOCKET.IO (atualizações em tempo real) ──
    (function(){
      const _tok = localStorage.getItem('doctorToken');
      const _doc = JSON.parse(localStorage.getItem('doctorData')||'{}');
      if (!_tok || !_doc.id) return;
      const _sock = io({ transports: ['websocket','polling'] });
      _sock.on('connect', () => _sock.emit('join_doctor', _doc.id));
      _sock.on('procedure_created', () => { if(typeof load==='function') load(); });
      _sock.on('procedure_updated', () => { if(typeof load==='function') load(); });
      _sock.on('procedure_type_created', () => { if(typeof load==='function') load(); });
      _sock.on('procedure_type_updated', () => { if(typeof load==='function') load(); });
      _sock.on('procedure_type_deleted', () => { if(typeof load==='function') load(); });
      _sock.on('procedure_category_created', () => { if(typeof load==='function') load(); });
      _sock.on('procedure_category_updated', () => { if(typeof load==='function') load(); });
    })();
  </script>

  <!-- socket.io -->
  <script src="/socket.io/socket.io.js"></script>
</body>
</html>