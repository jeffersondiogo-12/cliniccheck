        padding-top: 8px;
        border-top: 1px solid var(--sb-border);
      }

      .sb-group-btn {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: transparent;
        border: 0;
        color: var(--sb-text-muted);
