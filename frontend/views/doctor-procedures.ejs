<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clinic Chek · Procedimentos</title>
  <link rel="icon" type="image/svg+xml" href="/public/brand/clinic-check-favicon.svg">
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    /* ============================================================
       ESTILOS GLOBAIS (compatíveis com o tema da sidebar)
       ============================================================ */
    :root {
      --bg-base: #edf2f7;
      --bg-surface: #f7fafc;
      --bg-card: #ffffff;
      --bg-card-hover: #f0f5ff;
      --bg-elevated: #eef2f7;
      --bg-input: #ffffff;
      --border-subtle: #e2e8f0;
      --border-card: #e2e8f0;
      --text-primary: #2d3748;
      --text-secondary: #4a5568;
      --text-muted: #718096;
      --accent-1: #4a90d9;
      --accent-1-dim: #e8f0fe;
      --accent-2: #6bc5b8;
      --accent-2-dim: #e6f7f2;
      --accent-3: #b794f4;
      --accent-3-dim: #f0e8ff;
      --accent-4: #f6ad55;
      --accent-4-dim: #fef5e7;
      --accent-5: #6fcf97;
      --accent-5-dim: #eafaf1;
      --red: #e53e3e;
      --red-bg: #fff5f5;
      --shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
      --shadow-hover: 0 8px 30px rgba(0, 0, 0, 0.10);
      --radius: 12px;
      --font: 'Inter', system-ui, -apple-system, sans-serif;
      --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    [data-theme="dark"] {
      --bg-base: #0b1120;
      --bg-surface: #111c2e;
      --bg-card: #162033;
      --bg-card-hover: #1c2a42;
      --bg-elevated: #1e2d45;
      --bg-input: #111c2e;
      --border-subtle: rgba(255, 255, 255, 0.06);
      --border-card: rgba(255, 255, 255, 0.07);
      --text-primary: #f0f4ff;
      --text-secondary: #b0c4e8;
      --text-muted: #7a8aa8;
      --accent-1: #3b82f6;
      --accent-1-dim: rgba(59, 130, 246, 0.15);
      --accent-2: #06b6d4;
      --accent-2-dim: rgba(6, 182, 212, 0.12);
      --accent-3: #8b5cf6;
      --accent-3-dim: rgba(139, 92, 246, 0.12);
      --accent-4: #f59e0b;
      --accent-4-dim: rgba(245, 158, 11, 0.12);
      --accent-5: #10b981;
      --accent-5-dim: rgba(16, 185, 129, 0.12);
      --red: #f87171;
      --red-bg: rgba(239, 68, 68, 0.08);
      --shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
      --shadow-hover: 0 12px 40px rgba(0, 0, 0, 0.45);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: var(--font);
      background: var(--bg-base);
      color: var(--text-primary);
      display: flex;
      min-height: 100vh;
      transition: background var(--transition), color var(--transition);
    }

    .main {
      margin-left: 280px;
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      background: var(--bg-base);
      transition: background var(--transition), margin-left var(--transition);
    }

    .topbar {
      padding: 16px 32px;
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 40;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition: background var(--transition), border-color var(--transition);
    }
    .topbar h1 {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.3px;
      color: var(--text-primary);
    }
    .topbar .meta {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
    }
    .topbar-actions {
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .topbar-actions .badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--text-secondary);
      background: var(--bg-elevated);
      padding: 4px 14px 4px 10px;
      border-radius: 20px;
      border: 1px solid var(--border-subtle);
    }

    .content {
      padding: 24px 32px 40px;
      flex: 1;
    }

    /* ============================================================
       CARDS, FORMULÁRIOS, TABELAS (estilos da página de procedimentos)
       ============================================================ */
    .card {
      background: var(--bg-card);
      border-radius: var(--radius);
      border: 1px solid var(--border-card);
      overflow: hidden;
      margin-bottom: 20px;
      box-shadow: var(--shadow);
      transition: background var(--transition), border-color var(--transition), box-shadow var(--transition), transform 0.25s ease;
    }
    .card:hover {
      box-shadow: var(--shadow-hover);
      transform: translateY(-4px) scale(1.002);
      border-color: var(--accent-1);
    }
    .card-header {
      padding: 16px 22px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: rgba(255, 255, 255, 0.02);
      transition: border-color var(--transition), background var(--transition);
    }
    .card-header h3 {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .card-header h3 i {
      color: var(--accent-1);
      font-size: 16px;
    }
    .card-body {
      padding: 20px 22px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .form-grid.cols1 {
      grid-template-columns: 1fr;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .form-group.span2 {
      grid-column: span 2;
    }
    .form-group label {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.3px;
      transition: color var(--transition);
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 9px 14px;
      border: 1px solid var(--border-card);
      border-radius: var(--radius);
      font-size: 13px;
      font-family: var(--font);
      color: var(--text-primary);
      background: var(--bg-input);
      outline: none;
      transition: background var(--transition), border-color var(--transition), color var(--transition), box-shadow var(--transition), transform 0.15s ease;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--accent-1);
      box-shadow: 0 0 0 3px var(--accent-1-dim);
      transform: scale(1.01);
    }
    .form-group input::placeholder,
    .form-group textarea::placeholder {
      color: var(--text-muted);
      font-weight: 300;
    }
    .form-group textarea {
      resize: vertical;
      min-height: 80px;
    }
    .form-group select option {
      background: var(--bg-input);
      color: var(--text-primary);
    }

    .record-filter-box {
      background: var(--accent-1-dim);
      border: 1px solid var(--accent-1);
      border-radius: var(--radius);
      padding: 10px;
      display: grid;
      gap: 8px;
    }
    .record-filter-line {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }
    .record-hint {
      font-size: 10px;
      color: var(--text-muted);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      border: none;
      border-radius: var(--radius);
      font-size: 12px;
      font-weight: 600;
      font-family: var(--font);
      cursor: pointer;
      transition: background var(--transition), color var(--transition), border-color var(--transition), box-shadow var(--transition), transform 0.2s ease;
      text-decoration: none;
      letter-spacing: 0.2px;
    }
    .btn i {
      font-size: 14px;
    }
    .btn-solid {
      background: var(--accent-1);
      color: #fff;
      box-shadow: 0 4px 16px rgba(74, 144, 217, 0.3);
    }
    .btn-solid:hover {
      background: #3b7ec8;
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 6px 24px rgba(74, 144, 217, 0.4);
    }
    .btn-solid:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }
    .btn-outline {
      background: transparent;
      color: var(--text-secondary);
      border: 1px solid var(--border-card);
    }
    .btn-outline:hover {
      border-color: var(--accent-1);
      background: var(--accent-1-dim);
      color: var(--text-primary);
      transform: translateY(-2px) scale(1.02);
    }
    .btn-sm {
      padding: 5px 14px;
      font-size: 11px;
    }

    .alert-msg {
      padding: 12px 16px;
      border-radius: var(--radius);
      font-size: 13px;
      margin-top: 12px;
      display: none;
      font-weight: 500;
      transition: background var(--transition), color var(--transition), border-color var(--transition);
    }
    .alert-msg.show {
      display: block;
      animation: fadeUp 0.3s ease;
    }
    .alert-ok {
      background: var(--accent-5-dim);
      color: var(--accent-5);
      border-left: 3px solid var(--accent-5);
    }
    .alert-err {
      background: var(--red-bg);
      color: var(--red);
      border-left: 3px solid var(--red);
    }

    .spin {
      display: inline-block;
      width: 14px;
      height: 14px;
      border: 2px solid rgba(255, 255, 255, 0.2);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      vertical-align: middle;
      margin-right: 6px;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 12px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: 600;
      gap: 4px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      transition: background var(--transition), color var(--transition), transform 0.2s ease;
    }
    .badge:hover {
      transform: scale(1.06);
    }
    .badge-blue {
      background: var(--accent-1-dim);
      color: var(--accent-1);
    }
    .badge-green {
      background: var(--accent-5-dim);
      color: var(--accent-5);
    }
    .badge-yellow {
      background: var(--accent-4-dim);
      color: var(--accent-4);
    }
    .badge-red {
      background: var(--red-bg);
      color: var(--red);
    }
    .badge-gray {
      background: var(--bg-elevated);
      color: var(--text-muted);
    }

    .table-wrap {
      overflow-x: auto;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    thead th {
      padding: 10px 14px;
      text-align: left;
      font-size: 10px;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid var(--border-subtle);
      background: rgba(255, 255, 255, 0.02);
    }
    tbody tr {
      border-bottom: 1px solid var(--border-subtle);
      transition: background 0.2s ease, border-color var(--transition), transform 0.15s ease;
    }
    tbody tr:last-child {
      border-bottom: none;
    }
    tbody tr:hover {
      background: var(--bg-card-hover);
      transform: scale(1.002);
    }
    tbody td {
      padding: 11px 14px;
      color: var(--text-secondary);
      vertical-align: middle;
    }
    tbody td strong {
      color: var(--text-primary);
      font-weight: 500;
    }

    .tabs-row {
      display: flex;
      gap: 4px;
      margin-bottom: 18px;
    }
    .tab-btn {
      padding: 8px 16px;
      border: 1.5px solid var(--border-card);
      border-radius: var(--radius);
      background: var(--bg-card);
      font-size: 12px;
      font-weight: 500;
      font-family: var(--font);
      cursor: pointer;
      color: var(--text-secondary);
      transition: all 0.2s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
    }
    .tab-btn.active {
      background: var(--accent-1);
      color: #fff;
      border-color: var(--accent-1);
    }
    .tab-btn:hover:not(.active) {
      border-color: var(--accent-1);
      background: var(--accent-1-dim);
    }

    .search-bar {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
    }
    .search-bar input,
    .search-bar select {
      padding: 7px 14px;
      border: 1px solid var(--border-card);
      border-radius: var(--radius);
      font-size: 13px;
      font-family: var(--font);
      background: var(--bg-input);
      color: var(--text-primary);
      outline: none;
      transition: background var(--transition), border-color var(--transition), color var(--transition);
    }
    .search-bar input:focus,
    .search-bar select:focus {
      border-color: var(--accent-1);
      box-shadow: 0 0 0 3px var(--accent-1-dim);
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ============================================================
       RESPONSIVO (sidebar já é responsiva)
       ============================================================ */
    @media (max-width: 992px) {
      .main {
        margin-left: 0;
      }
    }
    @media (max-width: 900px) {
      body {
        display: block;
      }
      .main {
        margin-left: 0;
      }
      .topbar {
        padding: 12px 18px;
        flex-wrap: wrap;
        gap: 8px;
      }
      .topbar h1 {
        font-size: 18px;
      }
      .content {
        padding: 16px;
      }
      .card-header {
        flex-wrap: wrap;
      }
      .form-grid {
        grid-template-columns: 1fr;
      }
      .form-group.span2 {
        grid-column: span 1;
      }
      .btn {
        width: 100%;
        justify-content: center;
      }
      .btn-sm {
        width: auto;
      }
      .table-wrap table {
        min-width: 500px;
      }
      .search-bar input {
        min-width: 130px;
      }
    }
    @media (max-width: 640px) {
      .card-body {
        padding: 14px;
      }
      .record-filter-line {
        flex-direction: column;
        align-items: stretch;
      }
    }

    /* ============================================================
       MODAL DE EDIÇÃO
       ============================================================ */
    #editModal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.45);
      z-index: 200;
      align-items: center;
      justify-content: center;
    }
    #editModal .modal-box {
      background: var(--bg-card);
      border-radius: 14px;
      width: 100%;
      max-width: 520px;
      margin: 16px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    }
    #editModal .modal-head {
      padding: 18px 20px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    #editModal .modal-head h3 {
      font-size: 14px;
      font-weight: 600;
    }
    #editModal .modal-close {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 24px;
      color: var(--text-muted);
      transition: color 0.15s, transform 0.2s ease;
    }
    #editModal .modal-close:hover {
      color: var(--text-primary);
      transform: rotate(90deg);
    }
    #editModal .modal-body {
      padding: 20px;
    }
    #editModal .form-grid {
      grid-template-columns: 1fr 1fr;
    }
    @media (max-width: 640px) {
      #editModal .form-grid {
        grid-template-columns: 1fr;
      }
      #editModal .form-group.span2 {
        grid-column: span 1;
      }
    }
  </style>
</head>
<body>

  <!-- ============================================================
       SIDEBAR — NOVA ESTRUTURA (substitui o partial antigo)
       ============================================================ -->
  <aside class="sidebar" id="appSidebar">
    <style>
      /* ============================================================
         TEMA CLARO (PADRÃO) E ESCURO — TOGGLE COM CSS VARIABLES
         ============================================================ */
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        /* ----- TEMA CLARO ----- */
        --sb-bg: #f8fafc;
        --sb-surface: #ffffff;
        --sb-elevated: #f1f5f9;
        --sb-border: #e2e8f0;
        --sb-text: #1e293b;
        --sb-text-secondary: #334155;
        --sb-text-muted: #64748b;
        --sb-accent: #2563eb;
        --sb-accent-dim: #eff6ff;
        --sb-accent-hover: #dbeafe;
        --sb-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
        --sb-radius: 12px;
        --sb-font: 'Inter', system-ui, -apple-system, sans-serif;
        --sb-sidebar-width: 280px;
        --sb-sidebar-collapsed: 72px;
        --sb-transition: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      }

      /* TEMA ESCURO */
      [data-theme="dark"] {
        --sb-bg: #0b1120;
        --sb-surface: #111c2e;
        --sb-elevated: #1e2d45;
        --sb-border: rgba(255, 255, 255, 0.06);
        --sb-text: #f0f4ff;
        --sb-text-secondary: #b0c4e8;
        --sb-text-muted: #7a8aa8;
        --sb-accent: #3b82f6;
        --sb-accent-dim: rgba(59, 130, 246, 0.15);
        --sb-accent-hover: rgba(59, 130, 246, 0.25);
        --sb-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
      }

      /* ============================================================
         SIDEBAR — ESTRUTURA PRINCIPAL
         ============================================================ */
      .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: var(--sb-sidebar-width);
        background: var(--sb-surface);
        border-right: 1px solid var(--sb-border);
        color: var(--sb-text);
        font-family: var(--sb-font);
        z-index: 1000;
        display: flex;
        flex-direction: column;
        transition: width var(--sb-transition), transform var(--sb-transition), background var(--sb-transition);
        box-shadow: var(--sb-shadow);
        overflow: hidden;
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
      }

      /* Estado colapsado */
      .sidebar.collapsed {
        width: var(--sb-sidebar-collapsed);
      }
      .sidebar.collapsed .sb-brand-title,
      .sidebar.collapsed .sidebar-user,
      .sidebar.collapsed .sb-group-btn span:not(.caret),
      .sidebar.collapsed .nav-item span,
      .sidebar.collapsed .sidebar-footer .btn-logout span,
      .sidebar.collapsed .sb-toggle-label {
        opacity: 0;
        pointer-events: none;
        width: 0;
        overflow: hidden;
        transition: opacity 0.2s;
      }
      .sidebar.collapsed .sb-brand-icon {
        margin-right: 0;
      }
      .sidebar.collapsed .nav-item {
        justify-content: center;
        padding: 10px !important;
      }
      .sidebar.collapsed .nav-item i {
        margin-right: 0;
        font-size: 18px;
      }
      .sidebar.collapsed .sb-group-btn {
        justify-content: center;
        padding: 6px 0;
      }
      .sidebar.collapsed .sb-group-btn .caret {
        display: none;
      }
      .sidebar.collapsed .sidebar-footer .btn-logout {
        justify-content: center;
        padding: 10px !important;
      }
      .sidebar.collapsed .sidebar-footer .btn-logout i {
        margin-right: 0;
      }

      /* Overlay para mobile */
      .sidebar-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 999;
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      .sidebar-overlay.active {
        opacity: 1;
      }

      /* ============================================================
         HEADER / BRAND
         ============================================================ */
      .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 20px 14px;
        border-bottom: 1px solid var(--sb-border);
        flex-shrink: 0;
      }
      .sb-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        overflow: hidden;
      }
      .sb-brand-icon {
        width: 38px;
        height: 38px;
        background: linear-gradient(135deg, var(--sb-accent), #06b6d4);
        border-radius: var(--sb-radius);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 18px;
        flex-shrink: 0;
        transition: transform 0.3s ease;
      }
      .sb-brand-icon:hover {
        transform: rotate(-8deg) scale(1.05);
      }
      .sb-brand-title {
        display: flex;
        flex-direction: column;
        white-space: nowrap;
        overflow: hidden;
        transition: opacity 0.2s;
      }
      .sb-brand-title h2 {
        font-size: 17px;
        font-weight: 700;
        color: var(--sb-text);
        letter-spacing: -0.3px;
        background: linear-gradient(135deg, var(--sb-text) 60%, var(--sb-accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .sb-brand-title small {
        font-size: 10px;
        color: var(--sb-text-muted);
        font-weight: 400;
        -webkit-text-fill-color: var(--sb-text-muted);
      }

      .sb-toggle-btn {
        background: none;
        border: none;
