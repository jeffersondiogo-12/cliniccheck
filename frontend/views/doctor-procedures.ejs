        color: var(--sb-text-secondary);
        text-decoration: none;
        transition: background 0.2s, color 0.2s, transform 0.15s, padding 0.2s;
        position: relative;
        background: transparent;
        border: none;
        cursor: pointer;
        width: 100%;
        text-align: left;
        font-family: var(--sb-font);
        overflow: hidden;
      }
      .nav-item i {
        width: 20px;
        font-size: 15px;
