<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clinic Chek · Cadastro de Procedimento</title>
  <link rel="icon" type="image/svg+xml" href="/public/brand/clinic-check-favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

  <style>
    /* ============================================================
       TEMA ÚNICO — EXATAMENTE O MESMO DA SIDEBAR ORIGINAL
       ============================================================ */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      /* ----- TEMA CLARO (padrão) ----- */
      --sb-bg: #f8fafc;
      --sb-surface: #ffffff;
      --sb-elevated: #f1f5f9;
      --sb-border: #e2e8f0;
      --sb-text: #1e293b;
      --sb-text-secondary: #334155;
      --sb-text-muted: #64748b;
      --sb-accent: #2563eb;
      --sb-accent-dim: #eff6ff;
      --sb-accent-hover: #dbeafe;
      --sb-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
      --sb-shadow-hover: 0 8px 32px rgba(0, 0, 0, 0.10);
      --sb-radius: 12px;
      --sb-font: 'Inter', system-ui, -apple-system, sans-serif;
      --sb-sidebar-width: 280px;
      --sb-sidebar-collapsed: 72px;
      --sb-transition: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* TEMA ESCURO (exatamente igual ao da sidebar) */
    [data-theme="dark"] {
      --sb-bg: #0b1120;
      --sb-surface: #111c2e;
      --sb-elevated: #1e2d45;
      --sb-border: rgba(255, 255, 255, 0.06);
      --sb-text: #f0f4ff;
      --sb-text-secondary: #b0c4e8;
      --sb-text-muted: #7a8aa8;
      --sb-accent: #3b82f6;
      --sb-accent-dim: rgba(59, 130, 246, 0.15);
      --sb-accent-hover: rgba(59, 130, 246, 0.25);
      --sb-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
      --sb-shadow-hover: 0 12px 40px rgba(0, 0, 0, 0.45);
    }

    /* ============================================================
       SIDEBAR — ESTRUTURA PRINCIPAL (mesmo código)
       ============================================================ */
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--sb-sidebar-width);
      background: var(--sb-surface);
      border-right: 1px solid var(--sb-border);
      color: var(--sb-text);
      font-family: var(--sb-font);
      z-index: 1000;
      display: flex;
      flex-direction: column;
      transition: width var(--sb-transition), transform var(--sb-transition), background var(--sb-transition);
      box-shadow: var(--sb-shadow);
      overflow: hidden;
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
    }

    .sidebar.collapsed {
      width: var(--sb-sidebar-collapsed);
    }
    .sidebar.collapsed .sb-brand-title,
    .sidebar.collapsed .sidebar-user,
    .sidebar.collapsed .sb-group-btn span:not(.caret),
    .sidebar.collapsed .nav-item span,
    .sidebar.collapsed .sidebar-footer .btn-logout span,
    .sidebar.collapsed .sb-toggle-label {
      opacity: 0;
      pointer-events: none;
      width: 0;
      overflow: hidden;
      transition: opacity 0.2s;
    }
    .sidebar.collapsed .sb-brand-icon {
      margin-right: 0;
    }
    .sidebar.collapsed .nav-item {
      justify-content: center;
      padding: 10px !important;
    }
    .sidebar.collapsed .nav-item i {
      margin-right: 0;
      font-size: 18px;
    }
    .sidebar.collapsed .sb-group-btn {
      justify-content: center;
      padding: 6px 0;
    }
    .sidebar.collapsed .sb-group-btn .caret {
      display: none;
    }
    .sidebar.collapsed .sidebar-footer .btn-logout {
      justify-content: center;
      padding: 10px !important;
    }
    .sidebar.collapsed .sidebar-footer .btn-logout i {
      margin-right: 0;
    }

    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 999;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .sidebar-overlay.active {
      opacity: 1;
    }

    .sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 20px 14px;
      border-bottom: 1px solid var(--sb-border);
      flex-shrink: 0;
    }
    .sb-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      overflow: hidden;
    }
    .sb-brand-icon {
      width: 38px;
      height: 38px;
      background: linear-gradient(135deg, var(--sb-accent), #06b6d4);
      border-radius: var(--sb-radius);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 18px;
      flex-shrink: 0;
      transition: transform 0.3s ease;
    }
    .sb-brand-icon:hover {
      transform: rotate(-8deg) scale(1.05);
    }
    .sb-brand-title {
      display: flex;
      flex-direction: column;
      white-space: nowrap;
      overflow: hidden;
      transition: opacity 0.2s;
    }
    .sb-brand-title h2 {
      font-size: 17px;
      font-weight: 700;
      color: var(--sb-text);
      letter-spacing: -0.3px;
      background: linear-gradient(135deg, var(--sb-text) 60%, var(--sb-accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .sb-brand-title small {
      font-size: 10px;
      color: var(--sb-text-muted);
      font-weight: 400;
      -webkit-text-fill-color: var(--sb-text-muted);
    }

    .sb-toggle-btn {
      background: none;
      border: none;
      color: var(--sb-text-muted);
      font-size: 18px;
      cursor: pointer;
      padding: 6px 8px;
      border-radius: 8px;
      transition: background 0.2s, transform 0.3s;
      flex-shrink: 0;
    }
    .sb-toggle-btn:hover {
      background: var(--sb-elevated);
      color: var(--sb-text);
    }
    .sb-toggle-btn:active {
      transform: scale(0.9);
    }

    .sidebar-user {
      margin: 12px 16px 8px;
      padding: 14px 16px;
      background: var(--sb-elevated);
      border-radius: var(--sb-radius);
      border: 1px solid var(--sb-border);
      transition: background 0.3s, opacity 0.2s;
      flex-shrink: 0;
    }
    .sidebar-user .name {
      font-size: 14px;
      font-weight: 600;
      color: var(--sb-text);
    }
    .sidebar-user .role {
      font-size: 11px;
      color: var(--sb-text-muted);
      margin-top: 2px;
    }
    .sidebar-user .clinic {
      font-size: 11px;
      color: var(--sb-accent);
      margin-top: 4px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .sidebar-user .clinic i {
      font-size: 10px;
    }

    .sidebar-nav {
      flex: 1;
      padding: 8px 12px 8px;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--sb-border) transparent;
    }
    .sidebar-nav::-webkit-scrollbar {
      width: 4px;
    }
    .sidebar-nav::-webkit-scrollbar-thumb {
      background: var(--sb-border);
      border-radius: 10px;
    }

    .sb-group {
      margin-top: 4px;
    }
    .sb-group + .sb-group {
      margin-top: 6px;
      padding-top: 8px;
      border-top: 1px solid var(--sb-border);
    }

    .sb-group-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: transparent;
      border: 0;
      color: var(--sb-text-muted);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      padding: 6px 10px;
      cursor: pointer;
      font-family: var(--sb-font);
      border-radius: 6px;
      transition: color 0.25s, background 0.25s;
    }
    .sb-group-btn:hover {
      color: var(--sb-accent);
      background: var(--sb-accent-dim);
    }
    .sb-group-btn .caret {
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      font-size: 9px;
    }
    .sb-group.open .sb-group-btn .caret {
      transform: rotate(90deg);
      color: var(--sb-accent);
    }

    .sb-group-list {
      display: flex;
      flex-direction: column;
      gap: 2px;
      overflow: hidden;
      max-height: 0;
      opacity: 0;
      transform: translateY(-6px);
      transition: max-height 0.4s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.3s ease,
        transform 0.3s ease;
      pointer-events: none;
    }
    .sb-group.open .sb-group-list {
      max-height: 600px;
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 9px 12px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 500;
      color: var(--sb-text-secondary);
      text-decoration: none;
      transition: background 0.2s, color 0.2s, transform 0.15s, padding 0.2s;
      position: relative;
      background: transparent;
      border: none;
      cursor: pointer;
      width: 100%;
      text-align: left;
      font-family: var(--sb-font);
      overflow: hidden;
    }
    .nav-item i {
      width: 20px;
      font-size: 15px;
      color: var(--sb-text-muted);
      flex-shrink: 0;
      transition: color 0.2s, transform 0.3s;
    }
    .nav-item span {
      white-space: nowrap;
      overflow: hidden;
      transition: opacity 0.2s;
    }
    .nav-item::before {
      content: '';
      position: absolute;
      left: 0;
      top: 6px;
      bottom: 6px;
      width: 3px;
      border-radius: 0 4px 4px 0;
      background: var(--sb-accent);
      transform: scaleY(0);
      transform-origin: center;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .nav-item:hover {
      background: var(--sb-accent-dim);
      color: var(--sb-text);
      transform: translateX(3px);
    }
    .nav-item:hover i {
      color: var(--sb-accent);
      transform: scale(1.1) rotate(-4deg);
    }
    .nav-item:hover::before {
      transform: scaleY(0.5);
    }
    .nav-item.active {
      background: var(--sb-accent-dim);
      color: var(--sb-text);
      font-weight: 600;
      box-shadow: inset 3px 0 0 var(--sb-accent);
    }
    .nav-item.active::before {
      transform: scaleY(1);
    }
    .nav-item.active i {
      color: var(--sb-accent);
    }
    .nav-item:active {
      transform: scale(0.97);
    }
    .nav-item[hidden] {
      display: none !important;
    }

    .sidebar-footer {
      padding: 12px 16px 16px;
      border-top: 1px solid var(--sb-border);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .theme-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 6px 10px;
      border-radius: 8px;
      background: var(--sb-elevated);
      border: 1px solid var(--sb-border);
      transition: background 0.3s;
    }
    .theme-toggle .sb-toggle-label {
      font-size: 12px;
      font-weight: 500;
      color: var(--sb-text-muted);
      transition: opacity 0.2s;
    }
    .theme-toggle .toggle-switch {
      position: relative;
      width: 40px;
      height: 22px;
      background: var(--sb-border);
      border-radius: 12px;
      cursor: pointer;
      transition: background 0.3s;
      flex-shrink: 0;
    }
    .theme-toggle .toggle-switch .slider {
      position: absolute;
      top: 2px;
      left: 2px;
      width: 18px;
      height: 18px;
      background: #fff;
      border-radius: 50%;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }
    [data-theme="dark"] .theme-toggle .toggle-switch {
      background: var(--sb-accent);
    }
    [data-theme="dark"] .theme-toggle .toggle-switch .slider {
      transform: translateX(18px);
      background: #fff;
    }

    .btn-logout {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      width: 100%;
      border: none;
      border-radius: 8px;
      background: rgba(239, 68, 68, 0.08);
      color: #ef4444;
      font-size: 13px;
      font-weight: 500;
      font-family: var(--sb-font);
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
    }
    .btn-logout i {
      font-size: 15px;
    }
    .btn-logout span {
      transition: opacity 0.2s;
    }
    .btn-logout:hover {
      background: rgba(239, 68, 68, 0.16);
    }
    .btn-logout:active {
      transform: scale(0.97);
    }

    @media (max-width: 992px) {
      .sidebar {
        transform: translateX(-100%);
        width: var(--sb-sidebar-width);
        border-right: none;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.2);
      }
      .sidebar.open {
        transform: translateX(0);
      }
      .sidebar-overlay {
        display: block;
      }
      .sidebar-overlay.active {
        display: block;
      }
      .sidebar.collapsed {
        width: var(--sb-sidebar-width);
      }
      .sidebar.collapsed .sb-brand-title,
      .sidebar.collapsed .sidebar-user,
      .sidebar.collapsed .sb-group-btn span:not(.caret),
      .sidebar.collapsed .nav-item span,
      .sidebar.collapsed .sidebar-footer .btn-logout span,
      .sidebar.collapsed .sb-toggle-label {
        opacity: 1;
        pointer-events: auto;
        width: auto;
        overflow: visible;
      }
      .sidebar.collapsed .nav-item {
        justify-content: flex-start;
        padding: 9px 12px !important;
      }
      .sidebar.collapsed .nav-item i {
        font-size: 15px;
        margin-right: 0;
      }
      .sidebar.collapsed .sb-group-btn {
        justify-content: space-between;
        padding: 6px 10px;
      }
      .sidebar.collapsed .sb-group-btn .caret {
        display: inline;
      }
      .sidebar.collapsed .sidebar-footer .btn-logout {
        justify-content: flex-start;
        padding: 10px 14px !important;
      }
      .sidebar.collapsed .sidebar-footer .btn-logout i {
        margin-right: 0;
      }
    }
    @media (max-width: 480px) {
      .sidebar {
        width: 100%;
        max-width: 320px;
      }
      .sb-brand-title h2 {
        font-size: 15px;
      }
    }

    /* ============================================================
       MAIN — CONTEÚDO PRINCIPAL (usa as mesmas variáveis)
       ============================================================ */
    .main {
      margin-left: var(--sb-sidebar-width);
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      background: var(--sb-bg);
      transition: background var(--sb-transition), margin-left var(--sb-transition);
    }
    @media (max-width: 992px) {
      .main {
        margin-left: 0;
      }
    }

    .topbar {
      padding: 16px 32px;
      background: var(--sb-surface);
      border-bottom: 1px solid var(--sb-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 40;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition: background var(--sb-transition), border-color var(--sb-transition);
    }
    .topbar h1 {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.3px;
      color: var(--sb-text);
      transition: color var(--sb-transition);
    }
    .topbar .meta {
      font-size: 12px;
      color: var(--sb-text-muted);
      margin-top: 2px;
      transition: color var(--sb-transition);
    }
    .topbar-actions {
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .topbar-actions .badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--sb-text-secondary);
      background: var(--sb-elevated);
      padding: 4px 14px 4px 10px;
      border-radius: 20px;
      border: 1px solid var(--sb-border);
      transition: background var(--sb-transition), border-color var(--sb-transition), color var(--sb-transition);
    }
    .topbar-actions .badge i {
      color: var(--sb-accent);
      font-size: 10px;
      transition: color var(--sb-transition);
    }

    .content {
      padding: 24px 32px 40px;
      flex: 1;
      animation: fadeUp 0.35s ease;
    }

    /* ============================================================
       CARDS E GRIDS (com as variáveis da sidebar)
       ============================================================ */
    .card {
      background: var(--sb-surface);
      border-radius: var(--sb-radius);
      border: 1px solid var(--sb-border);
      overflow: hidden;
      margin-bottom: 20px;
      box-shadow: var(--sb-shadow);
      transition: background var(--sb-transition), border-color var(--sb-transition), box-shadow var(--sb-transition), transform 0.25s ease;
    }
    .card:hover {
      box-shadow: var(--sb-shadow-hover);
      transform: translateY(-4px) scale(1.002);
      border-color: var(--sb-accent);
    }
    .card-header {
      padding: 14px 20px;
      border-bottom: 1px solid var(--sb-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: rgba(255, 255, 255, 0.02);
      transition: border-color var(--sb-transition), background var(--sb-transition);
    }
    .card-header h3 {
      font-size: 14px;
      font-weight: 600;
      color: var(--sb-text);
      display: flex;
      align-items: center;
      gap: 8px;
      transition: color var(--sb-transition);
    }
    .card-header h3 i {
      color: var(--sb-accent);
      font-size: 16px;
      transition: color var(--sb-transition);
    }
    .card-body {
      padding: 18px 20px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .grid-1 {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .span-2 {
      grid-column: span 2;
    }
    .span-3 {
      grid-column: span 3;
    }

    @media (max-width: 768px) {
      .grid-2 { grid-template-columns: 1fr; }
      .span-2, .span-3 { grid-column: span 1; }
    }

    /* ============================================================
       FORMULÁRIOS (padrão da sidebar)
       ============================================================ */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .form-group label {
      font-size: 11px;
      font-weight: 600;
      color: var(--sb-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.3px;
      transition: color var(--sb-transition);
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 9px 14px;
      border: 1px solid var(--sb-border);
      border-radius: var(--sb-radius);
      font-size: 13px;
      font-family: var(--sb-font);
      color: var(--sb-text);
      background: var(--sb-surface);
      outline: none;
      transition: background var(--sb-transition), border-color var(--sb-transition), color var(--sb-transition), box-shadow var(--sb-transition), transform 0.15s ease;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--sb-accent);
      box-shadow: 0 0 0 3px var(--sb-accent-dim);
      transform: scale(1.01);
    }
    .form-group input::placeholder,
    .form-group textarea::placeholder {
      color: var(--sb-text-muted);
      font-weight: 300;
      transition: color var(--sb-transition);
    }
    .form-group textarea {
      resize: vertical;
      min-height: 80px;
    }

    /* ============================================================
       BOTÕES (padrão da sidebar)
       ============================================================ */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      border: none;
      border-radius: var(--sb-radius);
      font-size: 12px;
      font-weight: 600;
      font-family: var(--sb-font);
      cursor: pointer;
      transition: background var(--sb-transition), color var(--sb-transition), border-color var(--sb-transition), box-shadow var(--sb-transition), transform 0.2s ease;
      text-decoration: none;
      text-transform: none;
      letter-spacing: 0.2px;
      position: relative;
      overflow: hidden;
    }
    .btn::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,255,255,0.15), transparent 60%);
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
    }
    .btn:hover::after {
      opacity: 1;
    }
    .btn i {
      font-size: 14px;
    }
    .btn-solid {
      background: var(--sb-accent);
      color: #fff;
      box-shadow: 0 4px 16px rgba(37, 99, 235, 0.3);
    }
    .btn-solid:hover {
      background: #1d4ed8;
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 6px 24px rgba(37, 99, 235, 0.4);
    }
    .btn-solid:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }
    .btn-outline {
      background: transparent;
      color: var(--sb-text-secondary);
      border: 1px solid var(--sb-border);
    }
    .btn-outline:hover {
      border-color: var(--sb-accent);
      background: var(--sb-accent-dim);
      color: var(--sb-text);
      transform: translateY(-2px) scale(1.02);
    }
    .btn-teal {
      background: #06b6d4;
      color: #fff;
      box-shadow: 0 4px 16px rgba(6, 182, 212, 0.3);
    }
    .btn-teal:hover {
      background: #0891b2;
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 6px 24px rgba(6, 182, 212, 0.4);
    }
    .btn-sm {
      padding: 5px 14px;
      font-size: 11px;
    }
    .btn-red {
      background: rgba(239, 68, 68, 0.08);
      color: #ef4444;
      border: 1px solid rgba(239, 68, 68, 0.15);
    }
    .btn-red:hover {
      background: rgba(239, 68, 68, 0.12);
      transform: translateY(-2px) scale(1.02);
    }

    /* ============================================================
       ALERTAS
       ============================================================ */
    .alert-msg {
      padding: 12px 16px;
      border-radius: var(--sb-radius);
      font-size: 13px;
      margin-top: 12px;
      display: none;
      font-weight: 500;
      transition: background var(--sb-transition), color var(--sb-transition), border-color var(--sb-transition), transform 0.2s ease;
    }
    .alert-msg.show {
      display: block;
      animation: fadeUp 0.3s ease;
    }
    .alert-ok {
      background: rgba(16, 185, 129, 0.12);
      color: #10b981;
      border-left: 3px solid #10b981;
    }
    .alert-err {
      background: rgba(239, 68, 68, 0.08);
      color: #ef4444;
      border-left: 3px solid #ef4444;
    }

    .spin {
      display: inline-block;
      width: 14px;
      height: 14px;
      border: 2px solid rgba(255, 255, 255, 0.2);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      vertical-align: middle;
      margin-right: 6px;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ============================================================
       COMPONENTES ESPECÍFICOS DA PÁGINA
       ============================================================ */
    .search-wrap {
      position: relative;
    }
    .search-wrap .search-ico {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--sb-text-muted);
      font-size: 14px;
      pointer-events: none;
      transition: color var(--sb-transition);
    }
    .search-wrap input {
      padding-left: 36px !important;
    }
    .search-spinner {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      display: none;
    }
    .search-spinner.active {
      display: block;
    }
    .search-spinner span {
      display: inline-block;
      width: 14px;
      height: 14px;
      border: 2px solid var(--sb-border);
      border-top-color: var(--sb-accent);
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
    }
    .search-results {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--sb-surface);
      border: 1px solid var(--sb-border);
      border-top: none;
      border-radius: 0 0 var(--sb-radius) var(--sb-radius);
      z-index: 100;
      max-height: 200px;
      overflow-y: auto;
      display: none;
      box-shadow: var(--sb-shadow);
      transition: background var(--sb-transition), border-color var(--sb-transition);
    }
    .search-results.show {
      display: block;
    }
    .search-item {
      padding: 10px 14px;
      cursor: pointer;
      font-size: 13px;
      border-bottom: 1px solid var(--sb-border);
      display: flex;
      align-items: center;
      gap: 10px;
      transition: background 0.15s;
    }
    .search-item:last-child {
      border-bottom: none;
    }
    .search-item:hover {
      background: var(--sb-accent-dim);
    }
    .search-item .s-name {
      font-weight: 600;
      color: var(--sb-text);
    }
    .search-item .s-meta {
      font-size: 11px;
      color: var(--sb-text-muted);
    }
    .no-result {
      padding: 14px;
      text-align: center;
      color: var(--sb-text-muted);
      font-size: 13px;
    }
    .patient-selected {
      display: none;
      padding: 10px 14px;
      background: var(--sb-accent-dim);
      border: 1px solid var(--sb-accent);
      border-radius: var(--sb-radius);
      font-size: 13px;
      align-items: center;
      justify-content: space-between;
      margin-top: 8px;
    }
    .patient-selected.show {
      display: flex;
    }
    .patient-selected .ps-name {
      font-weight: 600;
      color: var(--sb-text);
    }
    .patient-selected button {
      background: none;
      border: none;
      cursor: pointer;
      color: #ef4444;
      font-size: 16px;
      transition: transform 0.2s;
    }
    .patient-selected button:hover {
      transform: scale(1.2);
    }

    /* MODAL DE PROCEDIMENTOS */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
      z-index: 200;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal-overlay.show {
      display: flex;
    }
    .modal {
      background: var(--sb-surface);
      border-radius: var(--sb-radius);
      width: 100%;
      max-width: 600px;
      max-height: 85vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: var(--sb-shadow-hover);
      border: 1px solid var(--sb-border);
      transition: background var(--sb-transition), border-color var(--sb-transition);
    }
    .modal-header {
      padding: 14px 20px;
      border-bottom: 1px solid var(--sb-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--sb-elevated);
      transition: border-color var(--sb-transition), background var(--sb-transition);
    }
    .modal-header h3 {
      font-size: 15px;
      font-weight: 600;
      color: var(--sb-text);
    }
    .modal-close {
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      color: var(--sb-text-muted);
      width: 32px;
      height: 32px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s, color 0.15s;
    }
    .modal-close:hover {
      background: var(--sb-accent-dim);
      color: var(--sb-text);
    }
    .modal-search {
      padding: 12px 16px;
      border-bottom: 1px solid var(--sb-border);
    }
    .modal-search input {
      width: 100%;
      padding: 9px 14px;
      border: 1px solid var(--sb-border);
      border-radius: var(--sb-radius);
      font-size: 13px;
      font-family: var(--sb-font);
      outline: none;
      background: var(--sb-surface);
      color: var(--sb-text);
      transition: background var(--sb-transition), border-color var(--sb-transition), color var(--sb-transition);
    }
    .modal-search input:focus {
      border-color: var(--sb-accent);
    }
    .modal-list {
      overflow-y: auto;
      flex: 1;
      padding: 4px 0;
    }
    .modal-item {
      padding: 12px 16px;
      cursor: pointer;
      border-bottom: 1px solid var(--sb-border);
      transition: background 0.15s;
      display: flex;
      gap: 10px;
      align-items: flex-start;
    }
    .modal-item:last-child {
      border-bottom: none;
    }
    .modal-item:hover {
      background: var(--sb-accent-dim);
    }
    .modal-item .mi-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--sb-text);
    }
    .modal-item .mi-meta {
      font-size: 12px;
      color: var(--sb-text-muted);
      margin-top: 2px;
    }
    .modal-item .mi-badge {
      font-size: 10px;
      padding: 2px 10px;
      border-radius: 999px;
      background: var(--sb-elevated);
      color: var(--sb-accent);
      font-weight: 600;
      border: 1px solid var(--sb-border);
      white-space: nowrap;
    }
    .modal-empty {
      padding: 30px;
      text-align: center;
      color: var(--sb-text-muted);
      font-size: 13px;
    }

    /* PROCEDIMENTO SELECIONADO DO MODAL */
    .proc-from-modal {
      display: none;
      padding: 10px 14px;
      background: var(--sb-accent-dim);
      border: 1px solid var(--sb-accent);
      border-radius: var(--sb-radius);
      font-size: 13px;
      margin-bottom: 12px;
    }
    .proc-from-modal.show {
      display: block;
    }
    .proc-from-modal strong {
      color: var(--sb-text);
    }
    .proc-from-modal .btn {
      float: right;
      margin-top: -2px;
    }

    /* ============================================================
       RESPONSIVO GERAL
       ============================================================ */
    @media (max-width: 900px) {
      .content { padding: 16px; }
      .topbar { padding: 12px 18px; flex-wrap: wrap; gap: 8px; }
      .topbar h1 { font-size: 18px; }
    }
    @media (max-width: 640px) {
      .card-body { padding: 14px; }
    }
  </style>
</head>
