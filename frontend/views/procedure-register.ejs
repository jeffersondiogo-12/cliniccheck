  <!-- ============================================================
  SCRIPTS — SIDEBAR + LÓGICA DA PÁGINA
  ============================================================ -->
  <script>
    // ============================================================
    // SIDEBAR (mesmo da primeira tela)
    // ============================================================
    (function initSidebar() {
      const sidebar = document.querySelector('.sidebar');
      const toggleBtn = document.getElementById('sidebarToggleBtn');
      const overlay = document.getElementById('sidebarOverlay');
      let isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
      if (isCollapsed) sidebar.classList.add('collapsed');

      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (window.innerWidth <= 992) {
          sidebar.classList.toggle('open');
          overlay.classList.toggle('active');
          document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
        } else {
          isCollapsed = !isCollapsed;
          sidebar.classList.toggle('collapsed', isCollapsed);
          localStorage.setItem('sidebarCollapsed', String(isCollapsed));
        }
      });

      overlay.addEventListener('click', function() {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      });

      window.addEventListener('resize', function() {
        if (window.innerWidth > 992) {
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        }
      });

      // Tema
      const themeToggle = document.getElementById('themeToggle');
      const currentTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', currentTheme);
      themeToggle.addEventListener('click', function() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const newTheme = isDark ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      });

      // Grupos colapsáveis
      document.querySelectorAll('.sb-group-btn').forEach((btn) => {
        btn.addEventListener('click', function() {
          const group = this.closest('.sb-group');
          if (group) group.classList.toggle('open');
        });
      });

      // Dados do usuário
      const token = localStorage.getItem('doctorToken');
      const doctorData = JSON.parse(localStorage.getItem('doctorData') || '{}');
      const nameEl = document.getElementById('sidebarName');
      const roleEl = document.getElementById('sidebarRole');
      const clinicEl = document.getElementById('sidebarClinic');
      if (nameEl) nameEl.textContent = doctorData.name || 'Profissional';
      if (roleEl) roleEl.textContent = doctorData.isClinicOwner ? 'Owner da Clinica' : 'Profissional';
      if (clinicEl) clinicEl.textContent = 'Clinica: ' + (doctorData.clinicName || '--');

      // Logout
      document.getElementById('logoutBtn').addEventListener('click', function() {
        localStorage.removeItem('doctorToken');
        localStorage.removeItem('doctorData');
        window.location.href = '/medico/login';
      });

      // Permissões (opcional)
      if (token) {
        fetch('/api/auth/permissions', { headers: { Authorization: 'Bearer ' + token } })
          .then((r) => r.ok ? r.json() : null)
          .then((data) => {
            if (!data || !Array.isArray(data.pages)) return;
            const allowed = new Set((data.pages || []).filter((p) => p.can_view).map((p) => p.code));
            document.querySelectorAll('#sidebarNav .nav-item[data-page]').forEach((item) => {
              const rawCodes = item.getAttribute('data-page-codes') || item.getAttribute('data-page') || '';
              const pageCodes = rawCodes.split(',').map((code) => code.trim()).filter(Boolean);
              const canSee = pageCodes.some((code) => allowed.has(code));
              item.hidden = !canSee;
            });
            document.querySelectorAll('.sb-group').forEach((g) => {
              const hasVisible = Array.from(g.querySelectorAll('.nav-item')).some((i) => !i.hidden);
              g.style.display = hasVisible ? '' : 'none';
            });
          })
          .catch(() => {});
      }
    })();

    // ============================================================
    // LÓGICA DA PÁGINA DE CADASTRO DE PROCEDIMENTO
    // ============================================================
    const token = localStorage.getItem('doctorToken');
    if (!token) window.location.href = '/medico/login';
    const h = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };

    let allProcedures = [];
    let allProcedureTypes = [];

    function esc(v) { return String(v || '').replace(/[&<>"']/g, (s) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[s])); }

    function fmtCategory(v) {
      const map = {
        CIRURGIA: 'Cirurgia',
        EXAME: 'Exame',
        TRATAMENTO: 'Tratamento',
        CONSULTA_ESPECIALIZADA: 'Consulta Especializada',
        INTERNACAO: 'Internação',
        OUTRO: 'Outro',
      };
      return map[v] || v || 'Sem categoria';
    }

    // Carrega tipos de procedimento
    async function loadProcedureTypes() {
      try {
        const [typesRes, catsRes] = await Promise.all([
          fetch('/api/procedure-types', { headers: h }),
          fetch('/api/procedure-types/categories', { headers: h }),
        ]);
        allProcedureTypes = typesRes.ok ? await typesRes.json() : [];
        const categories = catsRes.ok ? await catsRes.json() : [];

        const catSel = document.getElementById('procedureCategory');
        catSel.innerHTML = '<option value="">Todas</option>' + categories
          .map(c => `<option value="${esc(c.name)}">${esc(fmtCategory(c.name))}</option>`)
          .join('');

        renderProcedureTypeOptions();
      } catch {
        const typeSel = document.getElementById('procedureType');
        typeSel.innerHTML = '<option value="">Erro ao carregar tipos</option>';
      }
    }

    function renderProcedureTypeOptions(selectedValue) {
      const cat = document.getElementById('procedureCategory').value;
      const typeSel = document.getElementById('procedureType');
      const filtered = allProcedureTypes.filter(t => !cat || String(t.category || '') === cat);
      typeSel.innerHTML = '<option value="">Selecione</option>' + filtered
        .map(t => `<option value="${esc(t.name)}">${esc(t.name)}${t.category ? ' · ' + esc(fmtCategory(t.category)) : ''}</option>`)
        .join('');
      if (selectedValue) typeSel.value = selectedValue;
    }

    document.getElementById('procedureCategory').addEventListener('change', () => {
      renderProcedureTypeOptions();
    });

    // Busca de pacientes
    const patientSearch = document.getElementById('patientSearch');
    const searchResults = document.getElementById('searchResults');
    const searchSpinner = document.getElementById('searchSpinner');
    const patientSelected = document.getElementById('patientSelected');
    let searchTimeout = null;

    patientSearch.addEventListener('input', () => {
      const q = patientSearch.value.trim();
      searchResults.innerHTML = '';
      searchResults.classList.remove('show');
      clearTimeout(searchTimeout);
      if (q.length < 2) return;
      searchSpinner.classList.add('active');
      searchTimeout = setTimeout(async () => {
        try {
          const res = await fetch(`/api/reception/patients?search=${encodeURIComponent(q)}`, { headers: h });
          const patients = res.ok ? await res.json() : [];
          searchSpinner.classList.remove('active');
          if (!patients.length) {
            searchResults.innerHTML = '<div class="no-result">Nenhum paciente encontrado</div>';
          } else {
            searchResults.innerHTML = patients.slice(0, 8).map(p => `
              <div class="search-item" onclick="selectPatient('${esc(p.id)}','${esc(p.name)}','${esc(p.phone||'')}')">
                <i class="fas fa-user" style="color:var(--sb-accent);"></i>
                <div>
                  <div class="s-name">${esc(p.name)}</div>
                  <div class="s-meta">${esc(p.phone || p.email || '')}</div>
                </div>
              </div>
            `).join('');
          }
          searchResults.classList.add('show');
        } catch {
          searchSpinner.classList.remove('active');
        }
      }, 350);
    });

    document.addEventListener('click', (e) => {
      if (!document.getElementById('patientSearchWrap').contains(e.target)) {
        searchResults.classList.remove('show');
      }
    });

    function selectPatient(id, name, phone) {
      document.getElementById('patientId').value = id;
      document.getElementById('patientSelectedName').textContent = name + (phone ? ' — ' + phone : '');
      patientSelected.classList.add('show');
      patientSearch.style.display = 'none';
      patientSearch.value = '';
      searchResults.classList.remove('show');
    }

    function clearPatient() {
      document.getElementById('patientId').value = '';
      patientSelected.classList.remove('show');
      patientSearch.style.display = '';
      patientSearch.value = '';
      patientSearch.focus();
    }

    // Modal de procedimentos
    function openModal() {
      document.getElementById('modalOverlay').classList.add('show');
      document.getElementById('modalSearch').value = '';
      document.getElementById('modalSearch').focus();
      if (!allProcedures.length) {
        loadProceduresForModal();
      } else {
        renderModalItems(allProcedures);
      }
    }

    function closeModal() {
      document.getElementById('modalOverlay').classList.remove('show');
    }

    document.getElementById('modalOverlay').addEventListener('click', (e) => {
      if (e.target === document.getElementById('modalOverlay')) closeModal();
    });

    async function loadProceduresForModal() {
      document.getElementById('modalList').innerHTML = '<div class="modal-empty">Carregando...</div>';
      try {
        const res = await fetch('/api/surgeries', { headers: h });
        if (res.ok) {
          allProcedures = await res.json();
          renderModalItems(allProcedures);
        } else {
          document.getElementById('modalList').innerHTML = '<div class="modal-empty">Sem procedimentos cadastrados.</div>';
        }
      } catch {
        document.getElementById('modalList').innerHTML = '<div class="modal-empty">Erro ao carregar.</div>';
      }
    }

    function renderModalItems(items) {
      const list = document.getElementById('modalList');
      if (!items.length) {
        list.innerHTML = '<div class="modal-empty">Nenhum procedimento encontrado.</div>';
        return;
      }
      list.innerHTML = items.map(p => `
        <div class="modal-item" onclick="selectProcedureFromModal('${esc(p.id)}','${esc(p.procedure_name||'')}','${esc(p.procedure_type||'')}')">
          <div style="flex:1">
            <div class="mi-title">${esc(p.procedure_name || 'Procedimento')}</div>
            <div class="mi-meta">${p.hospital ? esc(p.hospital) + ' · ' : ''}${p.surgery_date ? new Date(p.surgery_date).toLocaleDateString('pt-BR') : ''}</div>
          </div>
          ${p.procedure_type ? `<span class="mi-badge">${esc(p.procedure_type)}</span>` : ''}
        </div>
      `).join('');
    }

    document.getElementById('modalSearch').addEventListener('input', function() {
      const q = this.value.toLowerCase();
      const filtered = allProcedures.filter(p =>
        (p.procedure_name || '').toLowerCase().includes(q) ||
        (p.procedure_type || '').toLowerCase().includes(q)
      );
      renderModalItems(filtered);
    });

    function selectProcedureFromModal(id, name, type) {
      document.getElementById('procedureName').value = name;
      if (type) {
        if (!Array.from(document.getElementById('procedureType').options).some(o => o.value === type)) {
          const current = document.getElementById('procedureType');
          current.insertAdjacentHTML('beforeend', `<option value="${esc(type)}">${esc(type)}</option>`);
        }
        document.getElementById('procedureType').value = type;
      }
      document.getElementById('procFromModalTitle').textContent = name;
      document.getElementById('procFromModalType').textContent = type ? '(' + type + ')' : '';
      document.getElementById('procFromModal').classList.add('show');
      closeModal();
    }

    function clearProcedureFromModal() {
      document.getElementById('procFromModal').classList.remove('show');
      document.getElementById('procedureName').value = '';
    }

    document.getElementById('searchProceduresBtn').addEventListener('click', openModal);

    // Salvar procedimento
    document.getElementById('saveBtn').addEventListener('click', async () => {
      const btn = document.getElementById('saveBtn');
      const ok = document.getElementById('saveOk');
      const err = document.getElementById('saveErr');
      ok.style.display = 'none';
      err.style.display = 'none';

      const procedureName = document.getElementById('procedureName').value.trim();
      const procedureType = document.getElementById('procedureType').value;
      const scheduledAt = document.getElementById('scheduledAt').value;
      const patientId = document.getElementById('patientId').value;

      if (!procedureName) { err.textContent = 'Informe o nome do procedimento.'; err.style.display = 'block'; return; }
      if (!procedureType) { err.textContent = 'Selecione o tipo de procedimento.'; err.style.display = 'block'; return; }
      if (!scheduledAt) { err.textContent = 'Informe a data prevista.'; err.style.display = 'block'; return; }
      if (!patientId) { err.textContent = 'Selecione um paciente.'; err.style.display = 'block'; return; }

      btn.disabled = true;
      btn.innerHTML = '<span class="spin"></span>Salvando...';
      try {
        const body = {
          patientId,
          procedureName,
          procedureType,
          procedureClassification: document.getElementById('procedureClassification').value || null,
          surgeryDate: scheduledAt,
          hospital: document.getElementById('hospital').value.trim() || null,
          procedureDetails: document.getElementById('procedureDetails').value.trim() || null,
          clinicalIndication: document.getElementById('clinicalIndication').value.trim() || null,
          complications: document.getElementById('complications').value.trim() || null,
          notes: document.getElementById('notes').value.trim() || null,
        };
        const res = await fetch('/api/surgeries', {
          method: 'POST',
          headers: h,
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Falha ao salvar procedimento');
        ok.textContent = 'Procedimento cadastrado com sucesso!';
        ok.style.display = 'block';
        document.getElementById('clearBtn').click();
        setTimeout(() => {
          window.location.href = '/medico/procedimentos';
        }, 2000);
      } catch (e) {
        err.textContent = e.message || 'Erro ao salvar.';
        err.style.display = 'block';
      }
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-save"></i> Salvar Procedimento';
    });

    // Limpar formulário
    document.getElementById('clearBtn').addEventListener('click', () => {
      ['procedureName', 'hospital', 'scheduledAt', 'procedureDetails', 'clinicalIndication', 'complications', 'notes'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = '';
      });
      ['procedureType', 'procedureClassification'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.selectedIndex = 0;
      });
      const cat = document.getElementById('procedureCategory');
      if (cat) cat.selectedIndex = 0;
      renderProcedureTypeOptions();
      clearPatient();
      clearProcedureFromModal();
      document.getElementById('saveOk').style.display = 'none';
      document.getElementById('saveErr').style.display = 'none';
    });

    // Inicialização
    loadProcedureTypes();

    // Socket.io (opcional, para atualizações em tempo real)
    (function() {
      const _d = JSON.parse(localStorage.getItem('doctorData') || '{}');
      if (!_d.id) return;
      const _sock = io({ transports: ['websocket', 'polling'] });
      _sock.on('connect', () => _sock.emit('join_doctor', _d.id));
      // Eventos podem ser adicionados conforme necessidade
    })();
  </script>

  <script src="/socket.io/socket.io.js"></script>
</body>
</html>