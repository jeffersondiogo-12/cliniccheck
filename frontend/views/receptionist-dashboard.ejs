      document.getElementById('summary').value='';
      document.getElementById('doctorId').value='';
      document.getElementById('eventNotes').value='';
      document.getElementById('eventGuests').value='';
      document.getElementById('eventReminders').value='';
      document.getElementById('recurrenceFreq').value='';
      document.getElementById('recurrenceInterval').value='1';
      document.getElementById('recurrenceEndType').value='count';
      document.getElementById('recurrenceCount').value='4';
      document.getElementById('recurrenceUntil').value='';
      document.getElementById('recurrenceUntil').classList.add('hidden');
      document.getElementById('saveOk').style.display='none';
      document.getElementById('saveErr').style.display='none';
    });

    document.getElementById('filterBtn').addEventListener('click', loadAgenda);
    document.getElementById('refreshBtn').addEventListener('click', loadAgenda);
    document.getElementById('recurrenceEndType').addEventListener('change', (e) => {
      const until = document.getElementById('recurrenceUntil');
      const isUntil = e.target.value === 'until';
      until.classList.toggle('hidden', !isUntil);
      document.getElementById('recurrenceCount').classList.toggle('hidden', isUntil);
    });


    // ============================================================
    // CAIXA (recepção)
    // ============================================================
    const RC_PAYMENT_METHOD_LABELS = {
      DINHEIRO: { label: 'Dinheiro', icon: 'fa-money-bill-wave' },
      CARTAO_DEBITO: { label: 'Cartão Débito', icon: 'fa-credit-card' },
      CARTAO_CREDITO: { label: 'Cartão Crédito', icon: 'fa-credit-card' },
      PIX: { label: 'PIX', icon: 'fa-bolt' },
      CONVENIO: { label: 'Convênio', icon: 'fa-file-invoice' },
      MISTO: { label: 'Misto', icon: 'fa-layer-group' },
    };
    // Formas "reais" que podem compor um recebimento — MISTO nunca é uma perna,
    // é so o marcador do lancamento quando ele usa mais de uma forma.
    const RC_SPLITTABLE_PAYMENT_METHODS = Object.keys(RC_PAYMENT_METHOD_LABELS).filter((m) => m !== 'MISTO');
    function rcPaymentBreakdownLabel(row){
      if (Array.isArray(row.payments) && row.payments.length > 1) {
        return row.payments.map((p) => `${RC_PAYMENT_METHOD_LABELS[p.method]?.label || p.method} (${rcFmtMoney(p.amount)})`).join(' + ');
      }
      return RC_PAYMENT_METHOD_LABELS[row.payment_method]?.label || row.payment_method || '—';
    }
    let rcCurrentSession = null;
    let rcProcedureTypesById = {};
    let rcReceiveTxId = null;
    let rcReceiveAmount = 0;
    let rcReceiveLegs = []; // [{ method, amount }]
    let rcInitialized = false;

    function rcFmtMoney(v){ return Number(v||0).toLocaleString('pt-BR', { style:'currency', currency:'BRL' }); }
    function rcOriginLabel(o){ return o === 'AUTO_SIGNATURE' ? 'Assinatura' : 'Manual'; }
    function rcStatusBadge(s){
      if (s === 'PENDING') return '<span class="badge badge-yellow">Pendente</span>';
      if (s === 'PAID') return '<span class="badge badge-green">Pago</span>';
      if (s === 'CANCELED') return '<span class="badge badge-red">Cancelado</span>';
      return '<span class="badge badge-gray">' + esc(s) + '</span>';
    }
    async function rcApiGet(url){
      const res = await fetch(url, { headers: h });
      const data = await res.json().catch(() => null);
      if (!res.ok) throw new Error(data?.error || 'Falha na requisição.');
      return data;
    }
    async function rcApiSend(url, method, body){
      const res = await fetch(url, { method, headers: h, body: body != null ? JSON.stringify(body) : undefined });
      const data = await res.json().catch(() => null);
      if (!res.ok) throw new Error(data?.error || 'Falha na requisição.');
      return data;
    }

    function initCashierSection(){
      if (rcInitialized) {
        rcLoadSession(); rcLoadPending(); rcLoadHistory();
        return;
      }
      rcInitialized = true;
      document.getElementById('rcSessionsHistoryBtn').addEventListener('click', openRcSessionsHistoryModal);
      document.getElementById('rcOpenNewChargeBtn').addEventListener('click', openRcNewChargeModal);
      document.getElementById('rcRefreshPendingBtn').addEventListener('click', rcLoadPending);
      document.getElementById('rcConfirmOpenSessionBtn').addEventListener('click', rcConfirmOpenSession);
      document.getElementById('rcConfirmCloseSessionBtn').addEventListener('click', rcConfirmCloseSession);
      document.getElementById('rcConfirmNewChargeBtn').addEventListener('click', rcConfirmNewCharge);
      document.getElementById('rcConfirmReceiveBtn').addEventListener('click', rcConfirmReceive);
      document.getElementById('rcHistoryStatusFilter').addEventListener('change', rcLoadHistory);
      document.getElementById('rcChargeProcedureTypeSelect').addEventListener('change', (e) => {
        const pt = rcProcedureTypesById[e.target.value];
        if (pt) {
          if (!document.getElementById('rcChargeDescriptionInput').value.trim()) {
            document.getElementById('rcChargeDescriptionInput').value = pt.name;
          }
          if (pt.price != null) {
            document.getElementById('rcChargeAmountInput').value = Number(pt.price).toFixed(2);
          }
        }
      });
      let rcPendingSearchTimer = null;
      document.getElementById('rcSearchPendingInput').addEventListener('input', () => {
        clearTimeout(rcPendingSearchTimer);
        rcPendingSearchTimer = setTimeout(rcLoadPending, 350);
      });
      let rcPatientSearchTimer = null;
      document.getElementById('rcChargePatientSearch').addEventListener('input', (e) => {
        document.getElementById('rcChargePatientId').value = '';
        const q = e.target.value.trim();
        clearTimeout(rcPatientSearchTimer);
        const resultsEl = document.getElementById('rcChargePatientResults');
        if (q.length < 2) { resultsEl.style.display = 'none'; return; }
        rcPatientSearchTimer = setTimeout(async () => {
          try {
            const rows = await rcApiGet(`/api/reception/patients?search=${encodeURIComponent(q)}`);
            if (rows.length === 0) {
              resultsEl.innerHTML = '<div class="patient-result-item">Nenhum paciente encontrado.</div>';
            } else {
              resultsEl.innerHTML = rows.map(p => `
                <div class="patient-result-item" onclick='selectRcChargePatient(${JSON.stringify(p.id)}, ${JSON.stringify(p.name)})'>
                  ${esc(p.name)}<small>${esc(p.phone || p.email || '')}</small>
                </div>
              `).join('');
            }
            resultsEl.style.display = 'block';
          } catch (e) { /* silencioso */ }
        }, 300);
      });
      document.addEventListener('click', (e) => {
        if (!e.target.closest('#rcChargePatientSearch') && !e.target.closest('#rcChargePatientResults')) {
          const el = document.getElementById('rcChargePatientResults');
          if (el) el.style.display = 'none';
        }
      });
      document.querySelectorAll('#rcOpenSessionModal, #rcCloseSessionModal, #rcNewChargeModal, #rcReceiveModal, #rcSessionsHistoryModal, #rcMovementModal').forEach(overlay => {
        overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('show'); });
      });

      rcLoadSession();
      rcLoadPending();
      rcLoadHistory();
    }

    // ── SESSÃO DE CAIXA ──
    async function rcLoadSession(){
      try {
        const data = await rcApiGet('/api/cashier/session/current');
        rcCurrentSession = data.session;
        rcRenderSession(data);
      } catch (e) {
        const el = document.getElementById('rcSessionBody');
        if (el) el.innerHTML = '<div class="empty-state">Erro ao carregar sessão de caixa.</div>';
      }
    }

    function rcRenderSession(data){
      const { session, totals } = data;
      const actionsWrap = document.getElementById('rcSessionActionsWrap');
      const body = document.getElementById('rcSessionBody');
      if (!body) return;

      if (session) {
        actionsWrap.innerHTML = `
          <button class="btn btn-outline btn-sm" type="button" id="rcSangriaBtn"><i class="fas fa-arrow-up"></i> Sangria</button>
          <button class="btn btn-outline btn-sm" type="button" id="rcAporteBtn"><i class="fas fa-arrow-down"></i> Aporte</button>
          <button class="btn btn-danger btn-sm" type="button" id="rcCloseSessionBtn"><i class="fas fa-door-closed"></i> Fechar Caixa</button>
        `;
        body.innerHTML = `
          <div class="session-row">
            <div class="session-info">
              <span class="dot open"></span>
              <span class="label">Aberto por <strong>${esc(session.opened_by_name || '—')}</strong> em <strong>${fmtDate(session.opened_at)}</strong></span>
            </div>
            <div class="session-info">
              <span class="label">Valor de abertura: <strong>${rcFmtMoney(session.opening_amount)}</strong></span>
            </div>
          </div>
          <div id="rcMovementsList" style="margin-top:12px;"></div>`;
        document.getElementById('rcCloseSessionBtn').addEventListener('click', openRcCloseSessionModal);
        document.getElementById('rcSangriaBtn').addEventListener('click', () => openRcMovementModal('SANGRIA'));
        document.getElementById('rcAporteBtn').addEventListener('click', () => openRcMovementModal('APORTE'));
        rcLoadMovements(session.id);
      } else {
        actionsWrap.innerHTML = '<button class="btn btn-solid btn-sm" type="button" id="rcOpenSessionBtn"><i class="fas fa-door-open"></i> Abrir Caixa</button>';
        body.innerHTML = '<div class="empty-state">Nenhum caixa aberto no momento. Abra o caixa para registrar recebimentos.</div>';
        document.getElementById('rcOpenSessionBtn').addEventListener('click', openRcOpenSessionModal);
      }

      document.getElementById('rcStatPendingAmount').textContent = rcFmtMoney(totals.pendingAmount);
      document.getElementById('rcStatPendingCount').textContent = totals.pendingCount;
      document.getElementById('rcStatPaidAmount').textContent = rcFmtMoney(totals.paidTotal);
      document.getElementById('rcStatOpeningAmount').textContent = session ? rcFmtMoney(session.opening_amount) : rcFmtMoney(0);
    }

    function openRcOpenSessionModal(){
      document.getElementById('rcOpeningAmountInput').value = '0';
      document.getElementById('rcOpenSessionErr').classList.remove('show');
      document.getElementById('rcOpenSessionModal').classList.add('show');
    }
    function closeRcOpenSessionModal(){ document.getElementById('rcOpenSessionModal').classList.remove('show'); }

    // ── SANGRIA / APORTE (recepcao) ──
    async function rcLoadMovements(sessionId){
      const el = document.getElementById('rcMovementsList');
      if (!el) return;
      try {
        const rows = await rcApiGet(`/api/cashier/session/${sessionId}/movements`);
        if (rows.length === 0) { el.innerHTML = ''; return; }
        el.innerHTML = '<div style="font-size:12px;color:var(--sb-text-muted);margin-bottom:6px;">Movimentações desta sessão:</div>' +
          rows.map(m => `
            <div style="display:flex;justify-content:space-between;font-size:12.5px;padding:4px 0;border-bottom:1px dashed var(--sb-border);">
              <span>${m.type === 'SANGRIA' ? '<i class="fas fa-arrow-up" style="color:#ef4444;"></i> Sangria' : '<i class="fas fa-arrow-down" style="color:#10b981;"></i> Aporte'} — ${esc(m.reason || 'sem motivo informado')} <span style="color:var(--sb-text-muted);">(${esc(m.created_by_name || '—')})</span></span>
              <strong>${rcFmtMoney(m.amount)}</strong>
            </div>
          `).join('');
      } catch (e) { /* silencioso */ }
    }

    let rcMovementType = null;
    function openRcMovementModal(type){
      rcMovementType = type;
      document.getElementById('rcMovementModalTitle').textContent = type === 'SANGRIA' ? 'Registrar Sangria' : 'Registrar Aporte';
      document.getElementById('rcMovementAmountInput').value = '';
      document.getElementById('rcMovementReasonInput').value = '';
      document.getElementById('rcMovementErr').classList.remove('show');
      document.getElementById('rcMovementModal').classList.add('show');
    }
    function closeRcMovementModal(){ document.getElementById('rcMovementModal').classList.remove('show'); }

    document.getElementById('rcConfirmMovementBtn')?.addEventListener('click', async () => {
      const errEl = document.getElementById('rcMovementErr');
      errEl.classList.remove('show');
      const amount = document.getElementById('rcMovementAmountInput').value;
      if (!amount || isNaN(Number(amount)) || Number(amount) <= 0) {
        errEl.textContent = 'Informe um valor maior que zero.'; errEl.classList.add('show'); return;
      }
      try {
        await rcApiSend(`/api/cashier/session/${rcCurrentSession.id}/movements`, 'POST', {
          type: rcMovementType,
          amount: Number(amount),
          reason: document.getElementById('rcMovementReasonInput').value.trim() || null,
        });
        closeRcMovementModal();
        await rcLoadSession();
      } catch (e) {
        errEl.textContent = e.message; errEl.classList.add('show');
      }
    });

    async function rcConfirmOpenSession(){
      const errEl = document.getElementById('rcOpenSessionErr');
      errEl.classList.remove('show');
      const btn = document.getElementById('rcConfirmOpenSessionBtn');
      const openingAmount = document.getElementById('rcOpeningAmountInput').value || '0';
      btn.disabled = true;
      try {
        await rcApiSend('/api/cashier/session/open', 'POST', { openingAmount: Number(openingAmount) });
        closeRcOpenSessionModal();
        await rcLoadSession();
      } catch (e) {
        errEl.textContent = e.message; errEl.classList.add('show');
      }
      btn.disabled = false;
    }

    async function openRcCloseSessionModal(){
      if (!rcCurrentSession) return;
      try {
        const data = await rcApiGet('/api/cashier/session/current');
        rcCurrentSession = data.session;
        const totals = data.totals;
        const opening = Number(rcCurrentSession.opening_amount || 0);
        const cash = Number(totals.paidByMethod?.DINHEIRO || 0);
        const expected = opening + cash;
        const breakdown = Object.entries(totals.paidByMethod || {})
          .map(([method, amt]) => `${RC_PAYMENT_METHOD_LABELS[method]?.label || method}: <strong>${rcFmtMoney(amt)}</strong>`)
          .join(' &nbsp;·&nbsp; ') || 'Nenhum recebimento nesta sessão ainda.';
        document.getElementById('rcCloseSessionSummary').innerHTML = `
          Abertura: <strong>${rcFmtMoney(opening)}</strong> &nbsp;·&nbsp; Total recebido: <strong>${rcFmtMoney(totals.paidTotal)}</strong><br>
          ${breakdown}<br><br>
          Esperado em dinheiro (abertura + recebimentos em dinheiro): <strong>${rcFmtMoney(expected)}</strong>`;
        document.getElementById('rcClosingAmountInput').value = '';
        document.getElementById('rcClosingNotesInput').value = '';
        document.getElementById('rcCloseSessionErr').classList.remove('show');
        document.getElementById('rcCloseSessionModal').classList.add('show');
      } catch (e) {
        alert(e.message);
      }
    }
    function closeRcCloseSessionModal(){ document.getElementById('rcCloseSessionModal').classList.remove('show'); }

    async function rcConfirmCloseSession(){
      const errEl = document.getElementById('rcCloseSessionErr');
      errEl.classList.remove('show');
      const closingAmountInformed = document.getElementById('rcClosingAmountInput').value;
      if (closingAmountInformed === '' || isNaN(Number(closingAmountInformed))) {
        errEl.textContent = 'Informe o valor conferido em caixa.'; errEl.classList.add('show'); return;
      }
      const btn = document.getElementById('rcConfirmCloseSessionBtn');
      btn.disabled = true;
      try {
        const updated = await rcApiSend(`/api/cashier/session/${rcCurrentSession.id}/close`, 'POST', {
          closingAmountInformed: Number(closingAmountInformed),
          notes: document.getElementById('rcClosingNotesInput').value.trim() || null,
        });
        closeRcCloseSessionModal();
        const diff = Number(updated.closing_difference || 0);
        const diffMsg = diff === 0 ? 'Caixa fechado sem diferença.' :
          (diff > 0 ? `Caixa fechado com sobra de ${rcFmtMoney(diff)}.` : `Caixa fechado com falta de ${rcFmtMoney(Math.abs(diff))}.`);
        alert(diffMsg);
        await rcLoadSession();
        await rcLoadHistory();
      } catch (e) {
        errEl.textContent = e.message; errEl.classList.add('show');
      }
      btn.disabled = false;
    }

    // ── A RECEBER ──
    async function rcLoadPending(){
      const tbody = document.getElementById('rcPendingTbody');
      if (!tbody) return;
      tbody.innerHTML = '<tr><td colspan="7" class="empty-state">Carregando...</td></tr>';
      try {
        const search = document.getElementById('rcSearchPendingInput').value.trim();
        const url = '/api/cashier/transactions?status=PENDING' + (search ? `&search=${encodeURIComponent(search)}` : '');
        const rows = await rcApiGet(url);
        if (rows.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="empty-state">Nenhum lançamento pendente.</td></tr>';
          return;
        }
        tbody.innerHTML = rows.map(r => `
          <tr>
            <td>${esc(r.patient_name)}</td>
            <td>${esc(r.procedure_type_name || r.description)}</td>
            <td>${esc(r.doctor_name || '—')}</td>
            <td><span class="badge ${r.origin === 'AUTO_SIGNATURE' ? 'badge-blue' : 'badge-gray'}">${rcOriginLabel(r.origin)}</span></td>
            <td>${rcFmtMoney(Number(r.amount) - Number(r.discount_amount||0))}</td>
            <td>${fmtDate(r.created_at)}</td>
            <td>
              <button class="btn btn-teal btn-xs" type="button" onclick='openRcReceiveModal(${JSON.stringify(r.id)}, ${JSON.stringify(r.procedure_type_name || r.description)}, ${Number(r.amount) - Number(r.discount_amount||0)})'>
                <i class="fas fa-hand-holding-usd"></i> Receber
              </button>
              <button class="btn btn-outline btn-xs" type="button" onclick="rcCancelCharge('${r.id}')" title="Cancelar lançamento">
                <i class="fas fa-times"></i>
              </button>
            </td>
          </tr>
        `).join('');
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="7" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }

    async function rcCancelCharge(id){
      if (!confirm('Cancelar este lançamento? Esta ação não pode ser desfeita.')) return;
      try {
        await rcApiSend(`/api/cashier/transactions/${id}/cancel`, 'POST', {});
        await rcLoadPending();
        await rcLoadHistory();
        await rcLoadSession();
      } catch (e) {
        alert(e.message);
      }
    }

    // ── HISTÓRICO ──
    async function rcLoadHistory(){
      const tbody = document.getElementById('rcHistoryTbody');
      if (!tbody) return;
      tbody.innerHTML = '<tr><td colspan="6" class="empty-state">Carregando...</td></tr>';
      try {
        const status = document.getElementById('rcHistoryStatusFilter').value;
        const rows = await rcApiGet(`/api/cashier/transactions?status=${status}`);
        const filtered = status === 'ALL' ? rows.filter(r => r.status !== 'PENDING') : rows;
        if (filtered.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" class="empty-state">Nenhum registro encontrado.</td></tr>';
          return;
        }
        tbody.innerHTML = filtered.map(r => `
          <tr>
            <td>${esc(r.patient_name)}</td>
            <td>${esc(r.procedure_type_name || r.description)}</td>
            <td>${rcFmtMoney(Number(r.amount) - Number(r.discount_amount||0))}</td>
            <td>${r.payment_method ? esc(rcPaymentBreakdownLabel(r)) : '—'}</td>
            <td>${fmtDate(r.paid_at || r.canceled_at)}</td>
            <td>${rcStatusBadge(r.status)}</td>
          </tr>
        `).join('');
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="6" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }

    // ── TIPOS DE PROCEDIMENTO / MÉDICOS (modal de novo lançamento) ──
    async function rcLoadProcedureTypesForCharge(){
      try {
        const rows = await rcApiGet('/api/cashier/procedure-types');
        rcProcedureTypesById = {};
        const select = document.getElementById('rcChargeProcedureTypeSelect');
        select.innerHTML = '<option value="">— Lançamento manual (sem tipo cadastrado) —</option>';
        rows.forEach(pt => {
          rcProcedureTypesById[pt.id] = pt;
          const opt = document.createElement('option');
          opt.value = pt.id;
          opt.textContent = pt.name + (pt.price != null ? ` (${rcFmtMoney(pt.price)})` : '');
          select.appendChild(opt);
        });
      } catch (e) { /* silencioso */ }
    }
    async function rcLoadDoctorsForCharge(){
      try {
        const rows = allDoctors && allDoctors.length ? allDoctors : await rcApiGet('/api/reception/doctors');
        const select = document.getElementById('rcChargeDoctorSelect');
        select.innerHTML = '<option value="">— Não vincular a um médico —</option>' +
          rows.map(d => `<option value="${esc(d.id)}">${esc(d.name)}</option>`).join('');
      } catch (e) { /* silencioso */ }
    }

    function selectRcChargePatient(id, name){
      document.getElementById('rcChargePatientId').value = id;
      document.getElementById('rcChargePatientSearch').value = name;
      document.getElementById('rcChargePatientResults').style.display = 'none';
    }

    async function openRcNewChargeModal(){
      document.getElementById('rcChargePatientSearch').value = '';
      document.getElementById('rcChargePatientId').value = '';
      document.getElementById('rcChargeProcedureTypeSelect').value = '';
      document.getElementById('rcChargeDescriptionInput').value = '';
      document.getElementById('rcChargeAmountInput').value = '';
      document.getElementById('rcChargeDiscountInput').value = '0';
      document.getElementById('rcChargeNotesInput').value = '';
      document.getElementById('rcOwnerEmailInput').value = '';
      document.getElementById('rcOwnerPasswordInput').value = '';
      document.getElementById('rcNewChargeErr').classList.remove('show');
      document.getElementById('rcNewChargeOk').classList.remove('show');
      document.getElementById('rcNewChargeModal').classList.add('show');
      await Promise.all([rcLoadProcedureTypesForCharge(), rcLoadDoctorsForCharge()]);
    }
    function closeRcNewChargeModal(){ document.getElementById('rcNewChargeModal').classList.remove('show'); }

    async function rcConfirmNewCharge(){
      const errEl = document.getElementById('rcNewChargeErr');
      const okEl = document.getElementById('rcNewChargeOk');
      errEl.classList.remove('show'); okEl.classList.remove('show');

      const patientId = document.getElementById('rcChargePatientId').value;
      if (!patientId) { errEl.textContent = 'Selecione um paciente da lista de busca.'; errEl.classList.add('show'); return; }

      const body = {
        patientId,
        doctorId: document.getElementById('rcChargeDoctorSelect').value || null,
        procedureTypeId: document.getElementById('rcChargeProcedureTypeSelect').value || null,
        description: document.getElementById('rcChargeDescriptionInput').value.trim() || null,
        amount: document.getElementById('rcChargeAmountInput').value !== '' ? Number(document.getElementById('rcChargeAmountInput').value) : null,
        discountAmount: document.getElementById('rcChargeDiscountInput').value !== '' ? Number(document.getElementById('rcChargeDiscountInput').value) : 0,
        notes: document.getElementById('rcChargeNotesInput').value.trim() || null,
        ownerEmail: document.getElementById('rcOwnerEmailInput').value.trim(),
        ownerPassword: document.getElementById('rcOwnerPasswordInput').value,
      };

      const btn = document.getElementById('rcConfirmNewChargeBtn');
      btn.disabled = true;
      try {
        await rcApiSend('/api/cashier/transactions', 'POST', body);
        okEl.textContent = 'Lançamento criado com sucesso!';
        okEl.classList.add('show');
        await rcLoadPending();
        await rcLoadSession();
        setTimeout(closeRcNewChargeModal, 900);
      } catch (e) {
        errEl.textContent = e.message; errEl.classList.add('show');
      }
      btn.disabled = false;
    }

    // ── RECEBER PAGAMENTO (aceita dividir em mais de uma forma, como um PDV) ──
    function rcRenderPaymentMethodButtons(){
      const wrap = document.getElementById('rcPaymentMethodButtons');
      wrap.innerHTML = RC_SPLITTABLE_PAYMENT_METHODS.map((code) => {
        const info = RC_PAYMENT_METHOD_LABELS[code];
        return `
          <div class="payment-method-btn" data-method="${code}" onclick="rcAddReceiveLeg('${code}')">
            <i class="fas ${info.icon}"></i> ${info.label}
          </div>`;
      }).join('');
    }
    function rcReceiveLegsSum(){
      return Math.round(rcReceiveLegs.reduce((acc, l) => acc + (Number(l.amount) || 0), 0) * 100) / 100;
    }
    function rcAddReceiveLeg(code){
      if (rcReceiveLegs.some((l) => l.method === code)) return;
      const remaining = Math.round((rcReceiveAmount - rcReceiveLegsSum()) * 100) / 100;
      rcReceiveLegs.push({ method: code, amount: remaining > 0 ? remaining : rcReceiveAmount });
      rcRenderReceiveLegs();
    }
    function rcRemoveReceiveLeg(code){
      rcReceiveLegs = rcReceiveLegs.filter((l) => l.method !== code);
      rcRenderReceiveLegs();
    }
    function rcSetReceiveLegAmount(code, value){
      const leg = rcReceiveLegs.find((l) => l.method === code);
      if (leg) leg.amount = Number(String(value).replace(',', '.')) || 0;
      rcUpdateReceiveRemainingNote();
    }
    function rcRenderReceiveLegs(){
      const wrap = document.getElementById('rcReceiveLegsWrap');
      wrap.innerHTML = rcReceiveLegs.length === 0
        ? '<div class="receive-legs-empty">Nenhuma forma de pagamento adicionada ainda.</div>'
        : rcReceiveLegs.map((l) => {
            const info = RC_PAYMENT_METHOD_LABELS[l.method];
            return `
              <div class="receive-leg-row">
                <span class="receive-leg-icon"><i class="fas ${info.icon}"></i></span>
                <span class="receive-leg-label">${info.label}</span>
                <input type="number" step="0.01" min="0.01" class="receive-leg-input" value="${Number(l.amount).toFixed(2)}" oninput="rcSetReceiveLegAmount('${l.method}', this.value)">
                <button type="button" class="receive-leg-remove" onclick="rcRemoveReceiveLeg('${l.method}')" title="Remover"><i class="fas fa-times"></i></button>
              </div>`;
          }).join('');
      document.querySelectorAll('#rcPaymentMethodButtons .payment-method-btn').forEach((el) => {
        el.classList.toggle('selected', rcReceiveLegs.some((l) => l.method === el.getAttribute('data-method')));
      });
      rcUpdateReceiveRemainingNote();
    }
    function rcUpdateReceiveRemainingNote(){
      const el = document.getElementById('rcReceiveRemaining');
      const remaining = Math.round((rcReceiveAmount - rcReceiveLegsSum()) * 100) / 100;
      if (rcReceiveLegs.length === 0) { el.innerHTML = ''; return; }
      if (Math.abs(remaining) < 0.005) {
        el.innerHTML = `<span style="color:#10b981;"><i class="fas fa-check-circle"></i> Total confere: ${rcFmtMoney(rcReceiveLegsSum())}</span>`;
      } else if (remaining > 0) {
        el.innerHTML = `<span style="color:#f59e0b;"><i class="fas fa-triangle-exclamation"></i> Faltam ${rcFmtMoney(remaining)} para completar o valor.</span>`;
      } else {
        el.innerHTML = `<span style="color:#ef4444;"><i class="fas fa-triangle-exclamation"></i> Excedeu em ${rcFmtMoney(Math.abs(remaining))} — ajuste os valores.</span>`;
      }
    }
    function openRcReceiveModal(id, description, amount){
      rcReceiveTxId = id;
      rcReceiveAmount = Math.round(Number(amount) * 100) / 100;
      rcReceiveLegs = [];
      document.getElementById('rcReceiveNotesInput').value = '';
      document.getElementById('rcReceiveErr').classList.remove('show');
      document.getElementById('rcReceiveSummary').innerHTML = `Confirmar recebimento de <strong>${rcFmtMoney(amount)}</strong> referente a <strong>${esc(description)}</strong>.`;
      rcRenderPaymentMethodButtons();
      rcRenderReceiveLegs();
      document.getElementById('rcReceiveModal').classList.add('show');
    }
    function closeRcReceiveModal(){ document.getElementById('rcReceiveModal').classList.remove('show'); }

    async function rcConfirmReceive(){
      const errEl = document.getElementById('rcReceiveErr');
      errEl.classList.remove('show');
      if (rcReceiveLegs.length === 0) { errEl.textContent = 'Selecione ao menos uma forma de pagamento.'; errEl.classList.add('show'); return; }
      for (const leg of rcReceiveLegs) {
        if (!(Number(leg.amount) > 0)) {
          errEl.textContent = `Informe um valor válido para ${RC_PAYMENT_METHOD_LABELS[leg.method]?.label || leg.method}.`;
          errEl.classList.add('show');
          return;
        }
      }
      const sum = rcReceiveLegsSum();
      if (Math.abs(sum - rcReceiveAmount) > 0.01) {
        errEl.textContent = `A soma das formas de pagamento (${rcFmtMoney(sum)}) precisa ser igual ao valor do lançamento (${rcFmtMoney(rcReceiveAmount)}).`;
        errEl.classList.add('show');
        return;
      }
      const btn = document.getElementById('rcConfirmReceiveBtn');
      btn.disabled = true;
      try {
        await rcApiSend(`/api/cashier/transactions/${rcReceiveTxId}/receive`, 'POST', {
          payments: rcReceiveLegs.map((l) => ({ method: l.method, amount: Number(l.amount) })),
          notes: document.getElementById('rcReceiveNotesInput').value.trim() || null,
        });
        closeRcReceiveModal();
        await rcLoadPending();
        await rcLoadHistory();
        await rcLoadSession();
      } catch (e) {
        errEl.textContent = e.message; errEl.classList.add('show');
      }
      btn.disabled = false;
    }

    // ── HISTÓRICO DE SESSÕES ──
    async function openRcSessionsHistoryModal(){
      document.getElementById('rcSessionsHistoryModal').classList.add('show');
      const tbody = document.getElementById('rcSessionsHistoryTbody');
      tbody.innerHTML = '<tr><td colspan="7" class="empty-state">Carregando...</td></tr>';
      try {
        const rows = await rcApiGet('/api/cashier/sessions?limit=50');
        if (rows.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="empty-state">Nenhuma sessão de caixa registrada.</td></tr>';
          return;
        }
        tbody.innerHTML = rows.map(s => {
          const diff = s.closing_difference != null ? Number(s.closing_difference) : null;
          const diffHtml = diff == null ? '—' :
            (diff === 0 ? '<span class="diff-zero">R$ 0,00</span>' :
              (diff > 0 ? `<span class="diff-positive">+${rcFmtMoney(diff)}</span>` : `<span class="diff-negative">${rcFmtMoney(diff)}</span>`));
          return `
            <tr>
              <td>${fmtDate(s.opened_at)}</td>
              <td>${fmtDate(s.closed_at)}</td>
              <td>${esc(s.opened_by_name || '—')}</td>
              <td>${rcFmtMoney(s.opening_amount)}</td>
              <td>${s.closing_totals_json ? rcFmtMoney(Object.values(s.closing_totals_json).reduce((a,b) => a + Number(b), 0)) : '—'}</td>
              <td>${diffHtml}</td>
              <td>${s.status === 'OPEN' ? '<span class="badge badge-green">Aberto</span>' : '<span class="badge badge-gray">Fechado</span>'}</td>
            </tr>`;
        }).join('');
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="7" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }
    function closeRcSessionsHistoryModal(){ document.getElementById('rcSessionsHistoryModal').classList.remove('show'); }


    // ===== INICIALIZAÇÃO =====
    window.addEventListener('load', () => {
      initReceptionCalendar();
      syncReceptionCalendar(currentAgendaItems, receptionCalendar);
    });

    (async()=>{ await loadDoctors(); await loadAgenda(); })();

    // Esconde itens do menu para os quais o proprietário não liberou acesso
    // (ex.: Financeiro > Caixa). Ficam escondidos desde o HTML (atributo
    // "hidden") até esta checagem confirmar o que pode aparecer — assim,
    // se a checagem demorar ou falhar, o item continua escondido em vez
    // de aparecer de relance ou ficar disponível por engano.
    document.querySelectorAll('.nav-item[data-page-codes]').forEach((item) => {
      item.hidden = true;
    });
    (async function applyReceptionPermissions() {
      try {
        const res = await fetch(isDoctorSession ? '/api/auth/permissions' : '/api/auth/permissions-receptionist', { headers: h });
        if (!res.ok) return;
        const data = await res.json();
        if (!data || !Array.isArray(data.pages)) return;
        const allowed = new Set(data.pages.filter((p) => p.can_view).map((p) => p.code));
        document.querySelectorAll('.nav-item[data-page-codes]').forEach((item) => {
          const codes = (item.getAttribute('data-page-codes') || '').split(',').map((c) => c.trim()).filter(Boolean);
          if (codes.length === 0) { item.hidden = false; return; }
          const canSee = codes.some((code) => allowed.has(code));
          item.hidden = !canSee;
        });

        // Telas do médico liberadas "fora do perfil" (Gestão da Clínica > Permissões)
        // que ainda não têm um link fixo aqui — cria o item dentro de "Acesso Extra"
        // na hora, pra não precisar mais forçar novo login pra usar a tela.
        const extraList = document.getElementById('extraAccessGroupList');
        if (extraList) {
          const alreadyLinked = new Set();
          document.querySelectorAll('.nav-item[data-page-codes]').forEach((item) => {
            (item.getAttribute('data-page-codes') || '').split(',').forEach((c) => alreadyLinked.add(c.trim()));
          });
          const EXTRA_PAGE_LINKS = {
            'dashboard':            { url: '/medico',                       label: 'Dashboard do Médico',    icon: 'fa-gauge-high' },
            'patients':             { url: '/medico/pacientes',             label: 'Pacientes (Médico)',     icon: 'fa-user-injured' },
            'patients.records':     { url: '/medico/prontuarios',           label: 'Prontuários',            icon: 'fa-file-medical' },
            'procedures':           { url: '/medico/procedimentos',         label: 'Procedimentos',          icon: 'fa-syringe' },
            'procedures.types':     { url: '/medico/procedimentos/tipos',   label: 'Tipos de Procedimento',  icon: 'fa-list' },
            'documents':            { url: '/medico/documentos',            label: 'Documentos',             icon: 'fa-file-signature' },
            'templates':            { url: '/medico/templates',             label: 'Modelos de Documento',   icon: 'fa-file-alt' },
            'prescriptions':        { url: '/medico/receita',               label: 'Receita / Atestado',     icon: 'fa-prescription' },
            'financeiro.relatorios':{ url: '/medico/financeiro/relatorios', label: 'Relatórios Financeiros', icon: 'fa-chart-pie' },
            'financeiro.despesas':  { url: '/medico/financeiro/despesas',   label: 'Contas a Pagar',         icon: 'fa-file-invoice-dollar' },
            'clinic':               { url: '/medico/clinica',               label: 'Minha Clínica',          icon: 'fa-hospital-alt' },
          };
          data.pages.forEach((p) => {
            if (!p.is_out_of_profile || !p.can_view) return;
            if (alreadyLinked.has(p.code)) return;
            const link = EXTRA_PAGE_LINKS[p.code];
            if (!link) return;
            alreadyLinked.add(p.code);
            const a = document.createElement('a');
            a.className = 'nav-item';
            a.href = link.url;
            a.setAttribute('data-page-codes', p.code);
            a.innerHTML = `<i class="fas ${link.icon}"></i> <span>${link.label}</span>`;
            extraList.appendChild(a);
          });
        }
      } catch (_e) { /* silencioso — itens continuam escondidos (falha segura), não bloqueia o resto do dashboard */ }
    })();

    // ===== SOCKET.IO =====
    (function() {
      const _sock = io({ transports: ['websocket','polling'] });
      const _rcUserData = JSON.parse(localStorage.getItem('receptionData') || '{}');
      _sock.on('connect', () => {
        _sock.emit('join_doctor', 'global');
        if (_rcUserData.clinicId) _sock.emit('join_clinic', _rcUserData.clinicId);
      });
      _sock.on('consultation_created', () => { if(typeof loadAgenda==='function') loadAgenda(); });
      _sock.on('agenda_updated', () => { if(typeof loadAgenda==='function') loadAgenda(); });
      _sock.on('procedure_created', () => { if(typeof loadAgenda==='function') loadAgenda(); });
      _sock.on('procedure_updated', () => { if(typeof loadAgenda==='function') loadAgenda(); });
      _sock.on('patient_created', () => { if(typeof loadAgenda==='function') loadAgenda(); });
      _sock.on('patient_updated', () => { if(typeof loadAgenda==='function') loadAgenda(); });
      ['cash_transaction_created','cash_transaction_paid','cash_transaction_canceled','cash_transaction_updated'].forEach((evt) => {
        _sock.on(evt, () => { if (typeof rcLoadPending === 'function') { rcLoadPending(); rcLoadHistory(); rcLoadSession(); } });
      });
      ['cash_session_opened','cash_session_closed'].forEach((evt) => {
        _sock.on(evt, () => { if (typeof rcLoadSession === 'function') rcLoadSession(); });
      });
    })();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
</body>
</html>