    // ===== CORES POR MÉDICO =====
    document.getElementById('saveDoctorColorBtn').addEventListener('click', function() {
      const ok = document.getElementById('colorOk');
      const err = document.getElementById('colorErr');
      ok.style.display = 'none';
      err.style.display = 'none';
      const doctorId = document.getElementById('colorDoctorId').value;
