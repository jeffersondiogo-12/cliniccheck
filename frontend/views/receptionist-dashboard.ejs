    document.getElementById('openTabletBtn').addEventListener('click', async () => {
      if (!selectedCalendarEvent || selectedCalendarEvent.extendedProps?.kind !== 'consultation') return;
      const patientId = selectedCalendarEvent.extendedProps?.patientId;
      const consultationId = selectedCalendarEvent.extendedProps?.consultationId;
      if (!patientId) { alert('Não foi possível identificar o paciente desta consulta.'); return; }
      const btn = document.getElementById('openTabletBtn');
      const originalLabel = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Abrindo...';
