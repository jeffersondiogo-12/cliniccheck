      const err = document.getElementById('guestErr');
      ok.style.display = 'none';
      err.style.display = 'none';
      const id = document.getElementById('guestConsultationId').value;
      if (!id) { err.textContent = 'Selecione uma consulta.'; err.style.display = 'block'; return; }
      const payload = {
        guests: parseCsvEmails(document.getElementById('guestEmails').value || ''),
