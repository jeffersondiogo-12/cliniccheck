      syncReceptionCalendar(currentAgendaItems, receptionCalendar);
      if (popupCalendar) syncReceptionCalendar(currentAgendaItems, popupCalendar);
    });

    // ===== SALVAR AGENDAMENTO =====
    document.getElementById('saveBtn').addEventListener('click', async () => {
      const btn = document.getElementById('saveBtn');
      const ok = document.getElementById('saveOk');
      const err = document.getElementById('saveErr');
      ok.style.display='none'; err.style.display='none';
      const patientId = document.getElementById('patientId').value;
      const doctorId = document.getElementById('doctorId').value;
      const consultationAt = normalizeConsultationAt(document.getElementById('consultationAt').value);
      const summary = document.getElementById('summary').value.trim();
      const notes = (document.getElementById('eventNotes').value || '').trim();
      const colorHex = document.getElementById('eventColor').value || null;
      const guests = parseCsvEmails(document.getElementById('eventGuests').value || '');
      const reminders = parseReminderMinutes(document.getElementById('eventReminders').value || '');
      const recurrence = parseRecurrenceFromForm();
      if (!patientId) { err.textContent='Selecione um paciente.'; err.style.display='block'; return; }
      if (!doctorId) { err.textContent='Selecione um profissional.'; err.style.display='block'; return; }
      if (!consultationAt) { err.textContent='Informe data e hora.'; err.style.display='block'; return; }
      if (!summary) { err.textContent='Informe o motivo da consulta.'; err.style.display='block'; return; }
      btn.disabled=true; btn.innerHTML='<span class="spin"></span>Salvando...';
      try {
        const dur = parseInt(document.getElementById('durationMin').value)||30;
        const modality = document.getElementById('isTeleconsulta').checked ? 'TELECONSULTA' : 'PRESENCIAL';
        const res = await fetch('/api/reception/agenda',{method:'POST',headers:h,body:JSON.stringify({
          patientId, doctorId, consultationAt, summary, notes, colorHex, guests, reminders, recurrence, durationMin:dur, modality,
        })});
        const d = await parseApiJson(res);
        if (!res.ok) {
          if (res.status === 409) throw new Error(d.error || 'Conflito de horário.');
          throw new Error(d.error||'Falha ao salvar');
        }
        ok.textContent = d.recurring
          ? `Série criada com sucesso (${d.created_count} ocorrências).`
          : (modality === 'TELECONSULTA'
              ? `Consulta agendada! Link da teleconsulta ${d.teleconsultation?.emailEnviado ? 'enviado por e-mail ao paciente' : 'gerado — copie na Agenda para enviar manualmente'}.`
              : 'Consulta agendada com sucesso!');
        ok.style.display='block';
        clearPatient();
        document.getElementById('consultationAt').value='';
        document.getElementById('summary').value='';
        document.getElementById('doctorId').value='';
        document.getElementById('eventNotes').value='';
        document.getElementById('eventGuests').value='';
        document.getElementById('isTeleconsulta').checked=false;
        document.getElementById('eventReminders').value='';
        document.getElementById('recurrenceFreq').value='';
        document.getElementById('recurrenceCount').value='4';
        document.getElementById('recurrenceUntil').value='';
        document.getElementById('recurrenceUntil').classList.add('hidden');
        await loadAgenda();
      } catch(e) { err.textContent=e.message||'Erro ao salvar.'; err.style.display='block'; }
      btn.disabled=false; btn.innerHTML='<i class="fas fa-save"></i> Salvar Agendamento';
    });

    document.getElementById('clearFormBtn').addEventListener('click',()=>{
