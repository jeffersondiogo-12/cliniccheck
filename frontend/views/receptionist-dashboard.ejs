    // ===== CARREGAR PROFISSIONAIS =====
    async function loadDoctors() {
      const res = await fetch('/api/reception/doctors', { headers: h });
      if (!res.ok) return;
      allDoctors = await res.json();
      const sel = document.getElementById('doctorId');
      const filter = document.getElementById('doctorFilter');
      const block = document.getElementById('blockDoctorIds');
      const recDoctors = document.getElementById('recDoctorId');
      const screenBlock = document.getElementById('screenBlockDoctorIds');
      const colorDoctor = document.getElementById('colorDoctorId');
      const opts = allDoctors.map(d=>`<option value="${esc(d.id)}">${esc(d.name)}${d.crm?' — '+esc(d.crm):''}</option>`).join('');
      sel.innerHTML = '<option value="">Selecione o profissional</option>' + opts;
      filter.innerHTML = '<option value="">Todos os profissionais</option>' + opts;
      block.innerHTML = opts;
      recDoctors.innerHTML = '<option value="">Selecione...</option>' + opts;
      screenBlock.innerHTML = opts;
      colorDoctor.innerHTML = '<option value="">Selecione...</option>' + opts;

      const legend = document.getElementById('doctorColorLegend');
      if (legend) legend.innerHTML = allDoctors.map(d => `<span class="color-chip"><i class="color-dot" style="background:${doctorColor(d.id)}"></i>${esc(d.name)}</span>`).join('');
      const legendScreen = document.getElementById('doctorColorLegendScreen');
      if (legendScreen) legendScreen.innerHTML = allDoctors.map(d => `<span class="color-chip"><i class="color-dot" style="background:${doctorColor(d.id)}"></i>${esc(d.name)}</span>`).join('');

      const recPatient = document.getElementById('recPatientId');
      const resPatients = await fetch('/api/reception/patients', { headers: h });
      const patients = resPatients.ok ? await resPatients.json() : [];
      recPatient.innerHTML = '<option value="">Selecione...</option>' + patients.map(p => `<option value="${esc(p.id)}">${esc(p.name)}</option>`).join('');
    }

    function refreshConsultationSelectors(items) {
      const sel = document.getElementById('guestConsultationId');
      if (!sel) return;
      sel.innerHTML = '<option value="">Selecione uma consulta...</option>' + items.map(i => {
        const txt = `${fmtDate(i.consultation_at)} - ${i.patient_name || '-'} - ${i.doctor_name || '-'}`;
        return `<option value="${esc(i.id)}">${esc(txt)}</option>`;
      }).join('');
    }

    // ===== CARREGAR INDISPONIBILIDADE =====
    async function loadUnavailability() {
      const params = new URLSearchParams();
      const f = document.getElementById('fromDate').value;
      const t = document.getElementById('toDate').value;
      const d = document.getElementById('doctorFilter').value;
      if(f) params.set('from',f+'T00:00:00');
      if(t) params.set('to',t+'T23:59:59');
      if(d) params.set('doctorId',d);
      const res = await fetch('/api/reception/agenda/unavailability?'+params.toString(), { headers: h });
      if (!res.ok) { currentUnavailabilityItems = []; return; }
      currentUnavailabilityItems = await parseApiJson(res);
    }

    // ===== CARREGAR AGENDA =====
    async function loadAgenda() {
      const rows = document.getElementById('agendaRows');
      rows.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:20px;color:var(--sb-text-muted)"><span class="spin" style="border-top-color:var(--sb-accent);border-color:var(--sb-border);"></span> Carregando...</td></tr>';
      const params = new URLSearchParams();
      const f = document.getElementById('fromDate').value;
      const t = document.getElementById('toDate').value;
      const d = document.getElementById('doctorFilter').value;
      if(f) params.set('from',f+'T00:00:00');
      if(t) params.set('to',t+'T23:59:59');
      if(d) params.set('doctorId',d);
      try {
        const res = await fetch('/api/reception/agenda?'+params.toString(),{headers:h});
        if (!res.ok) throw new Error();
        const items = await parseApiJson(res);
        currentAgendaItems = items;
        refreshConsultationSelectors(items);
        await loadUnavailability();

        if (receptionCalendar) syncReceptionCalendar(items, receptionCalendar);
        if (popupCalendar) syncReceptionCalendar(items, popupCalendar);

        updateCharts(items);

        const now = new Date();
        const hoje = items.filter(i=>new Date(i.consultation_at).toDateString()===now.toDateString()).length;
        const semana = items.filter(i=>{ const d=new Date(i.consultation_at); return d>=now && d<new Date(now.getTime()+7*24*3600000); }).length;
        const concluidas = items.filter(i=>new Date(i.consultation_at) < now).length;
        const proxima = items.filter(i => new Date(i.consultation_at) >= now).sort((a,b)=> new Date(a.consultation_at) - new Date(b.consultation_at))[0];
        const conclPct = items.length ? Math.round((concluidas / items.length) * 100) : 0;

        document.getElementById('receptionPulsePct').textContent = conclPct + '%';
        document.getElementById('receptionPulseBar').style.width = conclPct + '%';
        document.getElementById('receptionNext').textContent = proxima ? fmtDate(proxima.consultation_at) : 'Sem agenda';
        document.getElementById('statHoje').textContent = hoje;
        document.getElementById('statSemana').textContent = semana;
        document.getElementById('statTotal').textContent = items.length;
        document.getElementById('statConcluidas').textContent = concluidas;

        if (!items.length) { rows.innerHTML='<tr><td colspan="6" style="text-align:center;padding:20px;color:var(--sb-text-muted)">Nenhuma consulta encontrada.</td></tr>'; return; }
        rows.innerHTML = items.map(i=>{
          const done = new Date(i.consultation_at) < now;
          const gcalCell = i.google_event_id
            ? '<span style="font-size:11px;color:#10b981;font-weight:600;">✓ Calendário</span>'
            : `<a class="btn btn-outline btn-sm" href="${i.google_calendar_link}" target="_blank" rel="noopener" title="Adicionar manualmente ao Google Calendar">+ Google</a>`;
          return `<tr>
            <td>${esc(fmtDate(i.consultation_at))}<br><span class="badge ${done?'badge-done':'badge-up'}">${done?'Realizada':'Agendada'}</span></td>
            <td><strong>${esc(i.patient_name||'-')}</strong></td>
            <td>${esc(i.doctor_name||'-')}${i.crm?'<br><small style="color:var(--sb-text-muted)">'+esc(i.crm)+'</small>':''}</td>
            <td style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(i.summary||'-')}</td>
            <td>${done?'<span class="badge badge-done">Concluída</span>':'<span class="badge badge-up">Confirmada</span>'}${i.modality==='TELECONSULTA'?'<br><span class="badge" style="background:#e0f2fe;color:#075985;margin-top:4px;"><i class="fas fa-video"></i> Teleconsulta</span>':''}</td>
            <td>${gcalCell}</td>
          </tr>`;
        }).join('');
      } catch (e) {
        rows.innerHTML=`<tr><td colspan="6" style="text-align:center;padding:20px;color:#ef4444;">${esc(e.message || 'Erro ao carregar agenda.')}</td></tr>`;
      }
    }

    // ===== BLOQUEIOS =====
    async function saveUnavailability() {
      return saveUnavailabilityByIds({
        doctorIdsId: 'blockDoctorIds',
        startsAtId: 'blockStartAt',
        endsAtId: 'blockEndAt',
        reasonId: 'blockReason',
        okId: 'blockOk',
        errId: 'blockErr',
        btnId: 'saveBlockBtn',
      });
    }

    async function saveUnavailabilityByIds(cfg) {
      const ok = document.getElementById(cfg.okId);
      const err = document.getElementById(cfg.errId);
      const btn = document.getElementById(cfg.btnId);
      ok.style.display = 'none';
      err.style.display = 'none';
      const doctorIds = Array.from(document.getElementById(cfg.doctorIdsId).selectedOptions || []).map(o => o.value).filter(Boolean);
      const startsAt = normalizeConsultationAt(document.getElementById(cfg.startsAtId).value);
      const endsAt = normalizeConsultationAt(document.getElementById(cfg.endsAtId).value);
      const reason = (document.getElementById(cfg.reasonId).value || '').trim();
      if (!doctorIds.length || !startsAt || !endsAt) {
        err.textContent = 'Selecione ao menos um médico e informe início/fim da indisponibilidade.';
        err.style.display = 'block';
        return;
      }
      btn.disabled = true;
      btn.innerHTML = '<span class="spin"></span>Bloqueando...';
      try {
        const res = await fetch('/api/reception/agenda/unavailability', {
          method: 'POST',
          headers: h,
          body: JSON.stringify({ doctorIds, startsAt, endsAt, reason }),
        });
        const data = await parseApiJson(res);
        if (!res.ok) throw new Error(data.error || 'Falha ao bloquear horário.');
        ok.textContent = 'Indisponibilidade registrada com sucesso.';
        ok.style.display = 'block';
        document.getElementById(cfg.reasonId).value = '';
        await loadAgenda();
      } catch (e) {
        err.textContent = e.message || 'Erro ao bloquear horário.';
        err.style.display = 'block';
      }
      btn.disabled = false;
      btn.innerHTML = 'Bloquear';
    }

    document.getElementById('saveBlockBtn').addEventListener('click', saveUnavailability);
    document.getElementById('saveBlockScreenBtn').addEventListener('click', () => saveUnavailabilityByIds({
      doctorIdsId: 'screenBlockDoctorIds',
      startsAtId: 'screenBlockStartAt',
      endsAtId: 'screenBlockEndAt',
      reasonId: 'screenBlockReason',
      okId: 'screenBlockOk',
      errId: 'screenBlockErr',
      btnId: 'saveBlockScreenBtn',
    }));

    // ===== RECORRÊNCIA =====
    document.getElementById('saveRecurringBtn').addEventListener('click', async () => {
      const ok = document.getElementById('recOk');
      const err = document.getElementById('recErr');
      ok.style.display = 'none';
      err.style.display = 'none';
      const payload = {
        patientId: document.getElementById('recPatientId').value,
        doctorId: document.getElementById('recDoctorId').value,
        consultationAt: normalizeConsultationAt(document.getElementById('recConsultationAt').value),
        durationMin: Number(document.getElementById('recDuration').value || 30),
        summary: (document.getElementById('recSummary').value || '').trim(),
        recurrence: {
          frequency: document.getElementById('recFrequency').value,
          interval: Math.max(1, Number(document.getElementById('recInterval').value || 1)),
          endType: document.getElementById('recEndType').value,
          count: Math.max(1, Number(document.getElementById('recCount').value || 1)),
          until: normalizeConsultationAt(document.getElementById('recUntil').value),
        },
      };
      if (!payload.patientId || !payload.doctorId || !payload.consultationAt || !payload.summary) {
        err.textContent = 'Preencha paciente, médico, data/hora e resumo.';
        err.style.display = 'block';
        return;
      }
      const res = await fetch('/api/reception/agenda', { method: 'POST', headers: h, body: JSON.stringify(payload) });
      const data = await parseApiJson(res);
      if (!res.ok) {
        err.textContent = data.error || 'Falha ao criar recorrência.';
        err.style.display = 'block';
        return;
      }
      ok.textContent = `Série criada com sucesso (${data.created_count || 1} ocorrências).`;
      ok.style.display = 'block';
      await loadAgenda();
    });

    document.getElementById('recEndType').addEventListener('change', (e) => {
      document.getElementById('recUntilWrap').classList.toggle('hidden', e.target.value !== 'until');
    });

    // ===== CONVIDADOS E LEMBRETES =====
    document.getElementById('guestConsultationId').addEventListener('change', function() {
      const id = this.value;
      const found = currentAgendaItems.find(i => String(i.id) === String(id));
      if (!found) return;
      document.getElementById('guestEmails').value = Array.isArray(found.guests_json) ? found.guests_json.join(', ') : '';
      document.getElementById('guestReminders').value = Array.isArray(found.reminders_json) ? found.reminders_json.join(',') : '';
      document.getElementById('guestNotes').value = found.notes || '';
      document.getElementById('guestColor').value = found.color_hex || '#0f4c81';
      document.getElementById('guestScope').value = found.series_id ? 'series' : 'single';
