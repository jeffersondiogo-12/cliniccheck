      <button class="btn-logout" id="logoutBtn">
        <i class="fas fa-sign-out-alt"></i> <span>Sair</span>
      </button>
    </div>
  </aside>

  <!-- ============================================================
  MAIN
  ============================================================ -->
  <main class="main">
    <header class="topbar">
      <div>
        <h1>Gerenciamento de Clínica</h1>
        <div class="meta">Cadastre sua clínica e vincule profissionais e atendentes</div>
      </div>
      <div class="topbar-actions">
        <span class="badge"><i class="fas fa-circle"></i> Online</span>
        <a href="/medico" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> Dashboard</a>
      </div>
    </header>

    <div class="content">
      <div class="grid2">

        <!-- COLUNA ESQUERDA — formulário + lista de clínicas -->
        <div>
          <div class="card">
            <div class="card-header">
              <h3 id="formTitle"><i class="fas fa-plus-circle"></i> Nova Clínica</h3>
              <div style="display:flex;gap:8px;">
                <button class="btn btn-outline btn-sm" id="cancelEditBtn" style="display:none" onclick="cancelEdit()"><i class="fas fa-times"></i> Cancelar</button>
                <button class="btn btn-teal btn-sm" id="newClinicBtn" onclick="openNewClinicForm()"><i class="fas fa-plus"></i> Nova</button>
              </div>
            </div>
            <div class="card-body" id="clinicFormWrap">
              <div class="form-grid">
                <div class="form-group span2">
                  <label>Nome da Clínica *</label>
                  <input type="text" id="fName" placeholder="Ex: Clínica Aline — Estética Avançada" maxlength="120" />
                </div>
                <div class="form-group">
                  <label>CNPJ</label>
                  <input type="text" id="fCnpj" placeholder="00.000.000/0001-00" maxlength="18" oninput="maskCnpj(this)" />
                </div>
                <div class="form-group">
                  <label>Telefone</label>
                  <input type="text" id="fPhone" placeholder="(00) 00000-0000" maxlength="20" />
                </div>
                <div class="form-group">
                  <label>E-mail</label>
                  <input type="email" id="fEmail" placeholder="contato@clinica.com.br" />
                </div>
                <div class="form-group">
                  <label>CEP</label>
                  <input type="text" id="fZip" placeholder="00000-000" maxlength="9" oninput="maskCep(this)" onblur="fetchCep(this.value)" />
                </div>
                <div class="form-group span2">
                  <label>Endereço</label>
                  <input type="text" id="fAddress" placeholder="Rua, número, complemento" />
                </div>
                <div class="form-group">
                  <label>Cidade</label>
                  <input type="text" id="fCity" placeholder="Cidade" />
                </div>
                <div class="form-group">
                  <label>Estado (UF)</label>
                  <input type="text" id="fState" placeholder="SP" maxlength="2" style="text-transform:uppercase" />
                </div>
              </div>

              <!-- Identidade visual -->
              <div style="margin-top:18px;padding-top:14px;border-top:1.5px dashed var(--border-card)">
                <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--text-muted);margin-bottom:12px">
                  <i class="fas fa-paint-brush"></i> Identidade Visual (aparece nas receitas e atestados)
                </p>
                <div class="form-grid">
                  <div class="form-group">
                    <label>Cor do Cabeçalho</label>
                    <div style="display:flex;align-items:center;gap:8px">
                      <input type="color" id="fHeaderColor" value="#1a237e" style="width:44px;height:36px;padding:2px;border:1px solid var(--border-card);border-radius:8px;cursor:pointer;background:var(--bg-input)" />
                      <span id="fHeaderColorTxt" style="font-size:12px;color:var(--text-muted)">#1a237e</span>
                    </div>
                  </div>
                  <div class="form-group">
                    <label>Logo / Imagem do Cabeçalho</label>
                    <input type="file" id="fHeaderImageFile" accept="image/*" onchange="handleLogoUpload(this)" style="font-size:12px" />
                    <div id="fHeaderImagePreview" style="margin-top:6px;display:none">
                      <img id="fHeaderImagePreviewImg" src="" alt="Preview" style="max-height:60px;max-width:180px;object-fit:contain;border:1px solid var(--border-card);border-radius:8px;padding:4px;background:var(--bg-card)" />
                      <button type="button" onclick="clearLogo()" style="margin-left:8px;font-size:11px;color:var(--red);background:none;border:none;cursor:pointer"><i class="fas fa-times-circle"></i> Remover</button>
                    </div>
                    <input type="hidden" id="fHeaderImageUrl" />
                  </div>
                  <div class="form-group span2">
                    <label>Texto do Rodapé dos Documentos</label>
                    <input type="text" id="fFooterText" placeholder="Ex: CRM 000 | www.clinica.com.br | Atendimento de Seg a Sex 08h–18h" maxlength="200" />
                  </div>
                </div>
              </div>

              <div style="margin-top:14px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <button class="btn btn-solid" id="saveClinicBtn" onclick="saveClinic()">
                  <i class="fas fa-save"></i> Salvar Clínica
                </button>
                <input type="hidden" id="editingClinicId" />
              </div>
              <div class="alert-msg alert-ok" id="fOk"></div>
              <div class="alert-msg alert-err" id="fErr"></div>
            </div>
          </div>

          <!-- Lista de clínicas -->
          <div class="card">
            <div class="card-header">
              <h3><i class="fas fa-clinic-medical"></i> Minhas Clínicas</h3>
              <span id="clinicCount" style="font-size:11px;color:var(--text-muted)"></span>
            </div>
            <div class="card-body" id="clinicListWrap" style="padding:12px;">
              <div class="empty-state">
                <i class="fas fa-building" style="font-size:32px;opacity:0.25;display:block;margin-bottom:10px;"></i>
                <p>Carregando clínicas...</p>
              </div>
            </div>
          </div>
        </div>

        <!-- COLUNA DIREITA — painel de membros -->
        <div id="memberPanel" style="display:none">
          <div class="card">
            <div class="card-header">
              <div>
                <h3 id="memberPanelTitle"><i class="fas fa-users"></i> Membros da Clínica</h3>
                <div style="font-size:11px;color:var(--text-muted);margin-top:2px" id="memberPanelSub"></div>
              </div>
            </div>

            <!-- Adicionar membro -->
            <div class="card-body" style="padding-bottom:0">
              <div class="member-add-area">
                <div style="display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:end;">
                  <div>
                    <label>Adicionar Profissional / Atendente</label>
                    <select id="addMemberType" style="margin-bottom:6px;padding:8px 10px;border:1px solid var(--border-card);border-radius:var(--radius);font-size:12px;font-family:var(--font);width:100%;background:var(--bg-input);outline:none;" onchange="loadMemberOptions()">
                      <option value="doctor">Médico / Profissional</option>
                      <option value="receptionist">Recepcionista / Atendente</option>
                    </select>
                    <select id="addMemberId" style="padding:8px 10px;border:1px solid var(--border-card);border-radius:var(--radius);font-size:12px;font-family:var(--font);width:100%;background:var(--bg-input);outline:none;">
                      <option value="">Selecione...</option>
                    </select>
                  </div>
                  <button class="btn btn-teal" onclick="addMember()" id="addMemberBtn" style="height:38px;align-self:end;"><i class="fas fa-plus"></i> Adicionar</button>
                </div>
                <div class="alert-msg alert-ok" id="mOk"></div>
                <div class="alert-msg alert-err" id="mErr"></div>
              </div>
            </div>

            <!-- Tabela de membros -->
            <div class="table-wrap">
              <table>
                <thead><tr><th>Nome</th><th>E-mail</th><th>Tipo</th><th>Papel</th><th>Ações</th></tr></thead>
                <tbody id="membersBody">
                  <tr><td colspan="5" style="text-align:center;padding:24px;color:var(--text-muted)">Nenhum membro cadastrado</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Estado inicial direita -->
        <div id="emptyRight" style="display:flex;align-items:center;justify-content:center;min-height:300px;">
          <div class="empty-state">
            <i class="fas fa-hand-pointer" style="font-size:42px;opacity:0.25;display:block;margin-bottom:12px;"></i>
            <p style="margin-top:12px;font-size:13px;font-weight:500;color:var(--text-secondary)">Selecione uma clínica</p>
            <p style="font-size:11px;margin-top:4px;">Clique em uma clínica à esquerda para ver e gerenciar seus membros</p>
          </div>
        </div>

        <!-- Modal de Permissões -->
        <div class="modal-overlay" id="permModal">
          <div class="modal">
            <div class="modal-head">
              <div>
                <h3><i class="fas fa-lock"></i> Permissões por Tela</h3>
                <div id="permModalSub" style="font-size:12px;color:var(--text-muted);margin-top:2px;"></div>
              </div>
              <button class="modal-close" onclick="closePermissionsModal()">&times;</button>
            </div>
            <div class="modal-body">
              <div style="overflow-x:auto;">
                <table style="width:100%;border-collapse:collapse;font-size:12px;">
                  <thead>
                    <tr>
                      <th style="text-align:left;padding:8px;border-bottom:1px solid var(--border-subtle);font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;">Tela</th>
                      <th style="text-align:left;padding:8px;border-bottom:1px solid var(--border-subtle);font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;">Grupo</th>
                      <th style="text-align:left;padding:8px;border-bottom:1px solid var(--border-subtle);font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;">Perfil</th>
                      <th style="text-align:center;padding:8px;border-bottom:1px solid var(--border-subtle);font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;">Ver</th>
                      <th style="text-align:center;padding:8px;border-bottom:1px solid var(--border-subtle);font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;">Criar</th>
                      <th style="text-align:center;padding:8px;border-bottom:1px solid var(--border-subtle);font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;">Editar</th>
                      <th style="text-align:center;padding:8px;border-bottom:1px solid var(--border-subtle);font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;">Excluir</th>
                    </tr>
                  </thead>
                  <tbody id="permTableBody"></tbody>
                </table>
              </div>
              <div style="font-size:11px;color:var(--text-muted);margin-top:8px;">
                <i class="fas fa-info-circle"></i> Telas marcadas como "Fora do perfil" podem ser concedidas manualmente (ex.: atendente com tela médica).
              </div>
            </div>
            <div class="modal-foot">
              <button class="btn btn-outline" onclick="closePermissionsModal()">Cancelar</button>
              <button class="btn btn-solid" id="savePermBtn" onclick="savePermissions()"><i class="fas fa-save"></i> Salvar Permissões</button>
            </div>
          </div>
        </div>

        <!-- Modal de Edição de Perfil (qualquer membro) -->
        <div class="modal-overlay" id="editProfileModal">
          <div class="modal">
            <div class="modal-head">
              <div>
                <h3><i class="fas fa-user-edit"></i> Editar Perfil</h3>
                <div id="editProfileSub" style="font-size:12px;color:var(--text-muted);margin-top:2px;"></div>
              </div>
              <button class="modal-close" onclick="closeEditProfileModal()">&times;</button>
            </div>
            <div class="modal-body">
              <input type="hidden" id="editProfileMemberRowId">
              <div style="display:flex;gap:18px;align-items:center;margin-bottom:18px;">
                <div style="position:relative;">
                  <img id="epPhotoPreview" src="" alt="" style="width:76px;height:76px;border-radius:50%;object-fit:cover;display:none;">
                  <div id="epPhotoPlaceholder" style="width:76px;height:76px;border-radius:50%;background:var(--bg-elevated);display:flex;align-items:center;justify-content:center;font-size:26px;color:var(--text-muted);"><i class="fas fa-user"></i></div>
                </div>
                <div>
                  <button type="button" class="btn btn-outline btn-sm" id="epChoosePhotoBtn"><i class="fas fa-camera"></i> Trocar foto</button>
                  <input type="file" id="epPhotoInput" accept="image/*" style="display:none;">
                </div>
              </div>
              <div class="form-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                <div class="form-group span2"><label>Nome completo</label><input type="text" id="epName"></div>
                <div class="form-group"><label>Telefone</label><input type="text" id="epPhone" placeholder="(11) 99999-9999"></div>
                <div class="form-group" id="epSpecialtyGroup"><label>Especialidade</label><input type="text" id="epSpecialty"></div>
                <div class="form-group span2" id="epBioGroup"><label>Resumo profissional (bio)</label><textarea id="epBio" rows="3"></textarea></div>
              </div>
              <div class="alert-msg alert-err" id="editProfileErr" style="display:none;"></div>
            </div>
            <div class="modal-foot">
              <button class="btn btn-outline" onclick="closeEditProfileModal()">Cancelar</button>
              <button class="btn btn-solid" id="confirmEditProfileBtn"><i class="fas fa-save"></i> Salvar Perfil</button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>

  <!-- ============================================================
  SCRIPTS (mantidos integrais, com pequenos ajustes para o novo CSS)
  ============================================================ -->
  <script>
    (function() {
      // ============================================================
      // SIDEBAR — TOGGLE, TEMA, LOGOUT (idêntico à referência)
      // ============================================================
      const sidebar = document.querySelector('.sidebar');
      const toggleBtn = document.getElementById('sidebarToggleBtn');
      const overlay = document.getElementById('sidebarOverlay');
      let isCollapsed = false;

      const savedCollapse = localStorage.getItem('sidebarCollapsed');
      if (savedCollapse === 'true') {
        sidebar.classList.add('collapsed');
        isCollapsed = true;
      }

      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (window.innerWidth <= 992) {
          sidebar.classList.toggle('open');
          overlay.classList.toggle('active');
          document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
        } else {
          isCollapsed = !isCollapsed;
          sidebar.classList.toggle('collapsed', isCollapsed);
          localStorage.setItem('sidebarCollapsed', String(isCollapsed));
        }
      });

      overlay.addEventListener('click', function() {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      });

      window.addEventListener('resize', function() {
        if (window.innerWidth > 992) {
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        }
      });

      // TEMA
      const themeToggle = document.getElementById('themeToggle');
      const currentTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', currentTheme);

      themeToggle.addEventListener('click', function() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const newTheme = isDark ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      });

      // LOGOUT
      document.getElementById('logoutBtn').addEventListener('click', function() {
        localStorage.removeItem('doctorToken');
        localStorage.removeItem('doctorData');
        window.location.href = '/medico/login';
      });

      // ============================================================
      // DADOS DO USUÁRIO
      // ============================================================
      const token = localStorage.getItem('doctorToken');
      const doctorData = JSON.parse(localStorage.getItem('doctorData') || '{}');
      if (!token) { window.location.href = '/medico/login'; }

      const nameEl = document.getElementById('sidebarName');
      const roleEl = document.getElementById('sidebarRole');
      const clinicEl = document.getElementById('sidebarClinic');
      if (nameEl) nameEl.textContent = doctorData.name || 'Profissional';
      if (roleEl) roleEl.textContent = doctorData.isClinicOwner ? 'Owner da Clínica' : 'Profissional';
      if (clinicEl) clinicEl.textContent = 'Clínica: ' + (doctorData.clinicName || '--');

      const headers = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };

      // ============================================================
      // PERMISSÕES — esconde da sidebar as páginas que este usuário
      // não pode ver (os itens já nascem com "hidden" no HTML pra não
      // aparecer nem um instante antes desta checagem terminar).
      // ============================================================
      document.querySelectorAll('#sidebarNav .nav-item[data-page]').forEach((item) => {
        item.hidden = true;
      });
      fetch('/api/auth/permissions', { headers })
        .then((r) => r.ok ? r.json() : null)
        .then((data) => {
          if (!data || !Array.isArray(data.pages)) return;
          const allowed = new Set((data.pages || []).filter((p) => p.can_view).map((p) => p.code));
          document.querySelectorAll('#sidebarNav .nav-item[data-page]').forEach((item) => {
            const rawCodes = item.getAttribute('data-page-codes') || item.getAttribute('data-page') || '';
            const pageCodes = rawCodes.split(',').map((code) => code.trim()).filter(Boolean);
            if (!pageCodes.length) { item.hidden = false; return; }
            const canSee = pageCodes.some((code) => allowed.has(code));
            item.hidden = !canSee;
          });
          document.querySelectorAll('.sb-group').forEach((g) => {
            const hasVisible = Array.from(g.querySelectorAll('.nav-item')).some((i) => !i.hidden);
            g.style.display = hasVisible ? '' : 'none';
          });
        })
        .catch(() => {});

      // ============================================================
      // LÓGICA ORIGINAL DO CLINIC MANAGER (mantida intacta)
      // ============================================================
      let clinics = [];
      let clinicDoctors = [];
      let clinicReceptionists = [];
      let selectedClinicId = null;
      let editingId = null;
      let currentPermissionsMemberRowId = null;
      let canCreateNewClinic = true;

      function escH(s) {
        return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      // ── LOGO UPLOAD ────────────────────────────────────────────
      function handleLogoUpload(input) {
        const file = input.files[0];
        if (!file) return;
        if (file.size > 2 * 1024 * 1024) { alert('A imagem deve ter no máximo 2MB.'); input.value = ''; return; }
        const reader = new FileReader();
        reader.onload = function(e) {
          const dataUrl = e.target.result;
          document.getElementById('fHeaderImageUrl').value = dataUrl;
          document.getElementById('fHeaderImagePreviewImg').src = dataUrl;
          document.getElementById('fHeaderImagePreview').style.display = '';
        };
        reader.readAsDataURL(file);
      }

      function clearLogo() {
        document.getElementById('fHeaderImageUrl').value = '';
        document.getElementById('fHeaderImageFile').value = '';
        document.getElementById('fHeaderImagePreview').style.display = 'none';
      }

      document.addEventListener('DOMContentLoaded', function() {
        const cp = document.getElementById('fHeaderColor');
        if (cp) cp.addEventListener('input', function() {
          document.getElementById('fHeaderColorTxt').textContent = this.value;
        });
      });

      // ── MÁSCARAS ────────────────────────────────────────────────
      function maskCnpj(el) {
        let v = el.value.replace(/\D/g, '').slice(0, 14);
        v = v.replace(/^(\d{2})(\d)/, '$1.$2')
          .replace(/^(\d{2})\.(\d{3})(\d)/, '$1.$2.$3')
          .replace(/\.(\d{3})(\d)/, '.$1/$2')
          .replace(/(\d{4})(\d)/, '$1-$2');
        el.value = v;
      }

      function maskCep(el) {
        let v = el.value.replace(/\D/g, '').slice(0, 8);
        if (v.length > 5) v = v.slice(0, 5) + '-' + v.slice(5);
        el.value = v;
      }

      async function fetchCep(cep) {
        const digits = cep.replace(/\D/g, '');
        if (digits.length !== 8) return;
        try {
          const res = await fetch(`https://viacep.com.br/ws/${digits}/json/`);
          const data = await res.json();
          if (!data.erro) {
            document.getElementById('fAddress').value = data.logradouro || '';
            document.getElementById('fCity').value = data.localidade || '';
            document.getElementById('fState').value = data.uf || '';
          }
        } catch {}
      }

      // ── CARREGAR DADOS BASE ──────────────────────────────────────
      async function loadBase() {
        const cRes = await fetch('/api/clinics', { headers });
        clinics = cRes.ok ? await cRes.json() : [];
        renderClinicList();

        if (clinics.length === 1 && clinics[0]?.id) {
          await selectClinic(clinics[0].id);
        }
      }

      // ── RENDERIZAR LISTA ─────────────────────────────────────────
      function renderClinicList() {
        const wrap = document.getElementById('clinicListWrap');
        document.getElementById('clinicCount').textContent = `${clinics.length} clínica(s)`;
        if (!clinics.length) {
          wrap.innerHTML = `<div class="empty-state">
            <i class="fas fa-building" style="font-size:32px;opacity:0.25;display:block;margin-bottom:10px;"></i>
            <p>Nenhuma clínica cadastrada ainda.</p>
            <p style="font-size:11px;margin-top:4px;">Use o formulário acima para criar a sua.</p>
          </div>`;
          return;
        }
        wrap.innerHTML = clinics.map(c => `
          <div class="clinic-card${c.id === selectedClinicId ? ' selected' : ''}" id="cc_${c.id}" onclick="selectClinic('${c.id}')">
            <div class="cc-actions">
              <button class="btn btn-outline btn-sm" onclick="event.stopPropagation();editClinic('${c.id}')"><i class="fas fa-edit"></i></button>
              ${c.is_owner ? `<button class="btn btn-red btn-sm" onclick="event.stopPropagation();deleteClinic('${c.id}')"><i class="fas fa-trash-alt"></i></button>` : ''}
            </div>
            <div class="cc-name">${escH(c.name)}${!c.active ? '<span class="badge-inactive">Inativa</span>' : ''}</div>
            <div class="cc-meta">
              ${c.cnpj ? `CNPJ: ${formatCnpj(c.cnpj)} &nbsp;·&nbsp; ` : ''}
              ${c.city ? escH(c.city) + (c.state ? '/' + escH(c.state) : '') + ' &nbsp;·&nbsp; ' : ''}
              <strong>${c.member_count}</strong> membro(s)
              ${c.is_owner ? ' &nbsp;·&nbsp; <span style="color:var(--accent-1);font-weight:600;">Você é o owner</span>' : ''}
            </div>
          </div>`
        ).join('');

        updateCreateClinicUI();
      }

      function updateCreateClinicUI() {
        const btn = document.getElementById('newClinicBtn');
        if (!btn) return;

        const hasOwnedClinic = clinics.some(c => !!c.is_owner);
        const hasAnyClinic = clinics.length > 0;
        canCreateNewClinic = hasOwnedClinic || !hasAnyClinic;

        btn.disabled = !canCreateNewClinic;
        btn.title = canCreateNewClinic ? 'Criar nova clínica' : 'Somente owner pode criar nova clínica.';
      }

      function formatCnpj(v) {
        const d = String(v).replace(/\D/g, '');
        return d.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, '$1.$2.$3/$4-$5') || v;
      }

      // ── SELECIONAR CLÍNICA ───────────────────────────────────────
      async function selectClinic(id) {
        selectedClinicId = id;
        document.querySelectorAll('.clinic-card').forEach(el => el.classList.remove('selected'));
        const card = document.getElementById('cc_' + id);
        if (card) card.classList.add('selected');
        const clinic = clinics.find(c => c.id === id);
        document.getElementById('memberPanel').style.display = '';
        document.getElementById('emptyRight').style.display = 'none';
        document.getElementById('memberPanelTitle').textContent = `Membros — ${clinic?.name || ''}`;
        document.getElementById('memberPanelSub').textContent =
          `${clinic?.city || ''} ${clinic?.state ? '/ ' + clinic.state : ''} ${clinic?.cnpj ? '· CNPJ: ' + formatCnpj(clinic.cnpj) : ''}`.trim();
        await loadMembers(id);
      }

      let currentMembers = [];
      async function loadMembers(clinicId) {
        const res = await fetch(`/api/clinics/${clinicId}/members`, { headers });
        const members = res.ok ? await res.json() : [];
        currentMembers = members;
        renderMembersTable(members);
      }

      function renderMembersTable(members) {
        const tbody = document.getElementById('membersBody');
        if (!members.length) {
          tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:24px;color:var(--text-muted)">Nenhum membro. Adicione profissionais e atendentes acima.</td></tr>';
          return;
        }
        tbody.innerHTML = members.map(m => `<tr id="mr_${m.member_row_id}">
          <td>
            ${m.photo_url ? `<img src="${escH(m.photo_url)}" alt="" style="width:28px;height:28px;border-radius:50%;object-fit:cover;vertical-align:middle;margin-right:8px;">` : ''}
            <strong>${escH(m.name || '—')}</strong>${m.crm ? `<br><small style="color:var(--text-muted)">CRM: ${escH(m.crm)}</small>` : ''}${!m.active ? '<br><small style="color:var(--red)">Inativo</small>' : ''}
          </td>
          <td>${escH(m.email || '—')}</td>
          <td><span class="badge ${m.member_type === 'doctor' ? 'badge-doc' : 'badge-rec'}">${m.member_type === 'doctor' ? 'Médico' : 'Recepcionista'}</span></td>
          <td>
            <select onchange="updateMemberRole('${m.member_row_id}',this.value)" style="padding:4px 8px;border:1px solid var(--border-card);border-radius:6px;font-size:11px;font-family:var(--font);background:var(--bg-input);color:var(--text-primary);">
              <option value="admin" ${m.role === 'admin' ? 'selected' : ''}>Admin</option>
              <option value="member" ${m.role === 'member' ? 'selected' : ''}>Membro</option>
            </select>
          </td>
          <td style="display:flex;gap:6px;flex-wrap:wrap;">
            <button class="btn btn-outline btn-sm" onclick="openEditProfileModal('${m.member_row_id}')"><i class="fas fa-user-edit"></i> Perfil</button>
            <button class="btn btn-outline btn-sm" onclick="openPermissionsModal('${m.member_row_id}','${escH(m.name || 'Membro')}')"><i class="fas fa-lock"></i> Permissões</button>
            <button class="btn btn-red btn-sm" onclick="removeMember('${m.member_row_id}')"><i class="fas fa-user-minus"></i></button>
          </td>
        </tr>`).join('');
      }

      // ── EDITAR PERFIL DE QUALQUER MEMBRO ────────────────────────────
      function openEditProfileModal(memberRowId) {
        const m = currentMembers.find((x) => x.member_row_id === memberRowId);
        if (!m) return;
        document.getElementById('editProfileMemberRowId').value = memberRowId;
        document.getElementById('editProfileSub').textContent = `${m.member_type === 'doctor' ? 'Médico' : 'Recepcionista'}: ${m.name || ''}`;
        document.getElementById('epName').value = m.name || '';
        document.getElementById('epPhone').value = m.phone || '';
        const isDoctor = m.member_type === 'doctor';
        document.getElementById('epSpecialtyGroup').style.display = isDoctor ? '' : 'none';
        document.getElementById('epBioGroup').style.display = isDoctor ? '' : 'none';
        document.getElementById('epSpecialty').value = m.specialty || '';
        document.getElementById('epBio').value = m.bio || '';
        pendingEditProfilePhoto = null;
        if (m.photo_url) { document.getElementById('epPhotoPreview').src = m.photo_url; document.getElementById('epPhotoPreview').style.display = 'block'; document.getElementById('epPhotoPlaceholder').style.display = 'none'; }
        else { document.getElementById('epPhotoPreview').style.display = 'none'; document.getElementById('epPhotoPlaceholder').style.display = 'flex'; }
        document.getElementById('editProfileErr').style.display = 'none';
        document.getElementById('editProfileModal').style.display = 'flex';
      }
      function closeEditProfileModal(){ document.getElementById('editProfileModal').style.display = 'none'; }

      let pendingEditProfilePhoto = null;
      document.getElementById('epChoosePhotoBtn').addEventListener('click', () => document.getElementById('epPhotoInput').click());
      document.getElementById('epPhotoInput').addEventListener('change', () => {
        const file = document.getElementById('epPhotoInput').files[0];
        if (!file) return;
        if (file.size > 3.2 * 1024 * 1024) { alert('Imagem muito grande — escolha uma de até ~3MB.'); return; }
        const reader = new FileReader();
        reader.onload = () => {
          pendingEditProfilePhoto = reader.result;
          document.getElementById('epPhotoPreview').src = pendingEditProfilePhoto;
          document.getElementById('epPhotoPreview').style.display = 'block';
          document.getElementById('epPhotoPlaceholder').style.display = 'none';
        };
        reader.readAsDataURL(file);
      });

      document.getElementById('confirmEditProfileBtn').addEventListener('click', async () => {
        const errEl = document.getElementById('editProfileErr');
        errEl.style.display = 'none';
        const memberRowId = document.getElementById('editProfileMemberRowId').value;
        const name = document.getElementById('epName').value.trim();
        if (!name) { errEl.textContent = 'O nome não pode ficar em branco.'; errEl.style.display = 'block'; return; }
        const payload = {
          name,
          phone: document.getElementById('epPhone').value.trim(),
          specialty: document.getElementById('epSpecialty').value.trim(),
          bio: document.getElementById('epBio').value,
        };
        if (pendingEditProfilePhoto) payload.photoUrl = pendingEditProfilePhoto;
        try {
          const res = await fetch(`/api/clinics/${selectedClinicId}/members/${memberRowId}/profile`, {
            method: 'PUT', headers, body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Falha ao salvar perfil.');
          closeEditProfileModal();
          loadMembers(selectedClinicId);
        } catch (e) { errEl.textContent = e.message; errEl.style.display = 'block'; }
      });

      // ── PERMISSÕES ───────────────────────────────────────────────
      async function openPermissionsModal(memberRowId, memberName) {
        if (!selectedClinicId) return;
        currentPermissionsMemberRowId = memberRowId;
        document.getElementById('permModalSub').textContent = `Membro: ${memberName}`;
        document.getElementById('permTableBody').innerHTML = '<tr><td colspan="7" style="padding:12px;text-align:center;color:var(--text-muted)">Carregando...</td></tr>';
        document.getElementById('permModal').style.display = 'flex';

        const res = await fetch(`/api/clinics/${selectedClinicId}/members/${memberRowId}/permissions`, { headers });
        const pages = res.ok ? await res.json() : [];
        if (!pages.length) {
          document.getElementById('permTableBody').innerHTML = '<tr><td colspan="7" style="padding:12px;text-align:center;color:var(--text-muted)">Sem páginas cadastradas.</td></tr>';
          return;
        }

        const groupedPages = {};
        pages.forEach(p => {
          const g = p.menu_group || 'outros';
          if (!groupedPages[g]) groupedPages[g] = [];
          groupedPages[g].push(p);
        });
        let permHtml = '';
        for (const [group, items] of Object.entries(groupedPages)) {
          permHtml += `<tr><td colspan="7" style="padding:5px 8px;background:var(--bg-elevated);color:var(--text-secondary);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;border-bottom:1px solid var(--border-subtle);">${escH(group.replace(/_/g, ' '))}</td></tr>`;
          permHtml += items.map(p => {
            const isSub = p.code.includes('.');
            const rowBg = p.is_out_of_profile ? 'background:rgba(251,146,60,0.07);' : '';
            const indent = isSub ? 'padding-left:22px;' : '';
            const prefix = isSub ? '<span style="color:var(--text-muted);margin-right:4px;font-size:10px;">└</span>' : '';
            return `<tr data-page="${p.code}" style="${rowBg}">
              <td style="padding:7px 8px;${indent}border-bottom:1px solid var(--border-subtle);font-size:12px;">${prefix}${escH(p.name)} <small style="color:var(--text-muted)">(${escH(p.code)})</small></td>
              <td style="padding:7px 8px;border-bottom:1px solid var(--border-subtle);font-size:11px;color:var(--text-muted);text-transform:capitalize;">${escH(group.replace(/_/g, ' '))}</td>
              <td style="padding:7px 8px;border-bottom:1px solid var(--border-subtle);font-size:11px;">${p.is_out_of_profile ? '<span class="badge badge-rec">Fora do perfil</span>' : '<span class="badge badge-doc">Padrão</span>'}</td>
              <td style="padding:7px 8px;border-bottom:1px solid var(--border-subtle);text-align:center;"><input type="checkbox" class="perm-view" ${p.can_view ? 'checked' : ''}></td>
              <td style="padding:7px 8px;border-bottom:1px solid var(--border-subtle);text-align:center;"><input type="checkbox" class="perm-create" ${p.can_create ? 'checked' : ''}></td>
              <td style="padding:7px 8px;border-bottom:1px solid var(--border-subtle);text-align:center;"><input type="checkbox" class="perm-update" ${p.can_update ? 'checked' : ''}></td>
              <td style="padding:7px 8px;border-bottom:1px solid var(--border-subtle);text-align:center;"><input type="checkbox" class="perm-delete" ${p.can_delete ? 'checked' : ''}></td>
            </tr>`;
          }).join('');
        }
        document.getElementById('permTableBody').innerHTML = permHtml;
      }

      function closePermissionsModal() {
        document.getElementById('permModal').style.display = 'none';
        currentPermissionsMemberRowId = null;
      }

      async function savePermissions() {
        if (!selectedClinicId || !currentPermissionsMemberRowId) return;
        const btn = document.getElementById('savePermBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spin"></span>Salvando...';

        const permissions = Array.from(document.querySelectorAll('#permTableBody tr[data-page]')).map((row) => ({
          pageCode: row.getAttribute('data-page'),
          canView: row.querySelector('.perm-view').checked,
          canCreate: row.querySelector('.perm-create').checked,
          canUpdate: row.querySelector('.perm-update').checked,
          canDelete: row.querySelector('.perm-delete').checked,
        }));

        const res = await fetch(`/api/clinics/${selectedClinicId}/members/${currentPermissionsMemberRowId}/permissions`, {
          method: 'PUT',
          headers,
          body: JSON.stringify({ permissions }),
        });
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-save"></i> Salvar Permissões';

        if (!res.ok) {
          alert('Erro ao salvar permissões.');
          return;
        }
        alert('Permissões atualizadas com sucesso.');
        closePermissionsModal();
      }

      // ── FORM CLÍNICA ──────────────────────────────────────────────
      function openNewClinicForm() {
        if (!canCreateNewClinic) {
          alert('Somente owner pode criar nova clínica.');
          return;
        }
        cancelEdit();
        document.getElementById('clinicFormWrap').scrollIntoView({ behavior: 'smooth' });
        document.getElementById('fName').focus();
      }

      function fillForm(c) {
        document.getElementById('fName').value = c.name || '';
        document.getElementById('fCnpj').value = c.cnpj ? formatCnpj(c.cnpj) : '';
        document.getElementById('fPhone').value = c.phone || '';
        document.getElementById('fEmail').value = c.email || '';
        document.getElementById('fZip').value = c.zip_code ? c.zip_code.replace(/^(\d{5})(\d{3})$/, '$1-$2') : '';
        document.getElementById('fAddress').value = c.address || '';
        document.getElementById('fCity').value = c.city || '';
        document.getElementById('fState').value = c.state || '';
        const color = c.header_color || '#1a237e';
        document.getElementById('fHeaderColor').value = color;
        document.getElementById('fHeaderColorTxt').textContent = color;
        document.getElementById('fFooterText').value = c.footer_text || '';
        const imgUrl = c.header_image_url || '';
        document.getElementById('fHeaderImageUrl').value = imgUrl;
        if (imgUrl) {
          document.getElementById('fHeaderImagePreviewImg').src = imgUrl;
          document.getElementById('fHeaderImagePreview').style.display = '';
        } else {
          document.getElementById('fHeaderImagePreview').style.display = 'none';
        }
      }

      function editClinic(id) {
        const c = clinics.find(x => x.id === id);
        if (!c) return;
        editingId = id;
        document.getElementById('editingClinicId').value = id;
        document.getElementById('formTitle').innerHTML = '<i class="fas fa-edit"></i> Editar Clínica';
        document.getElementById('cancelEditBtn').style.display = '';
        document.getElementById('saveClinicBtn').innerHTML = '<i class="fas fa-save"></i> Atualizar';
        fillForm(c);
        document.getElementById('clinicFormWrap').scrollIntoView({ behavior: 'smooth' });
      }

      function cancelEdit() {
        editingId = null;
        document.getElementById('editingClinicId').value = '';
        document.getElementById('formTitle').innerHTML = '<i class="fas fa-plus-circle"></i> Nova Clínica';
        document.getElementById('cancelEditBtn').style.display = 'none';
        document.getElementById('saveClinicBtn').innerHTML = '<i class="fas fa-save"></i> Salvar Clínica';
        ['fName', 'fCnpj', 'fPhone', 'fEmail', 'fZip', 'fAddress', 'fCity', 'fState', 'fFooterText'].forEach(id => document.getElementById(id).value = '');
        document.getElementById('fHeaderColor').value = '#1a237e';
        document.getElementById('fHeaderColorTxt').textContent = '#1a237e';
        document.getElementById('fHeaderImageUrl').value = '';
        document.getElementById('fHeaderImagePreview').style.display = 'none';
        document.getElementById('fOk').style.display = 'none';
        document.getElementById('fErr').style.display = 'none';
      }

      async function saveClinic() {
        const ok = document.getElementById('fOk');
        const err = document.getElementById('fErr');
        ok.style.display = 'none';
        err.style.display = 'none';
        const name = document.getElementById('fName').value.trim();
        if (!name) {
          err.textContent = 'Nome da clínica é obrigatório.';
          err.style.display = 'block';
          document.getElementById('fName').classList.add('err');
          return;
        }
        document.getElementById('fName').classList.remove('err');
        const body = {
          name,
          cnpj: document.getElementById('fCnpj').value.replace(/\D/g, '') || null,
          phone: document.getElementById('fPhone').value.trim() || null,
          email: document.getElementById('fEmail').value.trim() || null,
          zipCode: document.getElementById('fZip').value.replace(/\D/g, '') || null,
          address: document.getElementById('fAddress').value.trim() || null,
          city: document.getElementById('fCity').value.trim() || null,
          state: document.getElementById('fState').value.trim().toUpperCase() || null,
          headerColor: document.getElementById('fHeaderColor').value || null,
          headerImageUrl: document.getElementById('fHeaderImageUrl').value || null,
          footerText: document.getElementById('fFooterText').value.trim() || null,
        };
        const btn = document.getElementById('saveClinicBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spin"></span>Salvando...';
        try {
          const url = editingId ? `/api/clinics/${editingId}` : '/api/clinics';
          const method = editingId ? 'PUT' : 'POST';
          const res = await fetch(url, { method, headers, body: JSON.stringify(body) });
          const data = await res.json();
          if (res.ok) {
            ok.textContent = editingId ? 'Clínica atualizada!' : 'Clínica criada com sucesso!';
            ok.style.display = 'block';
            if (editingId) {
              const idx = clinics.findIndex(c => c.id === editingId);
              if (idx >= 0) clinics[idx] = { ...clinics[idx], ...data };
            } else {
              data.member_count = 1;
              data.is_owner = true;
              clinics.unshift(data);
            }
            renderClinicList();
            cancelEdit();
            if (!editingId && data.id) selectClinic(data.id);
          } else {
            err.textContent = data.error || 'Erro ao salvar.';
            err.style.display = 'block';
            updateCreateClinicUI();
          }
        } catch {
          err.textContent = 'Erro de conexão.';
          err.style.display = 'block';
        }
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-save"></i> ' + (editingId ? 'Atualizar' : 'Salvar Clínica');
      }

      async function deleteClinic(id) {
        if (!confirm('Desativar esta clínica? Os dados serão mantidos.')) return;
        const res = await fetch(`/api/clinics/${id}`, { method: 'DELETE', headers });
        if (res.ok) {
          clinics = clinics.filter(c => c.id !== id);
          renderClinicList();
          if (selectedClinicId === id) {
            document.getElementById('memberPanel').style.display = 'none';
            document.getElementById('emptyRight').style.display = 'flex';
            selectedClinicId = null;
          }
        } else {
          alert('Erro ao remover.');
        }
      }

      // ── MEMBROS ───────────────────────────────────────────────────
      function loadMemberOptions() {
        const type = document.getElementById('addMemberType').value;
        const sel = document.getElementById('addMemberId');
        const list = type === 'doctor' ? allDoctors : allReceptionists;
        sel.innerHTML = '<option value="">Selecione...</option>';
        list.forEach(p => {
          const o = document.createElement('option');
          o.value = p.id;
          o.textContent = p.name + (p.email ? ' — ' + p.email : '') + (p.crm ? ' (CRM: ' + p.crm + ')' : '');
          sel.appendChild(o);
        });
      }

      async function addMember() {
        const ok = document.getElementById('mOk');
        const err = document.getElementById('mErr');
        ok.style.display = 'none';
        err.style.display = 'none';
        if (!selectedClinicId) {
          err.textContent = 'Selecione uma clínica primeiro.';
          err.style.display = 'block';
          return;
        }
        const memberId = document.getElementById('addMemberId').value;
        const memberType = document.getElementById('addMemberType').value;
        if (!memberId) {
          err.textContent = 'Selecione um profissional.';
          err.style.display = 'block';
          return;
        }
        const btn = document.getElementById('addMemberBtn');
        btn.disabled = true;
        try {
          const res = await fetch(`/api/clinics/${selectedClinicId}/members`, {
            method: 'POST',
            headers,
            body: JSON.stringify({ memberId, memberType })
          });
          const data = await res.json();
          if (res.ok) {
            ok.textContent = 'Membro adicionado com sucesso!';
            ok.style.display = 'block';
            const clinic = clinics.find(c => c.id === selectedClinicId);
            if (clinic) { clinic.member_count = Number(clinic.member_count || 0) + 1;
              renderClinicList(); }
            await loadMembers(selectedClinicId);
            document.getElementById('addMemberId').value = '';
          } else {
            err.textContent = data.error || 'Erro ao adicionar.';
            err.style.display = 'block';
          }
        } catch {
          err.textContent = 'Erro de conexão.';
          err.style.display = 'block';
        }
        btn.disabled = false;
      }

      async function updateMemberRole(memberRowId, role) {
        const res = await fetch(`/api/clinics/${selectedClinicId}/members/${memberRowId}`, {
          method: 'PATCH',
          headers,
          body: JSON.stringify({ role })
        });
        if (!res.ok) {
          alert('Erro ao atualizar papel do membro.');
        }
        await loadMembers(selectedClinicId);
      }

      async function removeMember(memberRowId) {
        if (!confirm('Remover este membro da clínica?')) return;
        const res = await fetch(`/api/clinics/${selectedClinicId}/members/${memberRowId}`, { method: 'DELETE', headers });
        if (res.ok) {
          const clinic = clinics.find(c => c.id === selectedClinicId);
          if (clinic && clinic.member_count > 0) clinic.member_count--;
          renderClinicList();
          await loadMembers(selectedClinicId);
        } else {
          alert('Erro ao remover membro.');
        }
      }

      async function assertClinicAccess() {
        try {
          const meRes = await fetch('/api/auth/me', { headers });
          if (!meRes.ok) {
            alert('Sessão inválida. Faça login novamente.');
            window.location.href = '/medico/login';
            return false;
          }
          return true;
        } catch (_err) {
          alert('Não foi possível validar sua permissão.');
          window.location.href = '/medico';
          return false;
        }
      }

      // ── EXPOR FUNÇÕES PARA O GLOBAL ──────────────────────────────
      window.selectClinic = selectClinic;
      window.editClinic = editClinic;
      window.deleteClinic = deleteClinic;
      window.openNewClinicForm = openNewClinicForm;
      window.cancelEdit = cancelEdit;
      window.saveClinic = saveClinic;
      window.handleLogoUpload = handleLogoUpload;
      window.clearLogo = clearLogo;
      window.maskCnpj = maskCnpj;
      window.maskCep = maskCep;
      window.fetchCep = fetchCep;
      window.loadMemberOptions = loadMemberOptions;
      window.addMember = addMember;
      window.updateMemberRole = updateMemberRole;
      window.removeMember = removeMember;
      window.openPermissionsModal = openPermissionsModal;
      window.closePermissionsModal = closePermissionsModal;
      window.savePermissions = savePermissions;
      window.loadBase = loadBase;

      // ── INIT ──────────────────────────────────────────────────────
      (async () => {
        const allowed = await assertClinicAccess();
        if (!allowed) return;
        loadBase();
      })();

      // ── SOCKET.IO ──────────────────────────────────────────────────
      (function() {
        const _d = JSON.parse(localStorage.getItem('doctorData') || '{}');
        if (!_d.id) return;
        const _sock = io({ transports: ['websocket', 'polling'] });
        _sock.on('connect', () => _sock.emit('join_doctor', _d.id));
        const refreshBase = () => { if (typeof loadBase === 'function') loadBase(); };
        const refreshMembers = () => {
          if (typeof loadMembers === 'function' && selectedClinicId) loadMembers(selectedClinicId);
          if (typeof renderClinicList === 'function') renderClinicList();
        };
        _sock.on('clinic_created', refreshBase);
        _sock.on('clinic_updated', refreshBase);
        _sock.on('clinic_deactivated', refreshBase);
        _sock.on('clinic_member_added', refreshMembers);
        _sock.on('clinic_member_role_updated', refreshMembers);
        _sock.on('clinic_member_removed', refreshMembers);
      })();

    })();
  </script>

  <!-- Socket.io (já incluso via CDN) -->
  <script src="/socket.io/socket.io.js"></script>
</body>
</html>