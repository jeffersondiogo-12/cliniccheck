                <div class="form-group">
                  <label>Tipo de Procedimento</label>
                  <select id="tplType">
                    <option value="">Geral (qualquer procedimento)</option>
                    <option value="Cirurgia de Mama">Cirurgia de Mama</option>
                    <option value="Abdominoplastia">Abdominoplastia</option>
                    <option value="Rinoplastia">Rinoplastia</option>
                    <option value="Lipoaspiração">Lipoaspiração</option>
                    <option value="Blefaroplastia">Blefaroplastia</option>
                    <option value="Lifting Facial">Lifting Facial</option>
                    <option value="Laser">Laser</option>
                    <option value="Botox">Botox</option>
                    <option value="Preenchimento">Preenchimento</option>
                    <option value="Peeling">Peeling</option>
                    <option value="Consulta">Consulta</option>
                    <option value="Outro">Outro</option>
                  </select>
                </div>
                <div class="form-group">
                  <label>Conteúdo do Documento</label>
                  <textarea id="tplBody" required placeholder="Digite o conteúdo do documento. Você pode usar HTML básico.

Variáveis disponíveis:
{{procedimento}} — nome do procedimento
{{descricao}} — detalhes clínicos"></textarea>
                </div>
              </div>
              <div style="margin-top:16px;display:flex;gap:10px;flex-wrap:wrap;">
                <button type="button" class="btn btn-outline btn-sm" id="useDefaultTplBtn">
                  <i class="fas fa-file-import"></i> Usar Modelo Padrão
                </button>
