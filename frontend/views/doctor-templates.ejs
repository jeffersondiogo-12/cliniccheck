  <!-- ============================================================
  SCRIPTS (mesmos da dashboard de referência)
  ============================================================ -->
  <script>
    // ============================================================
    // INICIALIZAÇÃO DO TEMA
    // ============================================================
    (function initTheme() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();

    // ============================================================
    // SIDEBAR (funcionalidades)
    // ============================================================
    (function initSidebar() {
      const sidebar = document.querySelector('.sidebar');
      const toggleBtn = document.getElementById('sidebarToggleBtn');
      const overlay = document.getElementById('sidebarOverlay');
      let isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
      if (isCollapsed) sidebar.classList.add('collapsed');

      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (window.innerWidth <= 992) {
          sidebar.classList.toggle('open');
          overlay.classList.toggle('active');
          document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
        } else {
          isCollapsed = !isCollapsed;
          sidebar.classList.toggle('collapsed', isCollapsed);
          localStorage.setItem('sidebarCollapsed', String(isCollapsed));
        }
      });

      overlay.addEventListener('click', function() {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      });

      window.addEventListener('resize', function() {
        if (window.innerWidth > 992) {
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        }
      });

      // Tema
      const themeToggle = document.getElementById('themeToggle');
      const currentTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', currentTheme);
      themeToggle.addEventListener('click', function() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const newTheme = isDark ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      });

      // Grupos colapsáveis
      document.querySelectorAll('.sb-group-btn').forEach((btn) => {
        btn.addEventListener('click', function() {
          const group = this.closest('.sb-group');
          if (group) group.classList.toggle('open');
        });
      });

      // Dados do usuário
      const doctorToken = localStorage.getItem('doctorToken');
      const receptionToken = localStorage.getItem('receptionToken');
      const token = doctorToken || receptionToken;
      const isReceptionSession = !doctorToken && !!receptionToken;
      const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');
      const nameEl = document.getElementById('sidebarName');
      const roleEl = document.getElementById('sidebarRole');
      const clinicEl = document.getElementById('sidebarClinic');
      if (nameEl) nameEl.textContent = doctorData.name || 'Profissional';
      if (roleEl) roleEl.textContent = isReceptionSession ? 'Recepcionista' : (doctorData.isClinicOwner ? 'Owner da Clinica' : 'Profissional');
      if (clinicEl) clinicEl.textContent = 'Clinica: ' + (doctorData.clinicName || '--');

      // Logout
      document.getElementById('logoutBtn').addEventListener('click', function() {
        localStorage.removeItem('doctorToken'); localStorage.removeItem('doctorData');
        localStorage.removeItem('receptionToken'); localStorage.removeItem('receptionData');
        window.location.href = isReceptionSession ? '/recepcao/login' : '/medico/login';
      });

      // Permissões (opcional)
      if (token) {
        fetch(isReceptionSession ? '/api/auth/permissions-receptionist' : '/api/auth/permissions', { headers: { Authorization: 'Bearer ' + token } })
          .then((r) => r.ok ? r.json() : null)
          .then((data) => {
            if (!data || !Array.isArray(data.pages)) return;
            const allowed = new Set((data.pages || []).filter((p) => p.can_view).map((p) => p.code));
            document.querySelectorAll('#sidebarNav .nav-item[data-page]').forEach((item) => {
              const rawCodes = item.getAttribute('data-page-codes') || item.getAttribute('data-page') || '';
              const pageCodes = rawCodes.split(',').map((code) => code.trim()).filter(Boolean);
              const canSee = pageCodes.some((code) => allowed.has(code));
              item.hidden = !canSee;
            });
            document.querySelectorAll('.sb-group').forEach((g) => {
              const hasVisible = Array.from(g.querySelectorAll('.nav-item')).some((i) => !i.hidden);
              g.style.display = hasVisible ? '' : 'none';
            });
          })
          .catch(() => {});
      }
    })();

    // ============================================================
    // LÓGICA DE TEMPLATES (CRUD)
    // ============================================================
    const doctorToken = localStorage.getItem('doctorToken');
    const receptionToken = localStorage.getItem('receptionToken');
    const token = doctorToken || receptionToken;
    const isReceptionSession = !doctorToken && !!receptionToken;
    const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');
    if (!token) window.location.href = '/medico/login';
    if (doctorData.name) document.getElementById('sidebarName').textContent = doctorData.name;

    const headers = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };

    let allTemplates = [];
    let editingId = null;

    function esc(v) { return String(v || '').replace(/[&<>"']/g, (s) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[s])); }

    async function loadTemplates() {
      try {
        const res = await fetch('/api/templates', { headers });
        if (!res.ok) throw new Error();
        allTemplates = await res.json();
        renderGrid();
      } catch (error) {
        console.error('Erro ao carregar modelos:', error);
        document.getElementById('tplGrid').innerHTML = '<div style="grid-column:span 2;text-align:center;padding:30px;color:var(--red);font-size:13px;">Erro ao carregar modelos.</div>';
      }
    }

    function renderGrid() {
      const q = (document.getElementById('tplSearch')?.value || '').trim().toLowerCase();
      const grid = document.getElementById('tplGrid');
      let list = allTemplates;
      if (q) {
        list = allTemplates.filter((t) =>
          (t.name || '').toLowerCase().includes(q) ||
          (t.procedure_type || '').toLowerCase().includes(q)
        );
      }

      if (!list.length) {
        grid.innerHTML = '<div style="grid-column:span 2;text-align:center;padding:30px;color:var(--text-muted);font-size:13px;">Nenhum modelo cadastrado. Crie o primeiro modelo ao lado.</div>';
        return;
      }

      grid.innerHTML = list.map(t => `
        <div class="tpl-card">
          <button class="tpl-del" onclick="deleteTemplate('${t.id}')" title="Excluir modelo">
            <i class="fas fa-trash-alt"></i>
          </button>
          <h4>${esc(t.name)}</h4>
          <div class="tpl-type">${t.procedure_type || 'Geral'}</div>
          <div style="margin-top:10px;">
            <button class="btn btn-outline btn-sm" onclick="editTemplate('${t.id}')">Editar modelo</button>
          </div>
        </div>
      `).join('');
    }

    document.getElementById('useDefaultTplBtn').addEventListener('click', () => {
      const type = document.getElementById('tplType').value || 'Procedimento Médico';
      document.getElementById('tplBody').value = `<h2>TERMO DE CONSENTIMENTO INFORMADO</h2>
<h3>${type}</h3>

<p>Eu, paciente abaixo identificado, declaro que fui informado(a) de forma clara e detalhada sobre o procedimento a ser realizado, seus objetivos, riscos e benefícios.</p>

<h4>1. IDENTIFICAÇÃO DO PROCEDIMENTO</h4>
<p>Procedimento: {{procedimento}}</p>
<p>Detalhes clínicos: {{descricao}}</p>

<h4>2. DESCRIÇÃO DO PROCEDIMENTO</h4>
<p>O procedimento consiste em intervenção cirúrgica/estética realizada pela equipe médica especializada, seguindo os protocolos estabelecidos pela medicina baseada em evidências.</p>

<h4>3. RISCOS E POSSÍVEIS COMPLICAÇÕES</h4>
<p>Os principais riscos associados incluem: reações anestésicas, infecções, hematomas, cicatrização inadequada, resultado insatisfatório, e outros inerentes ao procedimento específico.</p>

<h4>4. BENEFÍCIOS ESPERADOS</h4>
<p>Os benefícios esperados foram adequadamente explicados pelo médico responsável.</p>

<h4>5. ALTERNATIVAS DE TRATAMENTO</h4>
<p>Fui informado(a) sobre as alternativas disponíveis e optei livremente pelo procedimento indicado.</p>

<h4>6. DECLARAÇÃO DE CONSENTIMENTO</h4>
<p>Declaro que li e compreendi as informações contidas neste documento e consinto livre e voluntariamente com a realização do procedimento descrito.</p>`;
    });

    function editTemplate(id) {
      const t = allTemplates.find(x => String(x.id) === id);
      if (!t) return;
      editingId = id;
      document.getElementById('tplName').value = t.name || '';
      document.getElementById('tplType').value = t.procedure_type || '';
      document.getElementById('tplBody').value = t.body_html || '';
      document.getElementById('formTitle').textContent = 'Editar Modelo';
      document.getElementById('tplSubmitBtn').innerHTML = '<i class="fas fa-edit"></i> Atualizar Modelo';
      document.getElementById('cancelEditBtn').style.display = '';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function cancelEdit() {
      editingId = null;
      document.getElementById('tplForm').reset();
      document.getElementById('formTitle').textContent = 'Novo Modelo';
      document.getElementById('tplSubmitBtn').innerHTML = '<i class="fas fa-save"></i> Salvar Modelo';
      document.getElementById('cancelEditBtn').style.display = 'none';
    }

    document.getElementById('tplForm').addEventListener('submit', async e => {
      e.preventDefault();
      const btn = document.getElementById('tplSubmitBtn');
      const ok = document.getElementById('tplOk');
      const err = document.getElementById('tplErr');
      ok.style.display = 'none';
      err.style.display = 'none';
      btn.disabled = true;
      btn.innerHTML = '<span class="spin"></span>Salvando...';
      try {
        const isEdit = Boolean(editingId);
        const res = await fetch(isEdit ? `/api/templates/${editingId}` : '/api/templates', {
          method: isEdit ? 'PUT' : 'POST',
          headers,
          body: JSON.stringify({
            name: document.getElementById('tplName').value.trim(),
            bodyHtml: document.getElementById('tplBody').value.trim(),
            procedureType: document.getElementById('tplType').value || null,
          })
        });
        const data = await res.json();
        if (res.ok) {
          ok.textContent = isEdit ? `Modelo "${data.name}" atualizado!` : `Modelo "${data.name}" salvo!`;
          ok.style.display = 'block';
          cancelEdit();
          await loadTemplates();
        } else {
          err.textContent = data.error || 'Erro ao salvar modelo.';
          err.style.display = 'block';
        }
      } catch (error) {
        err.textContent = 'Erro de conexão.';
        err.style.display = 'block';
      }
      btn.disabled = false;
      if (!editingId) btn.innerHTML = '<i class="fas fa-save"></i> Salvar Modelo';
    });

    async function deleteTemplate(id) {
      if (!confirm('Excluir este modelo de documento?')) return;
      try {
        const res = await fetch(`/api/templates/${id}`, { method: 'DELETE', headers });
        if (res.ok) await loadTemplates();
      } catch (error) {
        alert('Erro ao excluir modelo.');
      }
    }

    document.getElementById('tplSearch').addEventListener('input', renderGrid);

    // ── INIT ──
    loadTemplates();

    // socket.io (opcional, para atualizações em tempo real)
    (function() {
      const _d = JSON.parse(localStorage.getItem('doctorData') || '{}');
      if (!_d.id) return;
      const _sock = io({ transports: ['websocket', 'polling'] });
      _sock.on('connect', () => _sock.emit('join_doctor', _d.id));
      _sock.on('template_created', () => { if (typeof loadTemplates === 'function') loadTemplates(); });
      _sock.on('template_updated', () => { if (typeof loadTemplates === 'function') loadTemplates(); });
      _sock.on('template_deleted', () => { if (typeof loadTemplates === 'function') loadTemplates(); });
    })();
  </script>

  <!-- socket.io (necessário para o script acima) -->
  <script src="/socket.io/socket.io.js"></script>
</body>
</html>