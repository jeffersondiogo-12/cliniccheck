  <!-- ============================================================
  MAIN — DASHBOARD FINANCEIRO
  ============================================================ -->
  <main class="main">
    <header class="topbar">
      <div>
        <h1>Dashboard Financeiro</h1>
        <div class="meta">Visão geral da saúde financeira da clínica</div>
      </div>
      <div class="topbar-actions">
        <input type="month" id="monthPicker" style="padding:8px 12px;border-radius:8px;border:1px solid var(--sb-border);background:var(--sb-surface);color:var(--sb-text);font-size:13px;">
        <button class="btn btn-outline btn-sm" id="refreshDashboardBtn"><i class="fas fa-sync"></i></button>
        <a href="/medico" class="btn btn-outline btn-sm">Dashboard</a>
      </div>
    </header>

    <div class="content">

      <!-- KPIs -->
      <div class="stats-row" id="kpiRow">
        <div class="stat-card">
          <div class="icon green"><i class="fas fa-arrow-trend-up"></i></div>
          <div class="info">
            <div class="stat-val" id="kpiRevenue">R$ 0,00</div>
            <div class="stat-label">Receita do mês <span id="kpiRevenueChange" style="font-weight:600;"></span></div>
          </div>
        </div>
        <div class="stat-card">
          <div class="icon yellow"><i class="fas fa-arrow-trend-down"></i></div>
          <div class="info">
            <div class="stat-val" id="kpiExpenses">R$ 0,00</div>
            <div class="stat-label">Despesas do mês</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="icon blue"><i class="fas fa-scale-balanced"></i></div>
          <div class="info">
            <div class="stat-val" id="kpiNetProfit">R$ 0,00</div>
            <div class="stat-label">Lucro líquido</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="icon purple"><i class="fas fa-receipt"></i></div>
          <div class="info">
            <div class="stat-val" id="kpiAvgTicket">R$ 0,00</div>
            <div class="stat-label">Ticket médio</div>
          </div>
        </div>
      </div>
      <div class="stats-row">
        <div class="stat-card">
          <div class="icon yellow"><i class="fas fa-clock"></i></div>
          <div class="info">
            <div class="stat-val" id="kpiPendingReceivables">R$ 0,00</div>
            <div class="stat-label">A receber (<span id="kpiPendingReceivablesCount">0</span>)</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="icon red"><i class="fas fa-file-invoice-dollar"></i></div>
          <div class="info">
            <div class="stat-val" id="kpiPendingPayables">R$ 0,00</div>
            <div class="stat-label">A pagar (<span id="kpiPendingPayablesCount">0</span>)</div>
          </div>
        </div>
      </div>

      <!-- Charts row 1 -->
      <div class="charts-grid">
        <div class="card">
          <div class="card-header"><span><i class="fas fa-chart-line"></i> Receita vs Despesa (últimos 6 meses)</span></div>
          <div class="card-body"><canvas id="trendChart" height="220"></canvas></div>
        </div>
        <div class="card">
          <div class="card-header"><span><i class="fas fa-chart-pie"></i> Receita por Forma de Pagamento</span></div>
          <div class="card-body"><canvas id="paymentMethodChart" height="220"></canvas></div>
        </div>
      </div>

      <!-- Charts row 2 -->
      <div class="charts-grid">
        <div class="card">
          <div class="card-header"><span><i class="fas fa-stethoscope"></i> Top Procedimentos por Receita</span></div>
          <div class="card-body"><canvas id="topProceduresChart" height="220"></canvas></div>
        </div>
        <div class="card">
          <div class="card-header"><span><i class="fas fa-user-md"></i> Receita por Médico</span></div>
          <div class="card-body"><canvas id="topDoctorsChart" height="220"></canvas></div>
        </div>
      </div>

      <!-- Listas -->
      <div class="charts-grid">
        <div class="card">
          <div class="card-header"><span><i class="fas fa-calendar-day"></i> Contas a Vencer (próximos 7 dias)</span></div>
          <div class="card-body">
            <div class="table-wrap">
              <table>
                <thead><tr><th>Descrição</th><th>Categoria</th><th>Vencimento</th><th>Valor</th></tr></thead>
                <tbody id="upcomingExpensesTbody"><tr><td colspan="4" class="empty-state">Carregando...</td></tr></tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><span><i class="fas fa-user-clock"></i> Pacientes Inadimplentes</span></div>
          <div class="card-body">
            <div class="table-wrap">
              <table>
                <thead><tr><th>Paciente</th><th>Pendências</th><th>Dias</th><th>Valor</th></tr></thead>
                <tbody id="overduePatientsTbody"><tr><td colspan="4" class="empty-state">Carregando...</td></tr></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script>
    // ============================================================
    // SIDEBAR (mesmo da primeira tela)
    // ============================================================
    (function initSidebar() {
      const sidebar = document.querySelector('.sidebar');
      const toggleBtn = document.getElementById('sidebarToggleBtn');
      const overlay = document.getElementById('sidebarOverlay');
      let isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
      if (isCollapsed) sidebar.classList.add('collapsed');

      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (window.innerWidth <= 992) {
          sidebar.classList.toggle('open');
          overlay.classList.toggle('active');
          document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
        } else {
          isCollapsed = !isCollapsed;
          sidebar.classList.toggle('collapsed', isCollapsed);
          localStorage.setItem('sidebarCollapsed', String(isCollapsed));
        }
      });

      overlay.addEventListener('click', function() {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      });

      window.addEventListener('resize', function() {
        if (window.innerWidth > 992) {
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        }
      });

      // Tema
      const themeToggle = document.getElementById('themeToggle');
      const currentTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', currentTheme);
      themeToggle.addEventListener('click', function() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const newTheme = isDark ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      });

      // Grupos colapsáveis
      document.querySelectorAll('.sb-group-btn').forEach((btn) => {
        btn.addEventListener('click', function() {
          const group = this.closest('.sb-group');
          if (group) group.classList.toggle('open');
        });
      });

      // Dados do usuário
      const doctorToken = localStorage.getItem('doctorToken');
      const receptionToken = localStorage.getItem('receptionToken');
      const token = doctorToken || receptionToken;
      const isReceptionSession = !doctorToken && !!receptionToken;
      const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');
      const nameEl = document.getElementById('sidebarName');
      const roleEl = document.getElementById('sidebarRole');
      const clinicEl = document.getElementById('sidebarClinic');
      if (nameEl) nameEl.textContent = doctorData.name || 'Profissional';
      if (roleEl) roleEl.textContent = isReceptionSession ? 'Recepcionista' : (doctorData.isClinicOwner ? 'Owner da Clinica' : 'Profissional');
      if (clinicEl) clinicEl.textContent = 'Clinica: ' + (doctorData.clinicName || '--');

      // Logout
      document.getElementById('logoutBtn').addEventListener('click', function() {
        localStorage.removeItem('doctorToken'); localStorage.removeItem('doctorData');
        localStorage.removeItem('receptionToken'); localStorage.removeItem('receptionData');
        window.location.href = isReceptionSession ? '/recepcao/login' : '/medico/login';
      });

      // Permissões (opcional)
      if (token) {
        fetch(isReceptionSession ? '/api/auth/permissions-receptionist' : '/api/auth/permissions', { headers: { Authorization: 'Bearer ' + token } })
          .then((r) => r.ok ? r.json() : null)
          .then((data) => {
            if (!data || !Array.isArray(data.pages)) return;
            const allowed = new Set((data.pages || []).filter((p) => p.can_view).map((p) => p.code));
            document.querySelectorAll('#sidebarNav .nav-item[data-page]').forEach((item) => {
              const rawCodes = item.getAttribute('data-page-codes') || item.getAttribute('data-page') || '';
              const pageCodes = rawCodes.split(',').map((code) => code.trim()).filter(Boolean);
              const canSee = pageCodes.some((code) => allowed.has(code));
              item.hidden = !canSee;
            });
            document.querySelectorAll('.sb-group').forEach((g) => {
              const hasVisible = Array.from(g.querySelectorAll('.nav-item')).some((i) => !i.hidden);
              g.style.display = hasVisible ? '' : 'none';
            });
          })
          .catch(() => {});
      }
    })();

    // ============================================================
    // DASHBOARD FINANCEIRO
    // ============================================================
    const doctorToken = localStorage.getItem('doctorToken');
    const receptionToken = localStorage.getItem('receptionToken');
    const token = doctorToken || receptionToken;
    const isReceptionSession = !doctorToken && !!receptionToken;
    if (!token) window.location.href = '/medico/login';
    const H = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };
    const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');

    const PAYMENT_LABELS = {
      DINHEIRO: 'Dinheiro', CARTAO_DEBITO: 'Cartão Débito', CARTAO_CREDITO: 'Cartão Crédito',
      PIX: 'PIX', CONVENIO: 'Convênio',
    };
    const CHART_COLORS = ['#0f4c81', '#10b981', '#f59e0b', '#8b5cf6', '#ef4444', '#06b6d4'];

    function esc(v){ return String(v==null?'':v).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    function fmtMoney(v){ return Number(v||0).toLocaleString('pt-BR', { style:'currency', currency:'BRL' }); }
    function fmtDate(v){ if(!v) return '—'; return new Date(v).toLocaleDateString('pt-BR'); }

    let trendChartInstance = null, paymentChartInstance = null, proceduresChartInstance = null, doctorsChartInstance = null;

    async function loadDashboard(){
      const month = document.getElementById('monthPicker').value; // YYYY-MM
      try {
        const res = await fetch(`/api/finance/reports/dashboard?month=${month}`, { headers: H });
        const data = await res.json();
        if (!res.ok) { alert(data?.error || 'Erro ao carregar dashboard.'); return; }
        renderKpis(data);
        renderTrendChart(data.trend);
        renderPaymentChart(data.revenueByPaymentMethod);
        renderProceduresChart(data.topProcedures);
        renderDoctorsChart(data.topDoctors);
        renderUpcomingExpenses(data.upcomingExpenses);
        renderOverduePatients(data.overduePatients);
      } catch (e) {
        console.error(e);
      }
    }

    function renderKpis(data){
      const k = data.kpis;
      document.getElementById('kpiRevenue').textContent = fmtMoney(k.revenue);
      document.getElementById('kpiExpenses').textContent = fmtMoney(k.expenses);
      document.getElementById('kpiNetProfit').textContent = fmtMoney(k.netProfit);
      document.getElementById('kpiAvgTicket').textContent = fmtMoney(k.averageTicket);
      document.getElementById('kpiPendingReceivables').textContent = fmtMoney(k.pendingReceivables);
      document.getElementById('kpiPendingReceivablesCount').textContent = k.pendingReceivablesCount;
      document.getElementById('kpiPendingPayables').textContent = fmtMoney(k.pendingPayables);
      document.getElementById('kpiPendingPayablesCount').textContent = k.pendingPayablesCount;

      const changeEl = document.getElementById('kpiRevenueChange');
      if (k.revenueChangePct == null) {
        changeEl.textContent = '';
      } else {
        const positive = k.revenueChangePct >= 0;
        changeEl.style.color = positive ? '#10b981' : '#ef4444';
        changeEl.textContent = `${positive ? '▲' : '▼'} ${Math.abs(k.revenueChangePct)}% vs mês anterior`;
      }

      const profitEl = document.getElementById('kpiNetProfit');
      profitEl.style.color = k.netProfit >= 0 ? '#10b981' : '#ef4444';
    }

    function renderTrendChart(trend){
      const ctx = document.getElementById('trendChart');
      if (trendChartInstance) trendChartInstance.destroy();
      trendChartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: trend.map(t => t.month),
          datasets: [
            { label: 'Receita', data: trend.map(t => t.revenue), backgroundColor: '#10b981' },
            { label: 'Despesa', data: trend.map(t => t.expenses), backgroundColor: '#ef4444' },
          ],
        },
        options: {
          responsive: true,
          plugins: { legend: { position: 'bottom' } },
          scales: { y: { beginAtZero: true, ticks: { callback: (v) => fmtMoney(v) } } },
        },
      });
    }

    function renderPaymentChart(methods){
      const ctx = document.getElementById('paymentMethodChart');
      if (paymentChartInstance) paymentChartInstance.destroy();
      if (!methods || methods.length === 0) {
        ctx.parentElement.innerHTML = '<div class="empty-state">Nenhum recebimento no período.</div>';
        return;
      }
      paymentChartInstance = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: methods.map(m => PAYMENT_LABELS[m.method] || m.method || 'Não informado'),
          datasets: [{ data: methods.map(m => m.total), backgroundColor: CHART_COLORS }],
        },
        options: { responsive: true, plugins: { legend: { position: 'bottom' } } },
      });
    }

    function renderProceduresChart(procedures){
      const ctx = document.getElementById('topProceduresChart');
      if (proceduresChartInstance) proceduresChartInstance.destroy();
      if (!procedures || procedures.length === 0) {
        ctx.parentElement.innerHTML = '<div class="empty-state">Sem dados no período.</div>';
        return;
      }
      proceduresChartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: procedures.map(p => p.name),
          datasets: [{ label: 'Receita', data: procedures.map(p => p.total), backgroundColor: '#0f4c81' }],
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          plugins: { legend: { display: false } },
          scales: { x: { beginAtZero: true, ticks: { callback: (v) => fmtMoney(v) } } },
        },
      });
    }

    function renderDoctorsChart(doctors){
      const ctx = document.getElementById('topDoctorsChart');
      if (doctorsChartInstance) doctorsChartInstance.destroy();
      if (!doctors || doctors.length === 0) {
        ctx.parentElement.innerHTML = '<div class="empty-state">Sem dados no período.</div>';
        return;
      }
      doctorsChartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: doctors.map(d => d.name),
          datasets: [{ label: 'Receita', data: doctors.map(d => d.total), backgroundColor: '#8b5cf6' }],
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          plugins: { legend: { display: false } },
          scales: { x: { beginAtZero: true, ticks: { callback: (v) => fmtMoney(v) } } },
        },
      });
    }

    function renderUpcomingExpenses(expenses){
      const tbody = document.getElementById('upcomingExpensesTbody');
      if (!expenses || expenses.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="empty-state">Nenhuma conta a vencer nos próximos 7 dias.</td></tr>';
        return;
      }
      tbody.innerHTML = expenses.map(e => `
        <tr>
          <td>${esc(e.description)}</td>
          <td>${esc(e.category)}</td>
          <td>${fmtDate(e.due_date)}</td>
          <td>${fmtMoney(e.amount)}</td>
        </tr>
      `).join('');
    }

    function renderOverduePatients(patients){
      const tbody = document.getElementById('overduePatientsTbody');
      if (!patients || patients.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="empty-state">Nenhum paciente inadimplente.</td></tr>';
        return;
      }
      tbody.innerHTML = patients.map(p => `
        <tr>
          <td>${esc(p.name)}</td>
          <td>${p.charges}</td>
          <td>${p.oldestDays} dias</td>
          <td>${fmtMoney(p.total)}</td>
        </tr>
      `).join('');
    }

    document.getElementById('refreshDashboardBtn').addEventListener('click', loadDashboard);
    document.getElementById('monthPicker').addEventListener('change', loadDashboard);

    // Inicializa com o mês atual
    (function initMonthPicker(){
      const now = new Date();
      const value = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}`;
      document.getElementById('monthPicker').value = value;
    })();

    loadDashboard();

    // Socket.io — atualiza o dashboard quando houver mudanças no caixa/despesas
    (function() {
      const _d = JSON.parse(localStorage.getItem('doctorData') || '{}');
      if (!_d.id) return;
      const _sock = io({ transports: ['websocket', 'polling'] });
      _sock.on('connect', () => {
        _sock.emit('join_doctor', _d.id);
        if (_d.clinicId) _sock.emit('join_clinic', _d.clinicId);
      });
      ['cash_transaction_created', 'cash_transaction_paid', 'cash_transaction_canceled', 'cash_transaction_updated',
       'expense_created', 'expense_paid'].forEach((evt) => {
        _sock.on(evt, () => { loadDashboard(); });
      });
    })();
  </script>

  <script src="/socket.io/socket.io.js"></script>
</body>
</html>
