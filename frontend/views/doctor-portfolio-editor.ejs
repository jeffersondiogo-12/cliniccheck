  <script>
    // ============================================================
    // SIDEBAR (mesmo da primeira tela)
    // ============================================================
    (function initSidebar() {
      const sidebar = document.querySelector('.sidebar');
      const toggleBtn = document.getElementById('sidebarToggleBtn');
      const overlay = document.getElementById('sidebarOverlay');
      let isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
      if (isCollapsed) sidebar.classList.add('collapsed');

      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (window.innerWidth <= 992) {
          sidebar.classList.toggle('open');
          overlay.classList.toggle('active');
          document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
        } else {
          isCollapsed = !isCollapsed;
          sidebar.classList.toggle('collapsed', isCollapsed);
          localStorage.setItem('sidebarCollapsed', String(isCollapsed));
        }
      });

      overlay.addEventListener('click', function() {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      });

      window.addEventListener('resize', function() {
        if (window.innerWidth > 992) {
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        }
      });

      // Tema
      const themeToggle = document.getElementById('themeToggle');
      const currentTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', currentTheme);
      themeToggle.addEventListener('click', function() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const newTheme = isDark ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      });

      // Grupos colapsáveis
      document.querySelectorAll('.sb-group-btn').forEach((btn) => {
        btn.addEventListener('click', function() {
          const group = this.closest('.sb-group');
          if (group) group.classList.toggle('open');
        });
      });

      // Dados do usuário
      const doctorToken = localStorage.getItem('doctorToken');
      const receptionToken = localStorage.getItem('receptionToken');
      const token = doctorToken || receptionToken;
      const isReceptionSession = !doctorToken && !!receptionToken;
      const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');
      const nameEl = document.getElementById('sidebarName');
      const roleEl = document.getElementById('sidebarRole');
      const clinicEl = document.getElementById('sidebarClinic');
      if (nameEl) nameEl.textContent = doctorData.name || 'Profissional';
      if (roleEl) roleEl.textContent = isReceptionSession ? 'Recepcionista' : (doctorData.isClinicOwner ? 'Owner da Clinica' : 'Profissional');
      if (clinicEl) clinicEl.textContent = 'Clinica: ' + (doctorData.clinicName || '--');

      // Logout
      document.getElementById('logoutBtn').addEventListener('click', function() {
        localStorage.removeItem('doctorToken'); localStorage.removeItem('doctorData');
        localStorage.removeItem('receptionToken'); localStorage.removeItem('receptionData');
        window.location.href = isReceptionSession ? '/recepcao/login' : '/medico/login';
      });

      // Permissões (opcional)
      if (token) {
        fetch(isReceptionSession ? '/api/auth/permissions-receptionist' : '/api/auth/permissions', { headers: { Authorization: 'Bearer ' + token } })
          .then((r) => r.ok ? r.json() : null)
          .then((data) => {
            if (!data || !Array.isArray(data.pages)) return;
            const allowed = new Set((data.pages || []).filter((p) => p.can_view).map((p) => p.code));
            document.querySelectorAll('#sidebarNav .nav-item[data-page]').forEach((item) => {
              const rawCodes = item.getAttribute('data-page-codes') || item.getAttribute('data-page') || '';
              const pageCodes = rawCodes.split(',').map((code) => code.trim()).filter(Boolean);
              const canSee = pageCodes.some((code) => allowed.has(code));
              item.hidden = !canSee;
            });
            document.querySelectorAll('.sb-group').forEach((g) => {
              const hasVisible = Array.from(g.querySelectorAll('.nav-item')).some((i) => !i.hidden);
              g.style.display = hasVisible ? '' : 'none';
            });
          })
          .catch(() => {});
      }
    })();

    // ============================================================
    // ESTOQUE
    // ============================================================
    const doctorToken = localStorage.getItem('doctorToken');
    const receptionToken = localStorage.getItem('receptionToken');
    const token = doctorToken || receptionToken;
    const isReceptionSession = !doctorToken && !!receptionToken;
    if (!token) window.location.href = '/medico/login';
    const H = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };
    const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');

    function esc(v){ return String(v==null?'':v).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    function fmtMoney(v){ return Number(v||0).toLocaleString('pt-BR', { style:'currency', currency:'BRL' }); }
    function fmtDate(v){ if(!v) return '—'; return new Date(v).toLocaleDateString('pt-BR', { timeZone: 'UTC' }); }
    function fmtDateTime(v){ if(!v) return '—'; return new Date(v).toLocaleString('pt-BR'); }

    // ── EXPORTAÇÃO — todo relatório desta tela pode ser baixado, não só visualizado ──
    function downloadCSV(filename, headers, rows){
      const cell = (v) => {
        const s = v == null ? '' : String(v);
        return /[";\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
      };
      const lines = [headers.map(cell).join(';')].concat(rows.map(r => r.map(cell).join(';')));
      const csv = '\uFEFF' + lines.join('\r\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    async function apiGet(url){
      const res = await fetch(url, { headers: H });
      const data = await res.json().catch(() => null);
      if (!res.ok) throw new Error(data?.error || 'Falha na requisição.');
      return data;
    }
    async function apiSend(url, method, body){
      const res = await fetch(url, { method, headers: H, body: body != null ? JSON.stringify(body) : undefined });
      const data = await res.json().catch(() => null);
      if (!res.ok) throw new Error(data?.error || 'Falha na requisição.');
      return data;
    }
    function closeModal(id){ document.getElementById(id).classList.remove('show'); }
    function openModal(id){ document.getElementById(id).classList.add('show'); }
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
      overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('show'); });
    });

    // ── TABS ──
    document.querySelectorAll('.report-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        document.querySelectorAll('.report-tab').forEach((b) => b.classList.toggle('active', b === btn));
        document.querySelectorAll('.report-panel').forEach((p) => p.classList.toggle('active', p.id === `panel-${tab}`));
      });
    });

    const WEEKDAY_LABELS = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
    const SECTION_TYPE_META = {
      TEXT: { icon: 'fa-align-left', label: 'Texto' },
      GALLERY: { icon: 'fa-image', label: 'Foto em destaque' },
      TESTIMONIALS: { icon: 'fa-quote-left', label: 'Depoimentos' },
    };

    let currentPortfolio = null;
    let currentSections = [];
    let currentPhotos = [];

    function readFileAsDataUrl(file){
      return new Promise((resolve, reject) => {
        if (file.size > 3.2 * 1024 * 1024) { reject(new Error('Imagem muito grande — escolha uma de até ~3MB.')); return; }
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = () => reject(new Error('Falha ao ler a imagem.'));
        reader.readAsDataURL(file);
      });
    }

    // ── CARREGAMENTO INICIAL ──
    async function loadEverything(){
      try {
        currentPortfolio = await apiGet('/api/portfolio/me');
        applyPortfolioToForm(currentPortfolio);
      } catch (e) { alert('Erro ao carregar portfólio: ' + e.message); }
      loadSections();
      loadGallery();
      checkGoogleStatus();
    }

    function applyPortfolioToForm(p){
      document.getElementById('pfSlug').value = p.slug || '';
      document.getElementById('pfPublished').checked = !!p.published;
      updatePublishBadge(p);

      document.getElementById('thPrimaryColor').value = p.theme_primary_color || '#0f4c81';
      document.getElementById('thAccentColor').value = p.theme_accent_color || '#10b981';
      document.getElementById('thFont').value = p.theme_font || 'inter';
      document.getElementById('thLayout').value = p.theme_layout || 'classico';
      document.getElementById('thNavStyle').value = p.theme_nav_style || 'fixa';
      document.getElementById('thHeadline').value = p.headline || '';

      if (p.cover_photo_url) { document.getElementById('coverPreview').src = p.cover_photo_url; document.getElementById('coverPreview').style.display = 'block'; document.getElementById('coverPlaceholder').style.display = 'none'; }
      if (p.logo_url) { document.getElementById('logoPreview').src = p.logo_url; document.getElementById('logoPreview').style.display = 'block'; document.getElementById('logoPlaceholder').style.display = 'none'; }

      document.getElementById('cfWhatsapp').value = p.whatsapp_number || '';
      document.getElementById('cfWhatsappMsg').value = p.whatsapp_message_template || '';
      document.getElementById('cfShowAgenda').checked = p.show_agenda !== false;
      document.getElementById('cfSlotMinutes').value = String(p.agenda_slot_minutes || 30);
      document.getElementById('cfDaysAhead').value = p.agenda_days_ahead || 14;
      document.getElementById('cfHoursStart').value = p.agenda_working_hours_start || '09:00';
      document.getElementById('cfHoursEnd').value = p.agenda_working_hours_end || '18:00';

      const workingSet = new Set(String(p.agenda_working_days || '1,2,3,4,5').split(',').map((d) => d.trim()));
      const row = document.getElementById('workingDaysRow');
      row.innerHTML = WEEKDAY_LABELS.map((label, idx) => `
        <label style="display:flex;align-items:center;gap:5px;font-size:12.5px;cursor:pointer;">
          <input type="checkbox" class="working-day-cb" value="${idx}" ${workingSet.has(String(idx)) ? 'checked' : ''}> ${label}
        </label>
      `).join('');
    }

    function updatePublishBadge(p){
      const badge = document.getElementById('publishStatusBadge');
      const link = document.getElementById('viewPublicLink');
      if (p.published) {
        badge.textContent = 'Publicado';
        badge.className = 'badge badge-green';
        link.href = `/portfolio/${p.slug}`;
        link.style.display = '';
      } else {
        badge.textContent = 'Rascunho (não publicado)';
        badge.className = 'badge badge-gray';
        link.style.display = 'none';
      }
    }

    async function checkGoogleStatus(){
      const banner = document.getElementById('googleStatusText');
      try {
        const status = await apiGet('/api/auth/google/status');
        if (status?.connected) {
          banner.innerHTML = 'Sua agenda do Google está conectada — os horários livres mostrados no portfólio já saem direto de lá. <a href="/medico/agenda">Gerenciar conexão</a>';
        } else {
          banner.innerHTML = 'Sua agenda do Google Calendar ainda não está conectada. <a href="/medico/agenda">Conectar agora</a> pra mostrar seus horários livres no portfólio.';
        }
      } catch (e) {
        banner.textContent = 'Não foi possível verificar a conexão com o Google Calendar agora.';
      }
    }

    // ── SALVAR CONFIGURAÇÕES (topo, aparência, contato/agenda — tudo junto) ──
    async function saveSettings(){
      const workingDays = Array.from(document.querySelectorAll('.working-day-cb:checked')).map((cb) => cb.value).join(',');
      const slugValue = document.getElementById('pfSlug').value.trim();
      
      // Se slug estiver vazio, não tenta atualizar (mantém o existente)
      const payload = {
        ...(slugValue ? { slug: slugValue } : {}),
        published: document.getElementById('pfPublished').checked,
        headline: document.getElementById('thHeadline').value.trim(),
        themePrimaryColor: document.getElementById('thPrimaryColor').value,
        themeAccentColor: document.getElementById('thAccentColor').value,
        themeFont: document.getElementById('thFont').value,
        themeLayout: document.getElementById('thLayout').value,
        themeNavStyle: document.getElementById('thNavStyle').value,
        whatsappNumber: document.getElementById('cfWhatsapp').value.replace(/\D/g, ''),
        whatsappMessageTemplate: document.getElementById('cfWhatsappMsg').value,
        showAgenda: document.getElementById('cfShowAgenda').checked,
        agendaSlotMinutes: document.getElementById('cfSlotMinutes').value,
        agendaDaysAhead: document.getElementById('cfDaysAhead').value,
        agendaWorkingHoursStart: document.getElementById('cfHoursStart').value,
        agendaWorkingHoursEnd: document.getElementById('cfHoursEnd').value,
        agendaWorkingDays: workingDays || '1,2,3,4,5',
      };
      const btn = document.getElementById('saveTopBtn');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Salvando...';
      try {
        currentPortfolio = await apiSend('/api/portfolio/me', 'PUT', payload);
        applyPortfolioToForm(currentPortfolio);
      } catch (e) { alert(e.message); }
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-save"></i> Salvar';
    }
    document.getElementById('saveTopBtn').addEventListener('click', saveSettings);

    document.getElementById('chooseCoverBtn').addEventListener('click', () => document.getElementById('coverInput').click());
    document.getElementById('coverInput').addEventListener('change', async () => {
      const file = document.getElementById('coverInput').files[0];
      if (!file) return;
      try {
        const dataUrl = await readFileAsDataUrl(file);
        document.getElementById('coverPreview').src = dataUrl;
        document.getElementById('coverPreview').style.display = 'block';
        document.getElementById('coverPlaceholder').style.display = 'none';
        currentPortfolio = await apiSend('/api/portfolio/me', 'PUT', { coverPhotoUrl: dataUrl });
      } catch (e) { alert(e.message); }
    });
    document.getElementById('chooseLogoBtn').addEventListener('click', () => document.getElementById('logoInput').click());
    document.getElementById('logoInput').addEventListener('change', async () => {
      const file = document.getElementById('logoInput').files[0];
      if (!file) return;
      try {
        const dataUrl = await readFileAsDataUrl(file);
        document.getElementById('logoPreview').src = dataUrl;
        document.getElementById('logoPreview').style.display = 'block';
        document.getElementById('logoPlaceholder').style.display = 'none';
        currentPortfolio = await apiSend('/api/portfolio/me', 'PUT', { logoUrl: dataUrl });
      } catch (e) { alert(e.message); }
    });

    // ── SEÇÕES ──
    async function loadSections(){
      const wrap = document.getElementById('sectionsList');
      wrap.innerHTML = '<div class="empty-state">Carregando...</div>';
      try {
        currentSections = await apiGet('/api/portfolio/me/sections');
        renderSections();
      } catch (e) { wrap.innerHTML = `<div class="empty-state">${esc(e.message)}</div>`; }
    }

    function renderSections(){
      const wrap = document.getElementById('sectionsList');
      if (currentSections.length === 0) { wrap.innerHTML = '<div class="empty-state">Nenhuma seção ainda. Clique em "Nova Seção" pra começar.</div>'; return; }
      wrap.innerHTML = currentSections.map((s, idx) => {
        const meta = SECTION_TYPE_META[s.type] || { icon: 'fa-file', label: s.type };
        return `
          <div class="type-product-row" style="display:flex;align-items:center;gap:12px;padding:12px 14px;border:1px solid var(--sb-border);border-radius:var(--sb-radius);margin-bottom:8px;${s.visible ? '' : 'opacity:.5;'}">
            <i class="fas ${meta.icon}" style="font-size:16px;color:var(--sb-accent);width:20px;"></i>
            <div style="flex:1;min-width:0;">
              <div style="font-weight:600;font-size:13.5px;">${esc(s.title || '(sem título)')}</div>
              <div style="font-size:11.5px;color:var(--sb-text-muted);">${meta.label}${s.visible ? '' : ' · oculta'}</div>
            </div>
            <button class="btn btn-outline btn-xs" title="Mover para cima" onclick="moveSectionUp(${idx})" ${idx === 0 ? 'disabled' : ''}><i class="fas fa-arrow-up"></i></button>
            <button class="btn btn-outline btn-xs" title="Mover para baixo" onclick="moveSectionDown(${idx})" ${idx === currentSections.length - 1 ? 'disabled' : ''}><i class="fas fa-arrow-down"></i></button>
            <button class="btn btn-outline btn-xs" title="${s.visible ? 'Ocultar' : 'Mostrar'}" onclick="toggleSectionVisible('${s.id}', ${!s.visible})"><i class="fas fa-eye${s.visible ? '' : '-slash'}"></i></button>
            <button class="btn btn-outline btn-xs" title="Editar" onclick="openEditSectionModal('${s.id}')"><i class="fas fa-pen"></i></button>
            <button class="btn btn-outline btn-xs" title="Excluir" onclick="deleteSection('${s.id}')"><i class="fas fa-trash"></i></button>
          </div>`;
      }).join('');
    }

    async function persistSectionOrder(){
      try { await apiSend('/api/portfolio/me/sections/reorder', 'PUT', { ids: currentSections.map((s) => s.id) }); }
      catch (e) { alert(e.message); }
    }
    function moveSectionUp(idx){
      if (idx === 0) return;
      [currentSections[idx - 1], currentSections[idx]] = [currentSections[idx], currentSections[idx - 1]];
      renderSections();
      persistSectionOrder();
    }
    function moveSectionDown(idx){
      if (idx === currentSections.length - 1) return;
      [currentSections[idx + 1], currentSections[idx]] = [currentSections[idx], currentSections[idx + 1]];
      renderSections();
      persistSectionOrder();
    }
    async function toggleSectionVisible(id, visible){
      try {
        await apiSend(`/api/portfolio/me/sections/${id}`, 'PUT', { visible });
        loadSections();
      } catch (e) { alert(e.message); }
    }
    async function deleteSection(id){
      if (!confirm('Excluir essa seção da sua página?')) return;
      try { await apiSend(`/api/portfolio/me/sections/${id}`, 'DELETE'); loadSections(); }
      catch (e) { alert(e.message); }
    }

    let pendingSectionImage = null;
    function toggleSectionTypeUi(){
      const type = document.getElementById('sfType').value;
      document.getElementById('sfTextWrap').style.display = type === 'TESTIMONIALS' ? 'none' : 'block';
      document.getElementById('sfTestimonialsWrap').style.display = type === 'TESTIMONIALS' ? 'block' : 'none';
    }
    document.getElementById('sfType').addEventListener('change', toggleSectionTypeUi);

    function testimonialRowHtml(item){
      return `
        <div class="testimonial-row" style="display:flex;gap:8px;align-items:flex-start;margin-bottom:8px;">
          <input type="text" class="tm-name" value="${esc(item.name || '')}" placeholder="Nome" style="flex:1;">
          <input type="text" class="tm-text" value="${esc(item.text || '')}" placeholder="Depoimento" style="flex:3;">
          <button type="button" class="btn btn-outline btn-xs" onclick="this.closest('.testimonial-row').remove()"><i class="fas fa-times"></i></button>
        </div>`;
    }
    document.getElementById('addTestimonialRowBtn').addEventListener('click', () => {
      document.getElementById('testimonialsRows').insertAdjacentHTML('beforeend', testimonialRowHtml({ name: '', text: '' }));
    });

    document.getElementById('openNewSectionBtn').addEventListener('click', () => {
      document.getElementById('sectionModalTitle').textContent = 'Nova Seção';
      document.getElementById('sectionEditId').value = '';
      document.getElementById('sectionTypeGroup').style.display = '';
      document.getElementById('sfType').value = 'TEXT';
      document.getElementById('sfType').disabled = false;
      document.getElementById('sfTitle').value = '';
      document.getElementById('sfContent').value = '';
      document.getElementById('sfImagePosition').value = 'right';
      document.getElementById('sfImagePreview').style.display = 'none';
      document.getElementById('testimonialsRows').innerHTML = '';
      pendingSectionImage = null;
      toggleSectionTypeUi();
      document.getElementById('sectionModalErr').style.display = 'none';
      openModal('sectionModal');
    });

    function openEditSectionModal(id){
      const s = currentSections.find((x) => x.id === id);
      if (!s) return;
      document.getElementById('sectionModalTitle').textContent = 'Editar Seção';
      document.getElementById('sectionEditId').value = s.id;
      document.getElementById('sectionTypeGroup').style.display = 'none'; // tipo não muda depois de criada
      document.getElementById('sfType').value = s.type;
      document.getElementById('sfTitle').value = s.title || '';
      document.getElementById('sfImagePosition').value = s.image_position || 'right';
      pendingSectionImage = null;
      if (s.image_url) { document.getElementById('sfImagePreview').src = s.image_url; document.getElementById('sfImagePreview').style.display = 'block'; }
      else { document.getElementById('sfImagePreview').style.display = 'none'; }

      if (s.type === 'TESTIMONIALS') {
        let items = [];
        try { items = JSON.parse(s.content || '[]'); } catch (e) { items = []; }
        document.getElementById('testimonialsRows').innerHTML = items.map((it) => testimonialRowHtml(it)).join('');
      } else {
        document.getElementById('sfContent').value = s.content || '';
      }
      toggleSectionTypeUi();
      document.getElementById('sectionModalErr').style.display = 'none';
      openModal('sectionModal');
    }

    document.getElementById('sfChooseImageBtn').addEventListener('click', () => document.getElementById('sfImageInput').click());
    document.getElementById('sfImageInput').addEventListener('change', async () => {
      const file = document.getElementById('sfImageInput').files[0];
      if (!file) return;
      try {
        pendingSectionImage = await readFileAsDataUrl(file);
        document.getElementById('sfImagePreview').src = pendingSectionImage;
        document.getElementById('sfImagePreview').style.display = 'block';
      } catch (e) { alert(e.message); }
    });

    document.getElementById('confirmSectionBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('sectionModalErr');
      errEl.style.display = 'none';
      const editId = document.getElementById('sectionEditId').value;
      const type = document.getElementById('sfType').value;
      const title = document.getElementById('sfTitle').value.trim();

      let content;
      if (type === 'TESTIMONIALS') {
        const items = [];
        document.querySelectorAll('#testimonialsRows .testimonial-row').forEach((row) => {
          const name = row.querySelector('.tm-name').value.trim();
          const text = row.querySelector('.tm-text').value.trim();
          if (name || text) items.push({ name, text });
        });
        content = JSON.stringify(items);
      } else {
        content = document.getElementById('sfContent').value;
      }

      const payload = { title, content, imagePosition: document.getElementById('sfImagePosition').value };
      if (pendingSectionImage) payload.imageUrl = pendingSectionImage;

      try {
        if (editId) {
          await apiSend(`/api/portfolio/me/sections/${editId}`, 'PUT', payload);
        } else {
          payload.type = type;
          await apiSend('/api/portfolio/me/sections', 'POST', payload);
        }
        closeModal('sectionModal');
        loadSections();
      } catch (e) { errEl.textContent = e.message; errEl.style.display = 'block'; }
    });

    // ── GALERIA ──
    async function loadGallery(){
      const grid = document.getElementById('galleryGrid');
      grid.innerHTML = '<div class="empty-state">Carregando...</div>';
      try {
        currentPhotos = await apiGet('/api/portfolio/me/photos');
        renderGallery();
      } catch (e) { grid.innerHTML = `<div class="empty-state">${esc(e.message)}</div>`; }
    }
    function renderGallery(){
      const grid = document.getElementById('galleryGrid');
      if (currentPhotos.length === 0) { grid.innerHTML = '<div class="empty-state">Nenhuma foto ainda.</div>'; return; }
      grid.innerHTML = currentPhotos.map((p, idx) => `
        <div style="border:1px solid var(--sb-border);border-radius:var(--sb-radius);overflow:hidden;">
          <img src="${p.url}" style="width:100%;height:120px;object-fit:cover;display:block;">
          <div style="padding:8px;">
            <input type="text" value="${esc(p.caption || '')}" placeholder="Legenda (opcional)" style="width:100%;font-size:12px;padding:6px 8px;margin-bottom:6px;" onchange="updatePhotoCaption('${p.id}', this.value)">
            <div style="display:flex;gap:4px;justify-content:space-between;">
              <button class="btn btn-outline btn-xs" onclick="movePhoto(${idx}, -1)" ${idx === 0 ? 'disabled' : ''}><i class="fas fa-arrow-left"></i></button>
              <button class="btn btn-outline btn-xs" onclick="movePhoto(${idx}, 1)" ${idx === currentPhotos.length - 1 ? 'disabled' : ''}><i class="fas fa-arrow-right"></i></button>
              <button class="btn btn-outline btn-xs" onclick="removePhoto('${p.id}')"><i class="fas fa-trash"></i></button>
            </div>
          </div>
        </div>
      `).join('');
    }
    document.getElementById('addGalleryPhotoBtn').addEventListener('click', () => document.getElementById('galleryPhotoInput').click());
    document.getElementById('galleryPhotoInput').addEventListener('change', async () => {
      const file = document.getElementById('galleryPhotoInput').files[0];
      if (!file) return;
      try {
        const dataUrl = await readFileAsDataUrl(file);
        await apiSend('/api/portfolio/me/photos', 'POST', { url: dataUrl });
        document.getElementById('galleryPhotoInput').value = '';
        loadGallery();
      } catch (e) { alert(e.message); }
    });
    async function updatePhotoCaption(id, caption){
      try { await apiSend(`/api/portfolio/me/photos/${id}`, 'PUT', { caption }); }
      catch (e) { alert(e.message); }
    }
    async function removePhoto(id){
      if (!confirm('Remover essa foto da galeria?')) return;
      try { await apiSend(`/api/portfolio/me/photos/${id}`, 'DELETE'); loadGallery(); }
      catch (e) { alert(e.message); }
    }
    function movePhoto(idx, dir){
      const target = idx + dir;
      if (target < 0 || target >= currentPhotos.length) return;
      [currentPhotos[idx], currentPhotos[target]] = [currentPhotos[target], currentPhotos[idx]];
      renderGallery();
      apiSend('/api/portfolio/me/photos/reorder', 'PUT', { ids: currentPhotos.map((p) => p.id) }).catch((e) => alert(e.message));
    }

    loadEverything();
  </script>

  <script src="/socket.io/socket.io.js"></script>
</body>
</html>
