        <div class="sb-group-list">
          <a class="nav-item" hidden data-page="dashboard" data-page-codes="dashboard,dashboard.insights" href="/medico">
            <i class="fas fa-th-large"></i> <span>Dashboard</span>
          </a>
          <a class="nav-item" hidden data-page="agenda" data-page-codes="agenda,agenda.consultations" href="/medico/agenda">
            <i class="fas fa-calendar-check"></i> <span>Agenda</span>
          </a>
          <a class="nav-item" hidden data-page="agenda.teleconsulta" data-page-codes="agenda,agenda.consultations" href="/medico/agenda">
            <i class="fas fa-video"></i> <span>Teleconsulta</span>
          </a>
        </div>
      </div>

      <!-- CADASTROS -->
      <div class="sb-group open" data-group="cadastro">
        <button class="sb-group-btn" type="button"><span>Cadastros</span><span class="caret">▶</span></button>
        <div class="sb-group-list">
          <a class="nav-item" hidden data-page="patients" data-page-codes="patients,patients.profile" href="/medico/pacientes">
            <i class="fas fa-user-injured"></i> <span>Pacientes</span>
          </a>
          <a class="nav-item" hidden data-page="patients.records" data-page-codes="patients.records,patients.followups" href="/medico/prontuarios">
            <i class="fas fa-notes-medical"></i> <span>Prontuários</span>
