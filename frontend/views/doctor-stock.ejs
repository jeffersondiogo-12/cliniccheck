    </div>
  </main>

  <!-- MODAL: produto -->
  <div class="modal-overlay" id="productModal">
    <div class="modal">
      <div class="modal-header"><h3 id="productModalTitle">Novo Produto</h3><button class="modal-close" onclick="closeModal('productModal')">&times;</button></div>
      <div class="modal-body">
        <input type="hidden" id="productEditId">
        <div class="form-grid">
          <div class="form-group span2"><label>Nome *</label><input type="text" id="pfName" placeholder="Ex: Toxina Botulínica 100U"></div>
          <div class="form-group span2"><label>Descrição</label><input type="text" id="pfDescription" placeholder="Opcional"></div>
          <div class="form-group"><label>Categoria</label><input type="text" id="pfCategory" placeholder="Ex: Injetáveis"></div>
          <div class="form-group"><label>Unidade *</label><input type="text" id="pfUnit" placeholder="UN, FR, ML, CX..." value="UN"></div>
          <div class="form-group"><label>Estoque mínimo</label><input type="number" step="0.001" min="0" id="pfMinQty" value="0"></div>
          <div class="form-group"><label>Fornecedor habitual</label><input type="text" id="pfSupplier" placeholder="Opcional"></div>
          <div class="form-group"><label>Código NCM</label><input type="text" id="pfNcm" placeholder="Opcional"></div>
          <div class="form-group"><label>Código de barras (EAN)</label><input type="text" id="pfEan" placeholder="Opcional — usado pra casar com XML de NFe"></div>
        </div>
        <div class="alert-err" id="productModalErr"></div>
      </div>
      <div class="modal-foot"><button class="btn btn-outline" onclick="closeModal('productModal')">Cancelar</button><button class="btn btn-solid" id="confirmProductBtn">Salvar</button></div>
    </div>
  </div>

  <!-- MODAL: nova movimentação manual -->
  <div class="modal-overlay" id="movementModal">
    <div class="modal">
      <div class="modal-header"><h3>Nova Movimentação</h3><button class="modal-close" onclick="closeModal('movementModal')">&times;</button></div>
      <div class="modal-body">
        <div class="form-grid">
          <div class="form-group span2">
            <label>Produto *</label>
            <select id="mfProduct"><option value="">Selecione...</option></select>
          </div>
          <div class="form-group">
            <label>Tipo *</label>
            <select id="mfType">
              <option value="ENTRADA">Entrada (compra, reposição)</option>
              <option value="SAIDA">Saída (uso avulso)</option>
              <option value="PERDA">Perda (vencimento, quebra)</option>
              <option value="AJUSTE">Ajuste de inventário</option>
            </select>
          </div>
          <div class="form-group"><label>Quantidade *</label><input type="number" step="0.001" id="mfQuantity" placeholder="0"></div>
          <div class="form-group"><label>Custo unitário (R$)</label><input type="number" step="0.01" min="0" id="mfUnitCost" placeholder="Opcional"></div>
          <div class="form-group"><label>Lote</label><input type="text" id="mfBatch" placeholder="Opcional"></div>
          <div class="form-group"><label>Validade</label><input type="date" id="mfExpiration"></div>
          <div class="form-group span2"><label>Motivo / observação</label><input type="text" id="mfReason" placeholder="Opcional"></div>
        </div>
        <div class="alert-err" id="movementModalErr"></div>
      </div>
      <div class="modal-foot"><button class="btn btn-outline" onclick="closeModal('movementModal')">Cancelar</button><button class="btn btn-solid" id="confirmMovementBtn">Salvar</button></div>
    </div>
  </div>

  <script>
    // ============================================================
    // SIDEBAR (mesmo da primeira tela)
    // ============================================================
    (function initSidebar() {
      const sidebar = document.querySelector('.sidebar');
      const toggleBtn = document.getElementById('sidebarToggleBtn');
      const overlay = document.getElementById('sidebarOverlay');
      let isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
      if (isCollapsed) sidebar.classList.add('collapsed');

      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (window.innerWidth <= 992) {
          sidebar.classList.toggle('open');
          overlay.classList.toggle('active');
          document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
        } else {
          isCollapsed = !isCollapsed;
          sidebar.classList.toggle('collapsed', isCollapsed);
          localStorage.setItem('sidebarCollapsed', String(isCollapsed));
        }
      });

      overlay.addEventListener('click', function() {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      });

      window.addEventListener('resize', function() {
        if (window.innerWidth > 992) {
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        }
      });

      // Tema
      const themeToggle = document.getElementById('themeToggle');
      const currentTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', currentTheme);
      themeToggle.addEventListener('click', function() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const newTheme = isDark ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      });

      // Grupos colapsáveis
      document.querySelectorAll('.sb-group-btn').forEach((btn) => {
        btn.addEventListener('click', function() {
          const group = this.closest('.sb-group');
          if (group) group.classList.toggle('open');
        });
      });

      // Dados do usuário
      const doctorToken = localStorage.getItem('doctorToken');
      const receptionToken = localStorage.getItem('receptionToken');
      const token = doctorToken || receptionToken;
      const isReceptionSession = !doctorToken && !!receptionToken;
      const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');
      const nameEl = document.getElementById('sidebarName');
      const roleEl = document.getElementById('sidebarRole');
      const clinicEl = document.getElementById('sidebarClinic');
      if (nameEl) nameEl.textContent = doctorData.name || 'Profissional';
      if (roleEl) roleEl.textContent = isReceptionSession ? 'Recepcionista' : (doctorData.isClinicOwner ? 'Owner da Clinica' : 'Profissional');
      if (clinicEl) clinicEl.textContent = 'Clinica: ' + (doctorData.clinicName || '--');

      // Logout
      document.getElementById('logoutBtn').addEventListener('click', function() {
        localStorage.removeItem('doctorToken'); localStorage.removeItem('doctorData');
        localStorage.removeItem('receptionToken'); localStorage.removeItem('receptionData');
        window.location.href = isReceptionSession ? '/recepcao/login' : '/medico/login';
      });

      // Permissões (opcional)
      if (token) {
        fetch(isReceptionSession ? '/api/auth/permissions-receptionist' : '/api/auth/permissions', { headers: { Authorization: 'Bearer ' + token } })
          .then((r) => r.ok ? r.json() : null)
          .then((data) => {
            if (!data || !Array.isArray(data.pages)) return;
            const allowed = new Set((data.pages || []).filter((p) => p.can_view).map((p) => p.code));
            document.querySelectorAll('#sidebarNav .nav-item[data-page]').forEach((item) => {
              const rawCodes = item.getAttribute('data-page-codes') || item.getAttribute('data-page') || '';
              const pageCodes = rawCodes.split(',').map((code) => code.trim()).filter(Boolean);
              const canSee = pageCodes.some((code) => allowed.has(code));
              item.hidden = !canSee;
            });
            document.querySelectorAll('.sb-group').forEach((g) => {
              const hasVisible = Array.from(g.querySelectorAll('.nav-item')).some((i) => !i.hidden);
              g.style.display = hasVisible ? '' : 'none';
            });
          })
          .catch(() => {});
      }
    })();

    // ============================================================
    // ESTOQUE
    // ============================================================
    const doctorToken = localStorage.getItem('doctorToken');
    const receptionToken = localStorage.getItem('receptionToken');
    const token = doctorToken || receptionToken;
    const isReceptionSession = !doctorToken && !!receptionToken;
    if (!token) window.location.href = '/medico/login';
    const H = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };
    const doctorData = JSON.parse(localStorage.getItem(isReceptionSession ? 'receptionData' : 'doctorData') || '{}');

    function esc(v){ return String(v==null?'':v).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    function fmtMoney(v){ return Number(v||0).toLocaleString('pt-BR', { style:'currency', currency:'BRL' }); }
    function fmtDate(v){ if(!v) return '—'; return new Date(v).toLocaleDateString('pt-BR', { timeZone: 'UTC' }); }
    function fmtDateTime(v){ if(!v) return '—'; return new Date(v).toLocaleString('pt-BR'); }

    // ── EXPORTAÇÃO — todo relatório desta tela pode ser baixado, não só visualizado ──
    function downloadCSV(filename, headers, rows){
      const cell = (v) => {
        const s = v == null ? '' : String(v);
        return /[";\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
      };
      const lines = [headers.map(cell).join(';')].concat(rows.map(r => r.map(cell).join(';')));
      const csv = '\uFEFF' + lines.join('\r\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    async function apiGet(url){
      const res = await fetch(url, { headers: H });
      const data = await res.json().catch(() => null);
      if (!res.ok) throw new Error(data?.error || 'Falha na requisição.');
      return data;
    }
    async function apiSend(url, method, body){
      const res = await fetch(url, { method, headers: H, body: body != null ? JSON.stringify(body) : undefined });
      const data = await res.json().catch(() => null);
      if (!res.ok) throw new Error(data?.error || 'Falha na requisição.');
      return data;
    }
    function closeModal(id){ document.getElementById(id).classList.remove('show'); }
    function openModal(id){ document.getElementById(id).classList.add('show'); }
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
      overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('show'); });
    });

    // ── TABS ──
    const loadedTabs = new Set();
    const tabLoaders = {
      overview: loadOverview,
      products: loadProducts,
      movements: loadMovements,
      xml: loadXmlImports,
    };
    document.querySelectorAll('.report-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        document.querySelectorAll('.report-tab').forEach((b) => b.classList.toggle('active', b === btn));
        document.querySelectorAll('.report-panel').forEach((p) => p.classList.toggle('active', p.id === `panel-${tab}`));
        if (!loadedTabs.has(tab)) { loadedTabs.add(tab); tabLoaders[tab]?.(); }
      });
    });

    function fmtQty(v){
      const n = Number(v || 0);
      return n.toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 3 });
    }

    const MOVEMENT_TYPE_LABELS = {
      ENTRADA: { label: 'Entrada', badge: 'badge-green' },
      SAIDA: { label: 'Saída', badge: 'badge-gray' },
      AJUSTE: { label: 'Ajuste', badge: 'badge-purple' },
      PERDA: { label: 'Perda', badge: 'badge-red' },
      CONSUMO_PROCEDIMENTO: { label: 'Consumo em Procedimento', badge: 'badge-gray' },
    };

    // ── VISÃO GERAL ──
    async function loadOverview(){
      const kpisEl = document.getElementById('stockKpis');
      const lowStockTbody = document.getElementById('lowStockTbody');
      kpisEl.innerHTML = '';
      lowStockTbody.innerHTML = '<tr><td colspan="4" class="empty-state">Carregando...</td></tr>';
      try {
        const data = await apiGet('/api/stock/summary');
        kpisEl.innerHTML = `
          <div class="stat-card"><div class="icon blue"><i class="fas fa-boxes-stacked"></i></div><div class="info"><div class="stat-val">${data.totalProducts}</div><div class="stat-label">Produtos cadastrados</div></div></div>
          <div class="stat-card"><div class="icon amber"><i class="fas fa-triangle-exclamation"></i></div><div class="info"><div class="stat-val">${data.lowStockCount}</div><div class="stat-label">Em alerta de reposição</div></div></div>
          <div class="stat-card"><div class="icon green"><i class="fas fa-arrow-down"></i></div><div class="info"><div class="stat-val">${fmtMoney(data.last30Days.entradasValor)}</div><div class="stat-label">Entradas nos últimos 30 dias</div></div></div>
          <div class="stat-card"><div class="icon purple"><i class="fas fa-arrow-up"></i></div><div class="info"><div class="stat-val">${data.last30Days.saidasQtd}</div><div class="stat-label">Saídas/consumos (30 dias)</div></div></div>
        `;
        lowStockTbody.innerHTML = data.lowStockItems.map((r) => `
          <tr>
            <td>${esc(r.name)}</td>
            <td style="color:${r.balance < 0 ? '#ef4444' : 'inherit'};font-weight:600;">${fmtQty(r.balance)} ${esc(r.unit)}</td>
            <td>${fmtQty(r.minimum_quantity)} ${esc(r.unit)}</td>
            <td>${esc(r.unit)}</td>
          </tr>
        `).join('') || '<tr><td colspan="4" class="empty-state">Nenhum produto abaixo do estoque mínimo. 🎉</td></tr>';
      } catch (e) {
        lowStockTbody.innerHTML = `<tr><td colspan="4" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }

    // ── PRODUTOS ──
    let allProducts = [];
    async function loadProducts(){
      const tbody = document.getElementById('productsTbody');
      tbody.innerHTML = '<tr><td colspan="8" class="empty-state">Carregando...</td></tr>';
      try {
        const search = document.getElementById('productSearchInput').value.trim();
        allProducts = await apiGet(`/api/stock/products${search ? `?search=${encodeURIComponent(search)}` : ''}`);
        tbody.innerHTML = allProducts.map((p) => `
          <tr>
            <td>${esc(p.name)}</td>
            <td>${esc(p.category || '—')}</td>
            <td>${esc(p.unit)}</td>
            <td style="color:${p.balance < 0 ? '#ef4444' : 'inherit'};font-weight:600;">${fmtQty(p.balance)}</td>
            <td>${fmtQty(p.minimum_quantity)}</td>
            <td>${fmtMoney(p.avg_cost)}</td>
            <td>${p.low_stock ? '<span class="badge badge-red">Repor</span>' : '<span class="badge badge-green">OK</span>'}</td>
            <td>
              <button class="btn btn-outline btn-xs" onclick="openEditProductModal('${p.id}')"><i class="fas fa-pen"></i></button>
              <button class="btn btn-outline btn-xs" onclick="deactivateProduct('${p.id}', ${JSON.stringify(p.name)})"><i class="fas fa-trash"></i></button>
            </td>
          </tr>
        `).join('') || '<tr><td colspan="8" class="empty-state">Nenhum produto cadastrado ainda.</td></tr>';
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="8" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }
    document.getElementById('productSearchBtn').addEventListener('click', loadProducts);
    document.getElementById('productSearchInput').addEventListener('keydown', (e) => { if (e.key === 'Enter') loadProducts(); });

    document.getElementById('openNewProductBtn').addEventListener('click', () => {
      document.getElementById('productModalTitle').textContent = 'Novo Produto';
      document.getElementById('productEditId').value = '';
      ['pfName','pfDescription','pfCategory','pfSupplier','pfNcm','pfEan'].forEach((id) => document.getElementById(id).value = '');
      document.getElementById('pfUnit').value = 'UN';
      document.getElementById('pfMinQty').value = '0';
      document.getElementById('productModalErr').style.display = 'none';
      openModal('productModal');
    });
    function openEditProductModal(id){
      const p = allProducts.find((x) => x.id === id);
      if (!p) return;
      document.getElementById('productModalTitle').textContent = 'Editar Produto';
      document.getElementById('productEditId').value = p.id;
      document.getElementById('pfName').value = p.name || '';
      document.getElementById('pfDescription').value = p.description || '';
      document.getElementById('pfCategory').value = p.category || '';
      document.getElementById('pfUnit').value = p.unit || 'UN';
      document.getElementById('pfMinQty').value = p.minimum_quantity ?? 0;
      document.getElementById('pfSupplier').value = p.supplier_name || '';
      document.getElementById('pfNcm').value = p.ncm_code || '';
      document.getElementById('pfEan').value = p.ean_code || '';
      document.getElementById('productModalErr').style.display = 'none';
      openModal('productModal');
    }
    document.getElementById('confirmProductBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('productModalErr');
      errEl.style.display = 'none';
      const name = document.getElementById('pfName').value.trim();
      if (!name) { errEl.textContent = 'Informe o nome do produto.'; errEl.style.display = 'block'; return; }
      const payload = {
        name,
        description: document.getElementById('pfDescription').value.trim() || null,
        category: document.getElementById('pfCategory').value.trim() || null,
        unit: document.getElementById('pfUnit').value.trim() || 'UN',
        minimumQuantity: document.getElementById('pfMinQty').value || 0,
        supplierName: document.getElementById('pfSupplier').value.trim() || null,
        ncmCode: document.getElementById('pfNcm').value.trim() || null,
        eanCode: document.getElementById('pfEan').value.trim() || null,
      };
      const editId = document.getElementById('productEditId').value;
      try {
        if (editId) await apiSend(`/api/stock/products/${editId}`, 'PUT', payload);
        else await apiSend('/api/stock/products', 'POST', payload);
        closeModal('productModal');
        loadProducts();
      } catch (e) { errEl.textContent = e.message; errEl.style.display = 'block'; }
    });
    async function deactivateProduct(id, name){
      if (!confirm(`Desativar "${name}"? Ele deixa de aparecer nas listas, mas o histórico de movimentações é mantido.`)) return;
      try { await apiSend(`/api/stock/products/${id}`, 'DELETE'); loadProducts(); }
      catch (e) { alert(e.message); }
    }

    // Deixa o <select> de produto do formulário de movimentação sempre
    // atualizado, mesmo se a aba Produtos ainda não tiver sido aberta.
    async function ensureProductsLoadedForSelect(){
      if (allProducts.length === 0) {
        try { allProducts = await apiGet('/api/stock/products'); } catch (e) { /* segue com lista vazia */ }
      }
      const select = document.getElementById('mfProduct');
      const current = select.value;
      select.innerHTML = '<option value="">Selecione...</option>' + allProducts.map((p) => `<option value="${p.id}">${esc(p.name)} (${fmtQty(p.balance)} ${esc(p.unit)})</option>`).join('');
      if (current) select.value = current;
    }

    // ── MOVIMENTAÇÕES ──
    let lastMovementsRows = [];
    async function loadMovements(){
      const tbody = document.getElementById('movementsTbody');
      tbody.innerHTML = '<tr><td colspan="7" class="empty-state">Carregando...</td></tr>';
      try {
        const type = document.getElementById('movementTypeFilter').value;
        const from = document.getElementById('movementFrom').value;
        const to = document.getElementById('movementTo').value;
        const params = new URLSearchParams();
        if (type) params.set('type', type);
        if (from) params.set('from', from);
        if (to) params.set('to', to);
        const rows = await apiGet(`/api/stock/movements?${params.toString()}`);
        lastMovementsRows = rows;
        tbody.innerHTML = rows.map((r) => {
          const info = MOVEMENT_TYPE_LABELS[r.type] || { label: r.type, badge: 'badge-gray' };
          return `
            <tr>
              <td>${fmtDateTime(r.created_at)}</td>
              <td>${esc(r.product_name)}</td>
              <td><span class="badge ${info.badge}">${info.label}</span></td>
              <td>${r.quantity > 0 ? '+' : ''}${fmtQty(r.quantity)} ${esc(r.product_unit)}</td>
              <td>${r.unit_cost != null ? fmtMoney(r.unit_cost) : '—'}</td>
              <td>${r.total_cost != null ? fmtMoney(r.total_cost) : '—'}</td>
              <td>${esc(r.reason || '—')}</td>
            </tr>`;
        }).join('') || '<tr><td colspan="7" class="empty-state">Nenhuma movimentação encontrada.</td></tr>';
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="7" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }
    document.getElementById('movementTypeFilter').addEventListener('change', loadMovements);
    document.getElementById('movementRefreshBtn').addEventListener('click', loadMovements);
    document.getElementById('movementDownloadBtn').addEventListener('click', () => {
      downloadCSV('movimentacoes-estoque.csv', ['Data','Produto','Tipo','Quantidade','Custo Unit.','Total','Motivo'],
        lastMovementsRows.map((r) => [fmtDateTime(r.created_at), r.product_name, (MOVEMENT_TYPE_LABELS[r.type] || {}).label || r.type, r.quantity, r.unit_cost ?? '', r.total_cost ?? '', r.reason || '']));
    });

    document.getElementById('openNewMovementBtn').addEventListener('click', async () => {
      await ensureProductsLoadedForSelect();
      document.getElementById('mfType').value = 'ENTRADA';
      document.getElementById('mfQuantity').value = '';
      document.getElementById('mfUnitCost').value = '';
      document.getElementById('mfBatch').value = '';
      document.getElementById('mfExpiration').value = '';
      document.getElementById('mfReason').value = '';
      document.getElementById('movementModalErr').style.display = 'none';
      openModal('movementModal');
    });
    document.getElementById('confirmMovementBtn').addEventListener('click', async () => {
      const errEl = document.getElementById('movementModalErr');
      errEl.style.display = 'none';
      const productId = document.getElementById('mfProduct').value;
      const type = document.getElementById('mfType').value;
      const quantity = document.getElementById('mfQuantity').value;
      if (!productId) { errEl.textContent = 'Selecione o produto.'; errEl.style.display = 'block'; return; }
      if (!quantity || Number(String(quantity).replace(',', '.')) === 0) { errEl.textContent = 'Informe uma quantidade válida.'; errEl.style.display = 'block'; return; }
      try {
        await apiSend('/api/stock/movements', 'POST', {
          productId, type, quantity,
          unitCost: document.getElementById('mfUnitCost').value || null,
          batchNumber: document.getElementById('mfBatch').value.trim() || null,
          expirationDate: document.getElementById('mfExpiration').value || null,
          reason: document.getElementById('mfReason').value.trim() || null,
        });
        closeModal('movementModal');
        loadMovements();
        if (loadedTabs.has('overview')) loadOverview();
        if (loadedTabs.has('products')) loadProducts();
      } catch (e) { errEl.textContent = e.message; errEl.style.display = 'block'; }
    });

    // ── IMPORTAR XML ──
    let selectedXmlFile = null;
    const xmlDropArea = document.getElementById('xmlDropArea');
    const xmlFileInput = document.getElementById('xmlFileInput');
    xmlDropArea.addEventListener('click', () => xmlFileInput.click());
    xmlDropArea.addEventListener('dragover', (e) => { e.preventDefault(); xmlDropArea.style.borderColor = 'var(--sb-accent)'; });
    xmlDropArea.addEventListener('dragleave', () => { xmlDropArea.style.borderColor = 'var(--sb-border)'; });
    xmlDropArea.addEventListener('drop', (e) => {
      e.preventDefault();
      xmlDropArea.style.borderColor = 'var(--sb-border)';
      if (e.dataTransfer.files.length > 0) selectXmlFile(e.dataTransfer.files[0]);
    });
    xmlFileInput.addEventListener('change', () => { if (xmlFileInput.files.length > 0) selectXmlFile(xmlFileInput.files[0]); });
    function selectXmlFile(file){
      if (!/\.xml$/i.test(file.name)) { alert('Selecione um arquivo .xml'); return; }
      selectedXmlFile = file;
      document.getElementById('xmlSelectedFileName').textContent = file.name;
      document.getElementById('xmlSelectedFile').style.display = 'flex';
      document.getElementById('xmlImportResult').style.display = 'none';
      document.getElementById('xmlImportErr').style.display = 'none';
    }
    document.getElementById('xmlImportBtn').addEventListener('click', async () => {
      if (!selectedXmlFile) return;
      const errEl = document.getElementById('xmlImportErr');
      const resultEl = document.getElementById('xmlImportResult');
      errEl.style.display = 'none';
      resultEl.style.display = 'none';
      const btn = document.getElementById('xmlImportBtn');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Importando...';
      try {
        const token = localStorage.getItem('doctorToken') || localStorage.getItem('receptionToken');
        const formData = new FormData();
        formData.append('xml', selectedXmlFile);
        const res = await fetch('/api/stock/xml-import', { method: 'POST', headers: { Authorization: 'Bearer ' + token }, body: formData });
        const data = await res.json().catch(() => null);
        if (!res.ok) throw new Error(data?.error || 'Falha ao importar o XML.');

        const newCount = data.items.filter((i) => i.wasNew).length;
        resultEl.style.display = 'block';
        resultEl.innerHTML = `
          <div class="info-banner" style="border-left-color:#10b981;background:rgba(16,185,129,.12);">
            <i class="fas fa-circle-check" style="color:#10b981;"></i>
            <span>
              Nota <strong>${esc(data.import.nfe_number || 's/n')}</strong> de <strong>${esc(data.import.supplier_name)}</strong> importada —
              ${data.items.length} ${data.items.length === 1 ? 'item' : 'itens'} lançado(s) como entrada
              (${newCount} produto${newCount === 1 ? '' : 's'} novo${newCount === 1 ? '' : 's'} cadastrado${newCount === 1 ? '' : 's'})${data.expensesCreated.length > 0 ? `, e ${data.expensesCreated.length} conta${data.expensesCreated.length === 1 ? '' : 's'} a pagar gerada${data.expensesCreated.length === 1 ? '' : 's'} a partir do boleto/duplicata da nota` : ''}.
            </span>
          </div>
          <div class="table-wrap" style="margin-top:12px;">
            <table>
              <thead><tr><th>Produto</th><th>Qtd.</th><th>Custo Unit.</th><th>Total</th><th></th></tr></thead>
              <tbody>
                ${data.items.map((i) => `<tr><td>${esc(i.productName)}</td><td>${fmtQty(i.quantity)}</td><td>${i.unitCost != null ? fmtMoney(i.unitCost) : '—'}</td><td>${i.totalCost != null ? fmtMoney(i.totalCost) : '—'}</td><td>${i.wasNew ? '<span class="badge badge-purple">Novo produto</span>' : ''}</td></tr>`).join('')}
              </tbody>
            </table>
          </div>
        `;
        selectedXmlFile = null;
        xmlFileInput.value = '';
        document.getElementById('xmlSelectedFile').style.display = 'none';
        loadXmlImports();
        allProducts = [];
        if (loadedTabs.has('overview')) loadOverview();
        if (loadedTabs.has('products')) loadProducts();
      } catch (e) {
        errEl.textContent = e.message;
        errEl.style.display = 'block';
      }
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-upload"></i> Importar';
    });

    async function loadXmlImports(){
      const tbody = document.getElementById('xmlImportsTbody');
      tbody.innerHTML = '<tr><td colspan="7" class="empty-state">Carregando...</td></tr>';
      try {
        const rows = await apiGet('/api/stock/xml-imports');
        tbody.innerHTML = rows.map((r) => `
          <tr>
            <td>${fmtDateTime(r.created_at)}</td>
            <td>${esc(r.nfe_number || '—')}</td>
            <td>${esc(r.supplier_name || '—')}</td>
            <td>${r.items_count}</td>
            <td>${r.new_products_count}</td>
            <td>${fmtMoney(r.total_value)}</td>
            <td>${r.expenses_created > 0 ? `<span class="badge badge-purple">${r.expenses_created}</span>` : '—'}</td>
          </tr>
        `).join('') || '<tr><td colspan="7" class="empty-state">Nenhuma importação ainda.</td></tr>';
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="7" class="empty-state">${esc(e.message)}</td></tr>`;
      }
    }

    // ── INIT ──
    loadedTabs.add('overview');
    loadOverview();

    // Socket.io — atualiza as abas já abertas quando houver mudança (outra aba/usuário)
    (function() {
      const _isRc = !localStorage.getItem('doctorToken') && !!localStorage.getItem('receptionToken');
      const _d = JSON.parse(localStorage.getItem(_isRc ? 'receptionData' : 'doctorData') || '{}');
      if (!_d.clinicId && !_d.id) return;
      const _sock = io({ transports: ['websocket', 'polling'] });
      _sock.on('connect', () => {
        if (_d.clinicId) _sock.emit('join_clinic', _d.clinicId);
        if (!_isRc && _d.id) _sock.emit('join_doctor', _d.id);
      });
      ['stock_product_created', 'stock_product_updated', 'stock_product_deleted', 'stock_movement_created', 'stock_xml_imported'].forEach((evt) => {
        _sock.on(evt, () => {
          allProducts = [];
          loadedTabs.forEach((tab) => tabLoaders[tab]?.());
        });
      });
    })();
  </script>

  <script src="/socket.io/socket.io.js"></script>
</body>
</html>
