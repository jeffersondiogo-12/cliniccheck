  </aside>

  <!-- ============================================================
  MAIN — ESTOQUE
  ============================================================ -->
  <main class="main">
    <header class="topbar">
      <div>
        <h1>Estoque</h1>
        <div class="meta">Produtos, movimentações e entrada por XML de NFe</div>
      </div>
      <div class="topbar-actions">
        <a href="/medico" class="btn btn-outline btn-sm">Dashboard</a>
      </div>
    </header>

    <div class="content">

      <div class="report-tabs" id="stockTabs">
        <button class="report-tab active" data-tab="overview">Visão Geral</button>
        <button class="report-tab" data-tab="products">Produtos</button>
        <button class="report-tab" data-tab="movements">Movimentações</button>
        <button class="report-tab" data-tab="xml">Importar XML</button>
      </div>

      <!-- ═══ VISÃO GERAL ═══ -->
      <div class="report-panel active" id="panel-overview">
        <div class="stats-row" id="stockKpis" style="margin-bottom:20px;"></div>
        <div class="card">
          <div class="card-header"><span><i class="fas fa-triangle-exclamation"></i> Produtos em Alerta de Reposição</span></div>
          <div class="card-body">
            <div class="table-wrap">
              <table>
                <thead><tr><th>Produto</th><th>Saldo Atual</th><th>Mínimo</th><th>Unidade</th></tr></thead>
                <tbody id="lowStockTbody"><tr><td colspan="4" class="empty-state">Carregando...</td></tr></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ PRODUTOS ═══ -->
      <div class="report-panel" id="panel-products">
        <div class="card">
          <div class="card-header">
            <span><i class="fas fa-box"></i> Produtos / Insumos</span>
            <div class="toolbar" style="margin:0;">
              <input type="text" id="productSearchInput" placeholder="Buscar por nome, EAN ou NCM...">
              <button class="btn btn-outline btn-sm" id="productSearchBtn"><i class="fas fa-search"></i></button>
              <button class="btn btn-solid btn-sm" id="openNewProductBtn"><i class="fas fa-plus"></i> Novo Produto</button>
            </div>
          </div>
          <div class="card-body">
            <div class="table-wrap">
              <table>
                <thead><tr><th>Produto</th><th>Categoria</th><th>Unid.</th><th>Saldo</th><th>Mínimo</th><th>Custo Médio</th><th>Status</th><th>Ações</th></tr></thead>
                <tbody id="productsTbody"><tr><td colspan="8" class="empty-state">Carregando...</td></tr></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ MOVIMENTAÇÕES ═══ -->
      <div class="report-panel" id="panel-movements">
        <div class="card">
          <div class="card-header">
            <span><i class="fas fa-arrow-right-arrow-left"></i> Movimentações</span>
            <div class="toolbar" style="margin:0;">
              <select id="movementTypeFilter">
                <option value="">Todos os tipos</option>
                <option value="ENTRADA">Entrada</option>
                <option value="SAIDA">Saída</option>
                <option value="AJUSTE">Ajuste</option>
                <option value="PERDA">Perda</option>
                <option value="CONSUMO_PROCEDIMENTO">Consumo em Procedimento</option>
              </select>
              <input type="date" id="movementFrom">
              <input type="date" id="movementTo">
              <button class="btn btn-outline btn-sm" id="movementRefreshBtn"><i class="fas fa-sync"></i></button>
              <button class="btn btn-outline btn-sm" id="movementDownloadBtn"><i class="fas fa-download"></i> Baixar CSV</button>
              <button class="btn btn-solid btn-sm" id="openNewMovementBtn"><i class="fas fa-plus"></i> Nova Movimentação</button>
            </div>
          </div>
          <div class="card-body">
            <div class="table-wrap">
              <table>
                <thead><tr><th>Data</th><th>Produto</th><th>Tipo</th><th>Qtd.</th><th>Custo Unit.</th><th>Total</th><th>Motivo</th></tr></thead>
                <tbody id="movementsTbody"><tr><td colspan="7" class="empty-state">Carregando...</td></tr></tbody>
