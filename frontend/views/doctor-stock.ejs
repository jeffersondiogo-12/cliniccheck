        <div class="card">
          <div class="card-header"><span><i class="fas fa-clock-rotate-left"></i> Importações Anteriores</span></div>
          <div class="card-body">
            <div class="table-wrap">
              <table>
                <thead><tr><th>Data</th><th>NFe</th><th>Fornecedor</th><th>Itens</th><th>Novos Produtos</th><th>Valor Total</th><th>Contas Geradas</th></tr></thead>
