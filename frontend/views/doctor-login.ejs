<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clinic Chek - Acesso ao Sistema</title>
  <link rel="icon" type="image/svg+xml" href="/public/brand/clinic-check-favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Sora:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-top: #eef7f2;
      --bg-mid: #ebf1f8;
      --bg-bottom: #ece8ff;
      --card: #ffffff;
      --text: #0d1b3d;
      --muted: #64748b;
      --field-border: #dbe2f2;
      --field-focus: #22b573;
      --field-icon: #95a3ba;
      --primary-a: #1fbf74;
      --primary-b: #1f8fc7;
      --primary-c: #5a31d7;
      --doctor: #1f8fc7;
      --attendant: #5a31d7;
      --patient: #1fbf74;
      --danger: #dc2626;
      --success: #15803d;
      --shadow-card: 0 24px 70px rgba(17, 24, 39, 0.13);
      --shadow-logo: 0 14px 24px rgba(31, 191, 116, 0.28);
      --radius-lg: 30px;
      --radius-md: 16px;
      --radius-sm: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      min-height: 100vh;
      font-family: 'Manrope', sans-serif;
      color: var(--text);
      background: linear-gradient(180deg, var(--bg-top) 0%, var(--bg-mid) 52%, var(--bg-bottom) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 28px 14px;
      position: relative;
      overflow-x: hidden;
    }

    .bg-shape {
      position: fixed;
      pointer-events: none;
      border-radius: 999px;
      filter: blur(2px);
      opacity: 0.42;
      z-index: 0;
      animation: floaty 10s ease-in-out infinite;
    }

    .bg-shape.a {
      width: 380px;
      height: 380px;
      right: -130px;
      top: -120px;
      background: radial-gradient(circle at 30% 30%, #a7efc8 0%, #88dbb0 40%, #6ccda1 100%);
    }

    .bg-shape.b {
      width: 360px;
      height: 360px;
      left: -120px;
      bottom: -140px;
      background: radial-gradient(circle at 45% 45%, #b8b3ff 0%, #9fa4ff 45%, #8b94ff 100%);
      animation-delay: 1.4s;
    }

    .bg-shape.c {
      width: 260px;
      height: 260px;
      right: 22%;
      bottom: -90px;
      background: radial-gradient(circle at 50% 50%, #8ebaf4 0%, #7aa6ea 45%, #739de0 100%);
      animation-delay: 2.5s;
    }

    .login-shell {
      width: min(760px, 100%);
      background: var(--card);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-card);
      border: 1px solid rgba(255, 255, 255, 0.75);
      position: relative;
      z-index: 2;
      overflow: hidden;
      animation: rise 0.55s ease-out;
    }

    .login-shell::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(146deg, rgba(255, 255, 255, 0.92) 0%, rgba(250, 253, 255, 0.98) 100%);
      z-index: -1;
    }

    .shell-inner { padding: 42px 54px 36px; }
    .logo-wrap { display: flex; justify-content: center; margin-bottom: 20px; }

    .logo-badge {
      width: 96px;
      height: 96px;
      border-radius: 26px;
      background: linear-gradient(142deg, #23c57a 0%, #1da8c9 56%, #2b53c8 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-logo);
      padding: 16px;
    }

    .logo-badge img { width: 100%; height: 100%; object-fit: contain; }

    .title {
      text-align: center;
      font-family: 'Sora', sans-serif;
      font-size: 46px;
      line-height: 1.08;
      letter-spacing: -1.2px;
      margin-bottom: 12px;
      color: #0d1b3d;
      font-weight: 700;
    }

    .subtitle {
      text-align: center;
      color: #64748b;
      font-size: 33px;
      line-height: 1.28;
      margin: 0 auto 26px;
      max-width: 620px;
      font-weight: 500;
    }

    .alert {
      border-radius: var(--radius-sm);
      padding: 12px 14px;
      margin-bottom: 12px;
      font-size: 14px;
      font-weight: 600;
      display: none;
    }

    .alert-err { color: var(--danger); background: #fff1f2; border: 1px solid #fecdd3; }
    .alert-ok { color: var(--success); background: #f0fdf4; border: 1px solid #bbf7d0; }

    .field { margin-bottom: 14px; }
    .field label {
      display: block;
      margin-bottom: 6px;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #1f2d4d;
      font-weight: 800;
    }

    .input-wrap { position: relative; }
    .input-wrap .icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      width: 18px;
      height: 18px;
      color: var(--field-icon);
      pointer-events: none;
    }

    .input-wrap input {
      width: 100%;
      height: 56px;
      border: 1.5px solid var(--field-border);
      border-radius: var(--radius-md);
      padding: 0 16px 0 44px;
      font-size: 22px;
      color: #1e2f52;
      background: #fff;
      outline: none;
      transition: border-color .18s, box-shadow .2s;
      font-family: 'Manrope', sans-serif;
      font-weight: 600;
    }

    .input-wrap input::placeholder { color: #a1afc4; font-weight: 500; }
    .input-wrap input:focus { border-color: var(--field-focus); box-shadow: 0 0 0 4px rgba(34, 181, 115, 0.14); }

    .toggle-pass {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      border: none;
      background: transparent;
      cursor: pointer;
      color: #94a3b8;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background .2s;
    }

    .toggle-pass:hover { background: #eef2ff; }

    .row-options {
      margin-top: 6px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-size: 15px;
      color: #4b5f84;
    }

    .remember {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      user-select: none;
      font-weight: 600;
    }

    .remember input { width: 16px; height: 16px; accent-color: #23bf75; }
    .forgot { color: #1fa460; text-decoration: none; font-weight: 700; }
    .forgot:hover { text-decoration: underline; }

    .submit-btn {
      width: 100%;
      margin-top: 18px;
      height: 62px;
      border: none;
      border-radius: var(--radius-md);
      color: #fff;
      font-size: 34px;
      font-weight: 800;
      letter-spacing: -0.4px;
      cursor: pointer;
      background: linear-gradient(99deg, var(--primary-a) 0%, var(--primary-b) 52%, var(--primary-c) 100%);
      box-shadow: 0 14px 28px rgba(72, 62, 186, 0.24);
      transition: transform .15s, box-shadow .2s, opacity .2s;
      font-family: 'Sora', sans-serif;
    }

    .submit-btn:hover { transform: translateY(-1px); box-shadow: 0 18px 30px rgba(72, 62, 186, 0.3); }
    .submit-btn:disabled { opacity: .7; cursor: not-allowed; transform: none; }

    .spin {
      display: inline-block;
      width: 18px;
      height: 18px;
      border: 2px solid rgba(255, 255, 255, 0.35);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin .7s linear infinite;
      vertical-align: -3px;
      margin-right: 8px;
    }

    .divider {
      margin: 22px 0 16px;
      position: relative;
      text-align: center;
      color: #8092af;
      font-weight: 700;
      font-size: 15px;
    }

    .divider::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      border-top: 1px solid #dbe3f4;
    }

    .divider span { position: relative; background: #fff; padding: 0 14px; }

    .access-link {
      display: flex;
      align-items: center;
      gap: 11px;
      border: 1.5px solid #dbe3f4;
      border-radius: var(--radius-md);
      padding: 13px 15px;
      text-decoration: none;
      color: #223457;
      font-size: 29px;
      font-weight: 700;
      margin-bottom: 10px;
      transition: border-color .18s, background .2s, transform .13s;
      min-height: 57px;
    }

    .access-link:hover { transform: translateY(-1px); background: #f8fbff; }
    .access-link svg { width: 25px; height: 25px; }
    .access-link.medico:hover { border-color: rgba(31, 143, 199, .55); }
    .access-link.medico svg { color: var(--doctor); }
    .access-link.atendente:hover { border-color: rgba(90, 49, 215, .5); }
    .access-link.atendente svg { color: var(--attendant); }
    .access-link.paciente:hover { border-color: rgba(31, 191, 116, .55); }
    .access-link.paciente svg { color: var(--patient); }

    .footer-note {
      text-align: center;
      margin-top: 8px;
      color: #7b8ca8;
      font-size: 15px;
      font-weight: 600;
    }

    .footer-note strong { color: #23a25f; }

    @keyframes rise {
      from { opacity: 0; transform: translateY(18px) scale(.985); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @keyframes floaty { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(8px); } }
    @keyframes spin { to { transform: rotate(360deg); } }

    @media (max-width: 930px) {
      .shell-inner { padding: 30px 24px 26px; }
      .title { font-size: 36px; }
      .subtitle { font-size: 24px; max-width: 520px; }
      .submit-btn { font-size: 28px; height: 56px; }
      .access-link { font-size: 24px; }
      .access-link svg { width: 22px; height: 22px; }
      .input-wrap input { font-size: 18px; }
    }

    @media (max-width: 620px) {
      body { padding: 12px; }
      .login-shell { border-radius: 22px; }
      .logo-badge { width: 80px; height: 80px; border-radius: 20px; }
      .title { font-size: 27px; letter-spacing: -0.6px; }
      .subtitle { font-size: 17px; margin-bottom: 18px; }
      .field label { font-size: 11px; }
      .input-wrap input { height: 50px; font-size: 16px; padding-left: 40px; }
      .submit-btn { height: 52px; font-size: 22px; }
      .access-link { font-size: 17px; min-height: 50px; }
      .access-link svg { width: 19px; height: 19px; }
      .row-options { font-size: 13px; }
      .footer-note { font-size: 13px; }
    }
  </style>
  <link rel="stylesheet" href="/public/css/global-palette.css">
</head>
<body>
  <div class="bg-shape a"></div>
  <div class="bg-shape b"></div>
  <div class="bg-shape c"></div>

  <div class="login-shell">
    <div class="shell-inner">
      <div class="logo-wrap">
        <div class="logo-badge">
          <img src="/public/brand/clinic-check-mark.svg" alt="Clinic Check">
        </div>
      </div>

      <h1 class="title">Acesso ao Sistema</h1>
      <p class="subtitle">Entre com suas credenciais para acessar o sistema Clinic Check.</p>

      <div class="alert alert-err" id="errAlert"></div>
      <div class="alert alert-ok" id="okAlert"></div>

      <form id="loginForm" autocomplete="on">
        <div class="field">
          <label for="clinicName">Clinica</label>
          <div class="input-wrap">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10z"/></svg>
            <input type="text" id="clinicName" placeholder="Nome da clinica" required>
          </div>
        </div>

        <div class="field">
          <label for="email">E-mail</label>
          <div class="input-wrap">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            <input type="email" id="email" placeholder="seu@email.com" required autofocus>
          </div>
        </div>

        <div class="field">
          <label for="password">Senha</label>
          <div class="input-wrap">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
            <input type="password" id="password" placeholder="••••••••" required>
            <button type="button" class="toggle-pass" id="togglePass" aria-label="Mostrar ou ocultar senha">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 6.5C7 6.5 2.73 9.61 1 14c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5A5 5 0 1 1 12 9a5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>
            </button>
          </div>
        </div>

        <div class="row-options">
          <label class="remember" for="rememberMe">
            <input type="checkbox" id="rememberMe" checked>
            Lembrar de mim
          </label>
          <a href="#" class="forgot" onclick="return false;">Esqueceu sua senha?</a>
        </div>

        <button type="submit" class="submit-btn" id="submitBtn">Entrar no Sistema</button>
      </form>

      <div class="divider"><span>ou</span></div>

      <a href="/recepcao/login" class="access-link atendente">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1a5 5 0 0 0-5 5v1H6a3 3 0 0 0-3 3v8h4v5l4-5h7a3 3 0 0 0 3-3v-5h-1V9a8 8 0 0 0-8-8zm6 14a1 1 0 0 1-1 1h-7l-2 2v-2H6a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1h11a1 1 0 0 1 1 1v5z"/></svg>
        Sou Atendente — Gerenciar Agenda
      </a>
      <a href="/paciente/login" class="access-link paciente">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5zm0 2c-4.42 0-8 2-8 4.5V21h16v-2.5C20 16 16.42 14 12 14z"/></svg>
        Acesso do Paciente — Portal Seguro
      </a>

      <p class="footer-note">Nao tem uma conta? <strong>Fale com a recepcao</strong></p>
    </div>
  </div>

  <script>
    const loginForm = document.getElementById('loginForm');
    const submitBtn = document.getElementById('submitBtn');
    const errAlert = document.getElementById('errAlert');
    const okAlert = document.getElementById('okAlert');
    const passInput = document.getElementById('password');
    const togglePass = document.getElementById('togglePass');

    togglePass.addEventListener('click', () => {
      const nextType = passInput.type === 'password' ? 'text' : 'password';
      passInput.type = nextType;
    });

    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const clinicName = document.getElementById('clinicName').value.trim();
      const email = document.getElementById('email').value.trim();
      const password = passInput.value;

      errAlert.style.display = 'none';
      okAlert.style.display = 'none';

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spin"></span>Validando acesso...';

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ clinicName, email, password })
        });

        const data = await res.json();
        if (res.ok && data.token) {
          localStorage.removeItem('doctorToken');
          localStorage.removeItem('doctorData');
          localStorage.removeItem('receptionToken');
          localStorage.removeItem('receptionData');
          localStorage.removeItem('patientToken');
          localStorage.removeItem('patientData');
          document.cookie = 'doctorToken=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
          document.cookie = 'receptionToken=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
          document.cookie = 'patientToken=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
          localStorage.setItem('doctorToken', data.token);
          localStorage.setItem('doctorData', JSON.stringify(data.doctor));
          document.cookie = `doctorToken=${encodeURIComponent(data.token)}; path=/; max-age=43200; SameSite=Lax`;
          okAlert.textContent = 'Acesso autorizado. Redirecionando...';
          okAlert.style.display = 'block';
          setTimeout(() => { window.location.href = '/medico'; }, 900);
          return;
        }

        errAlert.textContent = data.error || 'Credenciais invalidas.';
        errAlert.style.display = 'block';
      } catch {
        errAlert.textContent = 'Erro de conexao. Tente novamente em instantes.';
        errAlert.style.display = 'block';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Entrar no Sistema';
      }
    });
  </script>
</body>
</html>